---
// Every page uses this layout: SEO tags, fonts, navbar, mobile menu, footer, motion.
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/lora/wght-italic.css';
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import MobileMenu from '../components/layout/MobileMenu.astro';
import Footer from '../components/layout/Footer.astro';
import { site, reviewMode } from '../data/site';
import { assetUrl } from '../lib/assets';

interface BreadcrumbItem {
  name: string;
  url?: string;
}

interface Props {
  /** Page title; the site name is appended (the home page passes nothing). */
  title?: string;
  description?: string;
  /** Absolute or root-relative path to a 1200×630 share image. */
  image?: string;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[] | false;
  schemaExtra?: Record<string, any>[];
}
const {
  title,
  description = site.description,
  image = '/brand/og-default.jpg',
  noindex = false,
  breadcrumbs,
  schemaExtra = [],
} = Astro.props;
const fullTitle = title ? `${title} · ${site.fullName}` : `${site.fullName} · ${site.school.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const resolvedImage = assetUrl(image);
const ogImage = resolvedImage.startsWith('http') ? new URL(resolvedImage) : new URL(resolvedImage, Astro.site);

const siteUrl = Astro.site ? Astro.site.href.replace(/\/+$/, '') : 'https://insight.estin.dz';
const resolvedLogo = assetUrl('/brand/insight-logo.png');
const logoUrl = resolvedLogo.startsWith('http') ? resolvedLogo : new URL('/brand/insight-logo.png', Astro.site).href;

// Dynamic BreadcrumbList for hierarchical Google SERP Rich Snippets & AI Answer Engine extraction
const pathname = Astro.url.pathname.replace(/\/+$/, '');
const segments = pathname.split('/').filter(Boolean);

let breadcrumbElements: { '@type': string; position: number; name: string; item: string }[] = [];

if (breadcrumbs !== false && segments.length > 0) {
  if (Array.isArray(breadcrumbs) && breadcrumbs.length > 0) {
    breadcrumbElements = breadcrumbs.map((b, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: b.name,
      item: b.url ? (b.url.startsWith('http') ? b.url : `${siteUrl}${b.url}`) : canonical.href,
    }));
  } else {
    breadcrumbElements.push({
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteUrl}/`,
    });

    const segmentTitles: Record<string, string> = {
      about: 'About',
      collaborate: 'Collaborate',
      contact: 'Contact',
      crew: 'Crew & Helm',
      events: 'Events',
      join: 'Join',
      network: 'Research Network',
      privacy: 'Privacy Policy',
      research: 'Research Poles',
      ai: 'Artificial Intelligence',
      security: 'Cybersecurity',
      software: 'Software Engineering',
      networks: 'Networks & Systems',
      spark: 'SPARK 2026',
      training: 'Training Path',
      case: 'The Music Case',
      mentor: 'Mentor Panel',
    };

    let accum = '';
    for (let i = 0; i < segments.length; i++) {
      const seg = segments[i];
      accum += `/${seg}`;
      const isLast = i === segments.length - 1;
      let label = segmentTitles[seg] || seg.charAt(0).toUpperCase() + seg.slice(1).replace(/-/g, ' ');
      if (isLast && title) {
        label = title.split('·')[0].trim();
      }

      breadcrumbElements.push({
        '@type': 'ListItem',
        position: i + 2,
        name: label,
        item: `${siteUrl}${accum}/`,
      });
    }
  }
}

// Enterprise Schema.org Graph for Google Rich Snippets & AI Answer Engines (Perplexity, ChatGPT, Claude, Gemini)
const schemaGraph: Record<string, any> = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: site.fullName,
      alternateName: [site.name, 'INSIGHT ESTIN'],
      description: site.description,
      inLanguage: 'en',
      publisher: {
        '@id': `${siteUrl}/#organization`,
      },
    },
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: site.fullName,
      alternateName: [site.name, 'Club INSIGHT ESTIN', 'INSIGHT Research Club ESTIN'],
      url: `${siteUrl}/`,
      logo: {
        '@type': 'ImageObject',
        url: logoUrl,
        width: 680,
        height: 402,
      },
      image: ogImage.href,
      description: site.description,
      slogan: site.tagline,
      email: site.email,
      foundingDate: site.founded,
      knowsAbout: [
        'Artificial Intelligence',
        'Trustworthy AI',
        'Adversarial Robustness',
        'Cybersecurity',
        'Software Engineering',
        'Computer Networks',
        'Distributed Systems',
        'Scientific Research Methodology',
        'Academic Writing',
      ],
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Amizour',
        addressRegion: 'Béjaïa',
        postalCode: '06340',
        addressCountry: 'DZ',
      },
      parentOrganization: {
        '@type': 'CollegeOrUniversity',
        name: site.school.fullName,
        alternateName: site.school.name,
        url: site.school.url,
      },
      sameAs: [site.instagram.url, site.linkedin.url],
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical.href}#webpage`,
      url: canonical.href,
      name: fullTitle,
      description,
      inLanguage: 'en',
      isPartOf: {
        '@id': `${siteUrl}/#website`,
      },
      about: {
        '@id': `${siteUrl}/#organization`,
      },
      ...(breadcrumbElements.length > 0
        ? {
            breadcrumb: {
              '@id': `${canonical.href}#breadcrumb`,
            },
          }
        : {}),
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: ogImage.href,
        width: 1200,
        height: 630,
      },
    },
    ...(breadcrumbElements.length > 0
      ? [
          {
            '@type': 'BreadcrumbList',
            '@id': `${canonical.href}#breadcrumb`,
            itemListElement: breadcrumbElements,
          },
        ]
      : []),
    ...schemaExtra,
  ],
};
---
<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // `js` hides reveal-on-scroll content until motion.ts runs. If that script is slow or fails (weak mobile network),
      // `reveal-all` shows everything after 4 s, so a page is never left blank.
      (function (d) { d.classList.add('js'); setTimeout(function () { if (!d.classList.contains('motion-ready')) d.classList.add('reveal-all'); }, 4000); })(document.documentElement);
    </script>

    <!-- Primary Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <meta name="author" content={site.fullName} />
    <link rel="canonical" href={canonical} />

    <!-- Robots & Crawler Directives (AEO / SEO) -->
    {noindex || reviewMode ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <!-- Preconnect CDN for Edge Media Delivery -->
    <link rel="preconnect" href="https://pub-554f8a45acb54090af55ec98805e7e60.r2.dev" crossorigin />
    <link rel="dns-prefetch" href="https://pub-554f8a45acb54090af55ec98805e7e60.r2.dev" />

    <!-- Mobile & PWA -->
    <meta name="theme-color" content="#0B1120" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="INSIGHT" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/brand/insight-logo-sm.png" />
    <link rel="apple-touch-icon" href="/brand/insight-logo-sm.png" />

    <!-- Open Graph / Facebook / LinkedIn / Discord -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={site.fullName} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content={fullTitle} />

    <!-- Structured Data (Schema.org Graph for SEO & AEO) -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaGraph)} />

    <!-- AI & Answer Engine Discovery (AEO / GEO) -->
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Summary" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Full LLM Documentation" />

    <slot name="head" />
  </head>
  <body id="top" class="bg-ink text-silver font-sans text-[16px] antialiased selection:bg-blue selection:text-white">
    <slot name="body-start" />
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:px-4 focus:py-2 focus:bg-blue focus:text-white">Skip to content</a>
    <Navbar />
    <MobileMenu />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div id="scrollbar" aria-hidden="true" hidden><div id="scrollbar-thumb"></div></div>
    <script>
      import '../scripts/motion.ts';
      import '../scripts/scrollbar.ts';
    </script>
  </body>
</html>
