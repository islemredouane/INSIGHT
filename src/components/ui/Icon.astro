---
// Small inline icon set (the same strokes used in home-v3). Decorative by default.
interface Props {
  name: 'arrow-right' | 'arrow-up' | 'arrow-up-right' | 'instagram' | 'linkedin' | 'github' | 'star' | 'copy' | 'chevron-down' | 'plus' | 'x';
  class?: string;
  strokeWidth?: number;
}
const { name, class: className = 'w-4 h-4', strokeWidth = 1.8 } = Astro.props;
---
<svg class={className} fill="none" stroke="currentColor" stroke-width={strokeWidth} viewBox="0 0 24 24" aria-hidden="true">
  {name === 'arrow-right' && <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="square" />}
  {name === 'arrow-up' && <path d="M12 19V5M6 11l6-6 6 6" stroke-linecap="square" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8 7h9v9" stroke-linecap="square" />}
  {name === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></>}
  {name === 'linkedin' && <><rect x="3" y="3" width="18" height="18" rx="2" /><path d="M8 11v5M8 8v.01M12 16v-3.2a1.8 1.8 0 0 1 3.6 0V16M12 11v5" stroke-linecap="round" /></>}
  {name === 'github' && <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" stroke-linecap="round" stroke-linejoin="round" />}
  {name === 'star' && <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke-linecap="round" stroke-linejoin="round" />}
  {name === 'copy' && <><rect x="8" y="8" width="12" height="12" /><path d="M16 8V4H4v12h4" /></>}
  {name === 'chevron-down' && <path d="m6 9 6 6 6-6" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" stroke-linecap="square" />}
  {name === 'x' && <path d="M6 6l12 12M18 6 6 18" stroke-linecap="square" />}
</svg>
