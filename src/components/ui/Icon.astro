---
// Small inline icon set (the same strokes used in home-v3). Decorative by default.
interface Props {
  name: 'arrow-right' | 'arrow-up' | 'arrow-up-right' | 'instagram' | 'copy' | 'chevron-down' | 'plus' | 'x';
  class?: string;
  strokeWidth?: number;
}
const { name, class: className = 'w-4 h-4', strokeWidth = 1.8 } = Astro.props;
---
<svg class={className} fill="none" stroke="currentColor" stroke-width={strokeWidth} viewBox="0 0 24 24" aria-hidden="true">
  {name === 'arrow-right' && <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="square" />}
  {name === 'arrow-up' && <path d="M12 19V5M6 11l6-6 6 6" stroke-linecap="square" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8 7h9v9" stroke-linecap="square" />}
  {name === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></>}
  {name === 'copy' && <><rect x="8" y="8" width="12" height="12" /><path d="M16 8V4H4v12h4" /></>}
  {name === 'chevron-down' && <path d="m6 9 6 6 6-6" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" stroke-linecap="square" />}
  {name === 'x' && <path d="M6 6l12 12M18 6 6 18" stroke-linecap="square" />}
</svg>
