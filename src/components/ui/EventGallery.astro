---
// Modern interactive event gallery with self-balancing bento grid, keyboard-navigable lightbox & filmstrip
import SectionHeader from './SectionHeader.astro';
import EmptyState from './EmptyState.astro';

interface Props {
  images: string[];
  eventTitle?: string;
  eyebrow?: string;
  title?: string;
}

const {
  images = [],
  eventTitle = 'Event',
  eyebrow = 'Photos',
  title = 'Gallery.',
} = Astro.props;

// Helper: mathematically compute spans so:
// 1) Key moments (intro, keynote, games, awards) get featured wide spans
// 2) Total column units modulo 3 == 0 on desktop (lg), so the final row is 100% full
// 3) On tablet (sm), any odd single-column photos are sealed by expanding the final photo
function computeSpans(total: number) {
  if (total <= 2) return new Map<number, string>();

  const priorityCandidates = [0, 5, 8, 14].filter((i) => i < total - 1);

  let chosenWide: number[] = [];
  for (let k = 0; k <= priorityCandidates.length; k++) {
    const combos = getCombinations(priorityCandidates, k);
    for (const combo of combos) {
      if ((total + combo.length) % 3 === 0) {
        chosenWide = combo;
        break;
      }
    }
    if (chosenWide.length > 0 || (total % 3 === 0 && k === 0)) break;
  }

  const wideSet = new Set(chosenWide);
  const remainingLg = (total + wideSet.size) % 3;
  const singlesCount = total - wideSet.size;
  const lastNeedsSmWide = singlesCount % 2 !== 0;

  const result = new Map<number, string>();

  for (let i = 0; i < total; i++) {
    const isWideLg = wideSet.has(i);
    const isLast = i === total - 1;

    if (isWideLg) {
      result.set(i, 'sm:col-span-2 lg:col-span-2 aspect-[16/10]');
    } else if (isLast && remainingLg === 2) {
      result.set(i, 'sm:col-span-2 lg:col-span-2 aspect-[16/10]');
    } else if (isLast && remainingLg === 1) {
      result.set(i, 'sm:col-span-2 lg:col-span-3 aspect-[21/9]');
    } else if (isLast && lastNeedsSmWide) {
      result.set(i, 'sm:col-span-2 lg:col-span-1 aspect-[16/9] lg:aspect-[4/3]');
    } else {
      result.set(i, 'aspect-[4/3]');
    }
  }

  return result;
}

function getCombinations<T>(arr: T[], k: number): T[][] {
  if (k === 0) return [[]];
  if (arr.length === 0) return [];
  const head = arr[0];
  const tail = arr.slice(1);
  const withHead = getCombinations(tail, k - 1).map((c) => [head, ...c]);
  const withoutHead = getCombinations(tail, k);
  return [...withHead, ...withoutHead];
}

const spanMap = computeSpans(images.length);
---

<section class="bg-white text-ink py-24 border-t border-navy/10 relative overflow-hidden" id="gallery">
  <div class="max-w-[1240px] mx-auto px-6 md:px-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <SectionHeader eyebrow={eyebrow} title={title} class="max-w-xl" />
      {images.length > 0 && (
        <div class="rv flex items-center gap-3">
          <span class="inline-flex items-center px-3 py-1 rounded-full font-mono text-[12px] font-semibold tracking-wider text-blue bg-blue/10 border border-blue/20">
            {images.length} {images.length === 1 ? 'CAPTURE' : 'CAPTURES'}
          </span>
          <span class="hidden sm:inline-block font-mono text-[11px] text-muted">
            Click to expand · Navigate with ← →
          </span>
        </div>
      )}
    </div>

    {images.length > 0 ? (
      <div class="rv-stagger grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-5 [grid-auto-flow:dense]" role="region" aria-label="Event photos">
        {images.map((src, idx) => {
          const spanClass = spanMap.get(idx) || 'aspect-[4/3]';
          const indexLabel = String(idx + 1).padStart(2, '0');
          const totalLabel = String(images.length).padStart(2, '0');
          return (
            <button
              type="button"
              class:list={[
                'gallery-trigger group relative w-full overflow-hidden rounded-2xl bg-paper border border-navy/10 hover:border-blue/50 text-left transition-all duration-500 hover:shadow-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 cursor-pointer',
                spanClass,
              ]}
              data-index={idx}
              aria-label={`View photo ${idx + 1} of ${images.length} fullscreen`}
            >
              <img
                src={src}
                alt={`${eventTitle} photo ${idx + 1}`}
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              
              <!-- Subtle vignette overlay on hover -->
              <div class="absolute inset-0 bg-gradient-to-t from-ink/80 via-ink/20 to-transparent opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity duration-300 pointer-events-none" />

              <!-- Overlay info bar -->
              <div class="absolute inset-x-0 bottom-0 p-4 flex items-center justify-between opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-all duration-300 translate-y-1 group-hover:translate-y-0 group-focus-visible:translate-y-0 pointer-events-none">
                <span class="font-mono text-[11px] font-semibold text-white/95 bg-ink/60 backdrop-blur-md px-2.5 py-1 rounded border border-white/10 tracking-widest">
                  [{indexLabel} / {totalLabel}]
                </span>

                <span class="w-8 h-8 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-white flex items-center justify-center shadow-lg">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
                  </svg>
                </span>
              </div>
            </button>
          );
        })}
      </div>
    ) : (
      <EmptyState
        label="Coming soon"
        title="Photos are on their way."
        text="The Communication & Media department is preparing the photos of this event."
      />
    )}
  </div>

  <!-- Interactive Lightbox Modal -->
  {images.length > 0 && (
    <div
      id="gallery-lightbox"
      class="fixed inset-0 z-50 flex flex-col justify-between bg-ink/95 backdrop-blur-2xl opacity-0 pointer-events-none transition-opacity duration-300"
      role="dialog"
      aria-modal="true"
      aria-label="Photo Lightbox"
      tabindex="-1"
    >
      <!-- Top header bar -->
      <div class="relative z-10 flex items-center justify-between px-6 py-5 border-b border-silver/10 text-white select-none">
        <div class="flex items-center gap-3">
          <span class="eyebrow text-peri-light font-mono text-[11px] tracking-wider hidden sm:inline">
            INSIGHT ARCHIVE
          </span>
          <span class="hidden sm:inline text-silver/30 font-mono">/</span>
          <span class="text-[14px] font-medium text-silver truncate max-w-[200px] sm:max-w-xs md:max-w-md">
            {eventTitle}
          </span>
        </div>

        <div class="flex items-center gap-4">
          <span id="lightbox-counter" class="font-mono text-[13px] tracking-wider text-peri-light font-semibold bg-silver/10 px-3 py-1 rounded border border-silver/10">
            01 / {String(images.length).padStart(2, '0')}
          </span>

          <button
            type="button"
            id="lightbox-close"
            class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 border border-white/10 text-white text-[13px] font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-peri"
            aria-label="Close photo lightbox"
          >
            <span class="hidden sm:inline font-mono text-[11px] text-silver/70">ESC</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 6L6 18M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Main Stage with Navigation -->
      <div class="relative flex-1 flex items-center justify-center p-4 sm:p-8 min-h-0 overflow-hidden" id="lightbox-stage">
        <!-- Previous Button -->
        <button
          type="button"
          id="lightbox-prev"
          class="absolute left-4 sm:left-8 z-20 w-12 h-12 rounded-full bg-white/10 hover:bg-white/25 border border-white/15 text-white flex items-center justify-center backdrop-blur-md transition-all shadow-xl hover:scale-105 active:scale-95 focus:outline-none focus:ring-2 focus:ring-peri"
          aria-label="Previous photo"
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </button>

        <!-- Current Active Image -->
        <div class="relative max-w-full max-h-full flex items-center justify-center" id="lightbox-image-container">
          <img
            id="lightbox-image"
            src={images[0]}
            alt={`${eventTitle} fullscreen photo`}
            class="max-h-[70vh] sm:max-h-[74vh] max-w-[92vw] sm:max-w-[85vw] object-contain rounded-xl shadow-2xl transition-all duration-300 select-none cursor-grab"
            draggable="false"
          />
        </div>

        <!-- Next Button -->
        <button
          type="button"
          id="lightbox-next"
          class="absolute right-4 sm:right-8 z-20 w-12 h-12 rounded-full bg-white/10 hover:bg-white/25 border border-white/15 text-white flex items-center justify-center backdrop-blur-md transition-all shadow-xl hover:scale-105 active:scale-95 focus:outline-none focus:ring-2 focus:ring-peri"
          aria-label="Next photo"
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </button>
      </div>

      <!-- Bottom Filmstrip Navigation -->
      <div class="relative z-10 px-6 py-4 border-t border-silver/10 bg-ink-deep/80 backdrop-blur-lg">
        <div
          id="lightbox-filmstrip"
          class="flex items-center justify-center gap-2 overflow-x-auto max-w-4xl mx-auto py-1 scrollbar-none"
          role="tablist"
          aria-label="Filmstrip thumbnails"
        >
          {images.map((src, idx) => (
            <button
              type="button"
              class="filmstrip-thumb flex-none w-14 h-10 sm:w-16 sm:h-11 rounded-lg overflow-hidden border border-silver/20 opacity-40 hover:opacity-90 transition-all focus:outline-none"
              data-index={idx}
              role="tab"
              aria-label={`Jump to photo ${idx + 1}`}
            >
              <img src={src} alt="" class="w-full h-full object-cover pointer-events-none" loading="lazy" />
            </button>
          ))}
        </div>
      </div>
    </div>
  )}
</section>

<script is:inline define:vars={{ imagesCount: images.length }}>
  (() => {
    if (imagesCount === 0) return;

    const triggers = document.querySelectorAll('.gallery-trigger');
    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImg = document.getElementById('lightbox-image');
    const counter = document.getElementById('lightbox-counter');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    const thumbs = document.querySelectorAll('.filmstrip-thumb');
    const stage = document.getElementById('lightbox-stage');

    if (!lightbox || !lightboxImg) return;

    const imageSources = Array.from(triggers).map((el) => {
      const img = el.querySelector('img');
      return img ? img.src : '';
    });

    let currentIndex = 0;
    let lastActiveTrigger = null;

    function pad(n) {
      return String(n).padStart(2, '0');
    }

    function updateLightbox(index) {
      if (index < 0) index = imageSources.length - 1;
      if (index >= imageSources.length) index = 0;
      currentIndex = index;

      lightboxImg.style.opacity = '0';
      lightboxImg.style.transform = 'scale(0.97)';
      
      const nextSrc = imageSources[currentIndex];
      const preload = new Image();
      preload.src = nextSrc;
      preload.onload = () => {
        lightboxImg.src = nextSrc;
        lightboxImg.style.opacity = '1';
        lightboxImg.style.transform = 'scale(1)';
      };

      if (counter) {
        counter.textContent = `${pad(currentIndex + 1)} / ${pad(imageSources.length)}`;
      }

      thumbs.forEach((thumb, idx) => {
        if (idx === currentIndex) {
          thumb.classList.remove('opacity-40');
          thumb.classList.add('opacity-100', 'ring-2', 'ring-peri-light', 'scale-105');
          thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          thumb.classList.add('opacity-40');
          thumb.classList.remove('opacity-100', 'ring-2', 'ring-peri-light', 'scale-105');
        }
      });
    }

    function openLightbox(index) {
      lastActiveTrigger = document.activeElement;
      updateLightbox(index);
      lightbox.classList.remove('opacity-0', 'pointer-events-none');
      lightbox.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';
      lightbox.focus();
    }

    function closeLightbox() {
      lightbox.classList.remove('opacity-100', 'pointer-events-auto');
      lightbox.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';
      if (lastActiveTrigger && typeof lastActiveTrigger.focus === 'function') {
        lastActiveTrigger.focus();
      }
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const idx = parseInt(trigger.getAttribute('data-index') || '0', 10);
        openLightbox(idx);
      });
    });

    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
    if (prevBtn) prevBtn.addEventListener('click', (e) => { e.stopPropagation(); updateLightbox(currentIndex - 1); });
    if (nextBtn) nextBtn.addEventListener('click', (e) => { e.stopPropagation(); updateLightbox(currentIndex + 1); });

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt(thumb.getAttribute('data-index') || '0', 10);
        updateLightbox(idx);
      });
    });

    if (stage) {
      stage.addEventListener('click', (e) => {
        if (e.target === stage || e.target.id === 'lightbox-image-container') {
          closeLightbox();
        }
      });
    }

    window.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('pointer-events-auto')) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        closeLightbox();
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        updateLightbox(currentIndex - 1);
      } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        updateLightbox(currentIndex + 1);
      }
    });

    // Touch / Swipe support
    let touchStartX = 0;
    let touchEndX = 0;
    const swipeThreshold = 50;

    lightbox.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    lightbox.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchEndX - touchStartX;
      if (Math.abs(diff) > swipeThreshold) {
        if (diff > 0) {
          updateLightbox(currentIndex - 1);
        } else {
          updateLightbox(currentIndex + 1);
        }
      }
    }, { passive: true });
  })();
</script>
