---
// Modern Pro Architecture Event Gallery
// Features: Dual View Mode (Bento Grid & Masonry Wall), contextual editorial captions,
// pixel-locked baseline row alignment, and full interactive lightbox modal.
import SectionHeader from './SectionHeader.astro';
import EmptyState from './EmptyState.astro';
import { assetUrl } from '../../lib/assets';

interface Props {
  images: string[];
  eventTitle?: string;
  eyebrow?: string;
  title?: string;
}

const {
  images = [],
  eventTitle = 'Event',
  eyebrow = 'Photos & Archive',
  title = 'Gallery.',
} = Astro.props;

// Curated editorial captions mapping for Welcome Day 2026
const editorialCaptions: Record<number, string> = {
  0: 'Welcome Aboard · Helm Presentation',
  1: 'Meet the Crew & Departments',
  2: 'Audience & New Recruits',
  3: 'Research Poles Overview',
  4: 'The Voyage from Rookie to Captain',
  5: 'Dr. Pin-Yu Chen · Keynote from IBM Research NYC',
  6: 'Trustworthy AI & Adversarial Robustness',
  7: 'Interactive Q&A Session',
  8: 'Recruit Challenges & Game Time',
  9: 'Team Collaboration & Networking',
  10: 'Crew Mentoring & Discussions',
  11: 'Interactive Icebreakers',
  12: 'Engaged Student Audience',
  13: 'Trivia & Scientific Brainstorming',
  14: 'Award Ceremony & Prize Winners',
  15: 'New Recruits Induction Ceremony',
  16: 'INSIGHT Helm & Core Organizers',
  17: 'Official Welcome Day 2026 Finale',
};

// Curated per-photo focal point alignment (object-position)
// Guarantees subjects, faces, and stage elements remain perfectly framed
// without clipping or showing empty ceilings, while keeping grid architecture intact.
const imagePositions: Record<string, string> = {
  'welcome-day-1.jpg': 'center 20%',      // Recruits at onboarding table & INSIGHT Ship sign
  'welcome-day-2.jpg': 'center 45%',      // Sword pose with One Piece Wanted posters
  'welcome-day-3.jpg': 'center 25%',      // Recruits at activity table & treasure chest
  'welcome-day-4.jpg': 'center 15%',      // Recruits standing at table (prevents head clipping)
  'welcome-day-5.jpg': 'center 50%',      // Three recruits holding Wanted frame
  'live.jpg': 'center 48%',               // Dr. Pin-Yu Chen keynote stream from IBM Research
  'welcome-day-6.jpg': 'center 45%',      // Stage projection of virtual keynote
  'welcome-day-7.jpg': 'center 65%',      // Seated student audience in auditorium
  'game.jpg': 'center 45%',               // Stage recruit challenge & Homelander guessing game
  'welcome-day-8.jpg': 'center 45%',      // Speaker presentation with microphone
  'welcome-day-9.jpg': 'center 52%',      // Presenter on stage ("Choose Your Destiny")
  'welcome-day-10.jpg': 'center 68%',     // Hall overview with seated recruits
  'welcome-day-11.jpg': 'center 45%',     // Stage guessing game with timer & Itachi
  'welcome-day-12.jpg': 'center 42%',     // Stage guessing game with Trump slide
  'winners-and-prizes.jpg': 'center 40%', // Prize winners on stage with ESTIN gift bags
  'welcome-day-13.png': 'center 38%',     // Department Head presentation on stage
  'welcome-day-14.png': 'center 50%',     // Student attendees in auditorium seats
  'welcome-day-15.png': 'center 58%',     // Full INSIGHT Club finale group photo
};

function getImagePosition(src: string): string {
  const filename = src.split('/').pop() || '';
  return imagePositions[filename] || 'center center';
}

// Pro Bento span configuration:
// Locked to uniform row-unit heights (270px desktop, 240px tablet)
// Guaranteed mathematical baseline alignment
function getBentoSpan(index: number, total: number) {
  if (total <= 2) return 'col-span-1 row-span-1 min-h-[270px]';

  // Item 0: Grand 2x2 Hero Block (560px tall, 2 cols wide)
  if (index === 0) return 'sm:col-span-2 sm:row-span-2 lg:col-span-2 lg:row-span-2 min-h-[500px] lg:min-h-[560px]';

  // Featured 2-column wide highlights (270px tall, exactly matches 1 standard row)
  if (index === 5 && total >= 8) return 'sm:col-span-2 lg:col-span-2 row-span-1 min-h-[240px] lg:min-h-[270px]';
  if (index === 8 && total >= 11) return 'sm:col-span-2 lg:col-span-2 row-span-1 min-h-[240px] lg:min-h-[270px]';
  if (index === 14 && total >= 16) return 'sm:col-span-2 lg:col-span-2 row-span-1 min-h-[240px] lg:min-h-[270px]';

  // Standard 1x1 cell
  return 'col-span-1 row-span-1 min-h-[240px] lg:min-h-[270px]';
}
---

<section class="bg-[#F8F9FB] text-ink py-24 border-t border-navy/10 relative overflow-hidden" id="gallery">
  <div class="max-w-[1280px] mx-auto px-6 md:px-12">
    <!-- Gallery Top Bar / Header -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12">
      <div>
        <SectionHeader eyebrow={eyebrow} title={title} class="max-w-xl" />
        <p class="rv mt-3 font-serif italic text-lg sm:text-xl text-body">
          {images.length} visual records captured live at {eventTitle.split(':')[0]}.
        </p>
      </div>

      {images.length > 0 && (
        <div class="rv flex items-center gap-3">
          <!-- Total Count Badge -->
          <span class="inline-flex items-center px-3.5 py-1.5 rounded-xl font-mono text-[12px] font-semibold tracking-wider text-blue bg-blue/8 border border-blue/20">
            {images.length} CAPTURES
          </span>

          <!-- Launch Slideshow -->
          <button
            type="button"
            id="start-slideshow-btn"
            class="hidden sm:inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-[13px] font-medium bg-ink text-white hover:bg-navy transition-colors shadow-sm focus:outline-none focus:ring-2 focus:ring-blue cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 text-peri-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="5 3 19 12 5 21 5 3" />
            </svg>
            <span>Slideshow</span>
          </button>
        </div>
      )}
    </div>

    <!-- Gallery Container -->
    {images.length > 0 ? (
      <div
        id="gallery-container"
        class="rv-stagger gallery-bento grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:auto-rows-[270px] sm:auto-rows-[240px] [grid-auto-flow:dense] transition-all duration-300"
        role="region"
        aria-label="Event photos"
      >
        {images.map((src, idx) => {
          const bentoSpan = getBentoSpan(idx, images.length);
          const caption = editorialCaptions[idx] || `${eventTitle} Capture ${idx + 1}`;
          const indexLabel = String(idx + 1).padStart(2, '0');
          const totalLabel = String(images.length).padStart(2, '0');

          return (
            <button
              type="button"
              class:list={[
                'gallery-trigger group relative w-full overflow-hidden rounded-2xl bg-white border border-silver/60 hover:border-blue/50 text-left transition-all duration-500 hover:shadow-2xl hover:-translate-y-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue focus-visible:ring-offset-2 cursor-pointer shadow-[0_4px_16px_rgba(11,17,32,0.04)]',
                bentoSpan,
              ]}
              data-index={idx}
              data-bento-span={bentoSpan}
              aria-label={`View photo ${idx + 1}: ${caption}`}
            >
              <!-- Image element -->
              <img
                src={assetUrl(src)}
                alt={caption}
                class="gallery-img w-full h-full object-cover transition-transform duration-700 cubic-bezier(0.16, 1, 0.3, 1) group-hover:scale-105"
                style={`object-position: ${getImagePosition(src)};`}
                loading="lazy"
                decoding="async"
              />

              <!-- Ambient dark gradient vignette -->
              <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/25 to-transparent opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity duration-300 pointer-events-none" />

              <!-- Top index pill -->
              <div class="absolute top-4 left-4 opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-opacity duration-300 pointer-events-none">
                <span class="font-mono text-[11px] font-semibold text-white/90 bg-ink/70 backdrop-blur-md px-2.5 py-1 rounded-md border border-white/10 tracking-widest">
                  [{indexLabel} / {totalLabel}]
                </span>
              </div>

              <!-- Top right expand icon button -->
              <div class="absolute top-4 right-4 opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-all duration-300 scale-90 group-hover:scale-100 pointer-events-none">
                <span class="w-8 h-8 rounded-full bg-white/20 backdrop-blur-md border border-white/30 text-white flex items-center justify-center shadow-lg">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
                  </svg>
                </span>
              </div>

              <!-- Bottom caption info -->
              <div class="absolute inset-x-0 bottom-0 p-5 translate-y-2 group-hover:translate-y-0 opacity-0 group-hover:opacity-100 group-focus-visible:opacity-100 transition-all duration-300 pointer-events-none">
                <p class="font-display font-bold text-white text-[15px] sm:text-[16px] leading-snug drop-shadow-sm">
                  {caption}
                </p>
                <p class="mt-1 font-mono text-[11px] text-peri-light tracking-wide flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-peri-light inline-block"></span>
                  Click to inspect full resolution
                </p>
              </div>
            </button>
          );
        })}
      </div>
    ) : (
      <EmptyState
        label="Coming soon"
        title="Photos are on their way."
        text="The Communication & Media department is preparing the photos of this event."
      />
    )}
  </div>

  <!-- Interactive Lightbox Modal -->
  {images.length > 0 && (
    <div
      id="gallery-lightbox"
      class="fixed inset-0 z-50 flex flex-col justify-between bg-ink/95 backdrop-blur-2xl opacity-0 pointer-events-none transition-opacity duration-300"
      role="dialog"
      aria-modal="true"
      aria-label="Photo Lightbox"
      tabindex="-1"
    >
      <!-- Top header bar -->
      <div class="relative z-10 flex items-center justify-between px-6 py-5 border-b border-silver/10 text-white select-none">
        <div class="flex items-center gap-3">
          <span class="eyebrow text-peri-light font-mono text-[11px] tracking-wider hidden sm:inline">
            INSIGHT ARCHIVE
          </span>
          <span class="hidden sm:inline text-silver/30 font-mono">/</span>
          <span id="lightbox-title" class="text-[14px] font-medium text-silver truncate max-w-[200px] sm:max-w-xs md:max-w-md">
            {eventTitle}
          </span>
        </div>

        <div class="flex items-center gap-4">
          <span id="lightbox-counter" class="font-mono text-[13px] tracking-wider text-peri-light font-semibold bg-silver/10 px-3 py-1 rounded-lg border border-silver/10">
            01 / {String(images.length).padStart(2, '0')}
          </span>

          <button
            type="button"
            id="lightbox-close"
            class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 border border-white/10 text-white text-[13px] font-medium transition-colors focus:outline-none focus:ring-2 focus:ring-peri cursor-pointer"
            aria-label="Close photo lightbox"
          >
            <span class="hidden sm:inline font-mono text-[11px] text-silver/70">ESC</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 6L6 18M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Main Stage with Navigation -->
      <div class="relative flex-1 flex items-center justify-center p-4 sm:p-8 min-h-0 overflow-hidden" id="lightbox-stage">
        <!-- Previous Button -->
        <button
          type="button"
          id="lightbox-prev"
          class="absolute left-4 sm:left-8 z-20 w-12 h-12 rounded-full bg-white/10 hover:bg-white/25 border border-white/15 text-white flex items-center justify-center backdrop-blur-md transition-all shadow-xl hover:scale-105 active:scale-95 focus:outline-none focus:ring-2 focus:ring-peri cursor-pointer"
          aria-label="Previous photo"
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </button>

        <!-- Current Active Image & Caption -->
        <div class="relative max-w-full max-h-full flex flex-col items-center justify-center" id="lightbox-image-container">
          <img
            id="lightbox-image"
            src={assetUrl(images[0])}
            alt={`${eventTitle} fullscreen photo`}
            class="max-h-[68vh] sm:max-h-[72vh] max-w-[92vw] sm:max-w-[85vw] object-contain rounded-xl shadow-2xl transition-all duration-300 select-none cursor-grab"
            draggable="false"
          />
          <p id="lightbox-caption" class="mt-3 font-display font-medium text-white/90 text-sm sm:text-base text-center max-w-xl truncate px-4">
            {editorialCaptions[0]}
          </p>
        </div>

        <!-- Next Button -->
        <button
          type="button"
          id="lightbox-next"
          class="absolute right-4 sm:right-8 z-20 w-12 h-12 rounded-full bg-white/10 hover:bg-white/25 border border-white/15 text-white flex items-center justify-center backdrop-blur-md transition-all shadow-xl hover:scale-105 active:scale-95 focus:outline-none focus:ring-2 focus:ring-peri cursor-pointer"
          aria-label="Next photo"
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </button>
      </div>

      <!-- Bottom Filmstrip Navigation -->
      <div class="relative z-10 px-6 py-3 border-t border-silver/10 bg-ink-deep/80 backdrop-blur-lg">
        <div
          id="lightbox-filmstrip"
          class="flex items-center justify-center gap-2 overflow-x-auto max-w-4xl mx-auto py-1 scrollbar-none"
          role="tablist"
          aria-label="Filmstrip thumbnails"
        >
          {images.map((src, idx) => (
            <button
              type="button"
              class="filmstrip-thumb flex-none w-14 h-10 sm:w-16 sm:h-11 rounded-lg overflow-hidden border border-silver/20 opacity-40 hover:opacity-90 transition-all focus:outline-none cursor-pointer"
              data-index={idx}
              role="tab"
              aria-label={`Jump to photo ${idx + 1}`}
            >
              <img
                src={assetUrl(src)}
                alt=""
                class="w-full h-full object-cover pointer-events-none"
                style={`object-position: ${getImagePosition(src)};`}
                loading="lazy"
              />
            </button>
          ))}
        </div>
      </div>
    </div>
  )}
</section>

<script is:inline define:vars={{ imagesCount: images.length, captionsMap: editorialCaptions }}>
  (() => {
    if (imagesCount === 0) return;

    // View Switcher logic (Bento vs Masonry)
    const container = document.getElementById('gallery-container');
    const triggers = document.querySelectorAll('.gallery-trigger');

    // Lightbox Logic
    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImg = document.getElementById('lightbox-image');
    const lightboxCaption = document.getElementById('lightbox-caption');
    const counter = document.getElementById('lightbox-counter');
    const closeBtn = document.getElementById('lightbox-close');
    const prevBtn = document.getElementById('lightbox-prev');
    const nextBtn = document.getElementById('lightbox-next');
    const thumbs = document.querySelectorAll('.filmstrip-thumb');
    const stage = document.getElementById('lightbox-stage');
    const startSlideshowBtn = document.getElementById('start-slideshow-btn');

    if (!lightbox || !lightboxImg) return;

    const imageSources = Array.from(triggers).map((el) => {
      const img = el.querySelector('img');
      return img ? img.src : '';
    });

    let currentIndex = 0;
    let lastActiveTrigger = null;

    function pad(n) {
      return String(n).padStart(2, '0');
    }

    function updateLightbox(index) {
      if (index < 0) index = imageSources.length - 1;
      if (index >= imageSources.length) index = 0;
      currentIndex = index;

      lightboxImg.style.opacity = '0';
      lightboxImg.style.transform = 'scale(0.97)';
      
      const nextSrc = imageSources[currentIndex];
      const preload = new Image();
      preload.src = nextSrc;
      preload.onload = () => {
        lightboxImg.src = nextSrc;
        lightboxImg.style.opacity = '1';
        lightboxImg.style.transform = 'scale(1)';
      };

      if (counter) {
        counter.textContent = `${pad(currentIndex + 1)} / ${pad(imageSources.length)}`;
      }

      if (lightboxCaption) {
        lightboxCaption.textContent = captionsMap[currentIndex] || `Photo ${currentIndex + 1}`;
      }

      thumbs.forEach((thumb, idx) => {
        if (idx === currentIndex) {
          thumb.classList.remove('opacity-40');
          thumb.classList.add('opacity-100', 'ring-2', 'ring-peri-light', 'scale-105');
          thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          thumb.classList.add('opacity-40');
          thumb.classList.remove('opacity-100', 'ring-2', 'ring-peri-light', 'scale-105');
        }
      });
    }

    function openLightbox(index) {
      lastActiveTrigger = document.activeElement;
      updateLightbox(index);
      lightbox.classList.remove('opacity-0', 'pointer-events-none');
      lightbox.classList.add('opacity-100', 'pointer-events-auto');
      document.body.style.overflow = 'hidden';
      lightbox.focus();
    }

    function closeLightbox() {
      lightbox.classList.remove('opacity-100', 'pointer-events-auto');
      lightbox.classList.add('opacity-0', 'pointer-events-none');
      document.body.style.overflow = '';
      if (lastActiveTrigger && typeof lastActiveTrigger.focus === 'function') {
        lastActiveTrigger.focus();
      }
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const idx = parseInt(trigger.getAttribute('data-index') || '0', 10);
        openLightbox(idx);
      });
    });

    if (startSlideshowBtn) {
      startSlideshowBtn.addEventListener('click', () => openLightbox(0));
    }

    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
    if (prevBtn) prevBtn.addEventListener('click', (e) => { e.stopPropagation(); updateLightbox(currentIndex - 1); });
    if (nextBtn) nextBtn.addEventListener('click', (e) => { e.stopPropagation(); updateLightbox(currentIndex + 1); });

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt(thumb.getAttribute('data-index') || '0', 10);
        updateLightbox(idx);
      });
    });

    if (stage) {
      stage.addEventListener('click', (e) => {
        if (e.target === stage || e.target.id === 'lightbox-image-container') {
          closeLightbox();
        }
      });
    }

    window.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('pointer-events-auto')) return;

      if (e.key === 'Escape') {
        e.preventDefault();
        closeLightbox();
      } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        e.preventDefault();
        updateLightbox(currentIndex - 1);
      } else if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
        e.preventDefault();
        updateLightbox(currentIndex + 1);
      }
    });

    // Mobile Swipe Gestures
    let touchStartX = 0;
    let touchEndX = 0;
    const swipeThreshold = 50;

    lightbox.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    lightbox.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchEndX - touchStartX;
      if (Math.abs(diff) > swipeThreshold) {
        if (diff > 0) {
          updateLightbox(currentIndex - 1);
        } else {
          updateLightbox(currentIndex + 1);
        }
      }
    }, { passive: true });
  })();
</script>
