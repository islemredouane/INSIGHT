---
// Line icons used in the hairline grids (from home-v3).
interface Props { name: 'search' | 'book' | 'terminal' | 'pen' | 'network' | 'mic' | 'compass' | 'users' | 'mail' | 'flask'; class?: string }
const { name, class: className = 'w-5 h-5' } = Astro.props;
---
<svg class={className} fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true">
  {name === 'search' && <><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" stroke-linecap="round" /></>}
  {name === 'book' && <path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5zM20 5.5A1.5 1.5 0 0 0 18.5 4H13v16h5.5a1.5 1.5 0 0 0 1.5-1.5z" stroke-linejoin="round" />}
  {name === 'terminal' && <><rect x="3" y="4.5" width="18" height="15" rx="2" /><path d="m7 10 3 2.5L7 15M12.5 15H17" stroke-linecap="round" stroke-linejoin="round" /></>}
  {name === 'pen' && <><path d="M14.5 4.5 19.5 9.5 9 20H4v-5z" stroke-linejoin="round" /><path d="m12.5 6.5 5 5" /></>}
  {name === 'network' && <><circle cx="6" cy="12" r="2.5" /><circle cx="18" cy="6" r="2.5" /><circle cx="18" cy="18" r="2.5" /><path d="m8.2 10.9 7.6-3.8M8.2 13.1l7.6 3.8" /></>}
  {name === 'mic' && <><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21" stroke-linecap="round" /></>}
  {name === 'compass' && <><circle cx="12" cy="12" r="9" /><path d="m15.5 8.5-2 5-5 2 2-5z" stroke-linejoin="round" /></>}
  {name === 'users' && <><circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6.5 6.5 0 0 1 3.5 6" stroke-linecap="round" /></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" /><path d="m3 6 9 7 9-7" stroke-linejoin="round" /></>}
  {name === 'flask' && <path d="M9 3h6M10 3v6l-5.5 9.5A1.7 1.7 0 0 0 6 21h12a1.7 1.7 0 0 0 1.5-2.5L14 9V3M7.5 15h9" stroke-linecap="round" stroke-linejoin="round" />}
</svg>
