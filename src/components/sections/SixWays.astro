---
// "Six ways in" hairline grid (home-v3).
import SectionHeader from '../ui/SectionHeader.astro';
import ActivityIcon from '../ui/ActivityIcon.astro';
import { activities, closingLines } from '../../data/club';
interface Props { eyebrow?: string; id?: string }
const { eyebrow = 'Log 02 · What we do', id } = Astro.props;
---
<section id={id} class="bg-paper text-ink py-24 sm:py-28">
  <div class="max-w-[1240px] mx-auto px-6 md:px-12">
    <SectionHeader eyebrow={eyebrow} title="Six ways in." subtitle="From your first paper to your first publication." />
    <div class="mt-14 rounded-2xl overflow-hidden border border-navy/10 grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-navy/10 rv-cells">
      {activities.map((a, i) => (
        <article class="group p-8 bg-white hover:bg-paper transition-colors">
          <div class="flex items-start justify-between">
            <span class:list={['tile', 'highlight' in a && 'tile-on']}><ActivityIcon name={a.icon} /></span>
            <span class="font-mono text-[12px] text-muted">{String(i + 1).padStart(2, '0')}</span>
          </div>
          <h3 class="mt-8 font-display text-xl font-bold text-ink">{a.title}</h3>
          <p class="mt-2 text-[15px] text-body leading-relaxed">{a.text}</p>
          {'highlight' in a && <span class="mt-5 inline-flex items-center h-7 px-2.5 border border-blue/40 font-mono text-[12px] text-blue">{a.highlight}</span>}
        </article>
      ))}
    </div>
    <p class="rv mt-14 text-center font-serif italic text-muted text-lg">“{closingLines.sideEffects}”</p>
  </div>
</section>
