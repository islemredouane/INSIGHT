---
// Navy strip (home-v3 "Collaborate"). Text and link can be changed per page.
interface Props { title?: string; href?: string; label?: string }
const {
  title = "Are you a researcher, a lab or a club? Let's work together.",
  href = '/collaborate',
  label = 'Collaborate with us →',
} = Astro.props;
---
<section class="bg-navy py-14">
  <div class="max-w-[1240px] mx-auto px-6 md:px-12 flex flex-col md:flex-row items-center justify-between gap-8 text-center md:text-left">
    <h2 class="rv font-display text-2xl font-medium text-white max-w-2xl tracking-tight">{title}</h2>
    <a href={href} style="--d:120ms" class="rv btn btn-secondary shrink-0">{label}</a>
  </div>
</section>
