---
// "Next on the map" (home-v3): the next upcoming event + the latest past one.
// With nothing upcoming: the v3 placeholder row in dev, an honest "being planned" row in the built site.
import { getCollection } from 'astro:content';
import SectionHeader from '../ui/SectionHeader.astro';
import EventRow from '../cards/EventRow.astro';
import { todayUTC, eventEnd } from '../../lib/format';
import { site } from '../../data/site';

interface Props { eyebrow?: string }
const { eyebrow = 'Log 06 · Next on the map' } = Astro.props;
const today = todayUTC();
const events = await getCollection('events');
const upcoming = events.filter((e) => eventEnd(e) >= today).sort((a, b) => +a.data.date - +b.data.date);
const past = events.filter((e) => eventEnd(e) < today).sort((a, b) => +b.data.date - +a.data.date);
---
<section id="events" class="bg-white text-ink py-24 sm:py-28">
  <div class="max-w-[1240px] mx-auto px-6 md:px-12">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6">
      <SectionHeader eyebrow={eyebrow} title="Next on the map." />
      <a href="/events" class="rv text-[15px] font-medium text-blue hover:text-navy transition whitespace-nowrap">All events →</a>
    </div>
    <div class="rv-stagger mt-14 divide-y divide-navy/10 border-y border-navy/10">
      {upcoming[0] ? (
        <EventRow event={upcoming[0]} upcoming />
      ) : (
        <article class="py-10 grid lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-4 aspect-[16/10] rounded-2xl overflow-hidden relative bg-gradient-to-br from-navy to-ink">
            <div class="absolute inset-0 dots opacity-30"></div>
          </div>
          <div class="lg:col-span-8">
            <p class="eyebrow text-blue">Coming soon</p>
            <h3 class="mt-3 font-display text-2xl sm:text-3xl font-bold">Our next sessions are being planned.</h3>
            <p class="mt-3 text-[16px] text-body leading-relaxed">Paper readings, workshops and talks are coming. Follow {site.instagram.handle} to hear first.</p>
            <a href={site.instagram.url} target="_blank" rel="noopener noreferrer" class="mt-4 inline-block text-[15px] font-medium text-blue hover:text-navy transition">Follow on Instagram ↗</a>
          </div>
        </article>
      )}
      {past[0] && <EventRow event={past[0]} />}
    </div>
  </div>
</section>
