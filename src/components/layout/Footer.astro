---
// Footer (home-v3): 1. contact band · 2. brand, link columns, affiliation · 3. bottom bar
import Icon from '../ui/Icon.astro';
import { footerNav, site, mailto } from '../../data/site';
import { assetUrl } from '../../lib/assets';
const year = new Date().getFullYear();
---
<footer class="relative overflow-hidden bg-ink-deep border-t border-white/10" aria-labelledby="footer-title">
  <h2 id="footer-title" class="sr-only">{site.fullName}, footer</h2>

  <!-- Giant wordmark watermark -->
  <p class="pointer-events-none absolute inset-x-0 -bottom-[0.12em] select-none text-center font-display text-[22vw] font-black leading-none tracking-tighter text-white/[0.035] lg:text-[17rem]" aria-hidden="true">INSIGHT</p>

  <div class="relative z-10 max-w-[1240px] mx-auto px-6 md:px-12">

    <!-- 1. Contact band -->
    <div class="py-14 md:py-16 grid lg:grid-cols-12 gap-8 lg:items-end border-b border-white/10">
      <div class="lg:col-span-7">
        <p class="eyebrow text-peri">Get in touch</p>
        <a href={mailto()} class="group mt-4 inline-flex items-center gap-4 font-display font-bold text-white text-3xl sm:text-5xl tracking-tight hover:text-peri-light transition-colors break-all sm:break-normal">
          {site.email}
          <Icon name="arrow-up-right" class="w-7 h-7 sm:w-9 sm:h-9 shrink-0 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" />
        </a>
      </div>
      <div class="lg:col-span-5 lg:justify-self-end flex flex-col sm:flex-row sm:items-center gap-4 lg:flex-col lg:items-end">
        <p class="text-[15px] text-silver/70 leading-relaxed lg:text-right max-w-sm">Questions, guest talks, collaborations: students, researchers, labs and clubs are all welcome to write.</p>
        <div class="flex flex-wrap gap-3 lg:justify-end">
          <a href="/contact" class="btn btn-sm btn-primary shrink-0">Contact form</a>
          <button type="button" class="btn btn-sm btn-secondary shrink-0" data-copy-email={site.email}>
            <Icon name="copy" />
            <span>Copy email</span>
          </button>
        </div>
      </div>
    </div>

    <!-- 2. Brand · links · affiliation -->
    <div class="py-14 grid grid-cols-2 md:grid-cols-12 gap-x-8 gap-y-12">
      <div class="col-span-2 md:col-span-12 lg:col-span-4">
        <a href="/" class="inline-flex items-center gap-3" aria-label={`${site.name} ${site.shortDescription}, home`}>
          <img src={assetUrl('/brand/insight-logo-sm.png')} alt={`${site.name} logo`} width="61" height="36" class="h-9 w-auto logo-glow" loading="lazy" decoding="async" />
          <span class="flex flex-col leading-none">
            <span class="font-display text-xl font-bold tracking-tight text-white">{site.name}</span>
            <span class="mt-1 text-[13px] text-muted">{site.shortDescription}</span>
          </span>
        </a>
        <p class="mt-5 max-w-xs text-[15px] text-silver/70 leading-relaxed">The student-led research club of ESTIN. We read, question and contribute to science.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={site.instagram.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 h-10 px-3.5 border border-white/15 text-[14px] text-silver/80 hover:text-white hover:border-white/40 transition-colors" aria-label={`Instagram ${site.instagram.handle} (opens in a new tab)`}>
            <Icon name="instagram" />
            {site.instagram.handle}
          </a>
          <a href={site.linkedin.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 h-10 px-3.5 border border-white/15 text-[14px] text-silver/80 hover:text-white hover:border-white/40 transition-colors" aria-label="LinkedIn (opens in a new tab)">
            <Icon name="linkedin" />
            LinkedIn
          </a>
          <a href={site.github.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 h-10 px-3.5 border border-white/15 text-[14px] text-silver/80 hover:text-white hover:border-white/40 transition-colors" aria-label="GitHub Repository (opens in a new tab)">
            <Icon name="github" />
            GitHub
            <Icon name="star" class="w-3 h-3 text-amber-400 fill-amber-400" />
          </a>
        </div>
      </div>

      <nav class="col-span-2 md:col-span-8 lg:col-span-5 grid grid-cols-2 sm:grid-cols-3 gap-8" aria-label="Footer">
        {footerNav.map((col) => (
          <div>
            <h3 class="eyebrow text-silver">{col.title}</h3>
            <ul class="mt-5 space-y-3 text-[15px]">
              {col.links.map((link) => link.soon ? (
                <li class="flex items-center gap-2 whitespace-nowrap"><span class="text-silver/60">{link.label}</span><span class="inline-flex items-center h-5 px-1.5 border border-white/15 font-mono text-[11px] text-muted">Soon</span></li>
              ) : link.closed ? (
                <li class="flex items-center gap-2 whitespace-nowrap"><span class="text-silver/60">{link.label}</span><span class="inline-flex items-center h-5 px-1.5 border border-white/15 font-mono text-[11px] text-muted">Closed</span></li>
              ) : (
                <li><a href={link.href} class="footer-link">{link.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </nav>

      <div class="col-span-2 md:col-span-4 lg:col-span-3 md:justify-self-end">
        <h3 class="eyebrow text-silver">A club of</h3>
        <a href={site.school.url} target="_blank" rel="noopener noreferrer" class="mt-5 inline-block opacity-80 hover:opacity-100 transition-opacity" aria-label={`${site.school.name}, ${site.school.fullName} (opens in a new tab)`}>
          <img src={assetUrl('/brand/estin-logo-white.png')} alt={site.school.name} width="111" height="40" class="h-10 w-auto" loading="lazy" decoding="async" />
        </a>
        <p class="mt-4 text-[14px] text-silver/60 leading-relaxed">{site.school.fullName}<br />{site.school.location}</p>
      </div>
    </div>

    <!-- 3. Bottom bar -->
    <div class="py-6 border-t border-white/10 flex flex-col-reverse sm:flex-row sm:items-center justify-between gap-4">
      <p class="text-[13px] text-muted">© {year} {site.fullName} · {site.school.name} · <a href="/privacy" class="hover:text-white transition-colors">Privacy</a></p>
      <p class="hidden md:block eyebrow text-silver/60">{site.tagline}</p>
      <a href="#top" id="to-top" class="inline-flex items-center gap-2 text-[13px] text-silver/70 hover:text-white transition-colors">
        <Icon name="arrow-up" />
        Back to top
      </a>
    </div>
  </div>
</footer>

<script>
  // Copy email (any button with data-copy-email; with a fallback for blocked clipboards) + smooth back to top
  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((btn) => {
    const label = btn.querySelector('span')!;
    const idle = label.textContent;
    btn.addEventListener('click', async () => {
      const email = btn.dataset.copyEmail!;
      try {
        await navigator.clipboard.writeText(email);
        label.textContent = 'Copied';
      } catch {
        const t = document.createElement('textarea');
        t.value = email; t.setAttribute('readonly', ''); t.style.position = 'fixed'; t.style.opacity = '0';
        document.body.appendChild(t); t.select();
        label.textContent = document.execCommand('copy') ? 'Copied' : email;
        t.remove();
      }
      setTimeout(() => { label.textContent = idle; }, 1800);
    });
  });
  document.getElementById('to-top')?.addEventListener('click', (e) => {
    e.preventDefault();
    scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
  });
</script>
