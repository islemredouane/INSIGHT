---
// Full-width navbar (home-v3): transparent over the hero, solid ink + hairline once you scroll.
import { getCollection } from 'astro:content';
import Icon from '../ui/Icon.astro';
import { mainNav, secondaryNav, site, registrations } from '../../data/site';
import { isActive } from '../../lib/nav';
import { getPoles } from '../../lib/content';
import { shortDate, todayUTC, eventEnd } from '../../lib/format';
import { assetUrl } from '../../lib/assets';
const path = Astro.url.pathname;
const collaborate = secondaryNav[0];

// Second row (xl screens): the 4 research poles + the next event (or the latest one when nothing is planned).
const poles = await getPoles();
const today = todayUTC();
const events = (await getCollection('events')).sort((a, b) => +a.data.date - +b.data.date);
const next = events.find((e) => eventEnd(e) >= today);
const latest = events.filter((e) => eventEnd(e) < today).at(-1);
const featured = next ?? latest;

// SSR initial status calculation:
const featuredEnd = featured ? eventEnd(featured) : null;
const isCurrent = featured ? featured.data.date <= today && featuredEnd! >= today : false;
const isToday = featured ? featured.data.date.getTime() === today.getTime() : false;
const isMultiDay = Boolean(featured?.data.endDate && featured.data.endDate.getTime() !== featured.data.date.getTime());

let initialBadge = next ? 'NEXT' : 'LATEST';
let initialDateText = featured ? shortDate(featured.data.date).replace(/ \d{4}$/, '') : '';

if (next) {
  if (isToday) {
    initialBadge = 'TODAY';
  } else if (isCurrent && isMultiDay) {
    initialBadge = 'LIVE';
    initialDateText = `UNTIL ${shortDate(featured.data.endDate!).replace(/ \d{4}$/, '')}`;
  }
}
const isLiveBadge = initialBadge === 'TODAY' || initialBadge === 'LIVE';
---
<header id="nav" class="fixed top-0 inset-x-0 z-50 border-b border-transparent transition-colors duration-300">
  <div class="max-w-[1240px] mx-auto h-[72px] px-6 md:px-12 flex items-center justify-between gap-3 sm:gap-6">
    <a href="/" class="flex items-center gap-3 shrink-0" aria-label={`${site.name} ${site.shortDescription}, home`}>
      <img src={assetUrl('/brand/insight-logo-sm.png')} alt={`${site.name} logo`} width="54" height="32" class="h-8 w-auto logo-glow" fetchpriority="high" decoding="async" />
      <span class="flex flex-col leading-none">
        <span class="font-display text-[18px] font-bold tracking-tight text-white">{site.name}</span>
        <span class="hidden sm:block mt-1 text-[12px] text-muted">{site.shortDescription}</span>
      </span>
    </a>
    <nav class="hidden lg:flex items-center gap-6 xl:gap-9 h-full" aria-label="Main">
      {mainNav.map((item) => (
        <a href={item.href} class:list={['nav-link', { active: isActive(path, item.href) }]} aria-current={isActive(path, item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2.5">
      <!-- Star on GitHub button -->
      <a
        href={site.github.url}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 h-9 px-3 rounded-none border border-white/15 bg-white/5 hover:bg-white/10 hover:border-white/40 text-silver/90 hover:text-white transition-all text-[13px] font-mono select-none"
        aria-label="Star INSIGHT on GitHub (opens in a new tab)"
        title="Star INSIGHT on GitHub"
      >
        <Icon name="github" class="w-3.5 h-3.5" />
        <span class="font-medium text-[12px] tracking-wide">Star</span>
        <Icon name="star" class="w-3 h-3 text-amber-400 fill-amber-400" />
      </a>

      <!-- Wrapper does the hiding: .btn sets its own display, which would override `hidden` -->
      <span class="hidden lg:inline-flex">
        <a href={collaborate.href} class:list={['btn btn-sm btn-primary', { active: isActive(path, collaborate.href) }]} aria-current={isActive(path, collaborate.href) ? 'page' : undefined}>{collaborate.label}</a>
      </span>
      <!-- Under 360px only the menu button fits; Join stays the big button inside the menu -->
      {registrations.open && (
        <span class="hidden min-[360px]:inline-flex">
          <a href="/join" class="btn btn-sm btn-secondary">Join the crew</a>
        </span>
      )}
      <button id="menu-btn" class="menu-btn lg:hidden w-11 h-11 rounded-none border border-silver/20 text-silver hover:border-silver/50 transition-colors" aria-label="Open menu" aria-expanded="false" aria-controls="menu">
        <span class="mb-line" aria-hidden="true"></span><span class="mb-line" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <!-- Second row, xl screens only: research poles + next event. Stays visible while scrolling. -->
  <div id="nav-sub" class="hidden xl:block">
    <div class="max-w-[1240px] mx-auto h-11 px-12 flex items-center justify-between gap-8">
      <nav class="flex items-center gap-8 h-full" aria-label="Research poles">
        <span class="font-mono text-[11px] font-semibold uppercase tracking-[.16em] text-muted">Poles</span>
        {poles.map((p) => {
          const href = `/research/${p.id}`;
          const active = isActive(path, href);
          return (
            <a href={href} class:list={['sub-link', { active }]} aria-current={active ? 'page' : undefined}>
              <span class="sub-num">{String(p.data.number).padStart(2, '0')}</span>{p.data.name}
            </a>
          );
        })}
      </nav>
      {featured && (
        <a
          href={`/events/${featured.id}`}
          class="sub-next"
          data-event-date={featured.data.date.toISOString()}
          data-event-end-date={featured.data.endDate ? featured.data.endDate.toISOString() : ''}
        >
          <span class:list={['sub-next-label inline-flex items-center', { 'text-emerald-300': isLiveBadge }]}>
            {isLiveBadge && <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse mr-1.5 align-middle"></span>}
            {initialBadge} · {initialDateText}
          </span>
          <span class="truncate">{featured.data.title.split(':')[0]}</span>
          <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg>
        </a>
      )}
    </div>
  </div>
</header>

<script>
  // Navbar state + mobile menu controller (from home-v3)
  const root = document.documentElement;
  const nav = document.getElementById('nav')!;
  let lastY = scrollY;
  const onScroll = () => {
    const y = scrollY;
    nav.classList.toggle('scrolled', y > 24 || root.classList.contains('menu-open'));
    if (y <= 0) {
      nav.classList.remove('sub-hidden');
    } else if (y > lastY) {
      nav.classList.add('sub-hidden');
    } else if (y < lastY) {
      nav.classList.remove('sub-hidden');
    }
    lastY = y;
  };
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  // Dynamic client-side event status:
  // Evaluates live in the visitor's browser whether the featured event is TODAY, LIVE, NEXT, or LATEST,
  // without needing daily rebuilds or code pushes.
  const nextLink = document.querySelector<HTMLElement>('.sub-next[data-event-date]');
  const label = nextLink?.querySelector('.sub-next-label');
  if (nextLink && label && nextLink.dataset.eventDate) {
    const start = new Date(nextLink.dataset.eventDate);
    const end = nextLink.dataset.eventEndDate ? new Date(nextLink.dataset.eventEndDate) : null;
    const now = new Date();

    const pad = (n: number) => String(n).padStart(2, '0');
    const todayYMD = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
    const startYMD = `${start.getUTCFullYear()}-${pad(start.getUTCMonth() + 1)}-${pad(start.getUTCDate())}`;
    const endYMD = end ? `${end.getUTCFullYear()}-${pad(end.getUTCMonth() + 1)}-${pad(end.getUTCDate())}` : startYMD;

    const startMonthDay = start.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }).toUpperCase();
    const endMonthDay = end ? end.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' }).toUpperCase() : '';

    if (todayYMD === startYMD) {
      label.innerHTML = `<span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse mr-1.5 align-middle"></span>TODAY · ${startMonthDay}`;
      label.classList.add('text-emerald-300');
    } else if (todayYMD > startYMD && todayYMD <= endYMD) {
      label.innerHTML = `<span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse mr-1.5 align-middle"></span>LIVE · UNTIL ${endMonthDay}`;
      label.classList.add('text-emerald-300');
    } else if (todayYMD < startYMD) {
      label.textContent = `NEXT · ${startMonthDay}`;
      label.classList.remove('text-emerald-300');
    } else {
      label.textContent = `LATEST · ${endMonthDay || startMonthDay}`;
      label.classList.remove('text-emerald-300');
    }
  }

  const btn = document.getElementById('menu-btn') as HTMLButtonElement;
  const menu = document.getElementById('menu')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isOpen = () => root.classList.contains('menu-open');
  const focusables = () => [btn, ...menu.querySelectorAll<HTMLElement>('a[href], button')];

  function openMenu() {
    root.classList.add('menu-open'); onScroll();
    btn.setAttribute('aria-expanded', 'true'); btn.setAttribute('aria-label', 'Close menu');
    root.style.overflow = 'hidden'; // lock the page behind
    setTimeout(() => menu.querySelector<HTMLElement>('.mm-link')?.focus({ preventScroll: true }), reduce ? 0 : 300);
  }
  function closeMenu(returnFocus = true) {
    root.classList.remove('menu-open'); onScroll();
    btn.setAttribute('aria-expanded', 'false'); btn.setAttribute('aria-label', 'Open menu');
    root.style.overflow = '';
    if (returnFocus) btn.focus({ preventScroll: true });
  }

  btn.addEventListener('click', () => (isOpen() ? closeMenu() : openMenu()));
  document.addEventListener('keydown', (e) => {
    if (!isOpen()) return;
    if (e.key === 'Escape') { e.preventDefault(); closeMenu(); return; }
    if (e.key === 'Tab') { // keep focus inside the menu
      const f = focusables(), first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });
  // In-page links: close first, then glide; other links just close
  menu.querySelectorAll<HTMLAnchorElement>('a').forEach((a) => a.addEventListener('click', (e) => {
    const href = a.getAttribute('href') || '';
    if (href.startsWith('#')) {
      const target = document.querySelector(href);
      if (!target) return;
      e.preventDefault();
      closeMenu(false);
      setTimeout(() => target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' }), reduce ? 0 : 320);
    } else {
      closeMenu(false);
    }
  }));
  addEventListener('resize', () => { if (isOpen() && innerWidth >= 1024) closeMenu(false); });
</script>
