---
// Full-screen mobile menu (home-v3): drops from the navbar, staggered links, CTA + contact at the bottom.
// Lives outside <header>: the header's backdrop blur would otherwise trap a position:fixed child.
import Icon from '../ui/Icon.astro';
import { mainNav, secondaryNav, site } from '../../data/site';
import { isActive } from '../../lib/nav';
const path = Astro.url.pathname;
---
<div id="menu" class="lg:hidden" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="absolute inset-0 dots opacity-25 pointer-events-none"></div>
  <div class="absolute -top-20 -right-24 w-[420px] h-[420px] rounded-full bg-blue/20 blur-[110px] pointer-events-none"></div>
  <div class="relative h-full overflow-y-auto">
    <div class="min-h-full max-w-[1240px] mx-auto px-6 md:px-12 pt-6 pb-8 flex flex-col">
      <p class="mm-item eyebrow text-peri" style="--i:0">Menu</p>
      <nav class="mt-5" aria-label="Main (mobile)">
        <ul class="border-t border-white/10">
          {mainNav.map((item, i) => (
            <li class="mm-item" style={`--i:${i + 1}`}>
              <a href={item.href} class:list={['mm-link', { active: isActive(path, item.href) }]} aria-current={isActive(path, item.href) ? 'page' : undefined}>
                <span class="mm-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="mm-label">{item.label}</span>
                <Icon name="arrow-right" class="mm-arrow" />
              </a>
            </li>
          ))}
        </ul>
        <ul class="mm-item mt-6 grid grid-cols-2 gap-3" style={`--i:${mainNav.length + 1}`}>
          {secondaryNav.map((item) => (
            <li>
              <a href={item.href} class:list={['mm-sub', { active: isActive(path, item.href) }]} aria-current={isActive(path, item.href) ? 'page' : undefined}>
                {item.label}
                <Icon name="arrow-right" class="w-4 h-4 text-peri-light" />
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <div class="mm-item mt-auto pt-10" style={`--i:${mainNav.length + 2}`}>
        <a href="/join" class="mm-cta btn btn-primary w-full">Join the crew</a>
        <div class="mt-6 pt-6 border-t border-white/10 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 text-[14px]">
          <a href={`mailto:${site.email}`} class="text-silver/80 hover:text-white transition-colors">{site.email}</a>
          <a href={site.instagram.url} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-silver/80 hover:text-white transition-colors">
            <Icon name="instagram" />
            {site.instagram.handle}
          </a>
          <a href={site.linkedin.url} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-silver/80 hover:text-white transition-colors">
            <Icon name="linkedin" />
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
