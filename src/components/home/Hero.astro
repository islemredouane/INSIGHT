---
// Home hero (home-v3): headline words rise in, then the real logo and its particle beam.
import { site } from '../../data/site';
---
<section class="relative min-h-screen overflow-hidden bg-ink flex flex-col">
  <div class="absolute inset-0 dots opacity-25 pointer-events-none"></div>
  <div class="absolute top-1/3 left-[8%] w-[560px] h-[560px] rounded-full bg-blue/10 blur-[130px] pointer-events-none"></div>
  <!-- Beam canvas: full-bleed on the right, starts at the logo's rays -->
  <canvas id="beam" class="absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true"></canvas>

  <div class="relative flex-1 w-full max-w-[1240px] mx-auto px-6 md:px-12 pt-32 pb-16 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    <div class="lg:col-span-6 z-10">
      <div class="eyebrow text-peri flex items-center gap-3 hero-in" style="--hd:.05s">
        <span class="relative flex h-2 w-2"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-peri-light opacity-70"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-peri-light"></span></span>
        ESTIN Research Club · Est. 2026
      </div>
      <h1 data-split="hero" class="mt-6 font-display font-bold text-white text-5xl sm:text-6xl lg:text-[76px] leading-[1.02] tracking-[-0.035em]">{site.tagline}</h1>
      <p style="--hd:.75s" class="hero-in mt-7 max-w-lg border-l-2 border-blue/60 pl-5 font-serif italic text-xl sm:text-2xl text-silver/85 leading-relaxed">“{site.quote}”</p>
      <div class="mt-10 flex flex-wrap gap-4 hero-in" style="--hd:.9s">
        <a href="/join" class="btn btn-primary">Join the crew</a>
        <a href="/research" class="btn btn-secondary">Explore our research →</a>
      </div>
    </div>
    <!-- Real logo, large; the canvas beam leaves from its rays -->
    <div class="lg:col-span-6 relative h-[300px] lg:h-[460px] flex items-center">
      <img id="hero-logo" src="/brand/insight-logo.png" alt="" width="340" height="201" class="relative z-10 w-[230px] sm:w-[300px] lg:w-[340px] h-auto logo-glow" fetchpriority="high" />
    </div>
  </div>

  <a href="#about" style="--hd:1.4s" class="hero-in relative z-10 mx-auto mb-8 flex flex-col items-center gap-2 eyebrow text-muted hover:text-white transition">
    Scroll to explore
    <span class="w-px h-8 bg-gradient-to-b from-blue via-peri-light to-transparent"></span>
  </a>
</section>

<script>
  // Hero beam: particles leave the logo's rays and run off the right edge (from home-v3)
  type P = { x: number; y: number; vx: number; vy: number; r: number; c: string; life: number };
  const canvas = document.getElementById('beam') as HTMLCanvasElement | null;
  const logo = document.getElementById('hero-logo') as HTMLImageElement | null;
  if (canvas && logo) {
    const ctx = canvas.getContext('2d')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dpr = Math.min(devicePixelRatio || 1, 2);
    let W = 0, H = 0, ox = 0, oy = 0, parts: P[] = [];
    const colors = ['#DDE3EC', '#DDE3EC', '#AEC6FF', '#7F97C7', '#FFFFFF'];

    const origin = () => {
      const c = canvas.getBoundingClientRect(), l = logo.getBoundingClientRect();
      ox = l.right - c.left - l.width * 0.02; // tip of the rays
      oy = l.top - c.top + l.height * 0.53;   // rays sit at ~53% of the logo height
    };
    const resize = () => {
      const r = canvas.getBoundingClientRect();
      W = r.width; H = r.height;
      canvas.width = W * dpr; canvas.height = H * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      origin();
    };
    const spawn = (p: P, fresh: boolean) => {
      p.x = ox; p.y = oy + (Math.random() - .5) * 6;
      const a = (Math.random() - .5) * 0.34 + (Math.random() < .5 ? -.04 : .04);
      const s = Math.random() * 2.2 + 0.8;
      p.vx = Math.cos(a) * s; p.vy = Math.sin(a) * s;
      p.r = Math.random() * 1.5 + 0.4;
      p.c = colors[(Math.random() * colors.length) | 0];
      p.life = fresh ? 0 : Math.random() * 400;
      if (!fresh) { p.x += p.vx * p.life; p.y += p.vy * p.life; }
    };
    const init = () => {
      parts = [];
      const n = W < 768 ? 260 : 650;
      for (let i = 0; i < n; i++) { const p = {} as P; spawn(p, false); parts.push(p); }
    };
    const frame = () => {
      ctx.clearRect(0, 0, W, H);
      const g = ctx.createLinearGradient(ox, oy, W, oy); // soft light shaft
      g.addColorStop(0, 'rgba(174,198,255,.28)'); g.addColorStop(.35, 'rgba(127,151,199,.10)'); g.addColorStop(1, 'rgba(11,17,32,0)');
      ctx.fillStyle = g; ctx.beginPath();
      ctx.moveTo(ox, oy - 3); ctx.lineTo(W, oy - H * .26); ctx.lineTo(W, oy + H * .26); ctx.lineTo(ox, oy + 3); ctx.closePath(); ctx.fill();
      for (const p of parts) {
        if (!reduce) { p.x += p.vx; p.y += p.vy; p.life++; }
        const d = (p.x - ox) / (W - ox);
        if (p.x > W + 10 || p.y < -10 || p.y > H + 10) { spawn(p, true); continue; }
        ctx.globalAlpha = Math.max(0, Math.min(1, d * 6)) * (1 - d * .75);
        ctx.fillStyle = p.c; ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, 6.283); ctx.fill();
      }
      ctx.globalAlpha = 1;
      if (!reduce) requestAnimationFrame(frame);
    };
    const start = () => { resize(); init(); frame(); };
    logo.complete ? start() : logo.addEventListener('load', start);
    addEventListener('resize', () => { resize(); init(); if (reduce) frame(); });
  }
</script>
