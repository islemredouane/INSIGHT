---
// Editorial event row (home-v3 "Next on the map").
import type { CollectionEntry } from 'astro:content';
import { shortDate, eventTypeLabel } from '../../lib/format';
import { assetUrl } from '../../lib/assets';
interface Props { event: CollectionEntry<'events'>; upcoming?: boolean }
const { event, upcoming = false } = Astro.props;
const e = event.data;
const coverSrc = assetUrl(e.cover);
---
<article class="py-10 grid lg:grid-cols-12 gap-8 items-center group">
  <a href={`/events/${event.id}`} class="lg:col-span-4 aspect-[16/10] rounded-2xl overflow-hidden relative bg-gradient-to-br from-blue/80 to-navy block" tabindex="-1" aria-hidden="true">
    {coverSrc
      ? e.coverFit === 'contain'
        ? <><img src={coverSrc} alt="" width="600" height="375" class="absolute inset-0 w-full h-full object-cover blur-2xl scale-125 brightness-75" loading="lazy" decoding="async" /><img src={coverSrc} alt="" width="600" height="375" class="absolute inset-0 w-full h-full object-contain" loading="lazy" decoding="async" /></>
        : <img src={coverSrc} alt="" width="600" height="375" class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async" />
      : <div class="absolute inset-0 dots opacity-30"></div>}
  </a>
  <div class="lg:col-span-8">
    {upcoming
      ? <p class="eyebrow text-signal flex items-center gap-2"><span class="w-2 h-2 rounded-full bg-signal"></span>Upcoming · {shortDate(e.date)}</p>
      : <p class="eyebrow text-blue">{eventTypeLabel[e.type]} · {shortDate(e.date)}</p>}
    <h3 class="mt-3 font-display text-2xl sm:text-3xl font-bold group-hover:text-blue transition"><a href={`/events/${event.id}`}>{e.title}</a></h3>
    <p class="mt-3 text-[16px] text-body leading-relaxed">{e.summary}</p>
    <a href={`/events/${event.id}`} class="mt-4 inline-block text-[15px] font-medium text-blue hover:text-navy transition">{upcoming ? 'Details →' : 'Read the recap →'}</a>
  </div>
</article>
