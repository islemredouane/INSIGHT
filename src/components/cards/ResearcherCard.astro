---
// Researcher card (home-v3 "Research network"): 4:5 portrait, institution · country, name, title, fields, profile link.
import type { CollectionEntry } from 'astro:content';
import { assetUrl } from '../../lib/assets';
interface Props { researcher: CollectionEntry<'researchers'>; detailed?: boolean }
const { researcher, detailed = false } = Astro.props;
const r = researcher.data;
const link = r.links.profile ?? r.links.scholar ?? r.links.site;
---
<li class="rcard group">
  <div class="rportrait">
    {r.photo ? <img src={assetUrl(r.photo)} alt={r.name} width="400" height="500" loading="lazy" decoding="async" /> : <span class="rportrait-initials">{r.initials}</span>}
    {r.badge && <span class="rbadge">{r.badge}</span>}
  </div>
  <div class="rbody">
    <p class="eyebrow text-peri">{r.institution} · {r.country}</p>
    <h3 class="rname">{r.name}</h3>
    <p class="rtitle">{r.title}</p>
    <div class="rtags">{r.fields.map((f) => <span>{f}</span>)}</div>
    {detailed && r.bio && <p class="mt-4 text-[14px] leading-relaxed text-silver/70">{r.bio}</p>}
    {detailed && r.highlights.length > 0 && (
      <ul class="mt-4 space-y-1.5 text-[13px] leading-relaxed text-silver/65">
        {r.highlights.map((h) => <li class="pl-3 border-l border-peri/30">{h}</li>)}
      </ul>
    )}
    {link
      ? <a href={link} target="_blank" rel="noopener noreferrer" class="rlink" aria-label={`View academic profile of ${r.name}`}>Profile ↗</a>
      : <span class="rlink opacity-40 select-none" aria-hidden="true">Profile ↗</span>}
  </div>
</li>
