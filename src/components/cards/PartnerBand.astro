---
// Partner lab band (home-v3 "Research network").
import type { CollectionEntry } from 'astro:content';
interface Props { partner: CollectionEntry<'partners'> }
const p = Astro.props.partner.data;
---
<div style="--d:200ms" class="rv rounded-2xl border border-silver/10 bg-ink-2 p-6 sm:p-8 grid md:grid-cols-12 gap-6 md:items-center">
  <div class="md:col-span-2">
    {p.logo
      ? <img src={p.logo} alt={p.name} class="w-20 h-20 object-contain" loading="lazy" />
      : <div class="w-20 h-20 border border-silver/15 bg-white/[.03] flex items-center justify-center font-mono text-[11px] text-muted text-center leading-tight">[Lab<br />logo]</div>}
  </div>
  <div class="md:col-span-7">
    <p class="eyebrow text-peri-light">Research partner</p>
    <h3 class="mt-2 font-display text-2xl sm:text-3xl font-bold text-white tracking-tight">{p.name}</h3>
    <p class="mt-1 font-mono text-[13px] text-muted">{p.institution} · {p.country}</p>
    <p class="mt-3 text-[15px] text-silver/75 leading-relaxed max-w-xl">{p.summary}</p>
  </div>
  <div class="md:col-span-3 md:justify-self-end">
    {p.url
      ? <a href={p.url} target="_blank" rel="noopener" class="btn btn-sm btn-secondary">Visit the lab ↗</a>
      : <a href="#" class="btn btn-sm btn-secondary">Visit the lab ↗</a>}
  </div>
</div>
