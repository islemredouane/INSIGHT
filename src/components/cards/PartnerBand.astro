---
// Partner lab band (home-v3 "Research network").
import type { CollectionEntry } from 'astro:content';
import { assetUrl } from '../../lib/assets';
interface Props { partner: CollectionEntry<'partners'>; roundTop?: boolean; roundBottom?: boolean }
const p = Astro.props.partner.data;
const { roundTop = true, roundBottom = true } = Astro.props;
---
<div style="--d:200ms" class:list={['rv border border-silver/10 bg-ink-2 p-6 sm:p-8 grid md:grid-cols-12 gap-6 md:items-center', roundTop && 'rounded-t-2xl', roundBottom && 'rounded-b-2xl']}>
  <div class="md:col-span-2">
    {p.logo
      ? <img src={assetUrl(p.logo)} alt={p.name} width="80" height="80" class="w-20 h-20 object-contain" loading="lazy" decoding="async" />
      : <div class="w-20 h-20 border border-silver/15 bg-white/[.03] flex items-center justify-center font-mono text-[14px] text-peri text-center leading-tight font-bold">{p.name.slice(0, 2).toUpperCase()}</div>}
  </div>
  <div class="md:col-span-7">
    <p class="eyebrow text-peri-light">Research partner</p>
    <h3 class="mt-2 font-display text-2xl sm:text-3xl font-bold text-white tracking-tight">{p.name}</h3>
    <p class="mt-1 font-mono text-[13px] text-muted">{p.institution} · {p.country}</p>
    <p class="mt-3 text-[15px] text-silver/75 leading-relaxed max-w-xl">{p.summary}</p>
  </div>
  <div class="md:col-span-3 md:justify-self-end">
    {p.url && (
      <a href={p.url} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-secondary" aria-label={`Visit official website of ${p.name}`}>Visit the lab ↗</a>
    )}
  </div>
</div>
