---
// Collaborate — for researchers, labs, companies and clubs. Run by External Relations & Partnerships (deck slide 12).
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import ActivityIcon from '../components/ui/ActivityIcon.astro';
import MemberCard from '../components/cards/MemberCard.astro';
import Icon from '../components/ui/Icon.astro';
import { getDepartmentHeads, getResearchers, getPartners } from '../lib/content';
import { site, contactUrl } from '../data/site';
import { assetUrl } from '../lib/assets';
import { initials } from '../lib/format';

const dept = (await getEntry('departments', 'external-relations'))!;
const contacts = await getDepartmentHeads('external-relations');
const researchers = await getResearchers();
const hasLab = (await getPartners()).length > 0;

const sara = (await getEntry('crew', 'madaoui-sara'))!;
const mounir = (await getEntry('crew', 'bey-ahmed-khernache-mounir'))!;

const liaisons = [
  {
    member: sara,
    tier: 'Executive & Strategic',
    roleLabel: 'Founder · Vice-president (The Helm)',
    focus: 'Institutional MoUs, university agreements, scientific sponsorships, and keynote coordination.',
    email: sara.data.email ?? 's_madaoui@estin.dz',
    subject: 'Strategic Partnership with INSIGHT',
  },
  {
    member: mounir,
    tier: 'Operations & Outreach',
    roleLabel: 'Head · External Relations & Partnerships',
    focus: 'Guest talk scheduling, researcher mentorship matching across poles, and event co-organization.',
    email: mounir.data.email ?? 'm_beyahmedkhernache@estin.dz',
    subject: 'Collaboration Inquiry with INSIGHT',
  },
];

const ways = [
  { icon: 'mic', title: 'Give a talk', text: 'Share your research with our crew, on campus or live online.', subject: 'Giving a talk at INSIGHT', topic: 'researcher' },
  { icon: 'compass', title: 'Mentor a project team', text: 'Guide a student team in one of our four research poles.', subject: 'Mentoring an INSIGHT project team', topic: 'researcher' },
  { icon: 'flask', title: 'Co-supervise a project', text: 'Help a project go from a first question to a paper.', subject: 'Co-supervising an INSIGHT project', topic: 'researcher' },
  { icon: 'users', title: 'Partner or sponsor', text: 'Support the club as a laboratory, company or institution.', subject: 'Partnering with INSIGHT', topic: 'company' },
  { icon: 'network', title: 'Co-organise an event', text: 'Run a research event together with your club or lab.', subject: 'Co-organising an event with INSIGHT', topic: 'club' },
] as const;

const siteUrl = Astro.site ? Astro.site.href.replace(/\/+$/, '') : 'https://insight.estin.dz';

const collaborateSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Collaborate with INSIGHT Research Club',
  description: "Opportunities for researchers, professors, partner laboratories and industry to collaborate with INSIGHT at ESTIN.",
  url: `${siteUrl}/collaborate/`,
  mainEntity: {
    '@type': 'Service',
    name: 'INSIGHT Academic & Research Collaboration Program',
    provider: {
      '@type': 'Organization',
      name: 'INSIGHT Research Club',
      url: `${siteUrl}/`,
      contactPoint: [
        {
          '@type': 'ContactPoint',
          contactType: 'Executive Partnerships & Institutional Strategy',
          email: sara.data.email ?? 's_madaoui@estin.dz',
          name: sara.data.name,
          jobTitle: 'Founder · Vice-president',
        },
        {
          '@type': 'ContactPoint',
          contactType: 'External Relations & Operational Collaboration',
          email: mounir.data.email ?? 'm_beyahmedkhernache@estin.dz',
          name: mounir.data.name,
          jobTitle: 'Head of External Relations & Partnerships',
        },
      ],
    },
    serviceType: 'Academic Research Partnership',
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Collaboration Pathways',
      itemListElement: ways.map((w, idx) => ({
        '@type': 'Offer',
        position: idx + 1,
        itemOffered: {
          '@type': 'Service',
          name: w.title,
          description: w.text,
        },
      })),
    },
  },
};
---
<BaseLayout title="Collaborate" description="Work with INSIGHT, ESTIN's student-led research club: give a talk, mentor a team, co-supervise a project, partner or co-organise an event." schemaExtra={[collaborateSchema]}>
  <PageHeader
    eyebrow="Collaborate"
    title="Build bridges with the next generation of researchers."
    lead="INSIGHT connects ESTIN students with researchers, laboratories and the scientific community. If you'd like to work with our crew, we'd love to hear from you."
  >
    <div class="hero-in mt-10 flex flex-wrap gap-4" style="--hd:.8s">
      <a href={contactUrl('researcher')} class="btn btn-primary">Write to us</a>
      <a href="/network" class="btn btn-secondary">See our network →</a>
    </div>
  </PageHeader>

  <!-- LOG 01 · Ways to work with us -->
  <section class="bg-paper text-ink py-24 sm:py-28">
    <div class="max-w-[1240px] mx-auto px-6 md:px-12">
      <SectionHeader eyebrow="Log 01 · Ways to work with us" title="Five ways to collaborate." />
      <div class="mt-14 rounded-2xl overflow-hidden border border-navy/10 grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-navy/10 rv-cells">
        {ways.map((w, i) => (
          <a href={contactUrl(w.topic, w.subject)} class="group p-8 bg-white hover:bg-paper transition-colors block">
            <div class="flex items-start justify-between">
              <span class="tile"><ActivityIcon name={w.icon} /></span>
              <span class="font-mono text-[12px] text-muted">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <h3 class="mt-8 font-display text-xl font-bold text-ink">{w.title}</h3>
            <p class="mt-2 text-[15px] text-body leading-relaxed">{w.text}</p>
            <span class="mt-5 inline-flex items-center gap-2 text-[14px] font-medium text-blue">Get in touch <Icon name="arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-1" /></span>
          </a>
        ))}
        <div class="p-8 bg-ink flex flex-col justify-between gap-8">
          <div>
            <p class="eyebrow text-peri">Already with us</p>
            <p class="mt-4 font-display text-5xl font-bold text-white">{researchers.length}</p>
            <p class="mt-1 text-[15px] text-silver/75">{researchers.length === 1 ? 'researcher' : 'researchers'} in our network{hasLab ? ', and a partner laboratory' : ''}.</p>
          </div>
          <a href="/network" class="btn btn-sm btn-secondary self-start">Meet them →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- LOG 02 · Direct liaisons -->
  <section class="bg-white text-ink py-24 sm:py-28 border-t border-navy/10">
    <div class="max-w-[1240px] mx-auto px-6 md:px-12">
      <div class="grid lg:grid-cols-12 gap-8 items-end">
        <SectionHeader
          eyebrow="Log 02 · Direct liaisons"
          title="Connect with our partnership leads."
          subtitle="Direct channels for universities, visiting researchers, partner labs, and corporate sponsors."
          class="lg:col-span-8"
        />
        <div class="lg:col-span-4 lg:justify-self-end">
          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 bg-paper border border-navy/10 font-mono text-[12px] text-muted">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Replies within 48h
          </span>
        </div>
      </div>

      <!-- Two Strategic Liaison Cards -->
      <div class="mt-14 grid md:grid-cols-2 gap-8 rv-cells">
        {liaisons.map((l) => {
          const m = l.member.data;
          return (
            <article class="p-8 sm:p-10 rounded-2xl bg-paper border border-navy/10 flex flex-col justify-between hover:border-blue/40 transition-colors group">
              <div>
                <div class="flex items-start gap-5">
                  <div class="relative w-20 h-24 sm:w-24 sm:h-28 overflow-hidden rounded-xl border border-navy/10 bg-ink shrink-0">
                    {m.photo ? (
                      <img
                        src={assetUrl(m.photo)}
                        alt={m.name}
                        width="192"
                        height="224"
                        class="w-full h-full object-cover filter grayscale group-hover:grayscale-0 transition-all duration-300"
                        style={m.photoPosition ? `object-position:${m.photoPosition}` : undefined}
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="w-full h-full flex items-center justify-center font-display font-bold text-2xl text-silver">{initials(m.name)}</span>
                    )}
                  </div>
                  <div class="min-w-0">
                    <span class="inline-block font-mono text-[11px] font-semibold uppercase tracking-[.14em] text-blue px-2.5 py-0.5 bg-blue/10 border border-blue/20">
                      {l.tier}
                    </span>
                    <h3 class="mt-2 font-display text-2xl font-bold text-ink leading-tight">{m.name}</h3>
                    <p class="mt-1 text-[14px] text-muted font-medium">{l.roleLabel}</p>
                  </div>
                </div>

                <div class="mt-6 pt-6 border-t border-navy/10">
                  <p class="font-mono text-[11px] uppercase tracking-[.12em] text-muted font-semibold">Direct Scope</p>
                  <p class="mt-2 text-[15px] text-body leading-relaxed">{l.focus}</p>
                </div>
              </div>

              <div class="mt-8 pt-6 border-t border-navy/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-white -mx-8 -mb-8 sm:-mx-10 sm:-mb-10 p-6 sm:p-8 rounded-b-2xl border-x-0 border-b-0">
                <div class="min-w-0">
                  <span class="block font-mono text-[11px] uppercase tracking-[.12em] text-muted font-semibold">Official Email</span>
                  <a
                    href={`mailto:${l.email}?subject=${encodeURIComponent(l.subject)}`}
                    class="mt-1 block font-mono text-[14px] sm:text-[15px] font-semibold text-ink hover:text-blue transition-colors truncate"
                  >
                    {l.email}
                  </a>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <button
                    type="button"
                    class="btn btn-sm btn-secondary btn-on-light"
                    data-copy-email={l.email}
                    title="Copy email to clipboard"
                  >
                    <Icon name="copy" />
                    <span>Copy</span>
                  </button>
                  <a
                    href={`mailto:${l.email}?subject=${encodeURIComponent(l.subject)}`}
                    class="btn btn-sm btn-primary"
                    title={`Write to ${m.name}`}
                  >
                    <span>Write</span>
                    <Icon name="arrow-up-right" />
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>

      <!-- Department Context & Central General Desk -->
      <div class="mt-12 rounded-2xl bg-ink p-8 sm:p-10 text-white grid lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7">
          <p class="eyebrow text-peri">Department {String(dept.data.number).padStart(2, '0')} · {dept.data.name}</p>
          <h4 class="mt-2 font-display text-2xl font-bold text-white tracking-tight">{dept.data.onBoardAs}</h4>
          <p class="mt-3 text-[15px] text-silver/80 leading-relaxed">
            The full External Relations crew coordinates institutional partnerships, event co-organisation, hackathons, and sponsor relations alongside the Helm.
          </p>
          <div class="mt-6 flex flex-wrap gap-2">
            {dept.data.handles.map((h) => (
              <span class="px-3 py-1 font-mono text-[12px] text-silver/90 border border-white/15 bg-white/5">{h}</span>
            ))}
          </div>
        </div>
        <div class="lg:col-span-5 lg:border-l lg:border-white/15 lg:pl-8 flex flex-col gap-4">
          <div>
            <span class="font-mono text-[11px] uppercase tracking-[.12em] text-peri">General Inquiries Desk</span>
            <a href={`mailto:${site.email}`} class="mt-1 block font-display text-2xl font-bold text-white hover:text-peri-light transition-colors break-all">
              {site.email}
            </a>
          </div>
          <div class="flex flex-wrap items-center gap-3 pt-2">
            <button type="button" class="btn btn-sm btn-secondary" data-copy-email={site.email}>
              <Icon name="copy" />
              <span>Copy email</span>
            </button>
            <a href={contactUrl('researcher')} class="btn btn-sm btn-primary">
              <span>Structured form</span>
              <Icon name="arrow-right" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
