---
// SPARK · The Music Case (Part 4) — Session 4 Game (Steps 0-6).
// "A mini paper for Yacine" · Turn your paragraph into a real paper · 60 minutes.
// No red ✗, no blocking states, 100% responsive and aligned to the INSIGHT design system.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sparkSession4 } from '../../data/spark';

const steps = [
  '00 · Yacine’s Message',
  '01 · Sort the Pieces',
  '02 · The Title',
  '03 · The Introduction',
  '04 · Result or Meaning?',
  '05 · Abstract & Swap',
  '06 · Case File #4',
];
---
<BaseLayout
  title="The Music Case · Session 4 · SPARK"
  description="SPARK 2026 Session 4: A mini paper for Yacine. Structure sorting, title recipe, 4-move introduction, result vs discussion, 5-sentence abstract, and peer review."
  noindex
>
  <!-- Top Bar -->
  <section class="bg-ink text-white pt-24 xl:pt-32 pb-8 border-b border-white/10">
    <div class="max-w-[1100px] mx-auto px-5 flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="eyebrow text-peri">SPARK 2026 · Session 4</p>
        <div class="flex items-center gap-3 mt-1">
          <h1 id="team-label" class="font-display text-xl sm:text-2xl font-bold">The Music Case · Part 4</h1>
          <span id="team-badge" class="px-2.5 py-0.5 text-[11px] font-mono font-semibold uppercase tracking-wider rounded bg-blue/20 text-peri border border-blue/40">
            Team Loading…
          </span>
        </div>
      </div>
      <div class="flex items-center gap-3 text-[13px]">
        <!-- Mentor Reveal Controls (Password-Protected) -->
        <div class="relative">
          <button
            type="button"
            id="mentor-controls-toggle"
            aria-expanded="false"
            aria-controls="mentor-controls-menu"
            class="px-2.5 py-1 text-[11px] font-mono font-semibold rounded bg-white/10 hover:bg-white/20 text-silver transition flex items-center gap-1.5 border border-white/15"
          >
            <span>👑 Mentor Reveal:</span>
            <span id="unlocked-step-indicator" class="text-peri">Step 0/6</span>
          </button>
          <div
            id="mentor-controls-menu"
            class="hidden absolute right-0 mt-2 w-72 max-w-[calc(100vw-2rem)] bg-white text-ink border border-navy/10 rounded-xl shadow-2xl p-4 z-30 space-y-3 text-left"
          >
            <!-- Mentor Auth Gate (visible when not logged in as mentor) -->
            <form id="mentor-inline-login" class="space-y-2.5">
              <div class="flex items-center justify-between">
                <p class="font-mono text-[10px] uppercase text-blue font-bold tracking-wider">👑 Mentor Only</p>
                <span class="text-[10px] font-mono text-muted">Password required</span>
              </div>
              <p class="text-[12px] text-body leading-snug">
                Sign in with the SPARK mentor password to unlock steps and reveal model answers after teams finish.
              </p>
              <input
                id="mentor-inline-password"
                type="password"
                class="field !mt-0 !h-9 !py-1 !text-[13px]"
                placeholder="Mentor password…"
                autocomplete="current-password"
                required
              />
              <p id="mentor-inline-error" class="hidden text-[12px] text-signal font-medium"></p>
              <button type="submit" id="mentor-inline-submit" class="btn btn-sm btn-primary w-full justify-center">
                Unlock Mentor Controls
              </button>
            </form>

            <!-- Mentor Controls (visible ONLY once authenticated as mentor) -->
            <div id="mentor-controls-authed" class="hidden space-y-3">
              <div class="flex items-center justify-between pb-2 border-b border-navy/10">
                <span id="mentor-authed-badge" class="font-mono text-[10px] uppercase text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded font-semibold">
                  ✓ Mentor Active
                </span>
                <button type="button" id="btn-mentor-logout" class="text-[11px] text-muted hover:text-ink underline">
                  Lock controls
                </button>
              </div>

              <!-- Step Locks -->
              <div class="space-y-1.5">
                <p class="font-mono text-[10px] uppercase text-muted tracking-wider">1. Room Step Access</p>
                <button type="button" id="btn-reveal-next" class="btn btn-sm btn-primary w-full text-left justify-start">
                  🔓 Unlock Next Step
                </button>
                <div class="grid grid-cols-2 gap-1.5">
                  <button type="button" id="btn-reveal-all" class="btn btn-sm btn-secondary w-full justify-center btn-on-light !px-2 !text-[11px]">
                    ⚡ Unlock All
                  </button>
                  <button type="button" id="btn-lock-all" class="btn btn-sm btn-secondary w-full justify-center text-signal border-signal/20 hover:bg-signal/5 !px-2 !text-[11px]">
                    🔒 Reset (0)
                  </button>
                </div>
              </div>

              <!-- Answer Key Reveals -->
              <div class="pt-2 border-t border-navy/10 space-y-2">
                <div class="flex items-center justify-between">
                  <p class="font-mono text-[10px] uppercase text-muted tracking-wider">2. Model Answer Reveals</p>
                  <button type="button" id="btn-reveal-current-answers" class="text-[11px] font-semibold text-blue hover:underline">
                    Reveal current
                  </button>
                </div>
                <div class="space-y-1 text-[12px]">
                  {[
                    { step: 1, label: 'Step 1 · Card Sorting Solutions' },
                    { step: 2, label: 'Step 2 · Real Title & Analysis' },
                    { step: 3, label: 'Step 3 · Model 4-Move Intro' },
                    { step: 4, label: 'Step 4 · Model Result & Discussion' },
                    { step: 5, label: 'Step 5 · Model 5-Sentence Abstract' },
                  ].map((item) => (
                    <label class="flex items-center justify-between gap-2 px-2 py-1.5 rounded hover:bg-paper cursor-pointer">
                      <span class="text-ink font-medium">{item.label}</span>
                      <input
                        type="checkbox"
                        class="s4-reveal-step-toggle accent-blue"
                        data-step={item.step}
                      />
                    </label>
                  ))}
                </div>
                <div class="grid grid-cols-2 gap-1.5 pt-1">
                  <button type="button" id="btn-reveal-keys-all" class="btn btn-sm btn-secondary w-full justify-center btn-on-light !px-2 !text-[10px]">
                    Reveal All Keys
                  </button>
                  <button type="button" id="btn-hide-keys-all" class="btn btn-sm btn-secondary w-full justify-center btn-on-light !px-2 !text-[10px]">
                    Hide All Keys
                  </button>
                </div>
              </div>

              <div class="pt-2 border-t border-navy/10 text-center">
                <a href="/spark/mentor" target="_blank" class="text-[11px] text-blue hover:underline font-mono">
                  Open Full Mentor Dashboard ↗
                </a>
              </div>
            </div>
          </div>
        </div>

        <span class="text-white/20">|</span>
        <a href="/spark/session-3" class="text-silver/70 hover:text-white transition-colors flex items-center gap-1.5">
          <span>← Session 3</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Progress Bar (7 Steps: Message → Sort → Title → Intro → Result → Abstract → Case file) -->
  <nav class="bg-navy border-b border-white/10 sticky top-16 z-20 overflow-x-auto" aria-label="Game Steps">
    <div class="max-w-[1100px] mx-auto px-5 py-2.5 flex items-center gap-2 text-xs font-mono min-w-max">
      {steps.map((st, i) => (
        <button
          type="button"
          class={`step-tab px-3 py-1.5 rounded transition flex items-center gap-1.5 ${
            i === 0
              ? 'bg-blue text-white font-bold'
              : 'bg-white/5 text-silver/60 hover:text-white hover:bg-white/10 opacity-70 cursor-not-allowed'
          }`}
          data-step={i}
          disabled={i > 0}
        >
          <span class="step-num">{st.split(' · ')[0]}</span>
          <span class="hidden md:inline">{st.split(' · ')[1]}</span>
          <span class="step-lock-icon text-[10px] ml-0.5">{i === 0 ? '' : '🔒'}</span>
        </button>
      ))}
    </div>
  </nav>

  <!-- Main Game Panels Container (Paper Background, not Dark Blue) -->
  <main id="game" class="bg-paper text-ink py-10 sm:py-14 min-h-[75vh]">
    <div class="max-w-[1100px] mx-auto px-5 space-y-8">

      <!-- Team Banner & Status Bar -->
      <section class="bg-white border border-navy/10 rounded-2xl shadow-sm overflow-hidden">
        <div class="p-4 sm:p-5 flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div id="banner-icon-box" class="w-10 h-10 rounded-xl bg-blue/10 text-blue font-display font-bold flex items-center justify-center text-lg border border-blue/20">
              🧪
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span id="banner-team-name" class="font-display font-bold text-ink text-base">Connecting Team…</span>
                <span id="banner-status-badge" class="px-2.5 py-0.5 text-[11px] font-mono rounded bg-paper text-muted border border-navy/10 font-medium">
                  Connecting…
                </span>
              </div>
              <p id="banner-team-members" class="text-[13px] text-muted mt-0.5">Please enter or verify your 6-digit team code below.</p>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <!-- Toggle Side Evidence Drawer -->
            <button
              type="button"
              id="btn-toggle-evidence-drawer"
              class="text-[12px] font-mono font-semibold px-3 py-1.5 rounded-lg border border-blue/20 text-blue bg-blue/5 hover:bg-blue/10 transition-all flex items-center gap-1.5"
            >
              <span>📂 Evidence &amp; Paragraph Drawer</span>
            </button>

            <!-- Switch Team Button -->
            <button
              type="button"
              id="btn-switch-team"
              class="text-[12px] font-mono font-medium px-3 py-1.5 rounded-lg border border-navy/15 text-muted hover:text-ink hover:border-navy/30 bg-paper/50 hover:bg-paper transition-all shrink-0 items-center gap-1.5 hidden"
            >
              <span>🔄 Switch Team</span>
            </button>
          </div>
        </div>

        <!-- Connection Bar if not signed in -->
        <div id="banner-connect-panel" class="p-4 sm:px-6 bg-paper/50 border-t border-navy/5 flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-2">
            <span class="font-mono text-xs text-muted uppercase">Team Access:</span>
            <input
              id="inline-team-code"
              type="text"
              maxlength="6"
              placeholder="6-digit team code (e.g. 101010)"
              class="field !w-56 !h-9 !py-1 !text-xs font-mono uppercase tracking-wider"
            />
            <button type="button" id="inline-connect-btn" class="btn btn-sm btn-primary">
              Connect
            </button>
          </div>
          <div class="flex items-center gap-3 text-xs text-muted">
            <span id="live-save-status" class="flex items-center gap-1.5 font-mono text-emerald-700 font-medium">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              All changes saved locally
            </span>
          </div>
        </div>
        <div id="banner-feedback" class="hidden px-5 py-2 text-xs font-mono border-t"></div>
      </section>

      <!-- =========================================================================
           STEP 0: YACINE'S NEW MESSAGE (3 MIN)
           ========================================================================= -->
      <section id="panel-0" class="game-panel space-y-6">
        <div class="flex items-center justify-between gap-3">
          <div>
            <span class="font-mono text-[12px] uppercase text-blue font-bold tracking-wider">Step 0 · 3 Minutes</span>
            <h2 class="font-display text-3xl font-bold tracking-tight mt-1 text-ink">Yacine’s New Request</h2>
          </div>
          <span class="px-3 py-1 bg-blue/10 text-blue font-mono text-[12px] font-semibold rounded">Skill: Paper Architecture</span>
        </div>

        <!-- Yacine Phone Message Bubble -->
        <div class="bg-white border border-navy/10 rounded-2xl p-6 sm:p-8 shadow-sm space-y-4">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-full bg-blue text-white flex items-center justify-center font-display font-bold text-xl shadow-md">
              Y
            </div>
            <div>
              <p class="font-bold text-ink text-base">Yacine <span class="font-normal text-muted text-xs ml-1">· High School Student</span></p>
              <p class="text-[12px] text-muted font-mono">Status: Read your Session 3 paragraph with his teacher</p>
            </div>
          </div>

          <div class="max-w-2xl bg-paper/80 p-5 sm:p-6 rounded-2xl border border-navy/10 relative">
            <div class="absolute -top-2 left-6 w-4 h-4 bg-paper/80 border-t border-l border-navy/10 rotate-45"></div>
            <p class="text-body text-[15px] sm:text-[16px] leading-relaxed italic">
              "{sparkSession4.yacineMessage}"
            </p>
          </div>

          <div class="p-4 bg-blue/5 border border-blue/20 rounded-xl text-[13px] text-blue flex items-start gap-2.5">
            <span class="text-lg">💡</span>
            <p class="leading-relaxed">
              <strong>Mentor Cue:</strong> Today you turn your paragraph into a real mini paper. What students learned in hour 1: the 4 core parts of a paper (IMRD), recipes for a neutral title, the 4 moves of an introduction, result facts vs discussion meaning, and the 5-sentence abstract!
            </p>
          </div>
        </div>

        <!-- Session 3 Participation & Catch-Up Card -->
        <div class="bg-white border border-navy/10 p-6 sm:p-8 rounded-2xl shadow-sm space-y-4">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <div>
              <span class="font-mono text-xs uppercase tracking-wider text-blue font-semibold">Team Readiness</span>
              <h3 class="font-display text-lg font-bold text-ink mt-0.5">Did your team write a paragraph in Session 3?</h3>
              <p class="text-[13px] text-muted">Choose your team status so we set up your paragraph drawer for the upcoming writing steps.</p>
            </div>
            <span class="text-[12px] text-blue font-mono font-medium">Session 3 Check</span>
          </div>

          <div class="flex flex-col sm:flex-row gap-3 pt-1">
            <button type="button" class="s3-participation-choice choice-btn chosen" data-choice="yes">
              Yes, we have our Session 3 PEEL paragraph
            </button>
            <button type="button" class="s3-participation-choice choice-btn" data-choice="no">
              No, we're new / missed Session 3
            </button>
          </div>

          <!-- Yes info -->
          <div id="s3-choice-yes-info" class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-900 rounded-xl text-[13px] flex items-start gap-2.5">
            <span class="text-emerald-600 text-lg leading-none mt-0.5">✓</span>
            <div>
              <strong>Great!</strong> Your PEEL paragraph and Reading Card from earlier sessions are linked and will appear in the drawer beside your writing boxes in Steps 3, 4, and 5.
            </div>
          </div>

          <!-- No info -->
          <div id="s3-choice-no-info" class="hidden p-5 bg-blue/5 border border-blue/20 rounded-xl space-y-3">
            <div class="flex items-center gap-2 text-blue font-bold text-sm">
              <span>📖</span>
              <span>No problem at all! Here is the model research paragraph ready for your team:</span>
            </div>
            <div class="p-4 bg-white rounded-xl border border-navy/10 text-[13px] text-body leading-relaxed space-y-2">
              <p><strong>Point:</strong> {sparkSession4.modelSession3PeelFallback.p}</p>
              <p><strong>Evidence:</strong> {sparkSession4.modelSession3PeelFallback.e}</p>
              <p><strong>Explain:</strong> {sparkSession4.modelSession3PeelFallback.explain}</p>
              <p><strong>Link:</strong> {sparkSession4.modelSession3PeelFallback.l}</p>
              <p class="text-xs text-muted font-mono pt-1"><strong>Ref:</strong> {sparkSession4.modelSession3PeelFallback.ref}</p>
            </div>
            <div class="text-right">
              <button type="button" id="btn-load-fallback-peel" class="btn btn-sm btn-primary">
                ✓ Use this Paragraph in our Drawer
              </button>
            </div>
          </div>
        </div>

        <!-- The Map of a Paper (IMRD Overview) -->
        <div class="bg-white border border-navy/10 rounded-2xl p-6 sm:p-8 shadow-sm space-y-6">
          <div>
            <span class="font-mono text-xs uppercase tracking-wider text-blue font-semibold">The Standard Structure</span>
            <h2 class="font-display text-xl sm:text-2xl font-bold text-ink mt-1">The 4 Parts of a Scientific Paper</h2>
            <p class="text-body text-[14px] mt-1">
              Every empirical paper follows this exact logical progression. In Step 1, you will sort 8 sentences into these 4 parts.
            </p>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
            {sparkSession4.sortColumns.map((col) => (
              <div class="p-4 bg-paper rounded-xl border border-navy/10 flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between">
                    <span class="font-mono text-xs font-bold text-blue uppercase">{col.id}</span>
                    <span class="text-xs font-mono text-muted">{col.question}</span>
                  </div>
                  <h3 class="font-display font-bold text-ink text-base mt-1">{col.label}</h3>
                  <p class="text-body text-[13px] mt-2 leading-relaxed">{col.desc}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="pt-4 border-t border-navy/10 flex flex-wrap items-center justify-between gap-4">
            <p class="text-[13px] text-muted font-mono">Ready to build Yacine’s mini paper? Start with the detective sorting game.</p>
            <button type="button" class="btn btn-primary btn-next-step" data-next="1">
              Let’s build it →
            </button>
          </div>
        </div>
      </section>

      <!-- =========================================================================
           STEP 1: SORT THE PIECES (8 MIN)
           ========================================================================= -->
      <section id="panel-1" class="game-panel hidden space-y-6">
        <div class="flex items-center justify-between flex-wrap gap-3">
          <div>
            <span class="font-mono text-[12px] uppercase text-blue font-bold tracking-wider">Step 1 · 8 Minutes</span>
            <h2 class="font-display text-3xl font-bold tracking-tight mt-1 text-ink">Sort the Pieces</h2>
            <p class="text-body text-[14px] mt-1">
              These 8 sentences come from a mini paper about the music study. Drag or tap each card into the right part of the paper.
            </p>
          </div>
          <div class="flex items-center gap-2">
            <span id="sort-counter-badge" class="px-3 py-1 bg-paper border border-navy/10 text-muted font-mono text-[12px] font-semibold rounded">
              0 / 8 placed
            </span>
          </div>
        </div>

        <!-- 4 Target Columns -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
          {sparkSession4.sortColumns.map((col) => (
            <div
              class="sort-column bg-white border-2 border-dashed border-navy/20 rounded-2xl p-4 flex flex-col min-h-[220px] transition-all"
              data-col={col.id}
            >
              <div class="pb-3 border-b border-navy/10 flex items-center justify-between">
                <div>
                  <span class="font-mono text-xs font-bold text-blue uppercase">{col.id} · {col.label}</span>
                  <p class="text-[11px] text-muted font-medium mt-0.5">{col.question}</p>
                </div>
                <span class="col-count text-[11px] font-mono font-bold text-muted bg-paper px-2 py-0.5 rounded">0</span>
              </div>
              <div class="col-dropzone flex-1 py-3 space-y-2.5 min-h-[140px]" data-col={col.id}>
                <!-- Placed cards will appear here -->
              </div>
            </div>
          ))}
        </div>

        <!-- Unplaced Cards Tray -->
        <div class="bg-white border border-navy/10 rounded-2xl p-6 shadow-sm space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="font-display font-bold text-ink text-base">Unplaced Sentence Cards</h3>
            <span class="text-xs text-muted font-mono">Tip: On phone, tap a card then tap I, M, R, or D</span>
          </div>

          <div id="unplaced-cards-tray" class="grid sm:grid-cols-2 gap-3 min-h-[100px] p-2 bg-paper/60 rounded-xl border border-navy/5">
            {sparkSession4.sortCards.map((card) => (
              <div
                class="sentence-card bg-white p-3.5 rounded-xl border border-navy/15 shadow-sm cursor-grab active:cursor-grabbing hover:border-blue transition-all space-y-2"
                draggable="true"
                data-card-id={card.id}
                data-correct={card.correct}
              >
                <div class="flex items-center justify-between">
                  <span class="w-6 h-6 rounded-full bg-blue/10 text-blue font-mono font-bold text-xs flex items-center justify-center">
                    {card.id}
                  </span>
                  <!-- Mobile Quick Buttons -->
                  <div class="flex items-center gap-1 md:hidden">
                    {['I', 'M', 'R', 'D'].map((c) => (
                      <button
                        type="button"
                        class="quick-place-btn text-[10px] font-mono font-bold px-1.5 py-0.5 rounded bg-paper border border-navy/10 hover:bg-blue hover:text-white"
                        data-card-id={card.id}
                        data-target-col={c}
                      >
                        {c}
                      </button>
                    ))}
                  </div>
                </div>
                <p class="text-body text-[13px] leading-relaxed select-none">
                  {card.sentence}
                </p>
                <div class="card-reveal-info hidden pt-2 border-t border-navy/10 text-[11px] text-muted">
                  <!-- Reason shown upon reveal -->
                </div>
              </div>
            ))}
          </div>

          <div class="pt-4 border-t border-navy/10 flex flex-wrap items-center justify-between gap-4">
            <button type="button" id="btn-reset-cards" class="btn btn-sm btn-secondary btn-on-light">
              ↺ Reset All Cards
            </button>
            <div class="flex items-center gap-3">
              <span id="step1-saved-badge" class="hidden text-xs text-emerald-700 font-mono font-medium">✓ Sent to mentor</span>
              <button type="button" id="btn-submit-step1" class="btn btn-primary" disabled>
                Send to Mentor →
              </button>
            </div>
          </div>
        </div>

        <!-- Step 1 Reveal Container (visible after mentor reveals) -->
        <div id="step1-reveal-container" class="hidden p-5 bg-emerald-50 border border-emerald-200 rounded-2xl space-y-3">
          <div class="flex items-center gap-2 text-emerald-900 font-bold">
            <span class="text-lg">✓</span>
            <span class="font-display">Step 1 Answer Key Revealed by Mentor</span>
          </div>
          <p class="text-emerald-950 text-[13px] leading-relaxed">
            Inspect the solutions above! Correctly placed cards have earned a green check ✓. Remember: <strong>Sentence H</strong> is a weakness and limitation, so it belongs strictly in the <strong>Discussion</strong>!
          </p>
        </div>
      </section>

      <!-- =========================================================================
           STEP 2: THE TITLE (7 MIN)
           ========================================================================= -->
      <section id="panel-2" class="game-panel hidden space-y-6">
        <div class="flex items-center justify-between flex-wrap gap-3">
          <div>
            <span class="font-mono text-[12px] uppercase text-blue font-bold tracking-wider">Step 2 · 7 Minutes</span>
            <h2 class="font-display text-3xl font-bold tracking-tight mt-1 text-ink">The Title</h2>
            <p class="text-body text-[14px] mt-1">
              Write a title for your mini paper. Recipe: <strong>topic + who + (the finding)</strong>. Aim for 10 to 15 words. No feelings, no '!'.
            </p>
          </div>
          <div class="flex items-center gap-2">
            <button type="button" class="btn-open-paper-drawer btn btn-sm btn-secondary btn-on-light">
              📄 Open Paper
            </button>
          </div>
        </div>

        <div class="bg-white border border-navy/10 rounded-2xl p-6 sm:p-8 shadow-sm space-y-6">
          <!-- Recipe Banner -->
          <div class="p-4 bg-paper rounded-xl border border-navy/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
            <div>
              <p class="font-mono text-xs font-bold text-blue uppercase">The Research Title Recipe</p>
