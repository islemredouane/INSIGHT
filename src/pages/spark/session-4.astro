              <p>Loading introduction…</p>
            </div>
          </div>

          <!-- 2. Method & Results Section -->
          <div class="space-y-2">
            <h2 class="font-display font-bold text-lg text-ink">2. Method &amp; Empirical Results</h2>
            <div class="text-[14px] text-body leading-relaxed space-y-2">
              <p id="cf4-card-method" class="text-muted">
                Thirty undergraduate students read texts and answered questions across four sound conditions: quiet, preferred music with lyrics, disliked thrash metal with lyrics, and music without lyrics.
              </p>
              <p id="cf4-card-result" class="font-medium text-ink">
                Loading result sentence…
              </p>
            </div>
          </div>

          <!-- 3. Discussion Section -->
          <div class="space-y-2">
            <h2 class="font-display font-bold text-lg text-ink">3. Discussion &amp; Limits</h2>
            <div id="cf4-card-discussion" class="text-[14px] text-body leading-relaxed">
              <p>Loading discussion sentence…</p>
            </div>
          </div>

          <!-- References -->
          <div class="pt-6 border-t border-navy/10 text-xs text-muted space-y-1">
            <p class="font-mono uppercase font-bold text-ink">Reference:</p>
            <p class="font-mono">{sparkSession4.paperInfo.citation}</p>
          </div>

          <!-- Peer Review Attestation -->
          <div id="cf4-card-peer-attestation" class="p-4 bg-paper rounded-xl border border-navy/5 text-xs text-muted flex items-start gap-2">
            <span>✓</span>
            <div>
              <strong class="text-ink">Peer-Reviewed:</strong> Checked and approved by fellow student researchers in Session 4 peer swap.
            </div>
          </div>
        </article>

        <!-- Reflection & Submission Box -->
        <div class="bg-white border border-navy/10 rounded-2xl p-6 sm:p-8 shadow-sm space-y-5 max-w-3xl mx-auto">
          <div class="space-y-2">
            <label for="input-hardest-part" class="field-label">
              What was the hardest part of writing today? (Optional reflection)
            </label>
            <input
              id="input-hardest-part"
              type="text"
              class="field !py-2 text-[14px]"
              placeholder="e.g. Paraphrasing without copying the words, keeping results separate from why, choosing careful words…"
            />
          </div>

          <!-- Mentor Approval Badge / Action -->
          <div class="pt-4 border-t border-navy/10 flex flex-wrap items-center justify-between gap-4">
            <div id="cf4-mentor-status" class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-amber-400"></span>
              <span class="text-xs font-mono font-bold text-muted">Ready to submit to mentor</span>
            </div>
            <button type="button" id="btn-submit-casefile4" class="btn btn-primary">
              Send to Mentor for Approval →
            </button>
          </div>

          <!-- Next Session Homework Note -->
          <div class="p-4 bg-blue/5 border border-blue/20 rounded-xl text-xs text-blue space-y-1">
            <strong class="font-mono uppercase">Coming in Session 5 · Synthesis &amp; Linking:</strong>
            <p class="leading-relaxed">
              Next week, you will link this paper with the other papers you found in Session 1 to give Yacine the complete, definitive answer!
            </p>
          </div>
        </div>
      </section>

    </div>
  </main>

  <!-- Side Evidence & Paragraph Drawer (Reusable Across Steps 0, 3, 4, 5) -->
  <aside
    id="evidence-drawer"
    class="fixed inset-y-0 right-0 w-96 max-w-[90vw] bg-white border-l border-navy/10 shadow-2xl z-40 transform translate-x-full transition-transform duration-300 flex flex-col"
  >
    <div class="p-4 border-b border-navy/10 flex items-center justify-between bg-ink text-white">
      <div class="flex items-center gap-2">
        <span class="text-base">📂</span>
        <h3 class="font-display font-bold text-sm">Evidence Drawer</h3>
      </div>
      <button type="button" id="btn-close-evidence-drawer" class="text-silver hover:text-white text-lg p-1">✕</button>
    </div>

    <div class="flex-1 overflow-y-auto p-5 space-y-6 text-xs text-body">
      <!-- Session 3 PEEL Paragraph Section -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <span class="font-mono text-[11px] uppercase font-bold text-blue">Your Session 3 PEEL Paragraph</span>
          <span class="px-2 py-0.5 rounded bg-blue/10 text-blue font-mono text-[10px]">Read-only</span>
        </div>
        <div class="p-3 bg-paper rounded-xl border border-navy/10 space-y-2 text-[12px] leading-relaxed">
          <p><strong class="text-ink">P:</strong> <span id="drawer-peel-p">Loading…</span></p>
          <p><strong class="text-ink">E:</strong> <span id="drawer-peel-e">Loading…</span></p>
          <p><strong class="text-ink">E:</strong> <span id="drawer-peel-explain">Loading…</span></p>
          <p><strong class="text-ink">L:</strong> <span id="drawer-peel-l">Loading…</span></p>
          <p class="text-[11px] text-muted font-mono pt-1"><strong class="text-ink">Ref:</strong> <span id="drawer-peel-ref">Loading…</span></p>
        </div>
      </div>

      <!-- Session 2 Reading Card Section -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <span class="font-mono text-[11px] uppercase font-bold text-emerald-700">Session 2 Reading Card</span>
          <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-mono text-[10px]">Evidence</span>
        </div>
        <div class="p-3 bg-paper rounded-xl border border-navy/10 space-y-2 text-[12px] leading-relaxed">
          <p><strong class="text-ink">Who:</strong> 30 university undergraduates (mean age 21 years).</p>
          <p><strong class="text-ink">Conditions:</strong> Quiet silence, instrumental music, liked songs, disliked thrash metal.</p>
          <p><strong class="text-ink">Finding:</strong> Silence &amp; instrumental were highest; vocal lyric songs were lowest.</p>
          <p><strong class="text-ink">Mechanism:</strong> Cognitive interference between vocal words and text comprehension.</p>
        </div>
      </div>

      <!-- Quick Action: Open Easy Paper PDF -->
      <div class="pt-3 border-t border-navy/10">
        <button type="button" class="btn-open-paper-drawer btn btn-sm btn-secondary w-full justify-center">
          📄 View Easy Paper (PDF) ↗
        </button>
      </div>
    </div>
  </aside>

  <!-- Easy Paper Reader Modal -->
  <div id="paper-modal" class="hidden fixed inset-0 z-50 bg-ink/70 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-4xl w-full h-[85vh] flex flex-col overflow-hidden">
      <div class="p-4 bg-ink text-white flex items-center justify-between">
        <div>
          <h3 class="font-display font-bold text-base">Perham &amp; Currie (2014) · Easy Student Copy</h3>
          <p class="text-xs text-silver/60">4-Page Simplified Research Paper for SPARK 2026</p>
        </div>
        <div class="flex items-center gap-3">
          <a href={sparkSession4.paperInfo.pdfPath} target="_blank" rel="noopener" class="text-xs text-peri hover:underline font-mono">
            Open in new tab ↗
          </a>
          <button type="button" id="btn-close-paper-modal" class="text-white hover:text-silver text-xl font-bold p-1">✕</button>
        </div>
      </div>
      <div class="flex-1 bg-paper/50 p-2 overflow-hidden">
        <iframe
          src={sparkSession4.paperInfo.pdfPath}
          class="w-full h-full rounded border-0"
          title="Easy Student Copy PDF"
        ></iframe>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .choice-btn {
    flex: 1;
    padding: 0.75rem 1rem;
    font-size: 13px;
    font-weight: 600;
    border-radius: 0.75rem;
    border: 1px solid rgba(27, 42, 85, 0.15);
    background: #fff;
    color: #3A4458;
    text-align: left;
    transition: all 0.2s;
  }
  .choice-btn:hover {
    border-color: #3F66B0;
    color: #0B1120;
  }
  .choice-btn.chosen {
    border-color: #3F66B0;
    background: rgba(63, 102, 176, 0.08);
    color: #3F66B0;
  }
  .step-tab {
    cursor: pointer;
  }
  .sentence-card.dragging {
    opacity: 0.4;
    transform: scale(0.98);
  }
  .sort-column.drag-over {
    border-color: #3F66B0;
    background-color: rgba(63, 102, 176, 0.04);
  }
  @media print {
    nav, header, footer, .top-bar, .field-label, button, #panel-0, #panel-1, #panel-2, #panel-3, #panel-4, #panel-5 {
      display: none !important;
    }
    #panel-6 {
      display: block !important;
    }
    #mini-paper-print-area {
      border: none !important;
      box-shadow: none !important;
      padding: 0 !important;
      max-width: 100% !important;
    }
  }
</style>

<script>
  import {
    getSession4State,
    saveSession4Progress,
    getPeerTargetSession4,
    submitPeerReviewSession4,
    submitCaseFile4,
    watchSession4State,
    getStoredTeamCode,
    storeTeamCode,
    clearTeamCode,
    getStoredMentor,
    storeMentor,
    clearMentor,
    mentorLogin,
    mentorS4SetStep,
    mentorS4SetReveal,
    escapeHtml,
    friendlyError,
    type Session4TeamAnswers,
    type Session4RoomState,
    type PeerTargetS4Payload,
    type IntroMovesDraft,
    type AbstractDraft,
  } from '../../lib/spark/api';
  import { sparkSession4 } from '../../data/spark';

  // State
  let teamCode = getStoredTeamCode();
  let roomState: Session4RoomState = { unlocked_step: 0, revealed_steps: {} };
  let revealedKeys: Record<string, any> = {};
  let activePanel = 0;
  let mentorSession = getStoredMentor();
  let peerTarget: PeerTargetS4Payload | null = null;

  const defaultAnswers: Session4TeamAnswers = {
    step1_sort: {},
    step1_saved: false,
    step2_title: '',
    step2_final_title: '',
    step2_checks: [],
    step2_saved: false,
    step3_moves: { move1: '', move2: '', move3: '', move4: '' },
    step3_saved: false,
    step4_result: '',
    step4_discussion: '',
    step4_saved: false,
    step5_abstract: { a1: '', a2: '', a3: '', a4: '', a5: '' },
    step5_saved: false,
    step5_peer_review: { checks: [], star: '', wish: '' },
    step5_improved_abstract: { a1: '', a2: '', a3: '', a4: '', a5: '' },
    cf4_hardest: '',
    cf4_status: 'draft',
  };

  let answers: Session4TeamAnswers = structuredClone(defaultAnswers);
  let autosaveTimer: any = null;

  // Web Audio Synth for celebration / cues
  function playAudioChime(type: 'unlock' | 'success' | 'tag') {
    try {
      const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain);
      gain.connect(ctx.destination);
      const t = ctx.currentTime;
      if (type === 'unlock') {
        osc.frequency.setValueAtTime(330, t);
        osc.frequency.exponentialRampToValueAtTime(660, t + 0.15);
        gain.gain.setValueAtTime(0.15, t);
        gain.gain.exponentialRampToValueAtTime(0.01, t + 0.3);
        osc.start(t);
        osc.stop(t + 0.3);
      } else if (type === 'success') {
        osc.frequency.setValueAtTime(523.25, t);
        osc.frequency.setValueAtTime(659.25, t + 0.1);
        osc.frequency.setValueAtTime(783.99, t + 0.2);
        gain.gain.setValueAtTime(0.2, t);
        gain.gain.exponentialRampToValueAtTime(0.01, t + 0.4);
        osc.start(t);
        osc.stop(t + 0.4);
      } else {
        osc.frequency.setValueAtTime(440, t);
        gain.gain.setValueAtTime(0.08, t);
        gain.gain.exponentialRampToValueAtTime(0.01, t + 0.1);
        osc.start(t);
        osc.stop(t + 0.1);
      }
    } catch {
      // Audio not permitted or supported
    }
  }

  // DOM Elements
  const teamLabel = document.getElementById('team-label');
  const teamBadge = document.getElementById('team-badge');
  const bannerName = document.getElementById('banner-team-name');
  const bannerMembers = document.getElementById('banner-team-members');
  const bannerBadge = document.getElementById('banner-status-badge');
  const switchTeamBtn = document.getElementById('btn-switch-team');
  const bannerFeedback = document.getElementById('banner-feedback');
  const inlineInput = document.getElementById('inline-team-code') as HTMLInputElement | null;
  const inlineBtn = document.getElementById('inline-connect-btn') as HTMLButtonElement | null;
  const unlockedStepIndicator = document.getElementById('unlocked-step-indicator');
  const liveSaveStatus = document.getElementById('live-save-status');

  // Evidence Drawer Elements
  const evidenceDrawer = document.getElementById('evidence-drawer');
  const btnToggleDrawer = document.getElementById('btn-toggle-evidence-drawer');
  const btnCloseDrawer = document.getElementById('btn-close-evidence-drawer');
  const drawerPeelP = document.getElementById('drawer-peel-p');
  const drawerPeelE = document.getElementById('drawer-peel-e');
  const drawerPeelExplain = document.getElementById('drawer-peel-explain');
  const drawerPeelL = document.getElementById('drawer-peel-l');
  const drawerPeelRef = document.getElementById('drawer-peel-ref');

  // Paper Modal Elements
  const paperModal = document.getElementById('paper-modal');
  const btnClosePaperModal = document.getElementById('btn-close-paper-modal');
  document.querySelectorAll('.btn-open-paper-drawer').forEach((btn) => {
    btn.addEventListener('click', () => {
      paperModal?.classList.remove('hidden');
    });
  });
  btnClosePaperModal?.addEventListener('click', () => {
    paperModal?.classList.add('hidden');
  });

  // Drawer Toggle Handlers
  btnToggleDrawer?.addEventListener('click', () => {
    evidenceDrawer?.classList.toggle('translate-x-full');
  });
  btnCloseDrawer?.addEventListener('click', () => {
    evidenceDrawer?.classList.add('translate-x-full');
  });

  function showBannerFeedback(msg: string, type: 'success' | 'error' | 'info') {
    if (!bannerFeedback) return;
    bannerFeedback.textContent = msg;
    bannerFeedback.className = `px-5 py-2 text-xs font-mono border-t ${
      type === 'success'
        ? 'bg-emerald-50 text-emerald-800 border-emerald-200'
        : type === 'error'
        ? 'bg-signal/10 text-signal border-signal/20'
        : 'bg-blue/10 text-blue border-blue/20'
    }`;
    bannerFeedback.classList.remove('hidden');
    setTimeout(() => {
      bannerFeedback?.classList.add('hidden');
    }, 4000);
  }

  // Fallback storage key for local session 4 answers
  const LOCAL_S4_KEY = (code: string) => `spark-s4-answers-${code}`;

  function loadLocalAnswers(code: string): Session4TeamAnswers {
    try {
      const raw = localStorage.getItem(LOCAL_S4_KEY(code));
      if (raw) return { ...defaultAnswers, ...JSON.parse(raw) };
    } catch {}
    return structuredClone(defaultAnswers);
  }

  function saveLocalAnswers(code: string, ans: Session4TeamAnswers) {
    try {
      localStorage.setItem(LOCAL_S4_KEY(code), JSON.stringify(ans));
    } catch {}
  }

  // Connect Team Code
  async function handleConnectCode() {
    const code = inlineInput?.value.trim().toUpperCase();
    if (!code || code.length < 4) {
      showBannerFeedback('Please enter a valid team code.', 'error');
      return;
    }
    if (inlineBtn) inlineBtn.disabled = true;
    try {
      storeTeamCode(code);
      teamCode = code;
      answers = loadLocalAnswers(code);
      await syncState();
      showBannerFeedback(`Connected to Team ${code}!`, 'success');
      playAudioChime('success');
      if (switchTeamBtn) switchTeamBtn.classList.remove('hidden');
      if (inlineInput) inlineInput.value = '';
    } catch (err: any) {
      showBannerFeedback(friendlyError(err), 'error');
      if (inlineBtn) inlineBtn.disabled = false;
    }
  }

  inlineBtn?.addEventListener('click', handleConnectCode);
  inlineInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      handleConnectCode();
    }
  });

  switchTeamBtn?.addEventListener('click', () => {
    if (confirm('Switch team code? Your saved inputs remain stored.')) {
      clearTeamCode();
      location.reload();
    }
  });

  // Participation Choice (Yes / No for Session 3)
  const choiceBtns = document.querySelectorAll('.s3-participation-choice');
  const yesInfo = document.getElementById('s3-choice-yes-info');
  const noInfo = document.getElementById('s3-choice-no-info');
  const btnLoadFallbackPeel = document.getElementById('btn-load-fallback-peel');

  choiceBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      choiceBtns.forEach((b) => b.classList.remove('chosen'));
      btn.classList.add('chosen');
      const val = btn.getAttribute('data-choice');
      if (val === 'yes') {
        yesInfo?.classList.remove('hidden');
        noInfo?.classList.add('hidden');
      } else {
        yesInfo?.classList.add('hidden');
        noInfo?.classList.remove('hidden');
      }
    });
  });

  btnLoadFallbackPeel?.addEventListener('click', () => {
    loadPeelDrawer(sparkSession4.modelSession3PeelFallback);
    alert('✓ Session 3 Model Paragraph successfully loaded into your Evidence Drawer!');
    playAudioChime('tag');
  });

  function loadPeelDrawer(peel: any) {
    if (drawerPeelP) drawerPeelP.textContent = peel.p || sparkSession4.modelSession3PeelFallback.p;
    if (drawerPeelE) drawerPeelE.textContent = peel.e || sparkSession4.modelSession3PeelFallback.e;
    if (drawerPeelExplain) drawerPeelExplain.textContent = peel.explain || sparkSession4.modelSession3PeelFallback.explain;
    if (drawerPeelL) drawerPeelL.textContent = peel.l || sparkSession4.modelSession3PeelFallback.l;
    if (drawerPeelRef) drawerPeelRef.textContent = peel.ref || sparkSession4.modelSession3PeelFallback.ref;
  }

  // Step Tabs Navigation
  const stepTabs = document.querySelectorAll<HTMLButtonElement>('.step-tab');
  const panels = document.querySelectorAll<HTMLElement>('.game-panel');

  function setActivePanel(idx: number) {
    activePanel = idx;
    stepTabs.forEach((tab, i) => {
      if (i === idx) {
        tab.className = 'step-tab px-3 py-1.5 rounded transition flex items-center gap-1.5 bg-blue text-white font-bold';
      } else if (i <= roomState.unlocked_step) {
        tab.className = 'step-tab px-3 py-1.5 rounded transition flex items-center gap-1.5 bg-white/10 text-white hover:bg-white/20';
        tab.disabled = false;
      } else {
        tab.className = 'step-tab px-3 py-1.5 rounded transition flex items-center gap-1.5 bg-white/5 text-silver/40 cursor-not-allowed opacity-60';
        tab.disabled = true;
      }
    });

    panels.forEach((p, i) => {
      p.classList.toggle('hidden', i !== idx);
    });

    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  stepTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const targetStep = parseInt(tab.dataset.step || '0', 10);
      if (targetStep <= roomState.unlocked_step) {
        setActivePanel(targetStep);
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.btn-next-step').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = parseInt(btn.dataset.next || '0', 10);
      if (next <= roomState.unlocked_step) {
        setActivePanel(next);
      } else {
        alert('This step is locked. Your mentor will unlock it shortly for the room!');
      }
    });
  });

  // =========================================================================
  // STEP 1: SORT THE PIECES (Drag & Drop + Mobile Quick Placement)
  // =========================================================================
  const unplacedTray = document.getElementById('unplaced-cards-tray');
  const sortColumns = document.querySelectorAll<HTMLElement>('.sort-column');
  const sortCounterBadge = document.getElementById('sort-counter-badge');
  const btnSubmitStep1 = document.getElementById('btn-submit-step1') as HTMLButtonElement | null;
  const btnResetCards = document.getElementById('btn-reset-cards');
  const step1SavedBadge = document.getElementById('step1-saved-badge');
  const step1RevealContainer = document.getElementById('step1-reveal-container');

  function updateSortPlacementUI() {
    let placedCount = 0;
    const placements = answers.step1_sort || {};

    // Clear column dropzones
    sortColumns.forEach((col) => {
      const dz = col.querySelector('.col-dropzone');
      if (dz) dz.innerHTML = '';
    });

    // Populate dropzones or keep in unplaced tray
    sparkSession4.sortCards.forEach((c) => {
      const cardEl = document.querySelector(`.sentence-card[data-card-id="${c.id}"]`) as HTMLElement | null;
      if (!cardEl) return;
      const targetCol = placements[c.id];
      if (targetCol && ['I', 'M', 'R', 'D'].includes(targetCol)) {
        placedCount++;
        const dropzone = document.querySelector(`.col-dropzone[data-col="${targetCol}"]`);
        dropzone?.appendChild(cardEl);
      } else {
        unplacedTray?.appendChild(cardEl);
      }
    });

    // Update column counters
    sortColumns.forEach((col) => {
      const colId = col.dataset.col;
      const count = Object.values(placements).filter((v) => v === colId).length;
      const countEl = col.querySelector('.col-count');
      if (countEl) countEl.textContent = String(count);
    });

    if (sortCounterBadge) {
      sortCounterBadge.textContent = `${placedCount} / 8 placed`;
      if (placedCount === 8) {
        sortCounterBadge.className = 'px-3 py-1 bg-emerald-100 text-emerald-800 border border-emerald-300 font-mono text-[12px] font-bold rounded';
      } else {
        sortCounterBadge.className = 'px-3 py-1 bg-paper border border-navy/10 text-muted font-mono text-[12px] font-semibold rounded';
      }
    }

    if (btnSubmitStep1) {
      btnSubmitStep1.disabled = placedCount < 8;
    }

    // Handle Reveal state if active
    const isStep1Revealed = roomState.revealed_steps?.['1'] || false;
    step1RevealContainer?.classList.toggle('hidden', !isStep1Revealed);

    sparkSession4.sortCards.forEach((c) => {
      const cardEl = document.querySelector(`.sentence-card[data-card-id="${c.id}"]`) as HTMLElement | null;
      if (!cardEl) return;
      const revealInfo = cardEl.querySelector('.card-reveal-info') as HTMLElement | null;
      if (isStep1Revealed && revealInfo) {
        revealInfo.classList.remove('hidden');
        const userPlacement = placements[c.id];
        const isCorrect = userPlacement === c.correct;
        if (isCorrect) {
          revealInfo.innerHTML = `<span class="text-emerald-700 font-bold">✓ Correct (${c.correct})</span> · ${c.reason}`;
          cardEl.classList.add('border-emerald-400', 'bg-emerald-50/30');
        } else {
          revealInfo.innerHTML = `<span class="text-blue font-bold">Solution: ${c.correct}</span> · ${c.reason}`;
        }
      }
    });
  }

  // Setup Drag and Drop
  let draggedCardId: string | null = null;
  document.querySelectorAll<HTMLElement>('.sentence-card').forEach((card) => {
    card.addEventListener('dragstart', (e) => {
      draggedCardId = card.dataset.cardId || null;
      card.classList.add('dragging');
    });
    card.addEventListener('dragend', () => {
      card.classList.remove('dragging');
      draggedCardId = null;
    });
  });

  sortColumns.forEach((col) => {
    col.addEventListener('dragover', (e) => {
      e.preventDefault();
      col.classList.add('drag-over');
    });
    col.addEventListener('dragleave', () => {
      col.classList.remove('drag-over');
    });
    col.addEventListener('drop', (e) => {
      e.preventDefault();
      col.classList.remove('drag-over');
      const targetCol = col.dataset.col;
      if (draggedCardId && targetCol) {
        answers.step1_sort[draggedCardId] = targetCol;
        triggerAutosave({ step1_sort: answers.step1_sort });
        updateSortPlacementUI();
        playAudioChime('tag');
      }
    });
  });

  // Mobile Quick Place Buttons
  document.querySelectorAll<HTMLButtonElement>('.quick-place-btn').forEach((btn) => {
