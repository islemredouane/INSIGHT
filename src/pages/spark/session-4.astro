    roomState.unlocked_step = 0;
    if (mentorSession?.token) {
      try { await mentorS4SetStep(mentorSession.token, 0); } catch {}
    }
    syncState();
  });

  document.querySelectorAll<HTMLInputElement>('.s4-reveal-step-toggle').forEach((chk) => {
    chk.addEventListener('change', async () => {
      const st = chk.dataset.step;
      if (!st) return;
      roomState.revealed_steps = roomState.revealed_steps || {};
      roomState.revealed_steps[st] = chk.checked;
      if (mentorSession?.token) {
        try { await mentorS4SetReveal(mentorSession.token, parseInt(st, 10), chk.checked); } catch {}
      }
      syncState();
      playAudioChime('tag');
    });
  });

  btnRevealCurrentAnswers?.addEventListener('click', async () => {
    const curr = String(activePanel);
    roomState.revealed_steps = roomState.revealed_steps || {};
    roomState.revealed_steps[curr] = true;
    if (mentorSession?.token) {
      try { await mentorS4SetReveal(mentorSession.token, activePanel, true); } catch {}
    }
    syncState();
    playAudioChime('tag');
  });

  btnRevealKeysAll?.addEventListener('click', async () => {
    for (let i = 1; i <= 5; i++) {
      roomState.revealed_steps[String(i)] = true;
      if (mentorSession?.token) {
        try { await mentorS4SetReveal(mentorSession.token, i, true); } catch {}
      }
    }
    syncState();
  });

  btnHideKeysAll?.addEventListener('click', async () => {
    roomState.revealed_steps = {};
    for (let i = 1; i <= 5; i++) {
      if (mentorSession?.token) {
        try { await mentorS4SetReveal(mentorSession.token, i, false); } catch {}
      }
    }
    syncState();
  });

  // Watch room state realtime
  watchSession4State((s) => {
    if (s.unlocked_step > roomState.unlocked_step) {
      playAudioChime('unlock');
    }
    roomState = s;
    syncState();
  });

  // Init
  if (teamCode) {
    answers = loadLocalAnswers(teamCode);
  }
  syncState();
  refreshMentorAuthState();
</script>
