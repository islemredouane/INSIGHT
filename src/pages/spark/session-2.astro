  // ==================== STEP 1 ====================
  function checkPages(shouldSave = true) {
    sparkSession2.paperParts.forEach((part, idx) => {
      const input = document.querySelector<HTMLInputElement>(`.page-part-input[data-part="${part.id}"]`);
      const fb = document.querySelector<HTMLElement>(`.page-feedback[data-feedback="${part.id}"]`);
      if (!input || !fb) return;
      const val = Number(input.value);
      if (!val) {
        fb.textContent = '';
        delete answers.pages[part.id];
        return;
      }
      if (part.validPages.includes(val)) {
        fb.textContent = '✓ Correct';
        fb.className = 'page-feedback text-[12px] font-semibold text-emerald-700 whitespace-nowrap';
      } else if (revealedKeys.step1?.pageMap[idx]) {
        fb.textContent = `Check ${revealedKeys.step1.pageMap[idx].expected}`;
        fb.className = 'page-feedback text-[12px] text-body whitespace-nowrap';
      } else {
        fb.textContent = 'Try skimming again';
        fb.className = 'page-feedback text-[12px] text-muted whitespace-nowrap';
      }
      answers.pages[part.id] = val;
    });
    if (shouldSave) queueSave('s1-saved', { pages: answers.pages }, true);
  }

  document.querySelectorAll<HTMLInputElement>('.page-part-input').forEach((input) => {
    input.addEventListener('change', () => checkPages(true));
  });
  document.getElementById('check-pages-btn')?.addEventListener('click', () => checkPages(true));

  const trickInputs: Record<keyof typeof answers.trick, HTMLInputElement | null> = {
    who: document.getElementById('trick-who') as HTMLInputElement | null,
    what: document.getElementById('trick-what') as HTMLInputElement | null,
