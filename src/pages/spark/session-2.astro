      display: none !important;
    }
    #game {
      background: #fff !important;
      padding-top: 0 !important;
    }
    #cf2-summary-card {
      background: #fff !important;
      color: #0B1120 !important;
      border: 2px solid #0B1120 !important;
      box-shadow: none !important;
    }
    #cf2-summary-card * {
      color: #0B1120 !important;
      border-color: rgba(11, 17, 32, 0.2) !important;
    }
  }
</style>

<script>
  import { sparkSession2 } from '../../data/spark';
  import {
    getTeam, getStoredTeamCode, storeTeamCode, clearTeamCode,
    mentorLogin, mentorSession2Key, getStoredMentor, storeMentor, clearMentor,
    friendlyError, escapeHtml, type Session2AnswerKey,
  } from '../../lib/spark/api';

  // Team handling
  let teamCode = getStoredTeamCode() || 'DEMO';
  let STORAGE_KEY = `spark-s2-${teamCode}`;

  const teamBanner = document.getElementById('team-banner');
  const bannerIconBox = document.getElementById('banner-icon-box');
  const bannerName = document.getElementById('banner-team-name');
  const bannerMembers = document.getElementById('banner-team-members');
  const bannerBadge = document.getElementById('banner-status-badge');
  const switchTeamBtn = document.getElementById('btn-switch-team');
  const bannerFeedback = document.getElementById('banner-feedback');
  const teamLabel = document.getElementById('team-label');
  const teamBadge = document.getElementById('team-badge');
  const inlineInput = document.getElementById('inline-team-code') as HTMLInputElement | null;
  const inlineBtn = document.getElementById('inline-connect-btn') as HTMLButtonElement | null;

  let feedbackTimer: any = null;
  function showBannerFeedback(message: string, type: 'error' | 'success') {
    if (!bannerFeedback) return;
    if (feedbackTimer) clearTimeout(feedbackTimer);
    bannerFeedback.textContent = message;
    if (type === 'error') {
      bannerFeedback.className = 'px-5 sm:px-6 py-2.5 text-[13px] border-t border-signal/20 bg-signal/5 text-signal font-medium block';
    } else {
      bannerFeedback.className = 'px-5 sm:px-6 py-2.5 text-[13px] border-t border-emerald-500/20 bg-emerald-50 text-emerald-800 font-medium block';
      feedbackTimer = setTimeout(() => {
        bannerFeedback.className = 'hidden';
        bannerFeedback.textContent = '';
      }, 5000);
    }
  }

  function clearBannerFeedback() {
    if (!bannerFeedback) return;
    if (feedbackTimer) clearTimeout(feedbackTimer);
    bannerFeedback.className = 'hidden';
    bannerFeedback.textContent = '';
  }

  async function syncTeamInfo() {
    teamCode = getStoredTeamCode() || 'DEMO';
    STORAGE_KEY = `spark-s2-${teamCode}`;

    if (teamCode && teamCode !== 'DEMO') {
      try {
        const data = await getTeam(teamCode);
        if (data && data.team) {
          if (teamLabel) teamLabel.textContent = `Team ${data.team.name}`;
          if (teamBadge) teamBadge.textContent = `${data.team.code} · ${data.team.members.length} Members`;
          if (bannerName) bannerName.textContent = `Team ${data.team.name}`;
          if (bannerMembers) bannerMembers.textContent = `Members: ${data.team.members.join(', ')}`;
          if (bannerBadge) {
            bannerBadge.textContent = `✓ Code: ${data.team.code}`;
            bannerBadge.className = 'px-2.5 py-0.5 text-[11px] font-mono rounded bg-emerald-100 text-emerald-800 border border-emerald-300 font-semibold';
          }
          if (bannerIconBox) bannerIconBox.textContent = '✨';
          teamBanner?.classList.add('is-connected');
          return;
        }
      } catch (err) {
        console.warn('Backend sync warning:', err);
      }

      // Offline fallback with code
      if (teamLabel) teamLabel.textContent = `Team ${teamCode}`;
      if (teamBadge) teamBadge.textContent = `Code: ${teamCode}`;
      if (bannerName) bannerName.textContent = `Team ${teamCode}`;
      if (bannerMembers) bannerMembers.textContent = `Connected with code ${teamCode}`;
      if (bannerBadge) {
        bannerBadge.textContent = `Code: ${teamCode}`;
        bannerBadge.className = 'px-2.5 py-0.5 text-[11px] font-mono rounded bg-blue/10 text-blue font-semibold';
      }
      if (bannerIconBox) bannerIconBox.textContent = '👥';
      teamBanner?.classList.add('is-connected');
    } else {
      // Explorer / Guest mode
      if (teamLabel) teamLabel.textContent = 'The Music Case · Part 2';
      if (teamBadge) teamBadge.textContent = 'Explorer Mode';
      if (bannerName) bannerName.textContent = 'Working with a team?';
      if (bannerMembers) bannerMembers.textContent = 'Have a team code from Session 1? Enter it below. New to SPARK? Register a team in 1 minute!';
      if (bannerBadge) {
        bannerBadge.textContent = 'Explorer Mode';
        bannerBadge.className = 'px-2.5 py-0.5 text-[11px] font-mono rounded bg-paper text-muted border border-navy/10 font-medium';
      }
      if (bannerIconBox) bannerIconBox.textContent = '👥';
      teamBanner?.classList.remove('is-connected');
    }
  }

  // Connect button click
  async function handleConnectCode() {
    if (!inlineInput) return;
    const raw = inlineInput.value.trim().toUpperCase();
    if (!raw || raw.length < 4) {
      showBannerFeedback('Please enter your 6-character team code.', 'error');
      return;
    }
    if (inlineBtn) inlineBtn.disabled = true;
    clearBannerFeedback();

    try {
      const data = await getTeam(raw);
      if (!data || !data.team) {
        throw new Error("That code wasn't found. Check the letters or register a new team.");
      }
      storeTeamCode(raw);
      teamCode = raw;
      STORAGE_KEY = `spark-s2-${teamCode}`;
      showBannerFeedback(`✓ Connected as Team ${data.team.name}! Loading team workspace…`, 'success');
      setTimeout(() => {
        window.location.reload();
      }, 500);
    } catch (err: any) {
      showBannerFeedback(friendlyError(err), 'error');
      if (inlineBtn) inlineBtn.disabled = false;
    }
  }

  inlineBtn?.addEventListener('click', handleConnectCode);
  inlineInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      handleConnectCode();
    }
  });

  switchTeamBtn?.addEventListener('click', () => {
    clearTeamCode();
    showBannerFeedback('Switched to Explorer Mode. Reloading workspace…', 'success');
    setTimeout(() => {
      window.location.reload();
    }, 400);
  });

  // Run on load
  syncTeamInfo();

  // Load existing state from localStorage
  interface Session2State {
    step: number;
    unlockedStep: number;
    mentorReveals: Record<number, boolean>;
    hw_q1: string;
    hw_q2: string;
    pages: Record<string, number>;
    trick: { who: string; what: string; compared: string; measured: string };
    yellow: string[];
    blue: string[];
    jarWords: string[];
    prediction: string[]; // condition ids in ranked order
    predictionLocked: boolean;
    resultsRealText: string;
    resultsBonusText: string;
    readingCard: Record<string, string>;
    cardSubmitted: boolean;
    cf2Saved: boolean;
    cf2: {
      choice: string;
      explanation: string;
      sentenceYacine: string;
      reasonCareful: string;
    };
  }

  const defaultReveals: Record<number, boolean> = {
    0: false,
    1: false,
    2: false,
    3: false,
    4: false,
    5: false,
  };

  const defaultState: Session2State = {
    step: 0,
    unlockedStep: 0,
    mentorReveals: { ...defaultReveals },
    hw_q1: '',
    hw_q2: '',
    pages: {},
    trick: { who: '', what: '', compared: '', measured: '' },
    yellow: ['', '', ''],
    blue: ['', ''],
    jarWords: [],
    prediction: ['quiet', 'liked', 'no_lyrics', 'disliked'],
    predictionLocked: false,
    resultsRealText: '',
    resultsBonusText: '',
    readingCard: {
      reference: sparkSession2.paper.citation,
      question: '',
      who: '',
      what_done: '',
      main_result: '',
      explanation: '',
      limits: '',
      our_questions: '',
    },
    cardSubmitted: false,
    cf2Saved: false,
    cf2: {
      choice: 'yes',
      explanation: '',
      sentenceYacine: '',
      reasonCareful: '',
    },
  };

  const LEGACY_JAR_JSON = JSON.stringify([
    'Within design',
    'Significant (p < .05)',
    'Counterbalanced',
    'Pilot study',
    'Likert scale',
  ]);

  let state: Session2State = {
    ...defaultState,
    mentorReveals: { ...defaultReveals },
  };
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) {
      const parsed = JSON.parse(raw);
      const parsedJar = Array.isArray(parsed.jarWords)
        ? (JSON.stringify(parsed.jarWords) === LEGACY_JAR_JSON ? [] : parsed.jarWords)
        : [];
      state = {
        ...defaultState,
        ...parsed,
        jarWords: parsedJar,
        mentorReveals: { ...defaultReveals, ...(parsed.mentorReveals || {}) },
        trick: { ...defaultState.trick, ...(parsed.trick || {}) },
        readingCard: { ...defaultState.readingCard, ...(parsed.readingCard || {}) },
        cf2: { ...defaultState.cf2, ...(parsed.cf2 || {}) },
      };
    }
  } catch (e) {
    console.error('Failed to load session 2 state', e);
  }

  function saveState(statusElId?: string) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      if (statusElId) markStatus(statusElId, 'saved');
    } catch (e) {
      console.error('Save failed', e);
      if (statusElId) markStatus(statusElId, 'Save error');
    }
  }

  function markStatus(id: string, st: 'saving' | 'saved' | string) {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.remove('status-saving', 'status-saved', 'status-error');
    if (st === 'saving') {
      el.textContent = 'Saving…';
      el.classList.add('status-saving');
    } else if (st === 'saved') {
      el.textContent = '✓ Saved';
      el.classList.add('status-saved');
    } else {
      el.textContent = st;
      el.classList.add('status-error');
    }
  }

  // Navigation & Progressive Locks
  let activePanel = 0;

  function renderLocks() {
    const indicator = document.getElementById('unlocked-step-indicator');
    if (indicator) {
      indicator.textContent = `Step ${state.unlockedStep}/5`;
    }

    document.querySelectorAll<HTMLButtonElement>('.step-tab').forEach((btn) => {
      const n = Number(btn.dataset.step);
      const isLocked = n > state.unlockedStep;
      btn.classList.toggle('locked', isLocked);
      btn.classList.toggle('active', n === activePanel);
      btn.disabled = isLocked;
      const lockIcon = btn.querySelector('.step-lock-icon');
      if (lockIcon) {
        lockIcon.classList.toggle('hidden', !isLocked);
      }
    });

    document.querySelectorAll<HTMLElement>('.panel').forEach((p) => {
      const n = Number(p.dataset.panel);
      p.classList.toggle('hidden', n !== activePanel);
    });
  }

  // Server-verified Session 2 Answer Key (kept strictly in JS memory, never in HTML/localStorage)
  let serverAnswerKey: Session2AnswerKey | null = null;
  let keyLoadPromise: Promise<Session2AnswerKey | null> | null = null;

  function clearMentorKeyDOM() {
    document.querySelectorAll<HTMLElement>('[data-mentor-reveal]').forEach((el) => {
      el.innerHTML = '';
      el.classList.add('hidden');
    });
    document.querySelectorAll<HTMLElement>('[data-mentor-locked]').forEach((el) => {
      el.classList.remove('hidden');
    });
    document.querySelectorAll<HTMLInputElement>('.mentor-reveal-toggle').forEach((cb) => {
      cb.checked = false;
    });
  }

  function hydrateMentorKeyDOM(key: Session2AnswerKey) {
    // Step 0 · Sample HW Ideas
    const r0 = document.getElementById('mentor-reveal-0');
    if (r0) {
      r0.innerHTML = `
        <p class="text-[11px] font-mono uppercase text-blue font-bold tracking-wider">👑 Mentor Reveal · Sample Homework Questions</p>
        <p class="text-[12px] text-muted mt-0.5">Click any example below to add it to your team’s questions:</p>
        <div class="mt-2.5 flex flex-wrap gap-2">
          ${key.step0.sampleHomeworkQuestions
            .map(
              (q) =>
                `<button type="button" class="hw-chip text-[12px] bg-white hover:bg-blue/10 text-body hover:text-blue border border-navy/10 px-3 py-1.5 rounded transition text-left" data-suggestion="${escapeHtml(q)}">+ ${escapeHtml(q)}</button>`
            )
            .join('')}
        </div>
      `;
      r0.querySelectorAll<HTMLButtonElement>('.hw-chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          const text = chip.dataset.suggestion || '';
          if (!text) return;
          if (hwQ1?.value.trim() === text || hwQ2?.value.trim() === text) return;
          if (hwQ1 && !hwQ1.value.trim()) {
            hwQ1.value = text;
            state.hw_q1 = text;
          } else if (hwQ2) {
            hwQ2.value = text;
            state.hw_q2 = text;
          }
          saveState('s0-saved');
        });
      });
    }

    // Step 1 · Map & Four-Part Trick
    const r1 = document.getElementById('mentor-reveal-1');
    if (r1) {
      r1.innerHTML = `
        <p class="font-mono text-[11px] uppercase tracking-wider text-blue font-bold">👑 Mentor Reveal · Step 1 Answer Key</p>
        <div>
          <p class="font-semibold text-ink mb-1.5">Task A · Official Page Map</p>
          <ul class="space-y-1 text-body text-[12px]">
            ${key.step1.pageMap.map((p) => `<li><strong>${escapeHtml(p.name)}:</strong> ${escapeHtml(p.expected)}</li>`).join('')}
          </ul>
        </div>
        <div class="pt-3 border-t border-blue/15 space-y-1.5 text-body">
          <p class="font-semibold text-ink">Task B · Expected Four-Part Trick Answers</p>
          ${key.step1.fourPartTrick
            .map(
              (f) =>
                `<p><strong>${escapeHtml(f.label)}:</strong> ${escapeHtml(f.expected)} <span class="text-muted text-[11px]">(${escapeHtml(f.where)})</span></p>`
            )
            .join('')}
          <p class="text-[12px] text-amber-900 bg-amber-50 border border-amber-200 rounded p-2.5 mt-2">
            <strong>Mentor tip:</strong> ${escapeHtml(key.step1.mentorTip)}
          </p>
        </div>
      `;
    }

    // Step 2 · Yellow Facts, Blue Facts & Word Jar Glossary
    const r2y = document.getElementById('mentor-reveal-2-yellow');
    if (r2y) {
      r2y.innerHTML = `
        <p class="font-mono text-[11px] uppercase tracking-wider text-amber-900 font-bold">👑 Mentor Reveal · Accepted Yellow Facts (Any 3 are correct)</p>
        <ul class="mt-2 pl-4 list-disc space-y-1 text-amber-950/90">
          ${key.step2.yellowFacts.map((f) => `<li>${escapeHtml(f)}</li>`).join('')}
        </ul>
      `;
    }
    const r2b = document.getElementById('mentor-reveal-2-blue');
    if (r2b) {
      r2b.innerHTML = `
        <p class="font-mono text-[11px] uppercase tracking-wider text-blue font-bold">👑 Mentor Reveal · Accepted Blue Facts (Any 2 are correct)</p>
        <ul class="mt-2 pl-4 list-disc space-y-1 text-body">
          ${key.step2.blueFacts.map((f) => `<li>${escapeHtml(f)}</li>`).join('')}
        </ul>
        <p class="mt-2.5 text-[12px] text-amber-900 bg-amber-50 border border-amber-200 rounded p-2">
          <strong>Most common mistake:</strong> ${escapeHtml(key.step2.commonMistake)}
        </p>
      `;
    }
    const r2j = document.getElementById('mentor-reveal-2-jar');
    if (r2j) {
      r2j.innerHTML = `
        <div class="p-4 bg-ink text-white rounded-lg">
          <p class="font-mono text-[11px] uppercase tracking-wider text-peri">👑 Mentor Reveal · The 2 Essential Terms</p>
          <div class="mt-3 grid sm:grid-cols-2 gap-3 text-[13px]">
            ${key.step2.essentialTerms
              .map(
                (t) => `
              <div class="p-3 bg-white/5 border border-white/10 rounded">
                <span class="font-bold text-peri font-mono">${escapeHtml(t.term)}</span>
                <p class="mt-1 text-silver leading-relaxed">${escapeHtml(t.definition)}</p>
              </div>
            `
              )
              .join('')}
          </div>
        </div>
        <div class="p-4 bg-paper border border-navy/10 rounded-lg">
          <p class="font-mono text-[11px] uppercase tracking-wider text-blue font-bold mb-3">👑 Mentor Reveal · All 12 Curated Paper Terms</p>
          <div class="grid sm:grid-cols-2 gap-2">
            ${key.step2.wordJar
              .map(
                (w) => `
              <div class="p-3 bg-white border border-navy/10 rounded text-[13px]">
                <div class="flex items-center justify-between gap-2">
                  <strong class="text-ink">${escapeHtml(w.term)}</strong>
                  <span class="font-mono text-[10px] text-muted shrink-0">${escapeHtml(w.pageHint)}</span>
                </div>
                <p class="mt-1 text-body text-[12px] leading-relaxed">${escapeHtml(w.definition)}</p>
              </div>
            `
              )
              .join('')}
          </div>
        </div>
      `;
    }

    // Step 3 · Real Results & Table 1
    const r3 = document.getElementById('predict-phase-3');
    if (r3) {
      const t1 = key.step3.table1;
      r3.innerHTML = `
        <div class="bg-white border border-blue/30 p-6 sm:p-8 rounded-lg shadow-sm">
          <p class="font-mono text-[11px] uppercase tracking-wider text-blue font-bold">👑 Mentor Reveal · Step 3 Answer Key</p>
          <h3 class="font-display text-xl font-bold text-ink mt-1">Prediction vs. Empirical Reality</h3>
          <p class="text-[14px] text-body mt-1">Here is how your locked prediction matches what Perham &amp; Currie (2014) found:</p>

          <div class="mt-6 grid sm:grid-cols-2 gap-4">
            <div class="p-4 bg-paper/60 border border-navy/10 rounded-lg">
              <span class="font-mono text-[11px] uppercase tracking-wider text-muted font-semibold">Your Locked Prediction</span>
              <ol id="locked-prediction-list" class="mt-3 space-y-2 text-[14px]"></ol>
            </div>
            <div class="p-4 bg-blue/10 border border-blue/30 rounded-lg">
              <span class="font-mono text-[11px] uppercase tracking-wider text-blue font-semibold">Real Result (Page 3 / Page 8)</span>
              <div class="mt-3 space-y-2 text-[14px]">
                ${key.step3.ranking
                  .map(
                    (row) => `
                  <div class="p-2.5 bg-white rounded border border-blue/20">
                    <div class="flex items-center justify-between gap-2">
                      <span class="font-bold text-ink">${escapeHtml(row.rank)} · ${escapeHtml(row.icon)} ${escapeHtml(row.title)}</span>
                      <span class="font-mono text-[11px] font-semibold ${row.tone === 'good' ? 'text-emerald-700' : 'text-signal'}">${escapeHtml(row.note)}</span>
                    </div>
                  </div>
                `
                  )
                  .join('')}
              </div>
            </div>
          </div>

          <div class="mt-6 space-y-3">
            ${key.step3.surprises
              .map(
                (s) => `
              <div class="p-4 rounded-lg border ${s.tone === 'amber' ? 'bg-amber-50 border-amber-200' : 'bg-emerald-50 border-emerald-200'}">
                <span class="font-bold text-[14px] ${s.tone === 'amber' ? 'text-amber-900' : 'text-emerald-900'}">${escapeHtml(s.title)}</span>
                <p class="text-[13px] mt-1 leading-relaxed ${s.tone === 'amber' ? 'text-amber-800' : 'text-emerald-800'}">${escapeHtml(s.body)}</p>
              </div>
            `
              )
              .join('')}
          </div>

          <div class="mt-6 pt-6 border-t border-navy/10">
            <h4 class="font-display font-bold text-ink text-[15px]">Bonus Answer · Table 1: Did Students Know Which Condition Hurt Them?</h4>
            <p class="text-[13px] text-muted mt-0.5">Students rated each condition out of 100 after the test:</p>
            <div class="mt-3 overflow-x-auto">
              <table class="w-full text-left text-[13px] border border-navy/10 rounded overflow-hidden">
                <thead class="bg-paper font-mono text-[11px] uppercase text-muted">
                  <tr>
                    <th class="p-2.5">Table 1 (out of 100)</th>
                    <th class="p-2.5">Disliked songs</th>
                    <th class="p-2.5">Liked songs</th>
                    <th class="p-2.5">No lyrics</th>
                    <th class="p-2.5">Quiet</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-navy/10 bg-white">
                  <tr>
                    <td class="p-2.5 font-medium">How distracting it was</td>
                    <td class="p-2.5 font-mono text-signal font-semibold">${escapeHtml(t1.distracting.disliked)}</td>
                    <td class="p-2.5 font-mono text-signal font-semibold">${escapeHtml(t1.distracting.liked)}</td>
                    <td class="p-2.5 font-mono text-body">${escapeHtml(t1.distracting.noLyrics)}</td>
                    <td class="p-2.5 font-mono text-emerald-700">${escapeHtml(t1.distracting.quiet)}</td>
                  </tr>
                  <tr>
                    <td class="p-2.5 font-medium">How well I think I did</td>
                    <td class="p-2.5 font-mono text-signal">${escapeHtml(t1.perceived.disliked)}</td>
                    <td class="p-2.5 font-mono text-signal">${escapeHtml(t1.perceived.liked)}</td>
                    <td class="p-2.5 font-mono text-body">${escapeHtml(t1.perceived.noLyrics)}</td>
                    <td class="p-2.5 font-mono text-emerald-700">${escapeHtml(t1.perceived.quiet)}</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p class="text-[12px] text-body mt-2.5 leading-relaxed">
              <strong>Answer:</strong> ${escapeHtml(t1.bonusAnswer)}
            </p>
          </div>
        </div>
      `;
    }

    // Step 4 · Reading Card Approval + Official Key
    const r4 = document.getElementById('mentor-reveal-4');
    if (r4) {
