  // ---- Apply Live Room State (Step Locks + Answer Key Reveals from Supabase) ----
  async function applyRoomState(nextState: Session2RoomState, preloadedKeys?: Partial<Session2AnswerKey>) {
    roomState = {
      unlocked_step: Number(nextState.unlocked_step ?? 0),
      revealed_steps: nextState.revealed_steps || {},
      updated_at: nextState.updated_at,
    };

    // If current panel got locked by mentor reset, return to unlocked_step
    if (activePanel > roomState.unlocked_step) {
      activePanel = roomState.unlocked_step;
    }

    renderLocks();

    const revJson = JSON.stringify(roomState.revealed_steps);
    if (preloadedKeys) {
      revealedKeys = preloadedKeys;
      lastRevealedJson = revJson;
      hydrateRevealedStepDOM(revealedKeys);
    } else if (revJson !== lastRevealedJson) {
      try {
        revealedKeys = await getSession2RevealedKeys();
        lastRevealedJson = revJson;
        hydrateRevealedStepDOM(revealedKeys);
      } catch {
        // Leave lastRevealedJson unset so the next 4s poll automatically retries
        lastRevealedJson = '';
      }
    }

    renderMentorReveals();
  }

  function renderLocks() {
    const indicator = document.getElementById('unlocked-step-indicator');
    if (indicator) {
      indicator.textContent = `Step ${roomState.unlocked_step}/5`;
    }

    document.querySelectorAll<HTMLButtonElement>('.step-tab').forEach((btn) => {
      const n = Number(btn.dataset.step);
      const isLocked = n > roomState.unlocked_step;
      btn.classList.toggle('locked', isLocked);
      btn.classList.toggle('active', n === activePanel);
      btn.disabled = isLocked;
      const lockIcon = btn.querySelector('.step-lock-icon');
      if (lockIcon) {
        lockIcon.classList.toggle('hidden', !isLocked);
      }
    });

    document.querySelectorAll<HTMLElement>('.panel').forEach((p) => {
      const n = Number(p.dataset.panel);
      p.classList.toggle('hidden', n !== activePanel);
    });
  }

  function renderMentorReveals() {
    for (let stepNum = 0; stepNum <= 5; stepNum++) {
      const stepKey = `step${stepNum}` as keyof Session2AnswerKey;
      const revealed = Boolean(roomState.revealed_steps[String(stepNum)] && revealedKeys[stepKey]);
      document.querySelectorAll<HTMLElement>(`[data-mentor-reveal="${stepNum}"]`).forEach((el) => {
        el.classList.toggle('hidden', !revealed);
      });
      document.querySelectorAll<HTMLElement>(`[data-mentor-locked="${stepNum}"]`).forEach((el) => {
        el.classList.toggle('hidden', revealed);
      });
      const checkbox = document.querySelector<HTMLInputElement>(`.mentor-reveal-toggle[data-reveal-step="${stepNum}"]`);
      if (checkbox) {
        checkbox.checked = Boolean(roomState.revealed_steps[String(stepNum)]);
      }
    }

    if (Object.keys(answers.pages).length > 0) {
      checkPages(false);
    }
    if (revealedKeys.step3) {
      renderLockedList();
    }
    updateCardStatusUI();
  }

  function showPanel(n: number) {
    if (n > roomState.unlocked_step) {
      showBannerFeedback(`Step ${n} opens as soon as your mentor unlocks it in the Mentor Panel.`, 'error');
      return;
    }
    activePanel = n;
    renderLocks();
    window.scrollTo({ top: 180, behavior: 'smooth' });
  }

  document.querySelectorAll<HTMLButtonElement>('.step-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      const n = Number(btn.dataset.step);
      if (n <= roomState.unlocked_step) showPanel(n);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.next-panel-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = Number(btn.dataset.next);
      if (next > roomState.unlocked_step) {
        const statusId = `s${activePanel}-saved`;
        markStatus(statusId, `🔒 Waiting for mentor to unlock Step ${next}`);
        return;
      }
      showPanel(next);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.prev-panel-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const prev = Number(btn.dataset.prev);
      showPanel(prev);
    });
  });

  // ---- Top-Bar Mentor Reveal Controls (Wired Live to Supabase Room State!) ----
  const mentorMenu = document.getElementById('mentor-controls-menu');
  const mentorToggle = document.getElementById('mentor-controls-toggle');
  const mentorInlineLogin = document.getElementById('mentor-inline-login') as HTMLFormElement | null;
  const mentorInlinePassword = document.getElementById('mentor-inline-password') as HTMLInputElement | null;
  const mentorInlineError = document.getElementById('mentor-inline-error');
  const mentorInlineSubmit = document.getElementById('mentor-inline-submit') as HTMLButtonElement | null;
  const mentorControlsAuthed = document.getElementById('mentor-controls-authed');
  const mentorAuthedBadge = document.getElementById('mentor-authed-badge');

  function syncMentorAuthUI() {
    const mentor = getStoredMentor();
    const isAuthed = Boolean(mentor && mentor.token);
    mentorInlineLogin?.classList.toggle('hidden', isAuthed);
    mentorControlsAuthed?.classList.toggle('hidden', !isAuthed);
    if (isAuthed && mentorAuthedBadge && mentor) {
      mentorAuthedBadge.textContent = mentor.mentorName ? `✓ ${mentor.mentorName}` : `✓ ${mentor.role.toUpperCase()}`;
    }
  }
  syncMentorAuthUI();

  function closeMentorMenu() {
    mentorMenu?.classList.add('hidden');
    mentorToggle?.setAttribute('aria-expanded', 'false');
  }

  mentorInlineLogin?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!mentorInlinePassword) return;
    const pwd = mentorInlinePassword.value.trim();
    if (!pwd) return;
    if (mentorInlineSubmit) {
      mentorInlineSubmit.disabled = true;
      mentorInlineSubmit.textContent = 'Checking…';
    }
    mentorInlineError?.classList.add('hidden');

    try {
      const session = await mentorLogin(pwd);
      storeMentor(session);
      mentorInlinePassword.value = '';
      syncMentorAuthUI();
    } catch (err: any) {
      clearMentor();
      if (mentorInlineError) {
        mentorInlineError.textContent = friendlyError(err);
        mentorInlineError.classList.remove('hidden');
      }
    } finally {
      if (mentorInlineSubmit) {
        mentorInlineSubmit.disabled = false;
        mentorInlineSubmit.textContent = 'Unlock Mentor Controls';
      }
    }
  });

  document.getElementById('btn-mentor-logout')?.addEventListener('click', () => {
    clearMentor();
    syncMentorAuthUI();
    closeMentorMenu();
  });

  mentorToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    syncMentorAuthUI();
    const willOpen = mentorMenu?.classList.contains('hidden');
    mentorMenu?.classList.toggle('hidden');
    mentorToggle.setAttribute('aria-expanded', String(Boolean(willOpen)));
    if (willOpen && !getStoredMentor()) {
      setTimeout(() => mentorInlinePassword?.focus(), 50);
    }
  });
  document.addEventListener('click', closeMentorMenu);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMentorMenu();
  });
  mentorMenu?.addEventListener('click', (e) => e.stopPropagation());

  async function runMentorAction(fn: (token: string) => Promise<void>) {
    const mentor = getStoredMentor();
    if (!mentor?.token) {
      syncMentorAuthUI();
      return;
    }
    try {
      await fn(mentor.token);
      const fresh = await getSession2State(teamCode);
      if (fresh) await applyRoomState(fresh.state, fresh.revealed_keys);
    } catch (err: any) {
      const msg = friendlyError(err);
      if (msg.toLowerCase().includes('expired') || msg.toLowerCase().includes('session')) {
        clearMentor();
        syncMentorAuthUI();
      }
      showBannerFeedback(msg, 'error');
    }
  }

  document.getElementById('btn-reveal-next')?.addEventListener('click', () => {
    const next = Math.min(5, roomState.unlocked_step + 1);
    runMentorAction(async (token) => {
      await mentorS2SetStep(token, next);
      activePanel = next;
    });
    closeMentorMenu();
  });

  document.getElementById('btn-reveal-all')?.addEventListener('click', () => {
    runMentorAction((token) => mentorS2SetStep(token, 5));
    closeMentorMenu();
  });

  document.getElementById('btn-lock-all')?.addEventListener('click', () => {
    runMentorAction(async (token) => {
      await mentorS2SetStep(token, 0);
