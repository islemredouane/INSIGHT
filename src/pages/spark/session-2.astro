  async function ensureMentorAnswerKey(): Promise<Session2AnswerKey | null> {
    if (serverAnswerKey) return serverAnswerKey;
    const mentor = getStoredMentor();
    if (!mentor?.token) return null;
    if (!keyLoadPromise) {
      keyLoadPromise = mentorSession2Key(mentor.token)
        .then((key) => {
          serverAnswerKey = key;
          hydrateMentorKeyDOM(key);
          return key;
        })
        .catch(() => {
          // Forged or expired mentor token: reject and clear immediately
          clearMentor();
          serverAnswerKey = null;
          state.mentorReveals = { ...defaultReveals };
          saveState();
          clearMentorKeyDOM();
          syncMentorAuthUI();
          return null;
        })
        .finally(() => {
          keyLoadPromise = null;
        });
    }
    return keyLoadPromise;
  }

  function renderMentorReveals() {
    const canReveal = Boolean(serverAnswerKey && getStoredMentor()?.token);
    for (let stepNum = 0; stepNum <= 5; stepNum++) {
      const revealed = canReveal && Boolean(state.mentorReveals[stepNum]);
      document.querySelectorAll<HTMLElement>(`[data-mentor-reveal="${stepNum}"]`).forEach((el) => {
        el.classList.toggle('hidden', !revealed);
      });
      document.querySelectorAll<HTMLElement>(`[data-mentor-locked="${stepNum}"]`).forEach((el) => {
        el.classList.toggle('hidden', revealed);
      });
      const checkbox = document.querySelector<HTMLInputElement>(`.mentor-reveal-toggle[data-reveal-step="${stepNum}"]`);
      if (checkbox) {
        checkbox.checked = revealed;
      }
    }

    // Step 1: refresh page feedback live without flashing "Saved"
    if (Object.keys(state.pages).length > 0) {
      checkPages(false);
    }

    // Step 3: populate locked prediction list whenever Step 3 reveal opens
    if (canReveal && state.mentorReveals[3]) {
      renderLockedList();
    }

    // Step 4: sync waiting vs approved status
    updateCardStatusUI();
  }

  function unlockToStep(n: number) {
    if (n > state.unlockedStep) {
      state.unlockedStep = Math.min(5, n);
      saveState();
      renderLocks();
    }
  }

  function showPanel(n: number) {
    if (n > state.unlockedStep) {
      return;
    }
    activePanel = n;
    state.step = n;
    saveState();
    renderLocks();
    window.scrollTo({ top: 180, behavior: 'smooth' });
  }

  document.querySelectorAll<HTMLButtonElement>('.step-tab').forEach((btn) => {
    btn.addEventListener('click', () => {
      const n = Number(btn.dataset.step);
      if (n <= state.unlockedStep) {
        showPanel(n);
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.next-panel-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = Number(btn.dataset.next);
      unlockToStep(next);
      showPanel(next);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.prev-panel-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
