  const cardApprovedComment = document.getElementById('card-approved-comment');
  const cardStatus = document.getElementById('s4-card-status');
  const sendCardBtn = document.getElementById('send-card-mentor-btn') as HTMLButtonElement | null;

  function getEmptyCardBoxCount(): number {
    return sparkSession2.readingCardBoxes.filter((b) => !(answers.reading_card[b.id] || '').trim()).length;
  }

  function updateCardStatusUI() {
    if (answers.card_status === 'approved') {
      cardWaitingBox?.classList.add('hidden');
      cardApprovedPersonal?.classList.remove('hidden');
      if (cardApprovedTitle) {
        cardApprovedTitle.textContent = answers.card_approved_by
          ? `Reading Card Approved by ${answers.card_approved_by}!`
          : 'Reading Card Approved by Mentor!';
      }
      if (cardApprovedComment) {
        if (answers.card_mentor_comment) {
          cardApprovedComment.textContent = `Mentor note: “${answers.card_mentor_comment}”`;
          cardApprovedComment.classList.remove('hidden');
        } else {
          cardApprovedComment.classList.add('hidden');
        }
      }
      if (cardStatus) cardStatus.textContent = '✓ Approved by mentor';
    } else if (answers.card_status === 'pending') {
      cardApprovedPersonal?.classList.add('hidden');
      cardWaitingBox?.classList.remove('hidden');
      const emptyCount = getEmptyCardBoxCount();
      if (cardStatus) {
        cardStatus.textContent = emptyCount > 0
          ? `⏳ Sent to Mentor (${emptyCount} box${emptyCount === 1 ? '' : 'es'} still empty — you can still edit)`
          : '⏳ Sent live — waiting for mentor review';
      }
    } else {
      cardApprovedPersonal?.classList.add('hidden');
      cardWaitingBox?.classList.add('hidden');
      if (cardStatus) cardStatus.textContent = 'Fill the 8 boxes, then send to your mentor';
    }
  }

  sendCardBtn?.addEventListener('click', async () => {
    if (!teamCode) {
      showBannerFeedback('Please connect your Team Code at the top first so your mentor receives your Reading Card!', 'error');
      window.scrollTo({ top: 0, behavior: 'smooth' });
      return;
    }
    sendCardBtn.disabled = true;
    markStatus('s4-saved', 'saving');
    try {
      const updated = await submitSession2Card(teamCode, answers.reading_card);
      answers.card_status = updated.card_status || 'pending';
      answers.card_approved_by = updated.card_approved_by ?? null;
      answers.card_mentor_comment = updated.card_mentor_comment ?? null;
      markStatus('s4-saved', 'saved');
      updateCardStatusUI();
      cardWaitingBox?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } catch (err) {
      markStatus('s4-saved', friendlyError(err));
    } finally {
      sendCardBtn.disabled = false;
    }
  });

  // ==================== STEP 5: CASE FILE #2 ====================
  const choiceLabels: Record<string, string> = { yes: 'Yes', partly: 'Partly', no: 'No' };

  document.querySelectorAll<HTMLButtonElement>('.hw-ans-choice').forEach((b) => {
    const choice = b.dataset.choice || 'yes';
    b.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('.hw-ans-choice').forEach((btn) => btn.classList.remove('chosen'));
      b.classList.add('chosen');
      answers.cf2.choice = choice;
      if (answers.cf2_saved) updateSummaryCardUI();
      queueSave('s5-saved', { cf2: answers.cf2 });
    });
  });

  const cf2Explanation = document.getElementById('cf2-hw-explanation') as HTMLTextAreaElement | null;
  cf2Explanation?.addEventListener('input', () => {
    answers.cf2.explanation = cf2Explanation.value;
    if (answers.cf2_saved) updateSummaryCardUI();
    queueSave('s5-saved', { cf2: answers.cf2 });
  });

  const sentenceYacine = document.getElementById('cf2-sentence-yacine') as HTMLTextAreaElement | null;
  const reasonCareful = document.getElementById('cf2-reason-careful') as HTMLTextAreaElement | null;
  const summaryCard = document.getElementById('cf2-summary-card');
  const summaryHwCheck = document.getElementById('summary-hw-check');
  const summarySentence = document.getElementById('summary-sentence-yacine');
  const summaryReason = document.getElementById('summary-reason-careful');

  function updateSummaryCardUI() {
    if (summaryHwCheck) {
      const label = choiceLabels[answers.cf2.choice] || 'Yes';
      const exp = answers.cf2.explanation.trim();
      summaryHwCheck.textContent = exp ? `${label} — ${exp}` : label;
    }
    if (summarySentence) {
      summarySentence.textContent = answers.cf2.sentenceYacine.trim()
        ? `“${answers.cf2.sentenceYacine.trim()}”`
        : '—';
    }
    if (summaryReason) {
      summaryReason.textContent = answers.cf2.reasonCareful.trim() || '—';
    }
    summaryCard?.classList.toggle('hidden', !answers.cf2_saved);
  }

  sentenceYacine?.addEventListener('input', () => {
    answers.cf2.sentenceYacine = sentenceYacine.value;
    if (answers.cf2_saved) updateSummaryCardUI();
    queueSave('s5-saved', { cf2: answers.cf2 });
  });

  reasonCareful?.addEventListener('input', () => {
    answers.cf2.reasonCareful = reasonCareful.value;
    if (answers.cf2_saved) updateSummaryCardUI();
    queueSave('s5-saved', { cf2: answers.cf2 });
  });

  document.getElementById('save-cf2-btn')?.addEventListener('click', async () => {
    answers.cf2_saved = true;
    updateSummaryCardUI();
    await flushSave('s5-saved', { cf2: answers.cf2, cf2_saved: true });
    summaryCard?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });

  document.getElementById('print-case-btn')?.addEventListener('click', () => {
    window.print();
  });

  // ---- Populate All Inputs From Supabase Answers ----
  function hydrateInputsFromAnswers() {
    if (hwQ1) hwQ1.value = answers.hw_q1 || '';
    if (hwQ2) hwQ2.value = answers.hw_q2 || '';

    document.querySelectorAll<HTMLInputElement>('.page-part-input').forEach((input) => {
      const part = input.dataset.part;
      if (part && answers.pages[part]) input.value = String(answers.pages[part]);
    });
    if (Object.keys(answers.pages).length > 0) checkPages(false);

    Object.entries(trickInputs).forEach(([key, input]) => {
      if (input) input.value = answers.trick[key as keyof typeof answers.trick] || '';
    });

    ['yellow-1', 'yellow-2', 'yellow-3'].forEach((id, idx) => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (el) el.value = answers.yellow[idx] || '';
    });
    ['blue-1', 'blue-2'].forEach((id, idx) => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      if (el) el.value = answers.blue[idx] || '';
    });

    renderJar();
    renderSortable();
    updatePredictionUI();

    if (resultsRealText) resultsRealText.value = answers.results_real_text || '';
    if (resultsBonusText) resultsBonusText.value = answers.results_bonus_text || '';

    sparkSession2.readingCardBoxes.forEach((box) => {
      const el = document.getElementById(`card-${box.id}`) as HTMLTextAreaElement | null;
      if (el && answers.reading_card[box.id] !== undefined) {
        el.value = answers.reading_card[box.id];
      }
    });
    updateCardStatusUI();

    document.querySelectorAll<HTMLButtonElement>('.hw-ans-choice').forEach((b) => {
      b.classList.toggle('chosen', (b.dataset.choice || 'yes') === answers.cf2.choice);
    });
    if (cf2Explanation) cf2Explanation.value = answers.cf2.explanation || '';
    if (sentenceYacine) sentenceYacine.value = answers.cf2.sentenceYacine || '';
    if (reasonCareful) reasonCareful.value = answers.cf2.reasonCareful || '';
    updateSummaryCardUI();
  }

  // ---- Boot Session 2 Live ----
  async function boot() {
    try {
      const payload = await getSession2State(teamCode);
      if (teamCode && (!payload || !payload.team)) {
        // Stored team code was wiped/reset
        clearTeamCode();
        teamCode = null;
        const guestPayload = await getSession2State(null);
        renderTeamBanner(null);
        hydrateInputsFromAnswers();
        if (guestPayload) await applyRoomState(guestPayload.state, guestPayload.revealed_keys);
      } else if (payload) {
        renderTeamBanner(payload.team);
        if (payload.answers) {
          answers = {
            ...structuredClone(defaultAnswers),
            ...payload.answers,
            pages: { ...(payload.answers.pages || {}) },
            trick: { ...defaultAnswers.trick, ...(payload.answers.trick || {}) },
            yellow: Array.isArray(payload.answers.yellow) ? [...payload.answers.yellow, '', '', ''].slice(0, 3) : ['', '', ''],
            blue: Array.isArray(payload.answers.blue) ? [...payload.answers.blue, '', ''].slice(0, 2) : ['', ''],
            jar_words: Array.isArray(payload.answers.jar_words) ? [...payload.answers.jar_words] : [],
            prediction: Array.isArray(payload.answers.prediction) && payload.answers.prediction.length === 4
              ? [...payload.answers.prediction]
              : [...defaultAnswers.prediction],
            reading_card: { ...defaultAnswers.reading_card, ...(payload.answers.reading_card || {}) },
            cf2: { ...defaultAnswers.cf2, ...(payload.answers.cf2 || {}) },
          };
        }
        hydrateInputsFromAnswers();
        await applyRoomState(payload.state, payload.revealed_keys);
      }
    } catch (err) {
      console.error('Session 2 live boot warning:', err);
      renderTeamBanner(null);
      hydrateInputsFromAnswers();
      renderLocks();
    }

    // Watch live room step unlocks & per-step Mentor Reveals via Supabase Realtime
    watchSession2State((s) => {
      applyRoomState(s);
    });

    // Poll Reading Card approval live every 4s while team is pending or on Step 4
    setInterval(async () => {
      if (!teamCode || answers.card_status === 'approved') return;
      if (answers.card_status !== 'pending' && activePanel !== 4) return;
      try {
        const fresh = await getSession2State(teamCode);
        if (fresh?.answers && fresh.answers.card_status === 'approved') {
          answers.card_status = 'approved';
          answers.card_approved_by = fresh.answers.card_approved_by ?? null;
          answers.card_mentor_comment = fresh.answers.card_mentor_comment ?? null;
          updateCardStatusUI();
        }
      } catch {
        /* ignore transient hiccup */
      }
    }, 4000);
  }

  boot();
</script>
