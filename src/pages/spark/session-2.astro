  const jarContainer = document.getElementById('jar-words-list');
  function renderJar() {
    if (!jarContainer) return;
    jarContainer.innerHTML = '';
    if (!answers.jar_words.length) {
      const empty = document.createElement('p');
      empty.className = 'text-[12px] text-pink-800/70 italic';
      empty.textContent = 'No pink words added yet — type any unfamiliar term from the paper above.';
      jarContainer.appendChild(empty);
      return;
    }

    answers.jar_words.forEach((word, idx) => {
      const pill = document.createElement('span');
      pill.className =
        'inline-flex items-center gap-1.5 px-3 py-1 bg-white border border-pink-200 text-pink-900 rounded-full text-[12px] font-medium shadow-2xs';
      const labelSpan = document.createElement('span');
      labelSpan.textContent = `🩷 ${word}`;
      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'text-pink-400 hover:text-pink-700 ml-1 font-bold text-[14px] leading-none';
      removeBtn.textContent = '×';
      removeBtn.addEventListener('click', () => {
        answers.jar_words.splice(idx, 1);
        renderJar();
        queueSave('s2-saved', { jar_words: answers.jar_words }, true);
      });
      pill.appendChild(labelSpan);
      pill.appendChild(removeBtn);
      jarContainer.appendChild(pill);
    });
  }

  const pinkInput = document.getElementById('new-pink-word') as HTMLInputElement | null;
  function addPinkWord() {
    if (!pinkInput) return;
    const w = pinkInput.value.trim();
    if (w && !answers.jar_words.some((existing) => existing.toLowerCase() === w.toLowerCase())) {
      answers.jar_words.push(w);
      pinkInput.value = '';
      renderJar();
      queueSave('s2-saved', { jar_words: answers.jar_words }, true);
    }
  }
  document.getElementById('add-pink-btn')?.addEventListener('click', addPinkWord);
