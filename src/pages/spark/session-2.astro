    font-size: 13px;
    font-weight: 600;
    min-height: 1.2em;
  }
  .save-status.status-saving {
    color: #8A94A8;
    font-weight: 400;
  }
  .save-status.status-saved {
    color: #3F66B0;
  }
  .save-status.status-error {
    color: #C2463A;
  }

  /* Team banner state architecture */
  #team-banner.is-connected #banner-connect-panel {
    display: none !important;
  }
  #team-banner.is-connected #btn-switch-team {
    display: inline-flex !important;
  }
  #team-banner:not(.is-connected) #btn-switch-team {
    display: none !important;
  }
  #team-banner.is-connected #banner-icon-box {
