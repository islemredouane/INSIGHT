---
// SPARK · The Music Case (Part 2) — Session 2 Game (Steps 0-5).
// Open the key paper · Perham & Currie (2014) · Evidence-based reading & prediction.
// No red ✗, no blocking states, responsive and designed to the INSIGHT design system.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sparkSession2 } from '../../data/spark';

const steps = [
  '00 · Yacine & Homework',
  '01 · Map the Paper',
  '02 · Highlighter Hunt',
  '03 · Predict & Check',
  '04 · Reading Card',
  '05 · Case File #2',
];
---
<BaseLayout
  title="The Music Case (Part 2) · SPARK"
  description="SPARK 2026 Session 2: The Music Case. Deep reading, empirical predictions, highlighter hunt, and Case File #2."
  noindex
>
  <!-- Top Bar -->
  <section class="bg-ink text-white pt-24 xl:pt-32 pb-8 border-b border-white/10">
    <div class="max-w-[1100px] mx-auto px-5 flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="eyebrow text-peri">SPARK 2026 · Session 2</p>
        <div class="flex items-center gap-3 mt-1">
          <h1 id="team-label" class="font-display text-xl sm:text-2xl font-bold">The Music Case · Part 2</h1>
          <span id="team-badge" class="px-2.5 py-0.5 text-[11px] font-mono font-semibold uppercase tracking-wider rounded bg-blue/20 text-peri border border-blue/40">
            Team Loading…
          </span>
        </div>
      </div>
      <div class="flex items-center gap-3 text-[13px]">
        <!-- Mentor Reveal Controls (Password-Protected) -->
        <div class="relative">
          <button
            type="button"
            id="mentor-controls-toggle"
            aria-expanded="false"
            aria-controls="mentor-controls-menu"
            class="px-2.5 py-1 text-[11px] font-mono font-semibold rounded bg-white/10 hover:bg-white/20 text-silver transition flex items-center gap-1.5 border border-white/15"
          >
            <span>👑 Mentor Reveal:</span>
            <span id="unlocked-step-indicator" class="text-peri">Step 0/5</span>
          </button>
          <div
            id="mentor-controls-menu"
            class="hidden absolute right-0 mt-2 w-72 max-w-[calc(100vw-2rem)] bg-white text-ink border border-navy/10 rounded-xl shadow-2xl p-4 z-30 space-y-3 text-left"
          >
            <!-- Mentor Auth Gate (visible when not logged in as mentor) -->
            <form id="mentor-inline-login" class="space-y-2.5">
              <div class="flex items-center justify-between">
                <p class="font-mono text-[10px] uppercase text-blue font-bold tracking-wider">👑 Mentor Only</p>
                <span class="text-[10px] font-mono text-muted">Password required</span>
              </div>
              <p class="text-[12px] text-body leading-snug">
                Sign in with the SPARK mentor password to unlock steps and reveal answer keys after teams finish.
              </p>
              <input
                id="mentor-inline-password"
                type="password"
                class="field !mt-0 !h-9 !py-1 !text-[13px]"
                placeholder="Mentor password…"
                autocomplete="current-password"
                required
              />
              <p id="mentor-inline-error" class="hidden text-[12px] text-signal font-medium"></p>
              <button type="submit" id="mentor-inline-submit" class="btn btn-sm btn-primary w-full justify-center">
                Unlock Mentor Controls
              </button>
            </form>

            <!-- Mentor Controls (visible ONLY once authenticated as mentor) -->
            <div id="mentor-controls-authed" class="hidden space-y-3">
              <div class="flex items-center justify-between pb-2 border-b border-navy/10">
                <span id="mentor-authed-badge" class="font-mono text-[10px] uppercase text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded font-semibold">
                  ✓ Mentor Active
                </span>
                <button type="button" id="btn-mentor-logout" class="text-[11px] text-muted hover:text-ink underline">
                  Lock controls
                </button>
              </div>

              <!-- Step Locks -->
              <div class="space-y-1.5">
                <p class="font-mono text-[10px] uppercase text-muted tracking-wider">1. Room Step Access</p>
                <button type="button" id="btn-reveal-next" class="btn btn-sm btn-primary w-full text-left justify-start">
                  🔓 Unlock Next Step
                </button>
                <div class="grid grid-cols-2 gap-1.5">
                  <button type="button" id="btn-reveal-all" class="btn btn-sm btn-secondary w-full justify-center btn-on-light !px-2 !text-[11px]">
                    ⚡ Unlock All
                  </button>
                  <button type="button" id="btn-lock-all" class="btn btn-sm btn-secondary w-full justify-center text-signal border-signal/20 hover:bg-signal/5 !px-2 !text-[11px]">
                    🔒 Reset (0)
                  </button>
                </div>
              </div>

              <!-- Answer Key & Examples Reveals -->
              <div class="pt-2 border-t border-navy/10 space-y-2">
                <div class="flex items-center justify-between">
                  <p class="font-mono text-[10px] uppercase text-muted tracking-wider">2. Reveal Examples / Keys</p>
                  <button type="button" id="btn-reveal-current-answers" class="text-[11px] font-semibold text-blue hover:underline">
                    Reveal current
                  </button>
                </div>
                <div class="space-y-1 text-[12px]">
                  {[
                    { step: 0, label: 'Step 0 · Sample HW Ideas' },
                    { step: 1, label: 'Step 1 · Map & 4-Part Trick' },
                    { step: 2, label: 'Step 2 · Facts & Word Jar' },
                    { step: 3, label: 'Step 3 · Real Results & Table 1' },
                    { step: 4, label: 'Step 4 · Reading Card & Approve' },
                    { step: 5, label: 'Step 5 · Case File #2 & Bonus' },
                  ].map((item) => (
                    <label class="flex items-center justify-between gap-2 px-2 py-1.5 rounded hover:bg-paper cursor-pointer">
                      <span class="text-ink font-medium">{item.label}</span>
                      <input
                        type="checkbox"
                        class="mentor-reveal-toggle accent-blue w-4 h-4 cursor-pointer"
                        data-reveal-step={item.step}
                      />
                    </label>
                  ))}
                </div>
                <div class="grid grid-cols-2 gap-1.5 pt-1">
                  <button type="button" id="btn-reveal-all-answers" class="btn btn-sm btn-secondary btn-on-light w-full justify-center !px-2 !text-[11px]">
                    👁️ Reveal All
                  </button>
                  <button type="button" id="btn-hide-all-answers" class="btn btn-sm btn-secondary btn-on-light w-full justify-center !px-2 !text-[11px]">
                    🙈 Hide All
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <span class="text-white/20">|</span>
        <a href="/spark/case" class="text-silver/70 hover:text-white transition-colors flex items-center gap-1.5">
          <span>← Session 1</span>
        </a>
        <span class="text-white/20">|</span>
        <a href="/spark/join?next=/spark/session-2" id="switch-link" class="text-silver/70 hover:text-white transition-colors">
          Switch team
        </a>
      </div>
    </div>
  </section>

  <!-- Sticky Progress Bar with Lock indicators -->
  <nav id="progress" class="sticky top-[72px] xl:top-[116px] z-20 bg-white border-b border-navy/10 overflow-x-auto shadow-sm" aria-label="Session 2 progress">
    <div class="max-w-[1100px] mx-auto px-5 flex gap-1 py-3 min-w-max">
      {steps.map((label, i) => (
        <button type="button" class="step-tab" data-step={i}>
          <span class="step-num">{i}</span>
          <span class="step-label">{label}</span>
          <span class="step-lock-icon text-[11px] ml-1 hidden">🔒</span>
        </button>
      ))}
    </div>
  </nav>

  <!-- Main Game Panels Container -->
  <main id="game" class="bg-paper text-ink py-10 sm:py-14 min-h-[70vh]">
    <div class="max-w-[760px] mx-auto px-5">

      <!-- Team Check-In & Identity Banner -->
      <div id="team-banner" class="mb-8 bg-white border border-navy/10 rounded-xl shadow-sm overflow-hidden transition-all">
        <!-- Top Bar: Identity & Status -->
        <div class="p-5 sm:p-6 flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-3.5 min-w-0">
            <div id="banner-icon-box" class="w-10 h-10 rounded-lg bg-blue/10 text-blue flex items-center justify-center shrink-0 text-lg transition-colors">
              👥
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <h3 id="banner-team-name" class="font-display font-bold text-ink text-base sm:text-lg">
                  Working with a team?
                </h3>
                <span id="banner-status-badge" class="px-2.5 py-0.5 text-[11px] font-mono rounded bg-paper text-muted border border-navy/10 font-medium">
                  Explorer Mode
                </span>
              </div>
              <p id="banner-team-members" class="text-[13px] text-body mt-0.5">
                Have a team code from Session 1? Enter it below. New to SPARK? Register a team in 1 minute!
              </p>
            </div>
          </div>

          <!-- Switch team button (Visible ONLY when connected) -->
          <button
            type="button"
            id="btn-switch-team"
            class="text-[12px] font-mono font-medium px-3 py-1.5 rounded-lg border border-navy/15 text-muted hover:text-ink hover:border-navy/30 bg-paper/50 hover:bg-paper transition-all shrink-0 items-center gap-1.5"
          >
            <span class="text-sm">⇄</span> Switch Team
          </button>
        </div>

        <!-- Bottom Bar: Connection Controls (Visible ONLY in guest mode) -->
        <div id="banner-connect-panel" class="p-4 sm:px-6 bg-paper/50 border-t border-navy/5 flex flex-wrap items-center justify-between gap-4">
          <div class="flex flex-wrap items-center gap-2.5 w-full sm:w-auto">
            <label for="inline-team-code" class="text-[12px] font-mono text-muted uppercase tracking-wider shrink-0 font-medium">
              Team Code:
            </label>
            <div class="flex items-center gap-2 w-full sm:w-auto">
              <input
                id="inline-team-code"
                type="text"
                class="field !mt-0 !h-9 !w-32 uppercase text-center font-mono tracking-widest text-[14px] !py-0"
                maxlength="6"
                placeholder="K7P2QX"
              />
              <button type="button" id="inline-connect-btn" class="btn btn-sm btn-primary !h-9 !px-4 shrink-0">
                Connect
              </button>
            </div>
          </div>

          <div class="flex items-center gap-2.5 w-full sm:w-auto justify-between sm:justify-end pt-2 sm:pt-0 border-t sm:border-t-0 border-navy/10">
            <span class="text-[13px] text-muted">New to SPARK?</span>
            <a
              href="/spark/join?next=/spark/session-2"
              id="inline-register-btn"
              class="btn btn-sm btn-secondary btn-on-light !h-9 !px-3.5 !text-[13px] inline-flex items-center gap-1.5 shrink-0 bg-white hover:bg-blue hover:!text-white transition shadow-2xs font-semibold"
            >
              <span>Register Team</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <!-- Feedback / Errors -->
        <div id="banner-feedback" class="hidden px-5 sm:px-6 py-2.5 text-[13px] border-t border-navy/5"></div>
      </div>

      <!-- =========================================================================
           STEP 0 · BACK TO YACINE (3 min)
           ========================================================================= -->
      <section data-panel="0" class="panel">
        <div class="flex items-center justify-between gap-3">
          <div>
            <span class="font-mono text-[12px] uppercase text-blue font-bold tracking-wider">Step 0 · 3 Minutes</span>
            <h2 class="font-display text-3xl font-bold tracking-tight mt-1 text-ink">Back to Yacine</h2>
          </div>
          <span class="px-3 py-1 bg-blue/10 text-blue font-mono text-[12px] font-semibold rounded">Skill: Read with a question</span>
        </div>

        <!-- Mentor Cue Banner -->
        <div class="mt-6 p-4 sm:p-5 bg-ink text-white rounded-lg flex items-start gap-3.5 border border-white/10">
          <span class="text-2xl leading-none">🗣️</span>
          <div>
            <p class="font-mono text-[11px] uppercase tracking-wider text-peri">Mentor briefing</p>
            <p class="mt-1 text-[15px] text-white/95 leading-relaxed font-serif italic">
              “{sparkSession2.mentorCue}”
            </p>
          </div>
        </div>

        <!-- Story Recap -->
        <div class="mt-6 bg-white border border-navy/10 p-6 sm:p-8 rounded-lg shadow-sm">
          <h3 class="font-display text-lg font-bold text-ink">The Case So Far</h3>
          <div class="mt-3 text-[15px] leading-relaxed text-body space-y-3">
            <p>
              <strong>Yacine</strong> is a first-year student. Every evening, he studies with his headphones on and his favourite songs playing.
              <em>“Music helps me focus,”</em> he says.
            </p>
            <p>
              His sister doesn’t agree: <em>“Your grades went down since you started doing that. The music is distracting you.”</em>
            </p>
            <p>
              In Session 1, your team followed the research trail and discovered the landmark study:
              <strong>Perham & Currie (2014)</strong>. Today, you open the paper and uncover what science actually found.
            </p>
          </div>
        </div>

        <!-- Team's 2 Homework Questions -->
        <div class="mt-6 bg-white border border-navy/10 p-6 sm:p-8 rounded-lg shadow-sm">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <div>
              <h3 class="font-display text-lg font-bold text-ink">Our Team’s 2 Homework Questions</h3>
              <p class="text-[13px] text-muted mt-0.5">From your Case File #1 homework, or add them now.</p>
            </div>
            <span class="text-[12px] text-blue font-mono font-medium">Case File #1</span>
          </div>

          <div class="mt-4 space-y-3">
            <div>
              <label for="hw-q1" class="field-label">Question 1</label>
              <input
                id="hw-q1"
                class="field mt-1"
                maxlength="200"
                placeholder="Write your team's first question for the paper…"
              />
            </div>
            <div>
              <label for="hw-q2" class="field-label">Question 2</label>
              <input
                id="hw-q2"
                class="field mt-1"
                maxlength="200"
                placeholder="Write your team's second question for the paper…"
              />
            </div>
          </div>

          <!-- Mentor Reveal: Sample Homework Ideas (Hidden until mentor reveals Step 0) -->
          <div class="mt-4 pt-4 border-t border-navy/10">
            <div data-mentor-locked="0" class="flex items-center gap-2 text-[12px] text-muted bg-paper/70 border border-dashed border-navy/15 rounded-md px-3.5 py-2.5">
              <span>🔒</span>
              <span>Write your own 2 questions first. Sample question ideas can be unlocked by your mentor if needed.</span>
            </div>
            <div id="mentor-reveal-0" data-mentor-reveal="0" class="hidden p-4 bg-blue/5 border border-blue/25 rounded-lg"></div>
          </div>
        </div>

        <!-- Resource Launch Card -->
        <div class="mt-6 p-6 bg-gradient-to-r from-navy/5 via-blue/5 to-transparent border border-navy/10 rounded-lg">
          <h4 class="font-display font-bold text-ink">Get Your Paper Ready</h4>
          <p class="text-[14px] text-body mt-1">Open the paper in a new tab so your team can highlight and read along:</p>
          <div class="mt-4 flex flex-wrap gap-3">
            <a
              href={sparkSession2.paper.pdfPath}
              target="_blank"
              rel="noopener"
              class="btn btn-primary"
            >
              📄 Open Student Copy (PDF) ↗
            </a>
            <a
              href={sparkSession2.paper.doiLink}
              target="_blank"
              rel="noopener"
              class="btn btn-secondary btn-on-light"
            >
              🌐 Official DOI Page ↗
            </a>
          </div>
        </div>

        <!-- Next Action -->
        <div class="mt-8 flex justify-between items-center">
          <span id="s0-saved" class="save-status"></span>
          <button type="button" class="btn btn-primary next-panel-btn" data-next="1">
            Pass 1: Map the Paper →
          </button>
        </div>
      </section>

      <!-- =========================================================================
           STEP 1 · PASS 1: MAP THE PAPER (10 min)
           ========================================================================= -->
      <section data-panel="1" class="panel hidden">
        <div class="flex items-center justify-between gap-3">
          <div>
            <span class="font-mono text-[12px] uppercase text-blue font-bold tracking-wider">Step 1 · 10 Minutes</span>
            <h2 class="font-display text-3xl font-bold tracking-tight mt-1 text-ink">Pass 1: Map the Paper</h2>
          </div>
          <span class="px-3 py-1 bg-blue/10 text-blue font-mono text-[12px] font-semibold rounded">Skill: Reading Order & Abstract</span>
        </div>

        <!-- Notice Banner -->
        <div class="mt-6 p-4 bg-amber-50 border border-amber-200 text-amber-900 rounded-lg flex items-start gap-3 text-[14px]">
          <span class="text-amber-600 text-lg">💡</span>
          <div>
            <strong>Notice:</strong> Your PDF student copy starts directly at the Introduction and has no abstract.
            Use the <a href={sparkSession2.paper.doiLink} target="_blank" rel="noopener" class="underline font-semibold text-blue">Official DOI Page ↗</a> to read the abstract for Task B!
          </div>
        </div>

        <!-- Quick Links -->
        <div class="mt-4 flex flex-wrap gap-2">
          <a href={sparkSession2.paper.pdfPath} target="_blank" rel="noopener" class="btn btn-sm btn-secondary btn-on-light">
            📄 Open Student Copy (PDF) ↗
          </a>
          <a href={sparkSession2.paper.doiLink} target="_blank" rel="noopener" class="btn btn-sm btn-secondary btn-on-light">
            🌐 Open DOI Page (Abstract) ↗
          </a>
        </div>

        <!-- Task A: Find the parts -->
        <div class="mt-6 bg-white border border-navy/10 p-6 sm:p-8 rounded-lg shadow-sm">
          <h3 class="font-display text-lg font-bold text-ink">Task A: Find the 5 Parts</h3>
          <p class="text-[14px] text-body mt-1">
            Skim the PDF and type the page number where each major part begins:
          </p>

          <div class="mt-4 space-y-3">
            {sparkSession2.paperParts.map((part) => (
              <div class="p-3.5 border border-navy/10 rounded-md bg-paper/30 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div class="flex-1">
                  <p class="font-semibold text-ink text-[14px]">{part.name}</p>
                  <p class="text-[12px] text-muted leading-tight mt-0.5">{part.description}</p>
                </div>
                <div class="flex items-center gap-2 sm:min-w-[240px] sm:justify-end shrink-0 flex-wrap">
                  <span class="text-[12px] font-mono text-muted">Page #:</span>
                  <input
                    type="number"
                    min="1"
                    max="300"
                    class="field !mt-0 !w-20 !h-10 !py-1 text-center font-mono page-part-input"
                    data-part={part.id}
                    placeholder="—"
                  />
                  <span class="page-feedback text-[12px] font-medium whitespace-nowrap" data-feedback={part.id}></span>
                </div>
              </div>
            ))}
          </div>

          <div class="mt-3 text-right">
            <button type="button" id="check-pages-btn" class="btn btn-sm btn-primary">Check Pages</button>
          </div>
        </div>

        <!-- Task B: The Four-Part Trick -->
        <div class="mt-6 bg-white border border-navy/10 p-6 sm:p-8 rounded-lg shadow-sm">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <div>
              <h3 class="font-display text-lg font-bold text-ink">Task B: The Four-Part Trick</h3>
              <p class="text-[14px] text-body mt-0.5">
                From the abstract (on DOI page) and introduction, complete the 4 criteria:
              </p>
            </div>
            <a href={sparkSession2.paper.doiLink} target="_blank" rel="noopener" class="text-[12px] text-blue underline font-medium">
              Read Abstract on DOI Page ↗
            </a>
          </div>

          <div class="mt-4 border border-navy/10 rounded overflow-hidden divide-y divide-navy/10 bg-white">
            <div class="grid grid-cols-1 sm:grid-cols-[170px_1fr] divide-y sm:divide-y-0 sm:divide-x divide-navy/10">
              <div class="bg-paper/70 p-3.5 text-[13px] font-semibold text-ink flex items-center">
                Who?
              </div>
              <div class="p-2">
                <input
                  id="trick-who"
                  class="field !mt-0 !border-0 focus:!ring-1"
                  maxlength="150"
                  placeholder={sparkSession2.fourPartTrick.who.placeholder}
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-[170px_1fr] divide-y sm:divide-y-0 sm:divide-x divide-navy/10">
              <div class="bg-paper/70 p-3.5 text-[13px] font-semibold text-ink flex items-center">
                What are they testing?
              </div>
              <div class="p-2">
                <input
                  id="trick-what"
                  class="field !mt-0 !border-0 focus:!ring-1"
                  maxlength="150"
                  placeholder={sparkSession2.fourPartTrick.what.placeholder}
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-[170px_1fr] divide-y sm:divide-y-0 sm:divide-x divide-navy/10">
              <div class="bg-paper/70 p-3.5 text-[13px] font-semibold text-ink flex items-center">
                Compared to what?
              </div>
              <div class="p-2">
                <input
                  id="trick-compared"
                  class="field !mt-0 !border-0 focus:!ring-1"
                  maxlength="150"
                  placeholder={sparkSession2.fourPartTrick.comparedTo.placeholder}
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-[170px_1fr] divide-y sm:divide-y-0 sm:divide-x divide-navy/10">
              <div class="bg-paper/70 p-3.5 text-[13px] font-semibold text-ink flex items-center">
                Measured how?
              </div>
              <div class="p-2">
                <input
                  id="trick-measured"
                  class="field !mt-0 !border-0 focus:!ring-1"
                  maxlength="150"
                  placeholder={sparkSession2.fourPartTrick.measuredHow.placeholder}
                />
              </div>
            </div>
          </div>

          <!-- Mentor Reveal: Step 1 Answer Key (Hidden until mentor reveals Step 1) -->
          <div class="mt-5">
            <div data-mentor-locked="1" class="flex items-center gap-2 text-[12px] text-muted bg-paper/70 border border-dashed border-navy/15 rounded-md px-3.5 py-2.5">
              <span>🔒</span>
              <span>Complete Tasks A &amp; B with your team first. Expected answers &amp; page map unlock when your mentor reveals Step 1.</span>
            </div>
            <div id="mentor-reveal-1" data-mentor-reveal="1" class="hidden p-5 bg-blue/5 border border-blue/25 rounded-lg space-y-4 text-[13px]"></div>
          </div>
        </div>

        <!-- Next Action -->
        <div class="mt-8 flex justify-between items-center">
          <button type="button" class="btn btn-secondary btn-on-light prev-panel-btn" data-prev="0">
            ← Back to Step 0
          </button>
          <div class="flex items-center gap-3">
            <span id="s1-saved" class="save-status"></span>
            <button type="button" class="btn btn-primary next-panel-btn" data-next="2">
              Proceed to Highlighter Hunt →
            </button>
          </div>
        </div>
      </section>

      <!-- =========================================================================
           STEP 2 · HIGHLIGHTER HUNT (10 min)
           ========================================================================= -->
      <section data-panel="2" class="panel hidden">
        <div class="flex items-center justify-between gap-3">
          <div>
            <span class="font-mono text-[12px] uppercase text-blue font-bold tracking-wider">Step 2 · 10 Minutes</span>
            <h2 class="font-display text-3xl font-bold tracking-tight mt-1 text-ink">Highlighter Hunt</h2>
          </div>
          <span class="px-3 py-1 bg-blue/10 text-blue font-mono text-[12px] font-semibold rounded">Skill: Method vs Results</span>
        </div>

        <!-- 3 Colors Guide Bar -->
        <div class="mt-6 grid sm:grid-cols-3 gap-3">
          <div class="p-3.5 bg-amber-50 border border-amber-200 rounded-md">
            <span class="font-bold text-amber-900 text-[13px] flex items-center gap-1.5">
              <span>🟡</span> Yellow: Method
            </span>
            <p class="text-[12px] text-amber-800 mt-1 leading-tight">
              What they did: participants, task, sound conditions.
            </p>
          </div>
          <div class="p-3.5 bg-blue/10 border border-blue/30 rounded-md">
            <span class="font-bold text-blue text-[13px] flex items-center gap-1.5">
              <span>🔵</span> Blue: Results
            </span>
            <p class="text-[12px] text-body mt-1 leading-tight">
              What they found: scores, differences, ratings.
            </p>
          </div>
          <div class="p-3.5 bg-pink-50 border border-pink-200 rounded-md">
            <span class="font-bold text-pink-900 text-[13px] flex items-center gap-1.5">
              <span>🩷</span> Pink: Word Jar
            </span>
            <p class="text-[12px] text-pink-800 mt-1 leading-tight">
              Words we don’t understand for the mentor to explain.
            </p>
          </div>
        </div>

        <!-- Yellow Facts (Method) -->
        <div class="mt-6 bg-white border border-navy/10 p-6 sm:p-8 rounded-lg shadow-sm">
          <div class="flex items-center justify-between">
            <h3 class="font-display text-lg font-bold text-ink flex items-center gap-2">
              <span class="w-3.5 h-3.5 rounded-full bg-amber-400 inline-block"></span>
              3 Yellow Facts: What They Did (Method)
            </h3>
            <span class="text-[12px] font-mono text-muted">Own words</span>
          </div>
          <p class="text-[13px] text-muted mt-1">
            Golden rule: Could the researchers know this before running the study? If yes, it's yellow!
          </p>

          <div class="mt-4 space-y-3">
            <div>
              <label for="yellow-1" class="field-label">Yellow Fact 1</label>
              <input id="yellow-1" class="field mt-1" maxlength="250" placeholder="Write a Method fact in your own words (participants, task, or setup)…" />
            </div>
            <div>
              <label for="yellow-2" class="field-label">Yellow Fact 2</label>
              <input id="yellow-2" class="field mt-1" maxlength="250" placeholder="Write a second Method fact in your own words…" />
            </div>
            <div>
              <label for="yellow-3" class="field-label">Yellow Fact 3</label>
              <input id="yellow-3" class="field mt-1" maxlength="250" placeholder="Write a third Method fact in your own words…" />
            </div>
          </div>

          <div id="mentor-reveal-2-yellow" data-mentor-reveal="2" class="hidden mt-4 p-4 bg-amber-50/70 border border-amber-200 rounded-lg text-[13px]"></div>
        </div>

        <!-- Blue Facts (Results) -->
        <div class="mt-6 bg-white border border-navy/10 p-6 sm:p-8 rounded-lg shadow-sm">
          <div class="flex items-center justify-between">
            <h3 class="font-display text-lg font-bold text-ink flex items-center gap-2">
              <span class="w-3.5 h-3.5 rounded-full bg-blue inline-block"></span>
              2 Blue Facts: What They Found (Results)
            </h3>
            <span class="text-[12px] font-mono text-muted">Own words</span>
          </div>
          <p class="text-[13px] text-muted mt-1">
            Golden rule: Could anyone know this before looking at the test sheets? If no, it's blue!
          </p>

          <div class="mt-4 space-y-3">
            <div>
              <label for="blue-1" class="field-label">Blue Fact 1</label>
              <input id="blue-1" class="field mt-1" maxlength="250" placeholder="Write one result the researchers found, in your own words…" />
            </div>
            <div>
              <label for="blue-2" class="field-label">Blue Fact 2</label>
              <input id="blue-2" class="field mt-1" maxlength="250" placeholder="Write a second result they found, in your own words…" />
            </div>
          </div>

          <div id="mentor-reveal-2-blue" data-mentor-reveal="2" class="hidden mt-4 p-4 bg-blue/5 border border-blue/25 rounded-lg text-[13px]"></div>
        </div>

        <!-- Pink Words: The Interactive Word Jar -->
        <div class="mt-6 bg-white border border-navy/10 p-6 sm:p-8 rounded-lg shadow-sm">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <div>
              <h3 class="font-display text-lg font-bold text-ink flex items-center gap-2">
                <span>🏺</span> The Word Jar (Pink Words)
              </h3>
              <p class="text-[13px] text-muted mt-0.5">
                Add any scientific words from the paper you find confusing. Your mentor will explain the most common terms at the end of Step 2!
              </p>
            </div>
            <span class="text-[12px] font-mono text-pink-700 bg-pink-50 border border-pink-200 px-2 py-0.5 rounded">
              Team Word Jar
            </span>
          </div>

          <!-- Add Word to Jar -->
          <div class="mt-4 flex gap-2 items-center">
            <input
              id="new-pink-word"
              class="field !mt-0 !h-11 !py-2"
              maxlength="60"
              placeholder="Type an unfamiliar word you spotted in the paper…"
            />
            <button type="button" id="add-pink-btn" class="btn btn-sm btn-primary shrink-0">
              Add to Jar +
            </button>
          </div>

          <!-- Our Team's Jar Collection -->
          <div class="mt-4 p-4 bg-pink-50/60 border border-pink-200 rounded-lg">
            <p class="text-[12px] font-mono uppercase text-pink-900 tracking-wider font-semibold">
              Our Team's Added Words:
            </p>
            <div id="jar-words-list" class="mt-2 flex flex-wrap gap-2">
              <!-- Dynamically populated by team -->
            </div>
          </div>

          <!-- Locked Banner before Mentor Reveal -->
          <div data-mentor-locked="2" class="mt-5 flex items-center gap-2 text-[12px] text-muted bg-paper/70 border border-dashed border-navy/15 rounded-md px-3.5 py-2.5">
            <span>🔒</span>
            <span>Finish your Yellow facts, Blue facts, and Pink words first. Accepted facts &amp; Word Jar explanations unlock when your mentor reveals Step 2.</span>
          </div>

          <!-- Mentor Reveal: Top 2 Terms + Full Paper Glossary (hydrated from server) -->
          <div id="mentor-reveal-2-jar" data-mentor-reveal="2" class="hidden mt-5 space-y-4"></div>
        </div>

        <!-- Next Action -->
        <div class="mt-8 flex justify-between items-center">
          <button type="button" class="btn btn-secondary btn-on-light prev-panel-btn" data-prev="1">
            ← Back to Step 1
          </button>
          <div class="flex items-center gap-3">
            <span id="s2-saved" class="save-status"></span>
            <button type="button" class="btn btn-primary next-panel-btn" data-next="3">
              Predict, Then Check →
            </button>
          </div>
        </div>
      </section>

      <!-- =========================================================================
           STEP 3 · PREDICT, THEN CHECK (12 min): THE FUN PART
           ========================================================================= -->
      <section data-panel="3" class="panel hidden">
        <div class="flex items-center justify-between gap-3">
          <div>
            <span class="font-mono text-[12px] uppercase text-blue font-bold tracking-wider">Step 3 · 12 Minutes</span>
            <h2 class="font-display text-3xl font-bold tracking-tight mt-1 text-ink">Predict, Then Check</h2>
          </div>
          <span class="px-3 py-1 bg-blue/10 text-blue font-mono text-[12px] font-semibold rounded">The Fun Part!</span>
        </div>

        <!-- Phase 1: Team Prediction -->
        <div id="predict-phase-1" class="mt-6 bg-white border border-navy/10 p-6 sm:p-8 rounded-lg shadow-sm">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <div>
              <h3 class="font-display text-lg font-bold text-ink">1. Rank the 4 Situations</h3>
              <p class="text-[14px] text-body mt-0.5">
                Before reading the results, rank these from <strong>1st (Best for reading)</strong> to <strong>4th (Worst for reading)</strong>.
              </p>
            </div>
            <span class="px-2.5 py-0.5 bg-paper text-[11px] font-mono text-muted border border-navy/10 rounded">
              Use ▲ ▼ to order
            </span>
          </div>

          <!-- Sortable Cards Container -->
          <div id="conditions-sortable" class="mt-5 space-y-3">
            {sparkSession2.conditions.map((c, idx) => (
              <div
                class="condition-card p-4 border border-navy/10 rounded-lg bg-paper/40 flex items-center justify-between gap-3 transition-shadow hover:shadow-sm"
                data-id={c.id}
              >
                <div class="flex items-center gap-3">
                  <span class="rank-badge w-7 h-7 rounded-full bg-ink text-white font-mono font-bold text-[13px] flex items-center justify-center shrink-0">
                    {idx + 1}
                  </span>
                  <span class="text-2xl">{c.icon}</span>
                  <div>
                    <h4 class="font-display font-bold text-ink text-[15px]">{c.title}</h4>
                    <p class="text-[12px] text-muted">{c.shortDesc}</p>
                  </div>
                </div>
                <div class="flex flex-col gap-1 shrink-0">
                  <button type="button" class="rank-up text-xs font-mono px-2 py-1 bg-white border border-navy/10 rounded hover:bg-paper" title="Move Up">
                    ▲
                  </button>
                  <button type="button" class="rank-down text-xs font-mono px-2 py-1 bg-white border border-navy/10 rounded hover:bg-paper" title="Move Down">
                    ▼
                  </button>
                </div>
              </div>
            ))}
          </div>

          <div class="mt-6 flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-navy/10">
            <p class="text-[13px] text-muted italic">
              Once you lock your prediction, you cannot change it!
            </p>
            <button type="button" id="lock-prediction-btn" class="btn btn-primary">
              🔒 Lock Our Prediction
            </button>
          </div>
        </div>

        <!-- Phase 2: Read Results Input (Shown after lock) -->
        <div id="predict-phase-2" class="hidden mt-6 bg-white border border-navy/10 p-6 sm:p-8 rounded-lg shadow-sm space-y-5">
          <div class="p-3 bg-emerald-50 border border-emerald-200 text-emerald-900 rounded-md text-[13px] flex items-center gap-2">
            <span>🔒</span>
            <span class="font-semibold">Prediction Locked!</span>
            <span>Now open Results (page 3 in easy copy / page 8 in full copy) to check what really happened.</span>
          </div>

          <div>
            <label for="results-real-text" class="field-label">What did the paper really find?</label>
            <textarea
              id="results-real-text"
              class="field mt-1"
              rows="3"
              placeholder="In your own words: which conditions did best, which did worst, and did liking the song make any difference?"
            ></textarea>
          </div>

          <div>
            <label for="results-bonus-text" class="field-label">Bonus for fast teams: Did students know which condition hurt them?</label>
            <p class="text-[12px] text-muted mt-0.5">Check Table 1 (Students’ ratings out of 100) at the end of the paper.</p>
            <textarea
              id="results-bonus-text"
              class="field mt-1.5"
              rows="2"
              placeholder="Write your team's answer based on Table 1…"
            ></textarea>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
            <a href={sparkSession2.paper.pdfPath} target="_blank" rel="noopener" class="text-[13px] text-blue underline font-medium">
              📄 Check Results on Page 3 / Page 8 ↗
            </a>
            <div class="flex items-center gap-3">
              <span id="s3-findings-status" class="text-[12px] font-medium text-emerald-700"></span>
              <button type="button" id="save-results-btn" class="btn btn-primary">
                Save Our Findings ✓
              </button>
            </div>
          </div>

          <!-- Locked Banner before Mentor Reveal -->
          <div data-mentor-locked="3" class="flex items-center gap-2 text-[12px] text-muted bg-paper/70 border border-dashed border-navy/15 rounded-md px-3.5 py-2.5">
            <span>🔒</span>
            <span>Official results comparison, explanation &amp; Table 1 unlock once teams finish and your mentor reveals Step 3.</span>
          </div>
        </div>

        <!-- Phase 3: Side-by-side Empirical Comparison (Server-hydrated on Mentor Reveal · Step 3) -->
        <div id="predict-phase-3" data-mentor-reveal="3" class="hidden mt-6 space-y-6"></div>

        <!-- Next Action -->
        <div class="mt-8 flex justify-between items-center">
          <button type="button" class="btn btn-secondary btn-on-light prev-panel-btn" data-prev="2">
            ← Back to Step 2
          </button>
          <div class="flex items-center gap-3">
            <span id="s3-saved" class="save-status"></span>
            <button type="button" class="btn btn-primary next-panel-btn" data-next="4">
              Proceed to Reading Card →
            </button>
          </div>
        </div>
      </section>

      <!-- =========================================================================
           STEP 4 · THE READING CARD (12 min)
           ========================================================================= -->
      <section data-panel="4" class="panel hidden">
        <div class="flex items-center justify-between gap-3">
          <div>
            <span class="font-mono text-[12px] uppercase text-blue font-bold tracking-wider">Step 4 · 12 Minutes</span>
            <h2 class="font-display text-3xl font-bold tracking-tight mt-1 text-ink">The Reading Card</h2>
          </div>
          <span class="px-3 py-1 bg-blue/10 text-blue font-mono text-[12px] font-semibold rounded">Skill: Scientific Synthesis</span>
        </div>

        <p class="mt-4 text-[14px] text-body leading-relaxed">
          Synthesize <strong>Perham &amp; Currie (2014)</strong> across the 8 standard boxes. Use your own words — do not copy sentences directly from the paper:
        </p>

        <!-- 8 Boxes Form -->
        <div class="mt-6 bg-white border border-navy/10 p-6 sm:p-8 rounded-lg shadow-sm space-y-5">
          {sparkSession2.readingCardBoxes.map((box) => (
            <div>
              <div class="flex items-center justify-between gap-2 flex-wrap">
                <label for={`card-${box.id}`} class="field-label">{box.title}</label>
                <span class="text-[11px] text-muted font-mono">{box.prompt}</span>
              </div>
              {box.id === 'reference' ? (
                <textarea
                  id={`card-${box.id}`}
                  class="field mt-1.5 font-serif text-[13px]"
                  rows="2"
                  placeholder={box.placeholder}
                >{box.defaultValue}</textarea>
              ) : (
                <textarea
                  id={`card-${box.id}`}
                  class="field mt-1.5"
                  rows={box.id === 'what_done' || box.id === 'explanation' || box.id === 'limits' ? 3 : 2}
                  placeholder={box.placeholder}
                ></textarea>
              )}
            </div>
          ))}

          <div class="pt-4 border-t border-navy/10 flex flex-wrap items-center justify-between gap-4">
            <button type="button" id="send-card-mentor-btn" class="btn btn-primary">
              Send Reading Card to Mentor
            </button>
            <span id="s4-card-status" class="text-[13px] text-muted">Fill the 8 boxes, then send to your mentor</span>
          </div>

          <!-- Waiting Banner (Shown after student submits, before mentor reveals/approves Step 4) -->
          <div id="card-mentor-waiting" class="hidden mt-4 p-4 bg-amber-50 border border-amber-200 rounded-lg text-amber-900 flex items-start gap-3">
            <span class="text-xl leading-none">⏳</span>
            <div>
              <p class="font-bold text-amber-900 text-[14px]">Sent to Mentor — Waiting for Review</p>
              <p class="text-[13px] text-amber-800 mt-0.5 leading-relaxed">
                Call your mentor over (or wait for room debrief). Your mentor will approve your card with a green ✓ and reveal the official example Reading Card.
              </p>
            </div>
          </div>

          <!-- Locked Banner before Mentor Reveal -->
          <div data-mentor-locked="4" class="mt-4 flex items-center gap-2 text-[12px] text-muted bg-paper/70 border border-dashed border-navy/15 rounded-md px-3.5 py-2.5">
            <span>🔒</span>
            <span>Example Reading Card &amp; Mentor approval unlock after your team submits and your mentor reveals Step 4.</span>
          </div>

          <!-- Mentor Reveal: Approved Banner + Official Example Reading Card (Server-hydrated) -->
          <div id="mentor-reveal-4" data-mentor-reveal="4" class="hidden mt-4 space-y-4"></div>
        </div>

        <!-- Next Action -->
        <div class="mt-8 flex justify-between items-center">
          <button type="button" class="btn btn-secondary btn-on-light prev-panel-btn" data-prev="3">
            ← Back to Step 3
          </button>
          <div class="flex items-center gap-3">
            <span id="s4-saved" class="save-status"></span>
            <button type="button" class="btn btn-primary next-panel-btn" data-next="5">
              Proceed to Case File #2 →
            </button>
          </div>
        </div>
      </section>

      <!-- =========================================================================
           STEP 5 · CASE FILE #2 (8 min)
           ========================================================================= -->
      <section data-panel="5" class="panel hidden">
        <div class="flex items-center justify-between gap-3">
          <div>
            <span class="font-mono text-[12px] uppercase text-blue font-bold tracking-wider">Step 5 · 8 Minutes</span>
            <h2 class="font-display text-3xl font-bold tracking-tight mt-1 text-ink">Case File #2: Closing the Case</h2>
          </div>
          <span class="px-3 py-1 bg-blue/10 text-blue font-mono text-[12px] font-semibold rounded">Skill: Critical Reading</span>
        </div>

        <!-- 3 Closing Questions -->
        <div class="mt-6 bg-white border border-navy/10 p-6 sm:p-8 rounded-lg shadow-sm space-y-6">

          <!-- Q1: Did paper answer homework? -->
          <div>
            <label class="field-label">1. Our homework questions: Did the paper answer them?</label>
            <div class="mt-2 flex gap-3">
              <button type="button" class="hw-ans-choice choice-btn" data-choice="yes">Yes</button>
              <button type="button" class="hw-ans-choice choice-btn" data-choice="partly">Partly</button>
              <button type="button" class="hw-ans-choice choice-btn" data-choice="no">No</button>
            </div>
            <textarea
              id="cf2-hw-explanation"
              class="field mt-3"
              rows="2"
              placeholder={sparkSession2.caseFile2Questions.homeworkCheck.explanationPlaceholder}
            ></textarea>
          </div>

          <!-- Q2: One sentence for Yacine -->
          <div>
            <label for="cf2-sentence-yacine" class="field-label">2. What would you tell Yacine now? (One sentence)</label>
            <p class="text-[12px] text-muted mt-0.5">{sparkSession2.caseFile2Questions.sentenceForYacine.tip}</p>
            <textarea
              id="cf2-sentence-yacine"
              class="field mt-2"
              rows="2"
              placeholder={sparkSession2.caseFile2Questions.sentenceForYacine.placeholder}
            ></textarea>
          </div>

          <!-- Q3: One reason to be careful -->
          <div>
            <label for="cf2-reason-careful" class="field-label">3. One reason to be careful before applying this everywhere:</label>
            <p class="text-[12px] text-muted mt-0.5">Think about sample size, test setting, type of music, or what wasn't tested.</p>
            <textarea
              id="cf2-reason-careful"
              class="field mt-2"
              rows="2"
              placeholder={sparkSession2.caseFile2Questions.reasonToBeCareful.placeholder}
            ></textarea>
          </div>

          <div class="flex items-center justify-between pt-4 border-t border-navy/10">
            <button type="button" id="save-cf2-btn" class="btn btn-primary">
              Save Case File #2
            </button>
            <span id="s5-saved" class="save-status"></span>
          </div>

          <!-- Locked Banner before Mentor Reveal -->
          <div data-mentor-locked="5" class="flex items-center gap-2 text-[12px] text-muted bg-paper/70 border border-dashed border-navy/15 rounded-md px-3.5 py-2.5">
            <span>🔒</span>
            <span>Finish and save Case File #2 first. Model answers, accepted limits &amp; the Bonus Detective Challenge unlock when your mentor reveals Step 5.</span>
          </div>
        </div>

        <!-- Mentor Reveal: Step 5 Answer Key & Bonus Challenge (Server-hydrated) -->
        <div id="mentor-reveal-5" data-mentor-reveal="5" class="hidden mt-6 bg-white border border-blue/30 p-6 sm:p-8 rounded-lg shadow-sm space-y-6 text-[13px]"></div>

        <!-- Official Case Dossier Summary (Shown ONLY after team saves their own Case File #2) -->
        <div id="cf2-summary-card" class="hidden mt-8 bg-ink text-white p-6 sm:p-8 rounded-xl border border-white/15 relative overflow-hidden shadow-xl">
          <div class="flex items-center justify-between border-b border-white/15 pb-4">
            <div>
              <p class="font-mono text-[11px] uppercase tracking-wider text-peri">SPARK 2026 · Official Investigation Record</p>
              <h3 class="font-display text-2xl font-bold mt-1">Case File #2: The Music Case Closed</h3>
            </div>
            <span class="px-3 py-1 bg-emerald-500/20 text-emerald-300 font-mono text-[12px] font-bold rounded border border-emerald-500/40">
              ✓ SAVED
            </span>
          </div>

          <div class="mt-6 space-y-4 text-[14px]">
            <div>
              <span class="text-peri font-mono text-[11px] uppercase">The Key Paper</span>
              <p class="font-serif italic text-white/95 mt-0.5">{sparkSession2.paper.citation}</p>
            </div>

            <div>
              <span class="text-peri font-mono text-[11px] uppercase">Did It Answer Our Homework Questions?</span>
              <p id="summary-hw-check" class="text-silver mt-0.5">—</p>
            </div>

            <div>
              <span class="text-peri font-mono text-[11px] uppercase">Our Verdict for Yacine</span>
              <p id="summary-sentence-yacine" class="text-white font-medium mt-0.5 italic">—</p>
            </div>

            <div>
              <span class="text-peri font-mono text-[11px] uppercase">Our Reason to Be Careful</span>
              <p id="summary-reason-careful" class="text-silver mt-0.5">—</p>
            </div>
          </div>

          <div class="mt-8 pt-4 border-t border-white/15 flex flex-wrap gap-4 items-center justify-between print:hidden">
            <button type="button" id="print-case-btn" class="btn btn-sm btn-secondary">
              🖨️ Print / Save PDF
            </button>
            <div class="flex items-center gap-3">
              <a href="/spark/case" class="text-[13px] text-peri hover:text-white underline">
                Session 1 Archive
              </a>
              <a href="/spark" class="btn btn-sm btn-primary">
                Return to SPARK Hub →
              </a>
            </div>
          </div>
        </div>

        <!-- Back Navigation -->
        <div class="mt-8 flex justify-between items-center print:hidden">
          <button type="button" class="btn btn-secondary btn-on-light prev-panel-btn" data-prev="4">
            ← Back to Step 4
          </button>
          <span class="text-[12px] font-mono text-muted">End of Session 2</span>
        </div>

      </section>

    </div>
  </main>
</BaseLayout>

<style>
  /* Override global 168px min-height so compact rows="2"/rows="3" fields stay crisp */
  #game textarea.field {
    min-height: auto;
  }

  .step-tab {
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 6px 14px;
    font-size: 12px;
    color: #8A94A8;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: color .15s, border-color .15s;
  }
  .step-tab:hover {
    color: #3F66B0;
  }
  .step-tab .step-num {
    width: 20px;
    height: 20px;
    border-radius: 999px;
    border: 1px solid currentColor;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-family: var(--font-mono, monospace);
  }
  .step-tab.active {
    color: #3F66B0;
    border-color: #3F66B0;
    font-weight: 600;
  }
  .step-tab.locked {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .step-tab.locked:hover {
    color: #8A94A8;
  }
  .step-tab.locked .step-num {
    border-style: dashed;
  }
  .choice-btn {
    flex: 1;
    height: 40px;
    border: 1px solid rgba(27,42,85,.2);
    font-size: 14px;
    color: #3A4458;
    border-radius: 4px;
    background: #fff;
