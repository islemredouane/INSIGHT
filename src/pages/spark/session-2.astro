  function updateCardStatusUI() {
    const revealed = Boolean(serverAnswerKey && state.mentorReveals[4]);
    if (revealed) {
      cardWaitingBox?.classList.add('hidden');
      if (cardStatus) cardStatus.textContent = '✓ Approved by mentor';
    } else if (state.cardSubmitted) {
      cardWaitingBox?.classList.remove('hidden');
      const emptyCount = getEmptyCardBoxCount();
      if (cardStatus) {
        cardStatus.textContent = emptyCount > 0
          ? `⏳ Sent (${emptyCount} box${emptyCount === 1 ? '' : 'es'} still empty — feel free to finish filling them)`
          : '⏳ Sent — waiting for mentor review';
      }
    } else {
      cardWaitingBox?.classList.add('hidden');
      if (cardStatus) cardStatus.textContent = 'Fill the 8 boxes, then send to your mentor';
    }
  }

  document.getElementById('send-card-mentor-btn')?.addEventListener('click', () => {
    state.cardSubmitted = true;
    saveState('s4-saved');
    updateCardStatusUI();
    cardWaitingBox?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });

  // ==================== STEP 5: CASE FILE #2 ====================
  const choiceLabels: Record<string, string> = {
    yes: 'Yes',
    partly: 'Partly',
    no: 'No',
  };

  // Homework check choice
  document.querySelectorAll<HTMLButtonElement>('.hw-ans-choice').forEach((b) => {
    const choice = b.dataset.choice || 'yes';
    b.classList.toggle('chosen', choice === state.cf2.choice);
    b.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('.hw-ans-choice').forEach((btn) => btn.classList.remove('chosen'));
      b.classList.add('chosen');
      state.cf2.choice = choice;
      if (state.cf2Saved) updateSummaryCardUI();
      saveState('s5-saved');
    });
  });

  const cf2Explanation = document.getElementById('cf2-hw-explanation') as HTMLTextAreaElement | null;
  if (cf2Explanation) {
    cf2Explanation.value = state.cf2.explanation;
    cf2Explanation.addEventListener('input', () => {
      state.cf2.explanation = cf2Explanation.value;
      if (state.cf2Saved) updateSummaryCardUI();
      saveState('s5-saved');
    });
  }

  const sentenceYacine = document.getElementById('cf2-sentence-yacine') as HTMLTextAreaElement | null;
  const reasonCareful = document.getElementById('cf2-reason-careful') as HTMLTextAreaElement | null;
  const summaryCard = document.getElementById('cf2-summary-card');
  const summaryHwCheck = document.getElementById('summary-hw-check');
  const summarySentence = document.getElementById('summary-sentence-yacine');
  const summaryReason = document.getElementById('summary-reason-careful');

  function updateSummaryCardUI() {
    if (summaryHwCheck) {
      const label = choiceLabels[state.cf2.choice] || 'Yes';
      const exp = state.cf2.explanation.trim();
      summaryHwCheck.textContent = exp ? `${label} — ${exp}` : label;
    }
    if (summarySentence) {
      summarySentence.textContent = state.cf2.sentenceYacine.trim()
        ? `“${state.cf2.sentenceYacine.trim()}”`
        : '—';
    }
    if (summaryReason) {
      summaryReason.textContent = state.cf2.reasonCareful.trim() || '—';
    }
    summaryCard?.classList.toggle('hidden', !state.cf2Saved);
  }

  if (sentenceYacine) {
    sentenceYacine.value = state.cf2.sentenceYacine;
    sentenceYacine.addEventListener('input', () => {
      state.cf2.sentenceYacine = sentenceYacine.value;
      if (state.cf2Saved) updateSummaryCardUI();
      saveState('s5-saved');
    });
  }

  if (reasonCareful) {
    reasonCareful.value = state.cf2.reasonCareful;
    reasonCareful.addEventListener('input', () => {
      state.cf2.reasonCareful = reasonCareful.value;
      if (state.cf2Saved) updateSummaryCardUI();
      saveState('s5-saved');
    });
  }

  document.getElementById('save-cf2-btn')?.addEventListener('click', () => {
    state.cf2Saved = true;
    saveState('s5-saved');
    updateSummaryCardUI();
    summaryCard?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });

  document.getElementById('print-case-btn')?.addEventListener('click', () => {
    window.print();
  });

  // Initial setup: render locks, mentor reveals, summary state, and active step
  updateSummaryCardUI();
  renderLocks();
  renderMentorReveals();
  if (state.step && state.step > 0 && state.step <= state.unlockedStep) {
    showPanel(state.step);
  } else {
    showPanel(0);
  }
</script>
