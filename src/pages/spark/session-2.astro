  // ==================== STEP 3: PREDICT & CHECK ====================
  const sortContainer = document.getElementById('conditions-sortable');
  const lockPredBtn = document.getElementById('lock-prediction-btn') as HTMLButtonElement | null;
  const phase2El = document.getElementById('predict-phase-2');

  function renderSortable() {
    if (!sortContainer) return;
    sortContainer.innerHTML = '';
    answers.prediction.forEach((cid, idx) => {
      const cond = sparkSession2.conditions.find((c) => c.id === cid);
      if (!cond) return;
      const el = document.createElement('div');
      el.className =
        'condition-card p-4 border border-navy/10 rounded-lg bg-paper/40 flex items-center justify-between gap-3 transition-shadow hover:shadow-sm';
      el.dataset.id = cond.id;
      el.innerHTML = `
        <div class="flex items-center gap-3">
          <span class="rank-badge w-7 h-7 rounded-full bg-ink text-white font-mono font-bold text-[13px] flex items-center justify-center shrink-0">
            ${idx + 1}
          </span>
          <span class="text-2xl">${cond.icon}</span>
          <div>
            <h4 class="font-display font-bold text-ink text-[15px]">${cond.title}</h4>
            <p class="text-[12px] text-muted">${cond.shortDesc}</p>
          </div>
        </div>
        <div class="flex flex-col gap-1 shrink-0 ${answers.prediction_locked ? 'opacity-40 pointer-events-none' : ''}">
          <button type="button" class="rank-up text-xs font-mono px-2 py-1 bg-white border border-navy/10 rounded hover:bg-paper" data-idx="${idx}" title="Move Up" ${answers.prediction_locked ? 'disabled' : ''}>▲</button>
          <button type="button" class="rank-down text-xs font-mono px-2 py-1 bg-white border border-navy/10 rounded hover:bg-paper" data-idx="${idx}" title="Move Down" ${answers.prediction_locked ? 'disabled' : ''}>▼</button>
        </div>
      `;
      sortContainer.appendChild(el);
    });

    if (answers.prediction_locked) {
      if (lockPredBtn) {
        lockPredBtn.disabled = true;
        lockPredBtn.textContent = '🔒 Prediction Locked';
        lockPredBtn.classList.add('opacity-60', 'cursor-not-allowed');
      }
      return;
    }

    sortContainer.querySelectorAll('.rank-up').forEach((b) => {
      b.addEventListener('click', (e) => {
        const i = Number((e.currentTarget as HTMLElement).dataset.idx);
        if (i > 0) {
          const temp = answers.prediction[i];
          answers.prediction[i] = answers.prediction[i - 1];
          answers.prediction[i - 1] = temp;
          renderSortable();
          queueSave('s3-saved', { prediction: answers.prediction });
        }
      });
    });

    sortContainer.querySelectorAll('.rank-down').forEach((b) => {
      b.addEventListener('click', (e) => {
        const i = Number((e.currentTarget as HTMLElement).dataset.idx);
        if (i < answers.prediction.length - 1) {
          const temp = answers.prediction[i];
          answers.prediction[i] = answers.prediction[i + 1];
          answers.prediction[i + 1] = temp;
          renderSortable();
          queueSave('s3-saved', { prediction: answers.prediction });
        }
      });
    });
  }

