<script>
  import { sparkSession2 } from '../../data/spark';
  import { getTeam, getStoredTeamCode, storeTeamCode, clearTeamCode, friendlyError } from '../../lib/spark/api';

  // Team handling
  let teamCode = getStoredTeamCode() || 'DEMO';
  let STORAGE_KEY = `spark-s2-${teamCode}`;

  const bannerName = document.getElementById('banner-team-name');
  const bannerMembers = document.getElementById('banner-team-members');
  const bannerBadge = document.getElementById('banner-status-badge');
  const inputWrap = document.getElementById('code-input-wrap');
  const registerBtn = document.getElementById('inline-register-btn');
  const disconnectBtn = document.getElementById('inline-disconnect-btn');
  const codeError = document.getElementById('inline-code-error');
  const codeSuccess = document.getElementById('inline-code-success');
  const teamLabel = document.getElementById('team-label');
  const teamBadge = document.getElementById('team-badge');

  async function syncTeamInfo() {
    teamCode = getStoredTeamCode() || 'DEMO';
    STORAGE_KEY = `spark-s2-${teamCode}`;

    if (teamCode && teamCode !== 'DEMO') {
      try {
        const data = await getTeam(teamCode);
        if (data && data.team) {
          if (teamLabel) teamLabel.textContent = `Team ${data.team.name}`;
          if (teamBadge) teamBadge.textContent = `${data.team.code} · ${data.team.members.length} Members`;
          if (bannerName) bannerName.textContent = `Team ${data.team.name}`;
          if (bannerMembers) bannerMembers.textContent = `Members: ${data.team.members.join(', ')}`;
          if (bannerBadge) {
            bannerBadge.textContent = `✓ Code: ${data.team.code}`;
            bannerBadge.className = 'px-2.5 py-0.5 text-[11px] font-mono rounded bg-emerald-100 text-emerald-800 border border-emerald-300 font-semibold';
          }
          inputWrap?.classList.add('hidden');
          registerBtn?.classList.add('hidden');
          disconnectBtn?.classList.remove('hidden');
          return;
        }
      } catch (err) {
        console.warn('Backend sync warning:', err);
      }

      // Offline fallback with code
      if (teamLabel) teamLabel.textContent = `Team ${teamCode}`;
      if (teamBadge) teamBadge.textContent = `Code: ${teamCode}`;
      if (bannerName) bannerName.textContent = `Team ${teamCode}`;
      if (bannerBadge) {
        bannerBadge.textContent = `Code: ${teamCode}`;
        bannerBadge.className = 'px-2.5 py-0.5 text-[11px] font-mono rounded bg-blue/10 text-blue font-semibold';
      }
      inputWrap?.classList.add('hidden');
      registerBtn?.classList.add('hidden');
      disconnectBtn?.classList.remove('hidden');
    } else {
      // Explorer / Guest mode
      if (teamLabel) teamLabel.textContent = 'The Music Case · Part 2';
      if (teamBadge) teamBadge.textContent = 'Explorer Mode';
      if (bannerName) bannerName.textContent = 'Working with a team?';
      if (bannerMembers) bannerMembers.textContent = 'Have a team code from Session 1? Enter it below. New to SPARK? Register a team in 1 minute!';
      if (bannerBadge) {
        bannerBadge.textContent = 'No code connected';
        bannerBadge.className = 'px-2.5 py-0.5 text-[11px] font-mono rounded bg-paper text-muted border border-navy/10';
      }
      inputWrap?.classList.remove('hidden');
      registerBtn?.classList.remove('hidden');
      disconnectBtn?.classList.add('hidden');
    }
  }

  // Connect button click
  const inlineInput = document.getElementById('inline-team-code') as HTMLInputElement | null;
  const inlineBtn = document.getElementById('inline-connect-btn') as HTMLButtonElement | null;

  async function handleConnectCode() {
    if (!inlineInput) return;
    const raw = inlineInput.value.trim().toUpperCase();
    if (!raw || raw.length < 4) {
      if (codeError) {
        codeError.textContent = 'Please enter your 6-character team code.';
        codeError.classList.remove('hidden');
      }
      return;
    }
    if (inlineBtn) inlineBtn.disabled = true;
    codeError?.classList.add('hidden');
    codeSuccess?.classList.add('hidden');

    try {
      const data = await getTeam(raw);
      if (!data || !data.team) {
        throw new Error("That code wasn't found. Check the letters or register a new team.");
      }
      storeTeamCode(raw);
      teamCode = raw;
      STORAGE_KEY = `spark-s2-${teamCode}`;
      try {
        const stored = localStorage.getItem(STORAGE_KEY);
        if (stored) state = { ...defaultState, ...JSON.parse(stored) };
      } catch {}
      await syncTeamInfo();
      if (codeSuccess) {
        codeSuccess.textContent = `✓ Connected as Team ${data.team.name}!`;
        codeSuccess.classList.remove('hidden');
        setTimeout(() => codeSuccess.classList.add('hidden'), 4000);
      }
    } catch (err: any) {
      if (codeError) {
        codeError.textContent = friendlyError(err);
        codeError.classList.remove('hidden');
      }
    } finally {
      if (inlineBtn) inlineBtn.disabled = false;
    }
  }

  inlineBtn?.addEventListener('click', handleConnectCode);
  inlineInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      handleConnectCode();
    }
  });

  disconnectBtn?.addEventListener('click', async () => {
    clearTeamCode();
    await syncTeamInfo();
  });

  // Run on load
  syncTeamInfo();

  // Load existing state from localStorage
  interface Session2State {
    step: number;
    hw_q1: string;
    hw_q2: string;
    pages: Record<string, number>;
    trick: { who: string; what: string; compared: string; measured: string };
    yellow: string[];
    blue: string[];
    jarWords: string[];
    prediction: string[]; // condition ids in ranked order
    predictionLocked: boolean;
    resultsRealText: string;
    resultsRevealed: boolean;
    readingCard: Record<string, string>;
    cardApproved: boolean;
    cf2: {
      choice: string;
      explanation: string;
      sentenceYacine: string;
      reasonCareful: string;
    };
  }

  const defaultState: Session2State = {
    step: 0,
    hw_q1: '',
    hw_q2: '',
    pages: {},
    trick: { who: '', what: '', compared: '', measured: '' },
    yellow: ['', '', ''],
    blue: ['', ''],
    jarWords: ['Within design', 'Significant (p < .05)', 'Counterbalanced', 'Pilot study', 'Likert scale'],
    prediction: ['quiet', 'liked', 'no_lyrics', 'disliked'],
    predictionLocked: false,
    resultsRealText: '',
    resultsRevealed: false,
    readingCard: {
      reference: sparkSession2.paper.citation,
      question: '',
      who: '',
      what_done: '',
      main_result: '',
      explanation: '',
      limits: '',
      our_questions: '',
    },
    cardApproved: false,
    cf2: {
      choice: 'yes',
      explanation: '',
      sentenceYacine: '',
      reasonCareful: '',
    },
  };

  let state: Session2State = defaultState;
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) state = { ...defaultState, ...JSON.parse(raw) };
  } catch (e) {
    console.error('Failed to load session 2 state', e);
  }

  function saveState(statusElId?: string) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      if (statusElId) markStatus(statusElId, 'saved');
    } catch (e) {
      console.error('Save failed', e);
      if (statusElId) markStatus(statusElId, 'Save error');
    }
  }

  function markStatus(id: string, st: 'saving' | 'saved' | string) {
    const el = document.getElementById(id);
    if (!el) return;
    el.classList.remove('status-saving', 'status-saved', 'status-error');
    if (st === 'saving') {
      el.textContent = 'Saving…';
      el.classList.add('status-saving');
    } else if (st === 'saved') {
      el.textContent = '✓ Saved';
      el.classList.add('status-saved');
    } else {
      el.textContent = st;
      el.classList.add('status-error');
    }
  }

  // Navigation between panels
  let activePanel = 0;
  function showPanel(n: number) {
    activePanel = n;
    state.step = n;
    saveState();

    document.querySelectorAll<HTMLElement>('.panel').forEach((p) => {
      p.classList.toggle('hidden', Number(p.dataset.panel) !== n);
    });

    document.querySelectorAll<HTMLButtonElement>('.step-tab').forEach((btn) => {
      const stepIdx = Number(btn.dataset.step);
      btn.classList.toggle('active', stepIdx === n);
    });

    window.scrollTo({ top: 180, behavior: 'smooth' });
  }

  document.querySelectorAll<HTMLButtonElement>('.step-tab').forEach((btn) => {
    btn.addEventListener('click', () => showPanel(Number(btn.dataset.step)));
  });

  document.querySelectorAll<HTMLButtonElement>('.next-panel-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = Number(btn.dataset.next);
      showPanel(next);
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.prev-panel-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const prev = Number(btn.dataset.prev);
      showPanel(prev);
    });
  });

  // ==================== STEP 0 ====================
  const hwQ1 = document.getElementById('hw-q1') as HTMLInputElement | null;
  const hwQ2 = document.getElementById('hw-q2') as HTMLInputElement | null;
  if (hwQ1) {
    hwQ1.value = state.hw_q1;
    hwQ1.addEventListener('input', () => {
      state.hw_q1 = hwQ1.value;
      saveState('s0-saved');
    });
  }
  if (hwQ2) {
    hwQ2.value = state.hw_q2;
    hwQ2.addEventListener('input', () => {
      state.hw_q2 = hwQ2.value;
      saveState('s0-saved');
    });
  }
  document.querySelectorAll<HTMLButtonElement>('.hw-chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      const text = chip.dataset.suggestion || '';
      if (hwQ1 && !hwQ1.value.trim()) {
        hwQ1.value = text;
        state.hw_q1 = text;
      } else if (hwQ2) {
        hwQ2.value = text;
        state.hw_q2 = text;
      }
      saveState('s0-saved');
    });
  });

  // ==================== STEP 1 ====================
  // Check parts pages
  function checkPages() {
    sparkSession2.paperParts.forEach((part) => {
      const input = document.querySelector<HTMLInputElement>(`.page-part-input[data-part="${part.id}"]`);
      const fb = document.querySelector<HTMLElement>(`.page-feedback[data-feedback="${part.id}"]`);
      if (!input || !fb) return;
      const val = Number(input.value);
      if (!val) {
        fb.textContent = '';
        return;
      }
      if (part.validPages.includes(val)) {
        fb.textContent = '✓ Correct';
        fb.className = 'page-feedback text-[12px] font-semibold text-emerald-700';
      } else {
        fb.textContent = `Hint: check around ${part.expectedPageDisplay}`;
        fb.className = 'page-feedback text-[12px] text-body';
      }
      state.pages[part.id] = val;
    });
    saveState('s1-saved');
  }

  document.querySelectorAll<HTMLInputElement>('.page-part-input').forEach((input) => {
    const part = input.dataset.part;
    if (part && state.pages[part]) {
      input.value = String(state.pages[part]);
    }
    input.addEventListener('change', checkPages);
  });
  document.getElementById('check-pages-btn')?.addEventListener('click', checkPages);

  // 4-part trick inputs
  const trickInputs: Record<keyof typeof state.trick, HTMLInputElement | null> = {
    who: document.getElementById('trick-who') as HTMLInputElement | null,
    what: document.getElementById('trick-what') as HTMLInputElement | null,
    compared: document.getElementById('trick-compared') as HTMLInputElement | null,
    measured: document.getElementById('trick-measured') as HTMLInputElement | null,
  };
  Object.entries(trickInputs).forEach(([key, input]) => {
    if (!input) return;
    const k = key as keyof typeof state.trick;
    input.value = state.trick[k] || '';
    input.addEventListener('input', () => {
      state.trick[k] = input.value;
      saveState('s1-saved');
    });
  });

  // ==================== STEP 2 ====================
  // Yellow facts
  ['yellow-1', 'yellow-2', 'yellow-3'].forEach((id, idx) => {
    const el = document.getElementById(id) as HTMLInputElement | null;
    if (!el) return;
    el.value = state.yellow[idx] || '';
    el.addEventListener('input', () => {
      state.yellow[idx] = el.value;
      saveState('s2-saved');
    });
  });

  // Blue facts
  ['blue-1', 'blue-2'].forEach((id, idx) => {
    const el = document.getElementById(id) as HTMLInputElement | null;
    if (!el) return;
    el.value = state.blue[idx] || '';
    el.addEventListener('input', () => {
      state.blue[idx] = el.value;
      saveState('s2-saved');
    });
  });

  // Word Jar
  const jarContainer = document.getElementById('jar-words-list');
  function renderJar() {
    if (!jarContainer) return;
    jarContainer.innerHTML = '';
    state.jarWords.forEach((word, idx) => {
      const pill = document.createElement('span');
      pill.className =
        'inline-flex items-center gap-1.5 px-3 py-1 bg-white border border-pink-200 text-pink-900 rounded-full text-[12px] font-medium shadow-2xs';
      pill.innerHTML = `<span>🩷 ${word}</span><button type="button" class="text-pink-400 hover:text-pink-700 ml-1 font-bold text-[14px] leading-none" data-idx="${idx}">×</button>`;
      jarContainer.appendChild(pill);
    });

    jarContainer.querySelectorAll('button[data-idx]').forEach((b) => {
      b.addEventListener('click', (e) => {
        const i = Number((e.currentTarget as HTMLElement).dataset.idx);
        state.jarWords.splice(i, 1);
        renderJar();
        saveState('s2-saved');
      });
    });
  }
  renderJar();

  const pinkInput = document.getElementById('new-pink-word') as HTMLInputElement | null;
  document.getElementById('add-pink-btn')?.addEventListener('click', () => {
    if (!pinkInput) return;
    const w = pinkInput.value.trim();
    if (w && !state.jarWords.includes(w)) {
      state.jarWords.push(w);
      pinkInput.value = '';
      renderJar();
      saveState('s2-saved');
    }
  });

  // ==================== STEP 3: PREDICT & CHECK ====================
  const sortContainer = document.getElementById('conditions-sortable');
  function renderSortable() {
    if (!sortContainer) return;
    sortContainer.innerHTML = '';
    state.prediction.forEach((cid, idx) => {
      const cond = sparkSession2.conditions.find((c) => c.id === cid);
      if (!cond) return;
      const el = document.createElement('div');
      el.className =
        'condition-card p-4 border border-navy/10 rounded-lg bg-paper/40 flex items-center justify-between gap-3 transition-shadow hover:shadow-sm';
      el.dataset.id = cond.id;
      el.innerHTML = `
        <div class="flex items-center gap-3">
          <span class="rank-badge w-7 h-7 rounded-full bg-ink text-white font-mono font-bold text-[13px] flex items-center justify-center shrink-0">
            ${idx + 1}
          </span>
          <span class="text-2xl">${cond.icon}</span>
          <div>
            <h4 class="font-display font-bold text-ink text-[15px]">${cond.title}</h4>
            <p class="text-[12px] text-muted">${cond.shortDesc}</p>
          </div>
        </div>
        <div class="flex flex-col gap-1 shrink-0">
          <button type="button" class="rank-up text-xs font-mono px-2 py-1 bg-white border border-navy/10 rounded hover:bg-paper" data-idx="${idx}" title="Move Up">▲</button>
          <button type="button" class="rank-down text-xs font-mono px-2 py-1 bg-white border border-navy/10 rounded hover:bg-paper" data-idx="${idx}" title="Move Down">▼</button>
        </div>
      `;
      sortContainer.appendChild(el);
    });

    sortContainer.querySelectorAll('.rank-up').forEach((b) => {
      b.addEventListener('click', (e) => {
        const i = Number((e.currentTarget as HTMLElement).dataset.idx);
        if (i > 0) {
          const temp = state.prediction[i];
          state.prediction[i] = state.prediction[i - 1];
          state.prediction[i - 1] = temp;
          renderSortable();
          saveState('s3-saved');
        }
      });
    });

    sortContainer.querySelectorAll('.rank-down').forEach((b) => {
      b.addEventListener('click', (e) => {
        const i = Number((e.currentTarget as HTMLElement).dataset.idx);
        if (i < state.prediction.length - 1) {
          const temp = state.prediction[i];
          state.prediction[i] = state.prediction[i + 1];
          state.prediction[i + 1] = temp;
          renderSortable();
          saveState('s3-saved');
        }
      });
    });
  }
  renderSortable();

  const phase1El = document.getElementById('predict-phase-1');
  const phase2El = document.getElementById('predict-phase-2');
  const phase3El = document.getElementById('predict-phase-3');
  const lockedList = document.getElementById('locked-prediction-list');

  function renderLockedList() {
    if (!lockedList) return;
    lockedList.innerHTML = '';
    state.prediction.forEach((cid, idx) => {
      const cond = sparkSession2.conditions.find((c) => c.id === cid);
      if (!cond) return;
      const li = document.createElement('li');
      li.className = 'p-2 bg-white rounded border border-navy/10 flex items-center justify-between';
      li.innerHTML = `<span><strong>${idx + 1}.</strong> ${cond.icon} ${cond.title}</span>`;
      lockedList.appendChild(li);
    });
  }

  function updatePredictionUI() {
    if (state.predictionLocked) {
      phase2El?.classList.remove('hidden');
      if (state.resultsRevealed) {
        phase3El?.classList.remove('hidden');
        renderLockedList();
      }
    }
  }
  updatePredictionUI();

  document.getElementById('lock-prediction-btn')?.addEventListener('click', () => {
    state.predictionLocked = true;
    saveState('s3-saved');
    phase2El?.classList.remove('hidden');
    phase2El?.scrollIntoView({ behavior: 'smooth' });
  });

  const resultsRealText = document.getElementById('results-real-text') as HTMLTextAreaElement | null;
  if (resultsRealText) {
    resultsRealText.value = state.resultsRealText;
    resultsRealText.addEventListener('input', () => {
      state.resultsRealText = resultsRealText.value;
      saveState('s3-saved');
    });
  }

  document.getElementById('reveal-comparison-btn')?.addEventListener('click', () => {
    state.resultsRevealed = true;
    saveState('s3-saved');
    phase3El?.classList.remove('hidden');
    renderLockedList();
    phase3El?.scrollIntoView({ behavior: 'smooth' });
  });

  // ==================== STEP 4: READING CARD ====================
  sparkSession2.readingCardBoxes.forEach((box) => {
    const el = document.getElementById(`card-${box.id}`) as HTMLTextAreaElement | null;
    if (!el) return;
    if (state.readingCard[box.id]) {
      el.value = state.readingCard[box.id];
    }
    el.addEventListener('input', () => {
      state.readingCard[box.id] = el.value;
      saveState('s4-saved');
    });
  });

  const cardApprovedBox = document.getElementById('card-mentor-approved');
  const cardStatus = document.getElementById('s4-card-status');
  if (state.cardApproved) {
    cardApprovedBox?.classList.remove('hidden');
    if (cardStatus) cardStatus.textContent = '✓ Approved by mentor';
  }

  document.getElementById('send-card-mentor-btn')?.addEventListener('click', () => {
    state.cardApproved = true;
    saveState('s4-saved');
    cardApprovedBox?.classList.remove('hidden');
    if (cardStatus) cardStatus.textContent = '✓ Approved by mentor';
    cardApprovedBox?.scrollIntoView({ behavior: 'smooth' });
  });

  // ==================== STEP 5: CASE FILE #2 ====================
  // Homework check choice
  document.querySelectorAll<HTMLButtonElement>('.hw-ans-choice').forEach((b) => {
    const choice = b.dataset.choice || 'yes';
    b.classList.toggle('chosen', choice === state.cf2.choice);
    b.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('.hw-ans-choice').forEach((btn) => btn.classList.remove('chosen'));
      b.classList.add('chosen');
      state.cf2.choice = choice;
      saveState('s5-saved');
    });
  });

  const cf2Explanation = document.getElementById('cf2-hw-explanation') as HTMLTextAreaElement | null;
  if (cf2Explanation) {
    cf2Explanation.value = state.cf2.explanation;
    cf2Explanation.addEventListener('input', () => {
      state.cf2.explanation = cf2Explanation.value;
      saveState('s5-saved');
    });
  }

  const sentenceYacine = document.getElementById('cf2-sentence-yacine') as HTMLTextAreaElement | null;
  const summarySentence = document.getElementById('summary-sentence-yacine');
  if (sentenceYacine) {
    sentenceYacine.value = state.cf2.sentenceYacine;
    if (state.cf2.sentenceYacine && summarySentence) {
      summarySentence.textContent = `“${state.cf2.sentenceYacine}”`;
    }
    sentenceYacine.addEventListener('input', () => {
      state.cf2.sentenceYacine = sentenceYacine.value;
      if (summarySentence) {
        summarySentence.textContent = sentenceYacine.value ? `“${sentenceYacine.value}”` : '“If you need to read and understand what you study, turn off songs with lyrics—even your favourites—and study in silence or with instrumental music.”';
      }
      saveState('s5-saved');
    });
  }

  const reasonCareful = document.getElementById('cf2-reason-careful') as HTMLTextAreaElement | null;
  if (reasonCareful) {
    reasonCareful.value = state.cf2.reasonCareful;
    reasonCareful.addEventListener('input', () => {
      state.cf2.reasonCareful = reasonCareful.value;
      saveState('s5-saved');
    });
  }

  document.getElementById('save-cf2-btn')?.addEventListener('click', () => {
    saveState('s5-saved');
  });

  document.getElementById('print-case-btn')?.addEventListener('click', () => {
    window.print();
  });

  // Restore active step if saved
  if (state.step && state.step > 0 && state.step < 6) {
    showPanel(state.step);
  }
</script>
