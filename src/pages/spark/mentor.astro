      { key: 'peer', btn: s3TabPeer, view: s3ViewPeer },
    ] as const;
    map.forEach(({ key, btn, view }) => {
      const active = key === tab;
      btn.classList.toggle('border-blue', active);
      btn.classList.toggle('text-blue', active);
      btn.classList.toggle('font-semibold', active);
      btn.classList.toggle('border-transparent', !active);
      btn.classList.toggle('text-muted', !active);
      btn.classList.toggle('font-medium', !active);
      view.classList.toggle('hidden', !active);
    });
    if (tab === 'cf3') renderS3Cf3List();
    if (tab === 'peer') renderS3PeerList();
  }
  s3TabOverview.addEventListener('click', () => switchS3Tab('overview'));
  s3TabCf3.addEventListener('click', () => switchS3Tab('cf3'));
  s3TabPeer.addEventListener('click', () => switchS3Tab('peer'));

  // Session 2 Sub-tabs
  const s2TabOverview = document.getElementById('s2-tab-overview')!;
  const s2TabCards = document.getElementById('s2-tab-cards')!;
  const s2TabJar = document.getElementById('s2-tab-jar')!;
  const s2ViewOverview = document.getElementById('s2-view-overview')!;
  const s2ViewCards = document.getElementById('s2-view-cards')!;
  const s2ViewJar = document.getElementById('s2-view-jar')!;

  function switchS2Tab(tab: 'overview' | 'cards' | 'jar') {
    const map = [
      { key: 'overview', btn: s2TabOverview, view: s2ViewOverview },
      { key: 'cards', btn: s2TabCards, view: s2ViewCards },
      { key: 'jar', btn: s2TabJar, view: s2ViewJar },
    ] as const;
    map.forEach(({ key, btn, view }) => {
      const active = key === tab;
      btn.classList.toggle('border-blue', active);
      btn.classList.toggle('text-blue', active);
      btn.classList.toggle('font-semibold', active);
      btn.classList.toggle('border-transparent', !active);
      btn.classList.toggle('text-muted', !active);
      btn.classList.toggle('font-medium', !active);
      view.classList.toggle('hidden', !active);
    });
