    'Key 3 · 4-Move Intro',
    'Key 4 · Result & Meaning',
    'Key 5 · Abstract Model',
  ];

  const loginForm = document.getElementById('login-form') as HTMLFormElement;
  const panel = document.getElementById('panel')!;
  const mentorBadge = document.getElementById('mentor-badge')!;
  const mentorRoleLabel = document.getElementById('mentor-role-label')!;

  let mentor: MentorSession | null = getStoredMentor();
  let currentQuestions: MentorQuestionItem[] = [];
  let questionFilter: 'all' | 'pending' | 'approved' = 'all';

  // Session 4 state
  let s4Data: MentorS4Overview | null = null;
  let s4Cf4Filter: 'all' | 'pending' | 'approved' = 'all';
