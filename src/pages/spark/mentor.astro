    document.getElementById('s2-inspect-title')!.textContent = `${t.name} (${t.code})`;
    document.getElementById('s2-inspect-subtitle')!.textContent = `Members: ${(t.members || []).join(', ') || '—'}`;

    const pagesEntries = Object.entries(t.pages || {})
      .map(([k, v]) => `<span class="px-2 py-0.5 bg-paper border border-navy/10 rounded font-mono text-[11px]">${escapeHtml(k)}: p.${Number(v)}</span>`)
      .join(' ');

    const predList = (t.prediction || [])
      .map((id, idx) => `<li><strong>#${idx + 1}</strong> ${escapeHtml(CONDITION_LABELS[id] || id)}</li>`)
      .join('');

    const rc = t.reading_card || {};
    const rcHtml = READING_BOXES.map(
      (b) => `<div><strong class="text-ink">${escapeHtml(b.title)}:</strong> <span class="text-body">${rc[b.id]?.trim() ? escapeHtml(rc[b.id]) : '—'}</span></div>`
    ).join('');

    const body = document.getElementById('s2-inspect-body')!;
    const prevScroll = body.scrollTop;
    body.innerHTML = `
      <div class="space-y-2 border-b border-navy/10 pb-4">
        <p class="font-mono text-[11px] uppercase font-bold text-blue">Step 0 · Homework Questions</p>
        <p><strong>Q1:</strong> ${t.hw_q1?.trim() ? escapeHtml(t.hw_q1) : '<span class="text-muted">—</span>'}</p>
        <p><strong>Q2:</strong> ${t.hw_q2?.trim() ? escapeHtml(t.hw_q2) : '<span class="text-muted">—</span>'}</p>
      </div>

      <div class="space-y-2 border-b border-navy/10 pb-4">
        <p class="font-mono text-[11px] uppercase font-bold text-blue">Step 1 · Page Map &amp; 4-Part Trick</p>
        <div class="flex flex-wrap gap-1.5">${pagesEntries || '<span class="text-muted">No pages mapped yet</span>'}</div>
        <div class="grid sm:grid-cols-2 gap-2 mt-2 bg-paper p-3 rounded border border-navy/10">
          <div><strong>Who:</strong> ${t.trick?.who ? escapeHtml(t.trick.who) : '—'}</div>
          <div><strong>What tested:</strong> ${t.trick?.what ? escapeHtml(t.trick.what) : '—'}</div>
          <div><strong>Compared to:</strong> ${t.trick?.compared ? escapeHtml(t.trick.compared) : '—'}</div>
          <div><strong>Measured how:</strong> ${t.trick?.measured ? escapeHtml(t.trick.measured) : '—'}</div>
        </div>
      </div>

      <div class="space-y-2 border-b border-navy/10 pb-4">
        <p class="font-mono text-[11px] uppercase font-bold text-blue">Step 2 · 3 Colours &amp; Word Jar</p>
        <div><strong>Yellow (Method):</strong> ${(t.yellow || []).filter(Boolean).length ? `<ul class="list-disc pl-5">${t.yellow.filter(Boolean).map((x) => `<li>${escapeHtml(x)}</li>`).join('')}</ul>` : '<span class="text-muted">—</span>'}</div>
        <div><strong>Blue (Results):</strong> ${(t.blue || []).filter(Boolean).length ? `<ul class="list-disc pl-5">${t.blue.filter(Boolean).map((x) => `<li>${escapeHtml(x)}</li>`).join('')}</ul>` : '<span class="text-muted">—</span>'}</div>
        <div><strong>Pink Word Jar:</strong> ${(t.jar_words || []).length ? t.jar_words.map((w) => `<span class="inline-block px-2 py-0.5 bg-pink-50 text-pink-900 border border-pink-200 rounded-full text-[12px] mr-1">${escapeHtml(w)}</span>`).join('') : '<span class="text-muted">—</span>'}</div>
      </div>

      <div class="space-y-2 border-b border-navy/10 pb-4">
        <p class="font-mono text-[11px] uppercase font-bold text-blue">Step 3 · Prediction &amp; Findings</p>
        <p><strong>Status:</strong> ${t.prediction_locked ? '<span class="text-emerald-700 font-semibold">🔒 Locked</span>' : '<span class="text-muted">Not locked yet</span>'}</p>
        ${predList ? `<ol class="space-y-0.5 pl-1">${predList}</ol>` : ''}
        <p><strong>What paper really found:</strong> ${t.results_real_text?.trim() ? escapeHtml(t.results_real_text) : '<span class="text-muted">—</span>'}</p>
        <p><strong>Table 1 Bonus:</strong> ${t.results_bonus_text?.trim() ? escapeHtml(t.results_bonus_text) : '<span class="text-muted">—</span>'}</p>
      </div>

      <div class="space-y-2 border-b border-navy/10 pb-4">
        <div class="flex items-center justify-between gap-2">
          <p class="font-mono text-[11px] uppercase font-bold text-blue">Step 4 · Reading Card (${escapeHtml(t.card_status)})</p>
          ${t.card_status !== 'approved' ? `<button type="button" id="modal-quick-approve" class="btn btn-sm btn-primary bg-emerald-600 hover:bg-emerald-700 text-white !py-1 !px-3 !text-[12px]">✓ Approve Card Now</button>` : '<span class="text-emerald-700 font-semibold text-[12px]">✓ Approved</span>'}
        </div>
        <div class="space-y-1.5 bg-paper p-3 rounded border border-navy/10">${rcHtml}</div>
      </div>

      <div class="space-y-2">
