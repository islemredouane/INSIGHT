---
// SPARK · The Music Case — mentor panel. Password-gated; supports Session 4 (Live), Session 3, Session 2, and Session 1.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sparkSession2, sparkSession3, sparkSession4 } from '../../data/spark';

const s2ReadingBoxes = sparkSession2.readingCardBoxes.map((b) => ({ id: b.id, title: b.title }));
const s2PaperPartsCount = sparkSession2.paperParts.length;
const s2ConditionLabels: Record<string, string> = Object.fromEntries(
  sparkSession2.conditions.map((c) => [c.id, `${c.icon} ${c.title}`])
);
const s3MistakesCount = sparkSession3.badAnswerMistakes.length;
const s3SixChecks = sparkSession3.sixChecks;
---
<BaseLayout title="Mentor panel · SPARK" description="SPARK 2026 mentor panel." noindex>
  <section class="bg-ink text-white pt-24 xl:pt-32 pb-8 border-b border-white/10">
    <div class="max-w-[1160px] mx-auto px-5 flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="eyebrow text-peri">SPARK 2026 · The Music Case</p>
        <h1 class="mt-1 font-display text-2xl font-bold">Mentor Panel</h1>
      </div>
      <div id="mentor-badge" class="hidden text-[13px] text-silver/80 flex items-center gap-3">
        <a href="/spark/session-4" target="_blank" rel="noopener" class="px-2.5 py-1 rounded bg-blue text-white text-[12px] font-semibold transition-colors">
          Open Session 4 ↗
        </a>
        <a href="/spark/session-3" target="_blank" rel="noopener" class="px-2.5 py-1 rounded bg-white/10 hover:bg-white/20 text-white text-[12px] font-medium transition-colors">
          Open Session 3 ↗
        </a>
        <a href="/spark/session-2" target="_blank" rel="noopener" class="px-2.5 py-1 rounded bg-white/10 hover:bg-white/20 text-white text-[12px] font-medium transition-colors">
          Open Session 2 ↗
        </a>
        <span id="mentor-role-label" class="bg-white/10 px-2.5 py-1 rounded font-mono uppercase text-[11px]">Mentor</span>
        <button type="button" id="logout-btn" class="hover:text-white underline">Log out</button>
      </div>
    </div>
  </section>

  <section class="bg-paper text-ink py-10 min-h-[70vh]">
    <div class="max-w-[1160px] mx-auto px-5">

      <!-- Login Form -->
      <form id="login-form" class="max-w-sm mx-auto bg-white border border-navy/10 p-6 sm:p-8 mt-10 rounded shadow-sm">
        <h2 class="font-display text-lg font-bold text-ink">Sign in to Mentor Panel</h2>
        <p class="text-[13px] text-muted mt-1">Enter the mentor password given to organizers.</p>

        <label for="mentor-name-input" class="field-label mt-4">Your name (optional)</label>
        <input id="mentor-name-input" class="field mt-1" placeholder="e.g. Amine" />

        <label for="mentor-password" class="field-label mt-4">Mentor password</label>
        <input id="mentor-password" class="field mt-1" type="password" required />
        <p id="login-error" class="hidden mt-2 text-[14px] text-signal"></p>
        <button type="submit" class="btn btn-primary w-full mt-5">Log in</button>
      </form>

      <!-- Main Panel -->
      <div id="panel" class="hidden space-y-6">

        <!-- Top Session Switcher: Session 4 (Live) vs Session 3 vs Session 2 vs Session 1 -->
        <div class="flex flex-wrap items-center justify-between gap-3 bg-white border border-navy/10 p-2 rounded-lg shadow-sm">
          <div class="flex flex-wrap items-center gap-2">
            <button
              type="button"
              id="switch-session-4"
              class="px-4 py-2 rounded-md text-[14px] font-semibold bg-ink text-white flex items-center gap-2 transition-colors"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Session 4 · Live</span>
              <span id="s4-top-pending-badge" class="hidden text-[11px] bg-amber-500 text-white font-bold px-2 py-0.5 rounded-full">0</span>
            </button>
            <button
              type="button"
              id="switch-session-3"
              class="px-4 py-2 rounded-md text-[14px] font-medium text-muted hover:text-ink hover:bg-paper transition-colors flex items-center gap-2"
            >
              <span>Session 3 · Archive</span>
              <span id="s3-top-pending-badge" class="hidden text-[11px] bg-amber-500 text-white font-bold px-2 py-0.5 rounded-full">0</span>
            </button>
            <button
              type="button"
              id="switch-session-2"
              class="px-4 py-2 rounded-md text-[14px] font-medium text-muted hover:text-ink hover:bg-paper transition-colors flex items-center gap-2"
            >
              <span>Session 2 · Archive</span>
              <span id="s2-top-pending-badge" class="hidden text-[11px] bg-amber-500 text-white font-bold px-2 py-0.5 rounded-full">0</span>
            </button>
            <button
              type="button"
              id="switch-session-1"
              class="px-4 py-2 rounded-md text-[14px] font-medium text-muted hover:text-ink hover:bg-paper transition-colors flex items-center gap-2"
            >
              <span>Session 1 · Archive</span>
              <span id="s1-top-pending-badge" class="hidden text-[11px] bg-amber-500 text-white font-bold px-2 py-0.5 rounded-full">0</span>
            </button>
          </div>
          <div class="flex items-center gap-2 px-2 text-[12px] text-muted font-mono">
            <span id="live-sync-label">Live · syncing every 4s</span>
          </div>
        </div>

        <!-- =========================================================================
             SESSION 4 · LIVE PANEL (Default Active)
             ========================================================================= -->
        <div id="session-4-wrap" class="space-y-6">

          <!-- Session 4 Control Bar: Room Step + Live Model Answer Reveals -->
          <div class="bg-white border border-navy/10 p-5 rounded-lg shadow-sm space-y-4">
            <!-- Row 1: Room Step Progress -->
            <div class="flex flex-wrap items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <span class="text-sm font-semibold text-muted uppercase font-mono text-[11px] tracking-wider">Session 4 Room Step:</span>
                <span id="s4-current-step" class="font-display font-bold text-blue text-base">Step 0 · Yacine’s New Message</span>
              </div>

              <div class="flex flex-wrap items-center gap-2">
                <button type="button" id="s4-unlock-next" class="btn btn-sm btn-primary">Unlock next step →</button>
                <button type="button" id="s4-export-csv" class="btn btn-sm btn-secondary btn-on-light">Export Session 4 CSV ↓</button>
                <button type="button" id="s4-admin-reset" class="btn btn-sm btn-secondary btn-on-light text-signal border-signal/40 hover:bg-signal/5">
                  Reset Session 4
                </button>
              </div>

              <div class="flex items-center gap-1.5 w-full sm:w-auto pt-2 sm:pt-0 border-t sm:border-t-0 border-navy/10">
                <span class="text-[12px] text-muted font-mono uppercase mr-1">Jump:</span>
                <div class="flex gap-1" id="s4-jump-steps"></div>
              </div>
            </div>

            <!-- Row 2: Live Room Model Answer Reveals -->
            <div class="pt-4 border-t border-navy/10 space-y-2.5">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div>
                  <span class="text-[12px] font-mono uppercase tracking-wider font-bold text-ink">👑 Live Model Answer Reveals (All Student Screens)</span>
                  <p class="text-[12px] text-muted">Reveal or hide answer keys live across all team screens. Steps 1 to 5 cover sort solutions, title analysis, 4-move intro, result/discussion, and abstract.</p>
                </div>
                <div class="flex items-center gap-1.5">
                  <button type="button" id="s4-reveal-all" class="px-2.5 py-1 rounded text-[12px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200 hover:bg-emerald-100 transition-colors">
                    Reveal All
                  </button>
                  <button type="button" id="s4-hide-all" class="px-2.5 py-1 rounded text-[12px] font-semibold bg-paper text-muted border border-navy/15 hover:text-ink transition-colors">
                    Hide All
                  </button>
                </div>
              </div>
              <div id="s4-reveal-controls" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2"></div>
            </div>
          </div>

          <!-- Session 4 Quick Stats -->
          <div class="grid grid-cols-2 sm:grid-cols-6 gap-3">
            <div class="bg-white border border-navy/10 rounded-lg p-3.5 shadow-sm">
              <p class="font-mono text-[11px] uppercase text-muted">Teams Active</p>
              <p id="s4-stat-teams" class="font-display font-bold text-2xl text-ink mt-0.5">0</p>
            </div>
            <div class="bg-white border border-navy/10 rounded-lg p-3.5 shadow-sm">
              <p class="font-mono text-[11px] uppercase text-muted">Sort Placed</p>
              <p id="s4-stat-sort" class="font-display font-bold text-2xl text-blue mt-0.5">0</p>
            </div>
            <div class="bg-white border border-navy/10 rounded-lg p-3.5 shadow-sm">
              <p class="font-mono text-[11px] uppercase text-muted">Titles Saved</p>
              <p id="s4-stat-title" class="font-display font-bold text-2xl text-blue mt-0.5">0</p>
            </div>
            <div class="bg-white border border-navy/10 rounded-lg p-3.5 shadow-sm">
              <p class="font-mono text-[11px] uppercase text-muted">Intros Saved</p>
              <p id="s4-stat-intro" class="font-display font-bold text-2xl text-blue mt-0.5">0</p>
            </div>
            <div class="bg-white border border-amber-200 rounded-lg p-3.5 shadow-sm">
              <p class="font-mono text-[11px] uppercase text-amber-800">CF4 Pending</p>
              <p id="s4-stat-pending" class="font-display font-bold text-2xl text-amber-600 mt-0.5">0</p>
            </div>
            <div class="bg-white border border-emerald-200 rounded-lg p-3.5 shadow-sm">
              <p class="font-mono text-[11px] uppercase text-emerald-800">CF4 Approved</p>
              <p id="s4-stat-approved" class="font-display font-bold text-2xl text-emerald-600 mt-0.5">0</p>
            </div>
          </div>

          <!-- Session 4 View Sub-tabs -->
          <div class="flex items-center gap-2 border-b border-navy/10 pb-2">
            <button
              type="button"
              id="s4-tab-overview"
              class="px-4 py-2 border-b-2 border-blue text-blue font-semibold text-sm transition-colors"
            >
              Overview (All Teams)
            </button>
            <button
              type="button"
              id="s4-tab-cf4"
              class="px-4 py-2 border-b-2 border-transparent text-muted hover:text-ink font-medium text-sm transition-colors flex items-center gap-2"
            >
              <span>Case File #4 (Preprints)</span>
              <span id="s4-cards-pending-badge" class="hidden text-[11px] bg-amber-500 text-white font-bold px-1.5 py-0.2 rounded-full">0</span>
            </button>
            <button
              type="button"
              id="s4-tab-models"
              class="px-4 py-2 border-b-2 border-transparent text-muted hover:text-ink font-medium text-sm transition-colors"
            >
              Model Answers &amp; Guidance
            </button>
          </div>

          <!-- Sub-view 1: Overview Table -->
          <div id="s4-view-overview" class="space-y-4">
            <div class="overflow-x-auto bg-white border border-navy/10 rounded-lg shadow-sm">
              <table class="w-full text-[13px] text-left">
                <thead class="bg-paper border-b border-navy/10 text-muted uppercase text-[11px] font-mono tracking-wider">
                  <tr>
                    <th class="p-3.5">Team</th>
                    <th class="p-3.5">Members</th>
                    <th class="p-3.5">Step 1 Sort</th>
                    <th class="p-3.5">Step 2 Title</th>
                    <th class="p-3.5">Step 3 Intro</th>
                    <th class="p-3.5">Step 4 Result/Disc</th>
                    <th class="p-3.5">Step 5 Abstract</th>
                    <th class="p-3.5">Case File #4</th>
                    <th class="p-3.5">Updated</th>
                    <th class="p-3.5 text-right">Inspect</th>
                  </tr>
                </thead>
                <tbody id="s4-teams-body" class="divide-y divide-navy/10">
                  <tr><td colspan="10" class="p-6 text-center text-muted">Loading live Session 4 teams…</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Sub-view 2: Case File #4 Cards (Preprints with Green ✓ Approval) -->
          <div id="s4-view-cf4" class="hidden space-y-4">
            <div class="flex items-center justify-between flex-wrap gap-2">
              <div class="flex items-center gap-2">
                <button type="button" class="s4-filter-btn px-3 py-1 rounded-md text-xs font-semibold bg-ink text-white" data-filter="all">All</button>
                <button type="button" class="s4-filter-btn px-3 py-1 rounded-md text-xs font-medium text-muted hover:text-ink bg-white border border-navy/10" data-filter="pending">Pending Approval</button>
                <button type="button" class="s4-filter-btn px-3 py-1 rounded-md text-xs font-medium text-muted hover:text-ink bg-white border border-navy/10" data-filter="approved">Approved ✓</button>
              </div>
            </div>
            <div id="s4-cf4-list" class="space-y-4">
              <p class="text-sm text-muted p-6 text-center bg-white rounded-lg border border-navy/10">No Case File #4 submissions yet.</p>
            </div>
          </div>

          <!-- Sub-view 3: Model Answers & Guidance -->
          <div id="s4-view-models" class="hidden bg-white border border-navy/10 rounded-xl p-6 sm:p-8 space-y-6">
            <div>
              <h3 class="font-display font-bold text-lg text-ink">Session 4 · Mentor Answer Keys &amp; Pedagogical Guidance</h3>
              <p class="text-xs text-muted">Reference answers from the developer specification for Perham &amp; Currie (2014).</p>
            </div>

            <!-- Step 1 Sort Answers -->
            <div class="p-4 bg-paper rounded-xl border border-navy/10 space-y-2">
              <span class="font-mono text-xs font-bold text-blue uppercase">Step 1 · Sort Solutions:</span>
              <div class="grid sm:grid-cols-2 gap-2 text-xs">
                {sparkSession4.sortCards.map((c) => (
                  <div class="p-2 bg-white rounded border border-navy/5 flex items-start gap-2">
                    <span class="font-mono font-bold text-blue shrink-0">Card {c.id} ({c.correct}):</span>
                    <span>{c.reason}</span>
                  </div>
                ))}
              </div>
              <p class="text-[11px] text-muted italic pt-1">
                Note on Sentence H: It is said as a weakness, so it is a limit, and limits belong strictly in the Discussion.
              </p>
            </div>

            <!-- Step 2 Title Guidance -->
            <div class="p-4 bg-paper rounded-xl border border-navy/10 space-y-2 text-xs">
              <span class="font-mono font-bold text-blue uppercase">Step 2 · Title Criteria:</span>
              <p><strong>Published Real Title:</strong> "{sparkSession4.titleRecipe.realTitle}"</p>
              <p><strong>Approve if:</strong> Gives the topic and who, in neutral words (no exclamation marks or subjective drama). Ask, don't correct: "Would a stranger know what the paper is about?"</p>
            </div>

            <!-- Step 3 Intro Guidance -->
            <div class="p-4 bg-paper rounded-xl border border-navy/10 space-y-2 text-xs">
              <span class="font-mono font-bold text-blue uppercase">Step 3 · Model Introduction (4 Moves):</span>
              {sparkSession4.introMoves.map((m) => (
                <p><strong>Move {m.num} ({m.title}):</strong> {m.model}</p>
              ))}
            </div>

            <!-- Step 4 Result & Discussion Guidance -->
            <div class="p-4 bg-paper rounded-xl border border-navy/10 space-y-2 text-xs">
              <span class="font-mono font-bold text-blue uppercase">Step 4 · Result &amp; Discussion Models:</span>
              <p><strong>Result (Facts Only):</strong> {sparkSession4.resultDiscussion.result.model}</p>
              <p><strong>Discussion (Mechanism + Limit):</strong> {sparkSession4.resultDiscussion.discussion.model}</p>
            </div>

            <!-- Step 5 Abstract Model -->
            <div class="p-4 bg-paper rounded-xl border border-navy/10 space-y-2 text-xs">
              <span class="font-mono font-bold text-blue uppercase">Step 5 · Model 5-Sentence Abstract:</span>
              {sparkSession4.abstractGuide.map((b) => (
                <p><strong>{b.num}. {b.name}:</strong> {b.model}</p>
              ))}
            </div>
          </div>
        </div>

        <!-- =========================================================================
             SESSION 3 · LIVE PANEL (Default)
             ========================================================================= -->
        <div id="session-3-wrap" class="space-y-6">

          <!-- Session 3 Control Bar: Room Step + Live Answer Key Reveals -->
          <div class="bg-white border border-navy/10 p-5 rounded-lg shadow-sm space-y-4">
            <!-- Row 1: Room Step Progress -->
            <div class="flex flex-wrap items-center justify-between gap-4">
              <div class="flex items-center gap-3">
                <span class="text-sm font-semibold text-muted uppercase font-mono text-[11px] tracking-wider">Session 3 Room Step:</span>
                <span id="s3-current-step" class="font-display font-bold text-blue text-base">Step 0 · Yacine’s Message</span>
              </div>

              <div class="flex flex-wrap items-center gap-2">
                <button type="button" id="s3-unlock-next" class="btn btn-sm btn-primary">Unlock next step →</button>
                <button type="button" id="s3-admin-reset" class="hidden btn btn-sm btn-secondary btn-on-light text-signal border-signal/40 hover:bg-signal/5">
                  Reset Session 3
                </button>
              </div>

              <div class="flex items-center gap-1.5 w-full sm:w-auto pt-2 sm:pt-0 border-t sm:border-t-0 border-navy/10">
                <span class="text-[12px] text-muted font-mono uppercase mr-1">Jump:</span>
                <div class="flex gap-1" id="s3-jump-steps"></div>
              </div>
            </div>

            <!-- Row 2: Live Room Answer Key Reveals -->
            <div class="pt-4 border-t border-navy/10 space-y-2.5">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <div>
                  <span class="text-[12px] font-mono uppercase tracking-wider font-bold text-ink">👑 Live Answer Key Reveals (All Student Screens)</span>
                  <p class="text-[12px] text-muted">Reveal or hide answer keys live on all student laptops. Keys 0 to 5 cover message, mistakes, paraphrases, PEEL model, peer checks, and approval criteria.</p>
                </div>
                <div class="flex items-center gap-1.5">
                  <button type="button" id="s3-reveal-all" class="px-2.5 py-1 rounded text-[12px] font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200 hover:bg-emerald-100 transition-colors">
                    Reveal All
                  </button>
                  <button type="button" id="s3-hide-all" class="px-2.5 py-1 rounded text-[12px] font-semibold bg-paper text-muted border border-navy/15 hover:text-ink transition-colors">
                    Hide All
                  </button>
                </div>
              </div>
              <div id="s3-reveal-controls" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2"></div>
            </div>
          </div>

          <!-- Session 3 Quick Stats -->
          <div class="grid grid-cols-2 sm:grid-cols-6 gap-3">
            <div class="bg-white border border-navy/10 rounded-lg p-3.5 shadow-sm">
              <p class="font-mono text-[11px] uppercase text-muted">Teams Active</p>
              <p id="s3-stat-teams" class="font-display font-bold text-2xl text-ink mt-0.5">0</p>
            </div>
            <div class="bg-white border border-navy/10 rounded-lg p-3.5 shadow-sm">
              <p class="font-mono text-[11px] uppercase text-muted">Mistakes Tagged</p>
              <p id="s3-stat-spots" class="font-display font-bold text-2xl text-blue mt-0.5">0</p>
            </div>
            <div class="bg-white border border-navy/10 rounded-lg p-3.5 shadow-sm">
              <p class="font-mono text-[11px] uppercase text-muted">PEEL Saved</p>
              <p id="s3-stat-peel" class="font-display font-bold text-2xl text-blue mt-0.5">0</p>
            </div>
            <div class="bg-white border border-navy/10 rounded-lg p-3.5 shadow-sm">
              <p class="font-mono text-[11px] uppercase text-muted">Peer Reviews</p>
              <p id="s3-stat-peer" class="font-display font-bold text-2xl text-blue mt-0.5">0</p>
            </div>
            <div class="bg-white border border-amber-200 rounded-lg p-3.5 shadow-sm">
              <p class="font-mono text-[11px] uppercase text-amber-800">CF3 Pending</p>
              <p id="s3-stat-pending" class="font-display font-bold text-2xl text-amber-600 mt-0.5">0</p>
            </div>
            <div class="bg-white border border-emerald-200 rounded-lg p-3.5 shadow-sm">
              <p class="font-mono text-[11px] uppercase text-emerald-800">CF3 Approved</p>
              <p id="s3-stat-approved" class="font-display font-bold text-2xl text-emerald-600 mt-0.5">0</p>
            </div>
          </div>

          <!-- Session 3 Sub-tabs -->
          <div class="flex flex-wrap border-b border-navy/15 gap-4">
            <button type="button" id="s3-tab-overview" class="py-2.5 px-4 font-semibold text-[14px] border-b-2 border-blue text-blue transition-colors">
              Teams Overview
            </button>
            <button type="button" id="s3-tab-cf3" class="py-2.5 px-4 font-medium text-[14px] border-b-2 border-transparent text-muted hover:text-ink transition-colors flex items-center gap-2">
              <span>Case File #3 Review</span>
              <span id="s3-cards-pending-badge" class="hidden text-[11px] bg-amber-500 text-white font-bold px-2 py-0.5 rounded-full">0</span>
            </button>
            <button type="button" id="s3-tab-peer" class="py-2.5 px-4 font-medium text-[14px] border-b-2 border-transparent text-muted hover:text-ink transition-colors flex items-center gap-2">
              <span>🤝 Peer Swaps &amp; Answer Key</span>
            </button>
          </div>

          <!-- S3 SUB-TAB 1: TEAMS OVERVIEW -->
          <div id="s3-view-overview" class="space-y-4">
            <div class="overflow-x-auto bg-white border border-navy/10 rounded-lg shadow-sm">
              <table class="w-full text-[13px] text-left">
                <thead class="bg-paper border-b border-navy/10 text-muted uppercase text-[11px] font-mono tracking-wider">
                  <tr>
                    <th class="p-3.5">Team</th>
                    <th class="p-3.5">Members</th>
                    <th class="p-3.5">Step 1 Mistakes</th>
                    <th class="p-3.5">Step 2 Paraphrases</th>
                    <th class="p-3.5">Step 3 PEEL</th>
                    <th class="p-3.5">Step 4 Peer Review</th>
                    <th class="p-3.5">Case File #3</th>
                    <th class="p-3.5">Updated</th>
                    <th class="p-3.5 text-right">Inspect</th>
                  </tr>
                </thead>
                <tbody id="s3-teams-body" class="divide-y divide-navy/10">
                  <tr><td colspan="9" class="p-6 text-center text-muted">Loading live Session 3 teams…</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- S3 SUB-TAB 2: CASE FILE #3 REVIEW -->
          <div id="s3-view-cf3" class="hidden space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-3 bg-white p-4 rounded-lg border border-navy/10 shadow-sm">
              <div>
                <h2 class="font-display font-bold text-lg text-ink">Step 5 — Case File #3 Submissions</h2>
                <p class="text-[13px] text-muted">Review each team's final PEEL paragraph for Yacine. Approving pops up a live green ✓ on their screen.</p>
              </div>
              <div class="flex gap-2 text-[13px]">
                <button type="button" class="s3-cf3-filter-btn px-3 py-1 rounded bg-navy/10 font-medium" data-filter="all">All</button>
                <button type="button" class="s3-cf3-filter-btn px-3 py-1 rounded text-muted hover:bg-navy/5" data-filter="pending">Pending review</button>
