      </div>

      <div class="p-4 bg-paper rounded border border-navy/10 space-y-1.5">
        <p class="font-mono text-[11px] uppercase font-bold text-blue">Step 4 · Model Reading Card</p>
        <p class="text-emerald-800 font-medium">${escapeHtml(k.step4.approvalRule)}</p>
        <div class="grid sm:grid-cols-2 gap-2 pt-1">${k.step4.boxes.map((b) => `<div class="bg-white p-2 rounded border border-navy/10"><strong>${escapeHtml(b.title)}:</strong> ${escapeHtml(b.answer)}</div>`).join('')}</div>
      </div>

      <div class="p-4 bg-paper rounded border border-navy/10 space-y-1.5">
        <p class="font-mono text-[11px] uppercase font-bold text-blue">Step 5 · Case File #2 Model Verdict</p>
        <p><strong>Model sentence for Yacine:</strong> "${escapeHtml(k.step5.modelVerdict)}"</p>
        <p><strong>Accepted limits:</strong> ${k.step5.acceptedLimits.map((x) => escapeHtml(x)).join(' • ')}</p>
      </div>
    `;
  });

  /* =========================================================================
     SESSION 1 RENDERING & HANDLERS (Preserved)
     ========================================================================= */
  function renderOverview(data: MentorOverview) {
    document.getElementById('current-step')!.textContent = `Step ${data.state.unlocked_step} · ${stepLabels[data.state.unlocked_step]}`;
    (document.getElementById('reveal-mission') as HTMLButtonElement).classList.toggle('btn-primary', data.state.mission_revealed);

    const body = document.getElementById('teams-body')!;
    if (!data.teams.length) {
      body.innerHTML = '<tr><td colspan="9" class="p-6 text-center text-muted">No teams have joined yet. Share /spark/join with students.</td></tr>';
      return;
    }

    body.innerHTML = data.teams
      .map((t) => {
        let qStatusBadge = '<span class="text-muted">Draft</span>';
        if (t.step1_status === 'approved') {
          qStatusBadge = '<span class="text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded font-semibold text-[11px]">✓ Approved</span>';
        } else if (t.step1_status === 'pending') {
          qStatusBadge = '<span class="text-amber-700 bg-amber-50 px-2 py-0.5 rounded font-semibold text-[11px]">⏳ Pending</span>';
        }

        const safeId = encodeURIComponent(t.id);
        return `
          <tr class="hover:bg-paper/70 transition-colors">
            <td class="p-3.5 font-semibold text-ink">
              <a href="/spark/mentor/team?id=${safeId}" class="hover:text-blue hover:underline">
                ${escapeHtml(t.name)} <span class="text-muted font-mono text-[11px] block font-normal">${escapeHtml(t.code)}</span>
              </a>
            </td>
            <td class="p-3.5 text-body">${escapeHtml(t.members.join(', '))}</td>
            <td class="p-3.5 text-muted">${t.assigned_mentor ? escapeHtml(t.assigned_mentor) : '<span class="text-muted/60">—</span>'}</td>
            <td class="p-3.5">${qStatusBadge}</td>
            <td class="p-3.5 font-mono">${Number(t.cards_sorted) || 0} / 8</td>
            <td class="p-3.5">${t.key_paper_found ? '<span class="text-emerald-600 font-bold">Yes ★</span>' : '<span class="text-muted">—</span>'}</td>
            <td class="p-3.5 font-mono">${Number(t.hints_opened) || 0}</td>
            <td class="p-3.5 text-muted text-[12px]">${escapeHtml(new Date(t.last_activity).toLocaleTimeString())}</td>
            <td class="p-3.5 text-right">
              <a href="/spark/mentor/team?id=${safeId}" class="btn btn-sm btn-secondary btn-on-light !py-1 !px-2.5 !text-[12px]">
                Details →
              </a>
            </td>
          </tr>
        `;
      })
      .join('');
  }

  function updatePendingBadge() {
    const pendingCount = currentQuestions.filter((q) => q.status === 'pending').length;
    for (const id of ['questions-pending-badge', 's1-top-pending-badge']) {
      const badge = document.getElementById(id)!;
      if (pendingCount > 0) {
        badge.textContent = String(pendingCount);
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    }
  }

  function renderQuestions(force = false) {
    const list = document.getElementById('questions-list')!;
    if (!force && document.activeElement && list.contains(document.activeElement) && document.activeElement.tagName === 'INPUT') {
      return;
    }
    let filtered = currentQuestions;
    if (questionFilter === 'pending') filtered = currentQuestions.filter((q) => q.status === 'pending');
    else if (questionFilter === 'approved') filtered = currentQuestions.filter((q) => q.status === 'approved');

    if (!filtered.length) {
      list.innerHTML = `<div class="bg-white p-8 text-center text-muted rounded border border-navy/10">No questions found in this filter.</div>`;
      return;
    }

    list.innerHTML = filtered
      .map((q) => {
        const isPending = q.status === 'pending';
        const isApproved = q.status === 'approved';

        let badge = '<span class="text-muted bg-navy/5 px-2.5 py-1 rounded text-[12px]">Draft</span>';
        if (isApproved) {
          badge = `<span class="bg-emerald-100 text-emerald-800 font-semibold px-2.5 py-1 rounded text-[12px] flex items-center gap-1">✓ Approved ${q.approved_by ? `by ${escapeHtml(q.approved_by)}` : ''}</span>`;
        } else if (isPending) {
          badge = '<span class="bg-amber-100 text-amber-900 font-semibold px-2.5 py-1 rounded text-[12px] animate-pulse">⏳ Pending Review</span>';
        }

        const safeTeamId = encodeURIComponent(q.team_id);
        return `
          <div class="bg-white border ${isPending ? 'border-amber-300 ring-1 ring-amber-200' : 'border-navy/10'} rounded-lg p-5 shadow-sm space-y-4" data-team-id="${escapeHtml(q.team_id)}">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-navy/10 pb-3">
              <div>
                <a href="/spark/mentor/team?id=${safeTeamId}" class="font-display font-bold text-lg text-ink hover:text-blue hover:underline">
                  ${escapeHtml(q.team_name)}
                </a>
                <span class="text-muted font-mono text-[12px] ml-2">${escapeHtml(q.team_code)}</span>
                <span class="text-muted text-[13px] block sm:inline sm:ml-3">(${escapeHtml(q.members.join(', '))})</span>
              </div>
              <div class="flex items-center gap-2">
                ${badge}
                <a href="/spark/mentor/team?id=${safeTeamId}" class="text-[12px] text-blue hover:underline ml-2">Team page →</a>
              </div>
            </div>

            <div>
              <p class="font-mono text-[11px] uppercase tracking-wider text-muted">Research question</p>
              <p class="text-[16px] font-medium text-ink mt-1 font-serif">${q.question_text ? escapeHtml(q.question_text) : '<span class="text-muted italic">Not written yet</span>'}</p>
            </div>

            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-2 text-[13px] bg-paper p-3 rounded border border-navy/10">
              <div><span class="font-semibold text-ink">Who:</span> <span class="text-body">${q.who ? escapeHtml(q.who) : '—'}</span></div>
              <div><span class="font-semibold text-ink">What tested:</span> <span class="text-body">${q.what ? escapeHtml(q.what) : '—'}</span></div>
              <div><span class="font-semibold text-ink">Compared to:</span> <span class="text-body">${q.compared_to ? escapeHtml(q.compared_to) : '—'}</span></div>
              <div><span class="font-semibold text-ink">Measured how:</span> <span class="text-body">${q.measured_how ? escapeHtml(q.measured_how) : '—'}</span></div>
            </div>

            ${
              isPending
                ? `
              <div class="pt-2 border-t border-navy/10 flex flex-wrap items-center gap-3">
                <input class="field text-[13px] !py-1.5 flex-1 min-w-[200px] q-comment-input" placeholder="Optional short comment (e.g. 'Great focus', 'Solid variables')" />
                <button type="button" class="btn btn-sm btn-primary bg-emerald-600 hover:bg-emerald-700 text-white font-semibold approve-btn flex items-center gap-1.5">
                  <span>✓ Approve</span>
                </button>
              </div>
            `
                : ''
            }

            ${
              isApproved && q.mentor_comment
                ? `
              <p class="text-[12px] text-emerald-800 bg-emerald-50 px-3 py-1.5 rounded border border-emerald-200">
                <strong>Mentor note:</strong> "${escapeHtml(q.mentor_comment)}"
              </p>
            `
                : ''
            }
          </div>
        `;
      })
      .join('');

    list.querySelectorAll('.approve-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const card = target.closest('[data-team-id]') as HTMLElement;
        const teamId = card.dataset.teamId!;
        const comment = (card.querySelector('.q-comment-input') as HTMLInputElement)?.value.trim() || undefined;

        target.disabled = true;
        target.textContent = 'Approving…';

        try {
          await mentorApproveStep1(mentor!.token, teamId, mentor!.mentorName, comment);
          await refreshAll();
        } catch (err) {
          alert(friendlyError(err));
          target.disabled = false;
          target.textContent = '✓ Approve';
        }
      });
    });
  }

  document.querySelectorAll('.q-filter-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('.q-filter-btn').forEach((b) => {
        b.classList.remove('bg-navy/10', 'font-medium');
        b.classList.add('text-muted');
      });
      const target = e.currentTarget as HTMLButtonElement;
      target.classList.add('bg-navy/10', 'font-medium');
      target.classList.remove('text-muted');
      questionFilter = target.dataset.filter as any;
      renderQuestions(true);
    });
  });

  async function setStep(n: number) {
    if (!mentor) return;
    try {
      await mentorSetStep(mentor.token, n);
      await refreshAll();
    } catch (e) {
      alert(friendlyError(e));
    }
  }

  document.getElementById('unlock-next')?.addEventListener('click', async () => {
    const current = document.getElementById('current-step')!.textContent?.match(/Step (\d)/);
    const n = Math.min(5, Number(current?.[1] ?? 0) + 1);
    await setStep(n);
  });

  document.getElementById('reveal-mission')?.addEventListener('click', async () => {
    if (!mentor) return;
    const btn = document.getElementById('reveal-mission') as HTMLButtonElement;
    const next = !btn.classList.contains('btn-primary');
    try {
      await mentorRevealMission(mentor.token, next);
      await refreshAll();
    } catch (e) {
      alert(friendlyError(e));
    }
  });

  document.getElementById('export-csv')?.addEventListener('click', async () => {
    if (!mentor) return;
    try {
      const rows = await mentorExport(mentor.token);
      if (!rows.length) return alert('No teams yet.');
      const headers = Object.keys(rows[0]);
      const csv = [
        headers.join(','),
        ...rows.map((r) => headers.map((h) => safeCsvCell((r as any)[h])).join(',')),
      ].join('\n');
      const blob = new Blob([csv], { type: 'text/csv' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `spark-session-1-export-${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
    } catch (e) {
      alert(friendlyError(e));
    }
  });

  document.getElementById('admin-reset')?.addEventListener('click', async () => {
    if (!mentor) return;
    if (!confirm('RESET SESSION 1: Reset the whole session? This permanently deletes every team and all answers.')) return;
    try {
      await adminReset(mentor.token);
      await refreshAll();
      alert('Session reset.');
    } catch (e) {
      alert(friendlyError(e));
    }
  });

  document.getElementById('logout-btn')?.addEventListener('click', () => {
    clearMentor();
    mentor = null;
    location.reload();
  });

  loginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const pw = (document.getElementById('mentor-password') as HTMLInputElement).value;
    const name = (document.getElementById('mentor-name-input') as HTMLInputElement).value.trim();
    const err = document.getElementById('login-error')!;
    err.classList.add('hidden');
    try {
      const session = await mentorLogin(pw);
      session.mentorName = name || undefined;
      storeMentor(session);
      mentor = session;
      await init();
    } catch (ex) {
      err.textContent = friendlyError(ex);
      err.classList.remove('hidden');
    }
  });

  init();
</script>
