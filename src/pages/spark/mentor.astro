  document.getElementById('s4-export-csv')?.addEventListener('click', async () => {
    if (!mentor) return;
    try {
      const rows = await mentorS4Export(mentor.token);
      if (!rows.length) return alert('No teams yet.');
      const headers = Object.keys(rows[0]);
      const csv = [
        headers.join(','),
        ...rows.map((r) => headers.map((h) => safeCsvCell((r as any)[h])).join(',')),
      ].join('\n');
      const blob = new Blob([csv], { type: 'text/csv' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `spark-session-4-export-${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
    } catch (e) {
      alert(friendlyError(e));
    }
  });

  document.getElementById('s4-inspect-close')?.addEventListener('click', () => {
    document.getElementById('s4-inspect-modal')?.classList.add('hidden');
    s4InspectTeamId = null;
  });

  /* =========================================================================
     SESSION 3 RENDERING & HANDLERS
     ========================================================================= */
  function renderS3Overview(data: MentorS3Overview) {
    const curStep = data.state?.unlocked_step ?? 0;
    const stepLabel = document.getElementById('s3-current-step');
    if (stepLabel) {
      stepLabel.textContent = `Step ${curStep} · ${s3StepLabels[curStep] || ''}`;
    }

    // Update S3 jump buttons
    document.querySelectorAll<HTMLButtonElement>('#s3-jump-steps button').forEach((b) => {
      const step = Number(b.dataset.s3Jump);
      const active = step === curStep;
      b.classList.toggle('bg-blue', active);
      b.classList.toggle('text-white', active);
      b.classList.toggle('border-blue', active);
    });

    // Update S3 reveal buttons
    const revs = (data.state?.revealed_steps || {}) as Record<string, boolean>;
    document.querySelectorAll<HTMLButtonElement>('#s3-reveal-controls button').forEach((b) => {
      const step = b.dataset.s3Reveal;
      const isRev = step !== undefined && Boolean(revs[step]);
      const pill = b.querySelector('.s3-rev-pill');
      b.classList.toggle('bg-emerald-50', isRev);
      b.classList.toggle('border-emerald-300', isRev);
      b.classList.toggle('text-emerald-950', isRev);
      if (pill) {
        pill.textContent = isRev ? 'REVEALED' : 'OFF';
        pill.className = `s3-rev-pill font-mono text-[10px] px-1.5 py-0.5 rounded font-bold ${
          isRev ? 'bg-emerald-600 text-white' : 'bg-navy/10 text-muted'
        }`;
      }
    });

    // Stats
    const teams = data.teams || [];
    let spotsCount = 0;
    let peelCount = 0;
    let peerCount = 0;
    let pendingCount = 0;
    let approvedCount = 0;

    teams.forEach((t) => {
      if (t.step1_spots && Object.keys(t.step1_spots).length > 0) spotsCount++;
      if (t.peel_saved || (t.improved_peel && t.improved_peel.p)) peelCount++;
      if (t.peer_review && t.peer_review.star) peerCount++;
      if (t.cf3_status === 'pending') pendingCount++;
      if (t.cf3_status === 'approved') approvedCount++;
    });

    document.getElementById('s3-stat-teams')!.textContent = String(teams.length);
    document.getElementById('s3-stat-spots')!.textContent = String(spotsCount);
    document.getElementById('s3-stat-peel')!.textContent = String(peelCount);
    document.getElementById('s3-stat-peer')!.textContent = String(peerCount);
    document.getElementById('s3-stat-pending')!.textContent = String(pendingCount);
    document.getElementById('s3-stat-approved')!.textContent = String(approvedCount);

    const pendingBadge = document.getElementById('s3-cards-pending-badge');
    const topBadge = document.getElementById('s3-top-pending-badge');
    if (pendingBadge) {
      pendingBadge.textContent = String(pendingCount);
      pendingBadge.classList.toggle('hidden', pendingCount === 0);
    }
    if (topBadge) {
      topBadge.textContent = String(pendingCount);
      topBadge.classList.toggle('hidden', pendingCount === 0);
    }

    // Render S3 Table
    const tbody = document.getElementById('s3-teams-body')!;
    if (!teams.length) {
      tbody.innerHTML = '<tr><td colspan="9" class="p-6 text-center text-muted">No teams registered yet.</td></tr>';
      return;
    }

    tbody.innerHTML = teams
      .map((t) => {
        const spotsTagged = Object.keys(t.step1_spots || {}).length;
        const p1Ok = Boolean(t.step2_p1 && t.step2_p1.trim());
        const p2Ok = Boolean(t.step2_p2 && t.step2_p2.trim());
        const peeks = (t.step2_peek1 || 0) + (t.step2_peek2 || 0);

        const peelP = Boolean(t.peel?.p && t.peel.p.trim());
        const peelE = Boolean(t.peel?.e && t.peel.e.trim());
        const peelExp = Boolean(t.peel?.explain && t.peel.explain.trim());
        const peelL = Boolean(t.peel?.l && t.peel.l.trim());

        const peerSent = Boolean(t.peer_review?.star && t.peer_review.star.trim());

        let cf3Badge = '<span class="px-2 py-0.5 rounded text-[11px] font-mono bg-paper text-muted border border-navy/10">Draft</span>';
        if (t.cf3_status === 'approved') {
          cf3Badge = '<span class="px-2 py-0.5 rounded text-[11px] font-mono bg-emerald-50 text-emerald-800 border border-emerald-200 font-bold">✓ Approved</span>';
        } else if (t.cf3_status === 'pending') {
          cf3Badge = '<span class="px-2 py-0.5 rounded text-[11px] font-mono bg-amber-500 text-white font-bold animate-pulse">● Pending</span>';
        }

        return `
          <tr class="hover:bg-paper/60 transition-colors">
            <td class="p-3.5 font-bold font-mono text-ink">${escapeHtml(t.name)} <span class="text-muted font-normal text-xs">(${escapeHtml(t.code)})</span></td>
            <td class="p-3.5 text-body text-[12px] max-w-xs truncate">${escapeHtml((t.members || []).join(', ') || '—')}</td>
            <td class="p-3.5 font-mono text-[12px]">${spotsTagged > 0 ? `<span class="text-blue font-bold">${spotsTagged}/7 tagged</span>` : '<span class="text-muted">—</span>'}</td>
            <td class="p-3.5 font-mono text-[12px]">${(p1Ok || p2Ok) ? `<span class="text-emerald-700">P1:${p1Ok ? '✓' : '—'} P2:${p2Ok ? '✓' : '—'}</span> <span class="text-muted text-[10px]">(${peeks} peeks)</span>` : '<span class="text-muted">—</span>'}</td>
            <td class="p-3.5 font-mono text-[12px]">${(peelP || peelE) ? `<span class="text-ink font-semibold">${peelP ? 'P' : '·'}${peelE ? 'E' : '·'}${peelExp ? 'E' : '·'}${peelL ? 'L' : '·'}</span>` : '<span class="text-muted">—</span>'}</td>
            <td class="p-3.5 font-mono text-[12px]">${peerSent ? `<span class="text-emerald-700">✓ Done</span>` : '<span class="text-muted">Waiting</span>'}</td>
            <td class="p-3.5">${cf3Badge}</td>
            <td class="p-3.5 font-mono text-[11px] text-muted">${t.s3_updated_at ? new Date(t.s3_updated_at).toLocaleTimeString() : '—'}</td>
            <td class="p-3.5 text-right">
              <button type="button" class="s3-btn-inspect btn btn-sm btn-secondary btn-on-light !py-1 !px-2.5 !text-[11px]" data-team-id="${t.id}">
                Inspect 👁️
              </button>
            </td>
          </tr>
        `;
      })
      .join('');

    tbody.querySelectorAll<HTMLButtonElement>('.s3-btn-inspect').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.teamId;
        if (id) openS3InspectModal(id);
      });
    });
  }

  function renderS3Cf3List(preserveScroll = false) {
    const container = document.getElementById('s3-cf3-list')!;
    const prevScroll = container.scrollTop;
    let teams = (s3Data?.teams || []).filter((t) => Boolean(t.peel?.p || t.improved_peel?.p || t.cf3_status !== 'draft'));

    if (s3Cf3Filter === 'pending') teams = teams.filter((t) => t.cf3_status === 'pending');
    if (s3Cf3Filter === 'approved') teams = teams.filter((t) => t.cf3_status === 'approved');

    if (!teams.length) {
      container.innerHTML = `<p class="text-center py-12 text-muted">No Case File #3 submissions matching filter "${escapeHtml(s3Cf3Filter)}".</p>`;
      return;
    }

    container.innerHTML = teams
      .map((t) => {
        const p = t.improved_peel?.p ? t.improved_peel : t.peel;
        const text = [p.p, p.e, p.explain, p.l].filter((s) => s && s.trim()).join(' ');
        const isApproved = t.cf3_status === 'approved';

        return `
          <div class="bg-white border ${isApproved ? 'border-emerald-300' : 'border-navy/10'} rounded-xl p-5 shadow-sm space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-navy/10 pb-3">
              <div>
                <span class="font-bold text-ink font-mono text-base">${escapeHtml(t.name)} (${escapeHtml(t.code)})</span>
                <p class="text-[12px] text-muted">${escapeHtml((t.members || []).join(', ') || '—')}</p>
              </div>
              <div class="flex items-center gap-2">
                ${
                  isApproved
                    ? `<span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">✓ Approved (${escapeHtml(t.cf3_approved_by || 'Mentor')})</span>`
                    : `<span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-amber-100 text-amber-800 border border-amber-300">● ${escapeHtml(t.cf3_status.toUpperCase())}</span>`
                }
              </div>
            </div>

            <div class="p-4 bg-paper rounded-lg space-y-2">
              <p class="text-[15px] text-ink font-serif leading-relaxed italic">"${escapeHtml(text || '(No paragraph text submitted)')}"</p>
              <p class="text-[12px] font-mono text-muted border-t border-navy/10 pt-2"><strong>Reference:</strong> ${escapeHtml(p.ref || sparkSession3.apaReference)}</p>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
              <div class="flex-1 max-w-md">
                ${
                  !isApproved
                    ? `<input type="text" class="field !mt-0 !h-9 !py-1 !text-[13px] s3-mentor-comment-input" placeholder="Mentor praise (e.g. Great neutral tone &amp; careful verbs!)" value="${escapeHtml(t.cf3_mentor_comment || '')}">`
                    : `<p class="text-[12px] text-emerald-900 italic font-medium">"${escapeHtml(t.cf3_mentor_comment || 'Approved by mentor')}"</p>`
                }
              </div>
              <div>
                ${
                  !isApproved
                    ? `<button type="button" class="btn btn-sm btn-primary bg-emerald-600 hover:bg-emerald-700 text-white s3-btn-approve-cf3" data-team-id="${t.id}">✓ Approve Case File #3</button>`
                    : `<span class="text-xs font-mono text-muted">Approved at ${t.cf3_approved_at ? new Date(t.cf3_approved_at).toLocaleTimeString() : '—'}</span>`
                }
              </div>
            </div>
          </div>
        `;
      })
      .join('');

    if (preserveScroll) container.scrollTop = prevScroll;

    container.querySelectorAll<HTMLButtonElement>('.s3-btn-approve-cf3').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        if (!mentor) return;
        const teamId = (e.currentTarget as HTMLButtonElement).dataset.teamId;
        if (!teamId) return;
        const card = (e.currentTarget as HTMLElement).closest('.bg-white');
        const comment = (card?.querySelector('.s3-mentor-comment-input') as HTMLInputElement)?.value || '';

        btn.disabled = true;
        btn.textContent = 'Approving…';
        try {
          await mentorS3ApproveCaseFile(mentor.token, teamId, mentor.mentorName, comment);
          await refreshAll();
        } catch (err: any) {
          alert(friendlyError(err));
          btn.disabled = false;
          btn.textContent = '✓ Approve Case File #3';
        }
      });
    });
  }

  function renderS3PeerList() {
    const container = document.getElementById('s3-peer-list')!;
    const teams = s3Data?.teams || [];
    const reviews = teams.filter((t) => t.peer_review && t.peer_review.star);

    const badge = document.getElementById('s3-peer-count-badge');
    if (badge) badge.textContent = `${reviews.length} reviews`;

    if (!reviews.length) {
      container.innerHTML = '<p class="text-[13px] text-muted italic">No peer reviews submitted yet.</p>';
      return;
    }

    container.innerHTML = reviews
      .map((t) => {
        const r = t.peer_review;
        const targetTeam = teams.find((x) => x.id === (r as any).target_team_id);
        const targetLabel = targetTeam ? `${targetTeam.name} (${targetTeam.code})` : ((r as any).target_team_code || 'Anonymous Team');

        return `
          <div class="p-3 bg-paper rounded-lg border border-navy/10 space-y-2 text-[13px]">
            <div class="flex items-center justify-between">
              <span class="font-bold text-ink">From: ${escapeHtml(t.name)} (${escapeHtml(t.code)}) → To: ${escapeHtml(targetLabel)}</span>
              <span class="text-[11px] font-mono text-muted">${(r.checks || []).length}/6 checks</span>
            </div>
            <p><strong>🌟 Star:</strong> <span class="text-body italic">"${escapeHtml(r.star)}"</span></p>
            <p><strong>💡 Wish:</strong> <span class="text-body italic">"${escapeHtml(r.wish)}"</span></p>
          </div>
        `;
      })
      .join('');
  }

  function openS3InspectModal(teamId: string) {
    const team = s3Data?.teams.find((t) => t.id === teamId);
    if (!team) return;
    s3InspectTeamId = teamId;
    s3InspectLastHash = '';
    renderS3InspectModalBody(team);
    document.getElementById('s3-inspect-modal')?.classList.remove('hidden');
  }

