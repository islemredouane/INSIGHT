  // Session 3 Controls
  async function setS3Step(n: number) {
    if (!mentor) return;
    try {
      await mentorS3SetStep(mentor.token, n);
      await refreshAll();
    } catch (e) {
      alert(friendlyError(e));
    }
  }

  async function toggleS3Reveal(step: number) {
    if (!mentor) return;
    const current = Boolean(s3Data?.state?.revealed_steps?.[String(step)]);
    try {
      await mentorS3SetReveal(mentor.token, step, !current);
      await refreshAll();
    } catch (e) {
      alert(friendlyError(e));
    }
  }

  document.getElementById('s3-unlock-next')?.addEventListener('click', async () => {
    const cur = Number(s3Data?.state?.unlocked_step ?? 0);
    await setS3Step(Math.min(5, cur + 1));
  });

  document.getElementById('s3-reveal-all')?.addEventListener('click', async () => {
    if (!mentor) return;
    try {
      await mentorS3SetReveal(mentor.token, -1, true);
      await refreshAll();
    } catch (e) {
      alert(friendlyError(e));
    }
  });

  document.getElementById('s3-hide-all')?.addEventListener('click', async () => {
    if (!mentor) return;
    try {
      await mentorS3SetReveal(mentor.token, -1, false);
      await refreshAll();
    } catch (e) {
      alert(friendlyError(e));
    }
  });

  document.getElementById('s3-admin-reset')?.addEventListener('click', async () => {
    if (!mentor) return;
    if (!confirm('RESET SESSION 3: Clear all teams\' Session 3 answers, lock Session 3 back to Step 0, and hide all answer keys?\n\n(Registered teams, Session 1 & Session 2 data are kept intact.)')) return;
    try {
      await adminS3Reset(mentor.token);
      await refreshAll();
      alert('Session 3 reset cleanly to Step 0.');
    } catch (e) {
      alert(friendlyError(e));
    }
  });

  document.querySelectorAll('.s3-cf3-filter-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('.s3-cf3-filter-btn').forEach((b) => {
        b.classList.remove('bg-navy/10', 'font-medium');
        b.classList.add('text-muted');
      });
      const target = e.currentTarget as HTMLButtonElement;
      target.classList.add('bg-navy/10', 'font-medium');
      target.classList.remove('text-muted');
      s3Cf3Filter = target.dataset.filter as any;
      renderS3Cf3List(true);
    });
  });

  document.getElementById('s3-export-csv')?.addEventListener('click', async () => {
    if (!mentor) return;
    try {
      const rows = await mentorS3Export(mentor.token);
      if (!rows.length) return alert('No teams yet.');
      const headers = Object.keys(rows[0]);
      const csv = [
        headers.join(','),
        ...rows.map((r) => headers.map((h) => safeCsvCell((r as any)[h])).join(',')),
      ].join('\n');
      const blob = new Blob([csv], { type: 'text/csv' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `spark-session-3-export-${new Date().toISOString().slice(0, 10)}.csv`;
      a.click();
    } catch (e) {
      alert(friendlyError(e));
    }
  });

  document.getElementById('s3-toggle-key-ref')?.addEventListener('click', (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const body = document.getElementById('s3-mentor-key-body')!;
    const isHidden = body.classList.contains('hidden');
    body.classList.toggle('hidden', !isHidden);
    btn.textContent = isHidden ? 'Hide Answer Key' : 'Show Answer Key';
  });

  document.getElementById('s3-inspect-close')?.addEventListener('click', () => {
    document.getElementById('s3-inspect-modal')?.classList.add('hidden');
    s3InspectTeamId = null;
  });

  /* =========================================================================
     SESSION 2 RENDERING & HANDLERS
     ========================================================================= */
  function countFilled(obj: Record<string, unknown> | undefined | null): number {
    if (!obj || typeof obj !== 'object') return 0;
    return Object.values(obj).filter((v) => String(v ?? '').trim().length > 0).length;
  }

  function countNonEmpty(arr: unknown[] | undefined | null): number {
    if (!Array.isArray(arr)) return 0;
    return arr.filter((v) => String(v ?? '').trim().length > 0).length;
  }

  function renderS2Overview(data: MentorS2Overview) {
    const step = Number(data.state?.unlocked_step ?? 0);
    document.getElementById('s2-current-step')!.textContent = `Step ${step} · ${s2StepLabels[step] ?? ''}`;

    // Highlight active jump button
    s2JumpWrap.querySelectorAll<HTMLButtonElement>('[data-s2-jump]').forEach((btn) => {
      const idx = Number(btn.dataset.s2Jump);
      btn.classList.toggle('bg-blue', idx === step);
      btn.classList.toggle('text-white', idx === step);
      btn.classList.toggle('border-blue', idx === step);
    });

    // Update reveal toggles
    const rev = data.state?.revealed_steps || {};
    s2RevealWrap.querySelectorAll<HTMLButtonElement>('[data-s2-reveal]').forEach((btn) => {
      const k = btn.dataset.s2Reveal!;
      const isOn = Boolean(rev[k]);
      btn.classList.toggle('bg-emerald-50', isOn);
      btn.classList.toggle('border-emerald-400', isOn);
      btn.classList.toggle('text-emerald-900', isOn);
      btn.classList.toggle('bg-paper', !isOn);
      btn.classList.toggle('border-navy/15', !isOn);
      btn.classList.toggle('text-muted', !isOn);
      const pill = btn.querySelector('.s2-rev-pill');
      if (pill) {
        pill.textContent = isOn ? '👁 ON' : 'OFF';
        pill.className = isOn
          ? 's2-rev-pill font-mono text-[10px] px-1.5 py-0.5 rounded bg-emerald-600 text-white'
          : 's2-rev-pill font-mono text-[10px] px-1.5 py-0.5 rounded bg-navy/10 text-muted';
      }
    });

    // Stats & pending badges
    const teams = data.teams || [];
    const pendingCards = teams.filter((t) => t.card_status === 'pending').length;
    const approvedCards = teams.filter((t) => t.card_status === 'approved').length;
    const lockedPreds = teams.filter((t) => t.prediction_locked).length;
    const cf2Saved = teams.filter((t) => t.cf2_saved).length;

    document.getElementById('s2-stat-teams')!.textContent = String(teams.length);
    document.getElementById('s2-stat-preds')!.textContent = String(lockedPreds);
    document.getElementById('s2-stat-pending')!.textContent = String(pendingCards);
    document.getElementById('s2-stat-approved')!.textContent = String(approvedCards);
    document.getElementById('s2-stat-cf2')!.textContent = String(cf2Saved);

    const jarBadge = document.getElementById('s2-jar-count-badge')!;
    jarBadge.textContent = String((data.word_jar || []).length);

    for (const id of ['s2-cards-pending-badge', 's2-top-pending-badge']) {
      const el = document.getElementById(id)!;
      if (pendingCards > 0) {
        el.textContent = String(pendingCards);
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    }

    // Teams table
    const body = document.getElementById('s2-teams-body')!;
    if (!teams.length) {
      body.innerHTML = '<tr><td colspan="10" class="p-6 text-center text-muted">No teams have joined yet. Share /spark/join with students.</td></tr>';
      return;
    }

    body.innerHTML = teams
      .map((t) => {
        const hwCount = (t.hw_q1?.trim() ? 1 : 0) + (t.hw_q2?.trim() ? 1 : 0);
        const pagesCount = Object.values(t.pages || {}).filter((v) => Number(v) > 0).length;
        const trickCount = countFilled(t.trick as unknown as Record<string, unknown>);
        const yCount = countNonEmpty(t.yellow);
        const bCount = countNonEmpty(t.blue);
        const topPick = t.prediction?.[0] ? CONDITION_LABELS[t.prediction[0]] || t.prediction[0] : '';

        let cardBadge = '<span class="text-muted text-[12px]">Draft</span>';
        if (t.card_status === 'approved') {
          cardBadge = '<span class="text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded font-semibold text-[11px]">✓ Approved</span>';
        } else if (t.card_status === 'pending') {
          cardBadge = '<span class="text-amber-800 bg-amber-50 border border-amber-300 px-2 py-0.5 rounded font-semibold text-[11px] animate-pulse">⏳ Pending</span>';
        }

        const predCell = t.prediction_locked
          ? `<span class="text-emerald-700 font-semibold text-[12px]" title="${escapeHtml(topPick)}">🔒 ${escapeHtml(topPick.slice(0, 18))}</span>`
          : '<span class="text-muted">—</span>';

        const cf2Cell = t.cf2_saved
          ? `<span class="text-emerald-700 font-semibold text-[12px]">✓ ${escapeHtml(t.cf2?.choice || 'Saved')}</span>`
          : '<span class="text-muted">—</span>';

        const updatedTime = t.s2_updated_at || t.last_activity;
        const timeStr = updatedTime ? new Date(updatedTime).toLocaleTimeString() : '—';

        return `
          <tr class="hover:bg-paper/70 transition-colors ${t.card_status === 'pending' ? 'bg-amber-50/30' : ''}">
            <td class="p-3.5 font-semibold text-ink">
              <button type="button" class="s2-inspect-trigger text-left hover:text-blue hover:underline" data-team-id="${escapeHtml(t.id)}">
                ${escapeHtml(t.name)}
                <span class="text-muted font-mono text-[11px] block font-normal">${escapeHtml(t.code)}</span>
              </button>
            </td>
            <td class="p-3.5 text-body text-[12px]">${escapeHtml((t.members || []).join(', '))}</td>
            <td class="p-3.5 font-mono text-[12px]">${hwCount}/2</td>
            <td class="p-3.5 font-mono text-[12px]">${pagesCount}/${PAPER_PARTS_COUNT} · ${trickCount}/4</td>
            <td class="p-3.5 font-mono text-[12px]">Y:${yCount} · B:${bCount}</td>
            <td class="p-3.5">${predCell}</td>
            <td class="p-3.5">${cardBadge}</td>
            <td class="p-3.5">${cf2Cell}</td>
            <td class="p-3.5 text-muted text-[12px]">${escapeHtml(timeStr)}</td>
            <td class="p-3.5 text-right">
              <button type="button" class="s2-inspect-trigger btn btn-sm btn-secondary btn-on-light !py-1 !px-2.5 !text-[12px]" data-team-id="${escapeHtml(t.id)}">
                Inspect
              </button>
            </td>
          </tr>
        `;
      })
      .join('');

    body.querySelectorAll<HTMLButtonElement>('.s2-inspect-trigger').forEach((btn) => {
      btn.addEventListener('click', () => openInspectModal(btn.dataset.teamId!));
    });
  }

  function renderS2Cards(force = false) {
    const list = document.getElementById('s2-cards-list')!;
    // Don't clobber the DOM while a mentor is actively typing in a comment input
    if (!force && document.activeElement && list.contains(document.activeElement) && document.activeElement.tagName === 'INPUT') {
      return;
    }
    const teams = s2Data?.teams || [];
    let filtered = teams;
    if (s2CardFilter === 'pending') filtered = teams.filter((t) => t.card_status === 'pending');
    else if (s2CardFilter === 'approved') filtered = teams.filter((t) => t.card_status === 'approved');

    // Sort pending first, then approved, then draft
    const order: Record<string, number> = { pending: 0, approved: 1, draft: 2 };
    filtered = [...filtered].sort((a, b) => (order[a.card_status] ?? 2) - (order[b.card_status] ?? 2));

    if (!filtered.length) {
      list.innerHTML = '<div class="bg-white p-8 text-center text-muted rounded-lg border border-navy/10">No Reading Cards in this filter yet.</div>';
      return;
    }

    // Preserve any comment text the mentor is currently typing before re-rendering
    const draftComments: Record<string, string> = {};
    list.querySelectorAll<HTMLElement>('[data-s2-card-team]').forEach((el) => {
      const inp = el.querySelector<HTMLInputElement>('.s2-card-comment-input');
      if (inp && inp.value) draftComments[el.dataset.s2CardTeam!] = inp.value;
    });

    list.innerHTML = filtered
      .map((t) => {
        const isPending = t.card_status === 'pending';
        const isApproved = t.card_status === 'approved';
        const rc = t.reading_card || {};
        const filledBoxes = READING_BOXES.filter((b) => String(rc[b.id] || '').trim().length > 0).length;

        let badge = `<span class="text-muted bg-navy/5 px-2.5 py-1 rounded text-[12px]">Draft (${filledBoxes}/8 boxes)</span>`;
        if (isApproved) {
          badge = `<span class="bg-emerald-100 text-emerald-800 font-semibold px-2.5 py-1 rounded text-[12px]">✓ Approved ${t.card_approved_by ? `by ${escapeHtml(t.card_approved_by)}` : ''}</span>`;
        } else if (isPending) {
          badge = `<span class="bg-amber-100 text-amber-900 font-semibold px-2.5 py-1 rounded text-[12px] animate-pulse">⏳ Pending Review (${filledBoxes}/8)</span>`;
        }

        const boxesHtml = READING_BOXES.map((b) => {
          const val = String(rc[b.id] || '').trim();
          return `
            <div class="bg-paper/70 p-2.5 rounded border border-navy/10">
              <p class="font-mono text-[10px] uppercase tracking-wider text-muted font-bold">${escapeHtml(b.title)}</p>
              <p class="text-[13px] text-ink mt-1 whitespace-pre-wrap">${val ? escapeHtml(val) : '<span class="text-muted italic">—</span>'}</p>
            </div>
          `;
        }).join('');

        return `
          <div class="bg-white border ${isPending ? 'border-amber-300 ring-1 ring-amber-200' : 'border-navy/10'} rounded-lg p-5 shadow-sm space-y-4" data-s2-card-team="${escapeHtml(t.id)}">
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-navy/10 pb-3">
              <div>
                <span class="font-display font-bold text-lg text-ink">${escapeHtml(t.name)}</span>
                <span class="text-muted font-mono text-[12px] ml-2">${escapeHtml(t.code)}</span>
                <span class="text-muted text-[13px] block sm:inline sm:ml-3">(${escapeHtml((t.members || []).join(', '))})</span>
              </div>
              <div class="flex items-center gap-2">
                ${badge}
              </div>
            </div>

            <div class="grid sm:grid-cols-2 gap-2.5">
              ${boxesHtml}
            </div>

            ${
              !isApproved
                ? `
              <div class="pt-3 border-t border-navy/10 flex flex-wrap items-center gap-3">
                <input
                  class="field !mt-0 text-[13px] !py-1.5 flex-1 min-w-[220px] s2-card-comment-input"
                  placeholder="Optional mentor note (e.g. 'Great synthesis in your own words!')"
                  value="${escapeHtml(draftComments[t.id] || '')}"
                />
                <button type="button" class="btn btn-sm btn-primary bg-emerald-600 hover:bg-emerald-700 text-white font-semibold s2-approve-card-btn">
                  ✓ Approve Reading Card
                </button>
              </div>
            `
                : t.card_mentor_comment
                  ? `<p class="text-[12px] text-emerald-800 bg-emerald-50 px-3 py-2 rounded border border-emerald-200"><strong>Mentor note:</strong> "${escapeHtml(t.card_mentor_comment)}"</p>`
                  : ''
            }
          </div>
        `;
      })
      .join('');

    list.querySelectorAll<HTMLButtonElement>('.s2-approve-card-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!mentor) return;
        const cardEl = btn.closest<HTMLElement>('[data-s2-card-team]')!;
        const teamId = cardEl.dataset.s2CardTeam!;
        const comment = cardEl.querySelector<HTMLInputElement>('.s2-card-comment-input')?.value.trim() || undefined;
        btn.disabled = true;
        btn.textContent = 'Approving…';
        try {
          await mentorS2ApproveCard(mentor.token, teamId, mentor.mentorName, comment);
          await refreshAll();
        } catch (err) {
          alert(friendlyError(err));
          btn.disabled = false;
          btn.textContent = '✓ Approve Reading Card';
        }
      });
    });
  }

  function renderS2Jar() {
    const jarWrap = document.getElementById('s2-word-jar-list')!;
    const totalLabel = document.getElementById('s2-jar-total-label')!;
    const words = s2Data?.word_jar || [];
    const totalCount = words.reduce((acc, w) => acc + Number(w.count || 0), 0);
    totalLabel.textContent = `${words.length} unique · ${totalCount} total`;

    if (!words.length) {
      jarWrap.innerHTML = '<p class="text-[13px] text-muted italic">No teams have added Pink Words to the Word Jar yet.</p>';
      return;
    }

    jarWrap.innerHTML = words
      .map((item, idx) => {
        const isTop = idx < 2;
        return `
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-[13px] font-medium ${
            isTop
              ? 'bg-pink-600 text-white shadow-sm'
              : 'bg-pink-50 text-pink-900 border border-pink-200'
          }">
            ${isTop ? '<span>🔥</span>' : ''}
            <span>${escapeHtml(item.word)}</span>
            <span class="font-mono text-[11px] px-1.5 py-0.5 rounded-full ${isTop ? 'bg-white/20 text-white' : 'bg-pink-200/70 text-pink-900'}">${Number(item.count)}×</span>
          </span>
        `;
      })
      .join('');
  }

  // Inspect Team Modal
  const inspectModal = document.getElementById('s2-inspect-modal')!;
  const inspectClose = document.getElementById('s2-inspect-close')!;
  inspectClose.addEventListener('click', () => {
    s2InspectTeamId = null;
    inspectModal.classList.add('hidden');
  });
  inspectModal.addEventListener('click', (e) => {
    if (e.target === inspectModal) {
      s2InspectTeamId = null;
      inspectModal.classList.add('hidden');
    }
  });

  function openInspectModal(teamId: string) {
    const team = s2Data?.teams.find((t) => t.id === teamId);
    if (!team) return;
    s2InspectTeamId = teamId;
    s2InspectLastHash = '';
    renderInspectModalBody(team);
    inspectModal.classList.remove('hidden');
  }

  function renderInspectModalBody(t: MentorS2TeamRow) {
