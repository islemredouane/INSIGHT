        <p class="font-mono text-[11px] uppercase font-bold text-blue">Step 3 · Real Ranking &amp; Table 1</p>
        <ol class="space-y-1">${k.step3.ranking.map((r) => `<li><strong>${escapeHtml(r.rank)} ${escapeHtml(r.icon)} ${escapeHtml(r.title)}</strong> — ${escapeHtml(r.note)}</li>`).join('')}</ol>
