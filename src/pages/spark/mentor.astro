  const viewQuestions = document.getElementById('view-questions')!;

  tabOverview.addEventListener('click', () => switchTab('overview'));
  tabQuestions.addEventListener('click', () => switchTab('questions'));

  function switchTab(tab: 'overview' | 'questions') {
    if (tab === 'overview') {
      tabOverview.classList.add('border-blue', 'text-blue');
      tabOverview.classList.remove('border-transparent', 'text-muted');
      tabQuestions.classList.remove('border-blue', 'text-blue');
      tabQuestions.classList.add('border-transparent', 'text-muted');
      viewOverview.classList.remove('hidden');
      viewQuestions.classList.add('hidden');
    } else {
      tabQuestions.classList.add('border-blue', 'text-blue');
      tabQuestions.classList.remove('border-transparent', 'text-muted');
      tabOverview.classList.remove('border-blue', 'text-blue');
      tabOverview.classList.add('border-transparent', 'text-muted');
      viewQuestions.classList.remove('hidden');
      viewOverview.classList.add('hidden');
      renderQuestions();
    }
  }

  // Session 4 Sub-tabs
  const s4TabOverview = document.getElementById('s4-tab-overview')!;
  const s4TabCf4 = document.getElementById('s4-tab-cf4')!;
  const s4TabModels = document.getElementById('s4-tab-models')!;
  const s4ViewOverview = document.getElementById('s4-view-overview')!;
  const s4ViewCf4 = document.getElementById('s4-view-cf4')!;
  const s4ViewModels = document.getElementById('s4-view-models')!;

  function switchS4Tab(tab: 'overview' | 'cf4' | 'models') {
    const map = [
      { key: 'overview', btn: s4TabOverview, view: s4ViewOverview },
      { key: 'cf4', btn: s4TabCf4, view: s4ViewCf4 },
      { key: 'models', btn: s4TabModels, view: s4ViewModels },
    ] as const;
    map.forEach(({ key, btn, view }) => {
      const active = key === tab;
      btn?.classList.toggle('border-blue', active);
      btn?.classList.toggle('text-blue', active);
      btn?.classList.toggle('font-semibold', active);
      btn?.classList.toggle('border-transparent', !active);
      btn?.classList.toggle('text-muted', !active);
      btn?.classList.toggle('font-medium', !active);
      view?.classList.toggle('hidden', !active);
    });
    if (tab === 'cf4') renderS4Cf4List();
  }
  s4TabOverview?.addEventListener('click', () => switchS4Tab('overview'));
  s4TabCf4?.addEventListener('click', () => switchS4Tab('cf4'));
  s4TabModels?.addEventListener('click', () => switchS4Tab('models'));

  // Session 4 Jump buttons
  const s4JumpWrap = document.getElementById('s4-jump-steps')!;
  s4StepLabels.forEach((label, i) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.dataset.s4Jump = String(i);
    b.className = 'w-7 h-7 rounded border border-navy/20 text-[12px] font-semibold hover:border-blue hover:text-blue transition-colors';
    b.textContent = String(i);
    b.title = `Step ${i}: ${label}`;
    b.addEventListener('click', () => setS4Step(i));
    s4JumpWrap?.appendChild(b);
  });

  // Session 4 Reveal toggle buttons
  const s4RevealWrap = document.getElementById('s4-reveal-controls')!;
  s4RevealLabels.forEach((label, idx) => {
    const stepNum = idx + 1; // Keys 1 to 5
    const b = document.createElement('button');
    b.type = 'button';
    b.dataset.s4Reveal = String(stepNum);
    b.className = 'px-2.5 py-2 rounded-md border text-[12px] font-semibold transition-all text-left flex items-center justify-between gap-1 bg-paper border-navy/15 text-muted hover:border-blue hover:text-ink';
    b.innerHTML = `<span class="truncate">${escapeHtml(label)}</span><span class="s4-rev-pill font-mono text-[10px] px-1.5 py-0.5 rounded bg-navy/10">OFF</span>`;
    b.addEventListener('click', () => toggleS4Reveal(stepNum));
    s4RevealWrap?.appendChild(b);
  });

  async function setS4Step(step: number) {
    if (!mentor) return;
    try {
      await mentorS4SetStep(mentor.token, step);
      await refreshAll();
    } catch (e) {
      alert(friendlyError(e));
    }
  }

  async function toggleS4Reveal(step: number) {
    if (!mentor) return;
    try {
      const cur = Boolean(s4Data?.state?.revealed_steps?.[String(step)]);
      await mentorS4SetReveal(mentor.token, step, !cur);
      await refreshAll();
    } catch (e) {
      alert(friendlyError(e));
    }
  }

  document.getElementById('s4-unlock-next')?.addEventListener('click', async () => {
    const cur = s4Data?.state?.unlocked_step ?? 0;
    if (cur >= 6) return alert('Session 4 is already at Step 6 (Case File #4).');
    await setS4Step(cur + 1);
  });

  document.getElementById('s4-reveal-all')?.addEventListener('click', async () => {
    if (!mentor) return;
    try {
      for (let i = 1; i <= 5; i++) {
        await mentorS4SetReveal(mentor.token, i, true);
      }
      await refreshAll();
    } catch (e) {
      alert(friendlyError(e));
    }
  });

  document.getElementById('s4-hide-all')?.addEventListener('click', async () => {
    if (!mentor) return;
    try {
      for (let i = 1; i <= 5; i++) {
        await mentorS4SetReveal(mentor.token, i, false);
      }
      await refreshAll();
    } catch (e) {
      alert(friendlyError(e));
    }
  });

  document.getElementById('s4-admin-reset')?.addEventListener('click', async () => {
    if (!confirm('Reset Session 4 to Step 0 for all teams?')) return;
    if (!mentor) return;
    try {
      await adminS4Reset(mentor.token);
      await refreshAll();
      alert('Session 4 reset cleanly to Step 0.');
    } catch (e) {
      alert(friendlyError(e));
    }
  });

  document.querySelectorAll('.s4-filter-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('.s4-filter-btn').forEach((b) => {
        b.classList.remove('bg-ink', 'text-white', 'font-semibold');
        b.classList.add('bg-white', 'text-muted', 'font-medium');
      });
      const target = e.currentTarget as HTMLButtonElement;
      target.classList.add('bg-ink', 'text-white', 'font-semibold');
      target.classList.remove('bg-white', 'text-muted', 'font-medium');
      s4Cf4Filter = target.dataset.filter as any;
      renderS4Cf4List();
    });
  });

  // Session 1 Jump buttons
  const jumpWrap = document.getElementById('jump-steps')!;
  stepLabels.forEach((_, i) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'w-7 h-7 rounded border border-navy/20 text-[12px] font-semibold hover:border-blue hover:text-blue transition-colors';
    b.textContent = String(i);
    b.title = `Step ${i}: ${stepLabels[i]}`;
    b.addEventListener('click', () => setStep(i));
    jumpWrap.appendChild(b);
  });

  // Session 3 Jump buttons
  const s3JumpWrap = document.getElementById('s3-jump-steps')!;
  s3StepLabels.forEach((label, i) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.dataset.s3Jump = String(i);
    b.className = 'w-7 h-7 rounded border border-navy/20 text-[12px] font-semibold hover:border-blue hover:text-blue transition-colors';
    b.textContent = String(i);
    b.title = `Step ${i}: ${label}`;
    b.addEventListener('click', () => setS3Step(i));
    s3JumpWrap.appendChild(b);
  });

  // Session 3 Reveal toggle buttons
  const s3RevealWrap = document.getElementById('s3-reveal-controls')!;
  s3RevealLabels.forEach((label, i) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.dataset.s3Reveal = String(i);
    b.className = 'px-2.5 py-2 rounded-md border text-[12px] font-semibold transition-all text-left flex items-center justify-between gap-1 bg-paper border-navy/15 text-muted hover:border-blue hover:text-ink';
    b.innerHTML = `<span class="truncate">${escapeHtml(label)}</span><span class="s3-rev-pill font-mono text-[10px] px-1.5 py-0.5 rounded bg-navy/10">OFF</span>`;
    b.addEventListener('click', () => toggleS3Reveal(i));
    s3RevealWrap.appendChild(b);
  });

  // Session 2 Jump buttons
  const s2JumpWrap = document.getElementById('s2-jump-steps')!;
  s2StepLabels.forEach((label, i) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.dataset.s2Jump = String(i);
    b.className = 'w-7 h-7 rounded border border-navy/20 text-[12px] font-semibold hover:border-blue hover:text-blue transition-colors';
    b.textContent = String(i);
    b.title = `Step ${i}: ${label}`;
    b.addEventListener('click', () => setS2Step(i));
    s2JumpWrap.appendChild(b);
  });

  // Session 2 Reveal toggle buttons
  const s2RevealWrap = document.getElementById('s2-reveal-controls')!;
  s2RevealLabels.forEach((label, i) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.dataset.s2Reveal = String(i);
    b.className = 'px-2.5 py-2 rounded-md border text-[12px] font-semibold transition-all text-left flex items-center justify-between gap-1 bg-paper border-navy/15 text-muted hover:border-blue hover:text-ink';
    b.innerHTML = `<span class="truncate">${escapeHtml(label)}</span><span class="s2-rev-pill font-mono text-[10px] px-1.5 py-0.5 rounded bg-navy/10">OFF</span>`;
    b.addEventListener('click', () => toggleS2Reveal(i));
    s2RevealWrap.appendChild(b);
  });

  async function init() {
    if (!mentor) return;
    loginForm.classList.add('hidden');
    panel.classList.remove('hidden');
    mentorBadge.classList.remove('hidden');
    mentorRoleLabel.textContent = mentor.mentorName ? `${mentor.mentorName} (${mentor.role})` : mentor.role;

    // All mentors now have full rights (resets, step control, reveals, approvals)
    document.getElementById('admin-reset')?.classList.remove('hidden');
    document.getElementById('s2-admin-reset')?.classList.remove('hidden');
    document.getElementById('s3-admin-reset')?.classList.remove('hidden');
    document.getElementById('s4-admin-reset')?.classList.remove('hidden');

    selectSession(4);
    await refreshAll();
    setInterval(refreshAll, 4000);

    const notes = await mentorNotes(mentor.token).catch(() => []);
    const list = document.getElementById('notes-list')!;
    list.innerHTML = notes
      .map((n) => `<li class="border-b border-navy/5 pb-1"><strong class="text-blue">${escapeHtml(n.card)}</strong> — <span class="font-semibold text-ink">${escapeHtml(n.fit)}</span>: <span class="text-muted">${escapeHtml(n.why)}</span></li>`)
      .join('');
  }

  async function refreshAll() {
    if (!mentor) return;
    try {
      const [s4OverviewData, s3OverviewData, s2OverviewData, overviewData, questionsData] = await Promise.all([
        mentorS4Overview(mentor.token).catch(() => null),
        mentorS3Overview(mentor.token),
        mentorS2Overview(mentor.token),
        mentorOverview(mentor.token),
        mentorQuestions(mentor.token),
      ]);

      if (s4OverviewData) {
        s4Data = s4OverviewData;
        renderS4Overview(s4OverviewData);
        if (!s4ViewCf4.classList.contains('hidden')) renderS4Cf4List();
        if (s4InspectTeamId) {
          const team = s4OverviewData.teams.find((t) => t.id === s4InspectTeamId);
          if (team) renderS4InspectModalBody(team);
        }
      }

      s3Data = s3OverviewData;
      renderS3Overview(s3OverviewData);
      if (!s3ViewCf3.classList.contains('hidden')) renderS3Cf3List();
      if (!s3ViewPeer.classList.contains('hidden')) renderS3PeerList();
      if (s3InspectTeamId) {
        const team = s3OverviewData.teams.find((t) => t.id === s3InspectTeamId);
        if (team) renderS3InspectModalBody(team);
      }

      s2Data = s2OverviewData;
      renderS2Overview(s2OverviewData);
      if (!s2ViewCards.classList.contains('hidden')) renderS2Cards();
      if (!s2ViewJar.classList.contains('hidden')) renderS2Jar();
      if (s2InspectTeamId) {
        const team = s2OverviewData.teams.find((t) => t.id === s2InspectTeamId);
        if (team) renderInspectModalBody(team);
      }

      renderOverview(overviewData);
      currentQuestions = questionsData;
      updatePendingBadge();
      if (!viewQuestions.classList.contains('hidden')) {
        renderQuestions();
      }

      const syncEl = document.getElementById('live-sync-label');
      if (syncEl) {
        syncEl.textContent = `Synced ${new Date().toLocaleTimeString()}`;
        syncEl.classList.remove('text-signal');
      }
    } catch (e) {
      const msg = friendlyError(e);
      console.error(e);
      const syncEl = document.getElementById('live-sync-label');
      if (syncEl) {
        syncEl.textContent = `Sync warning: ${msg}`;
        syncEl.classList.add('text-signal');
      }
      if (/expired|invalid|mentor session/i.test(msg)) {
        clearMentor();
        mentor = null;
        panel.classList.add('hidden');
        mentorBadge.classList.add('hidden');
        loginForm.classList.remove('hidden');
        const errEl = document.getElementById('login-error');
        if (errEl) {
          errEl.textContent = 'Mentor session expired — please sign in again.';
          errEl.classList.remove('hidden');
        }
      }
    }
  }

  /* =========================================================================
     SESSION 4 RENDERING & HANDLERS
     ========================================================================= */
  function renderS4Overview(data: MentorS4Overview) {
    const curStep = data.state?.unlocked_step ?? 0;
    const stepLabel = document.getElementById('s4-current-step');
    if (stepLabel) {
      stepLabel.textContent = `Step ${curStep} · ${s4StepLabels[curStep] || ''}`;
    }

    // Update S4 jump buttons
    document.querySelectorAll<HTMLButtonElement>('#s4-jump-steps button').forEach((b) => {
      const step = Number(b.dataset.s4Jump);
      const active = step === curStep;
      b.classList.toggle('bg-blue', active);
      b.classList.toggle('text-white', active);
      b.classList.toggle('border-blue', active);
    });

    // Update S4 reveal buttons
    const revs = (data.state?.revealed_steps || {}) as Record<string, boolean>;
    document.querySelectorAll<HTMLButtonElement>('#s4-reveal-controls button').forEach((b) => {
      const step = b.dataset.s4Reveal;
      const isRev = step !== undefined && Boolean(revs[step]);
      const pill = b.querySelector('.s4-rev-pill');
      b.classList.toggle('bg-emerald-50', isRev);
      b.classList.toggle('border-emerald-300', isRev);
      b.classList.toggle('text-emerald-950', isRev);
      if (pill) {
        pill.textContent = isRev ? 'REVEALED' : 'OFF';
        pill.className = `s4-rev-pill font-mono text-[10px] px-1.5 py-0.5 rounded font-bold ${
          isRev ? 'bg-emerald-600 text-white' : 'bg-navy/10 text-muted'
        }`;
      }
    });

    // Stats
    const teams = data.teams || [];
    let sortCount = 0;
    let titleCount = 0;
    let introCount = 0;
    let pendingCount = 0;
    let approvedCount = 0;

    teams.forEach((t) => {
      if (t.step1_sort && Object.keys(t.step1_sort).length > 0) sortCount++;
      if (t.step2_final_title || t.step2_title) titleCount++;
      const m = t.step3_moves as any;
      if (m && (m.move1 || m.move2 || m.move3 || m.move4 || m.m1 || m.m2 || m.m3 || m.m4)) introCount++;
      if (t.cf4_status === 'pending') pendingCount++;
      if (t.cf4_status === 'approved') approvedCount++;
    });

    const statTeams = document.getElementById('s4-stat-teams');
    const statSort = document.getElementById('s4-stat-sort');
    const statTitle = document.getElementById('s4-stat-title');
    const statIntro = document.getElementById('s4-stat-intro');
    const statPending = document.getElementById('s4-stat-pending');
    const statApproved = document.getElementById('s4-stat-approved');
    const pendingBadge = document.getElementById('s4-cards-pending-badge');

    if (statTeams) statTeams.textContent = String(teams.length);
    if (statSort) statSort.textContent = String(sortCount);
    if (statTitle) statTitle.textContent = String(titleCount);
    if (statIntro) statIntro.textContent = String(introCount);
    if (statPending) statPending.textContent = String(pendingCount);
    if (statApproved) statApproved.textContent = String(approvedCount);
    if (pendingBadge) {
      pendingBadge.textContent = String(pendingCount);
      pendingBadge.classList.toggle('hidden', pendingCount === 0);
    }

    // Render S4 Table
    const tbody = document.getElementById('s4-teams-body');
    if (!tbody) return;
    if (!teams.length) {
      tbody.innerHTML = '<tr><td colspan="10" class="p-6 text-center text-muted">No teams registered yet.</td></tr>';
      return;
    }

    tbody.innerHTML = teams
      .map((t) => {
        const sortCardsCount = Object.keys(t.step1_sort || {}).length;
        const titleText = (t.step2_final_title || t.step2_title || '').trim();
        const m = (t.step3_moves || {}) as any;
        const introFilled = [
          m.move1 || m.m1,
          m.move2 || m.m2,
          m.move3 || m.m3,
          m.move4 || m.m4,
        ].filter((str) => str && str.trim().length > 0).length;
        const resOk = Boolean(t.step4_result && t.step4_result.trim());
        const discOk = Boolean(t.step4_discussion && t.step4_discussion.trim());
        const absObj = (t.step5_improved_abstract || t.step5_abstract || {}) as any;
        const absFilled = [
          absObj.a1 || absObj.c,
          absObj.a2 || absObj.g,
          absObj.a3 || absObj.m,
          absObj.a4 || absObj.r,
          absObj.a5 || absObj.meaning,
        ].filter((s) => s && s.trim().length > 0).length;

        let cf4Badge = '<span class="px-2 py-0.5 rounded text-[11px] font-mono bg-paper text-muted border border-navy/10">Draft</span>';
        if (t.cf4_status === 'approved') {
          cf4Badge = '<span class="px-2 py-0.5 rounded text-[11px] font-mono bg-emerald-50 text-emerald-800 border border-emerald-200 font-bold">✓ Approved</span>';
        } else if (t.cf4_status === 'pending') {
          cf4Badge = '<span class="px-2 py-0.5 rounded text-[11px] font-mono bg-amber-500 text-white font-bold animate-pulse">● Pending</span>';
        }

        const updatedStr = t.s4_updated_at ? new Date(t.s4_updated_at).toLocaleTimeString() : '—';

        return `
          <tr class="hover:bg-paper/60 transition-colors">
            <td class="p-3.5 font-bold font-mono text-ink">${escapeHtml(t.name)} <span class="text-muted font-normal text-xs">(${escapeHtml(t.code)})</span></td>
            <td class="p-3.5 text-body text-[12px] max-w-xs truncate">${escapeHtml((t.members || []).join(', ') || '—')}</td>
            <td class="p-3.5 font-mono text-[12px]">${sortCardsCount > 0 ? `<span class="text-blue font-bold">${sortCardsCount}/8 sorted</span>` : '<span class="text-muted">—</span>'}</td>
            <td class="p-3.5 text-[12px] max-w-xs truncate" title="${escapeHtml(titleText)}">${titleText ? escapeHtml(titleText) : '<span class="text-muted">—</span>'}</td>
            <td class="p-3.5 font-mono text-[12px]">${introFilled > 0 ? `<span class="text-emerald-700 font-semibold">${introFilled}/4 moves</span>` : '<span class="text-muted">—</span>'}</td>
            <td class="p-3.5 font-mono text-[12px]">${(resOk || discOk) ? `<span class="text-blue font-semibold">R:${resOk ? '✓' : '—'} D:${discOk ? '✓' : '—'}</span>` : '<span class="text-muted">—</span>'}</td>
            <td class="p-3.5 font-mono text-[12px]">${absFilled > 0 ? `<span class="text-ink font-semibold">${absFilled}/5 sents</span>` : '<span class="text-muted">—</span>'}</td>
            <td class="p-3.5">${cf4Badge}</td>
            <td class="p-3.5 font-mono text-[11px] text-muted">${updatedStr}</td>
            <td class="p-3.5 text-right">
              <button type="button" class="s4-inspect-btn px-2.5 py-1 text-xs font-semibold rounded bg-paper hover:bg-white text-ink border border-navy/15 shadow-2xs" data-team-id="${escapeHtml(t.id)}">
                Inspect ↗
              </button>
            </td>
          </tr>
        `;
      })
      .join('');

    tbody.querySelectorAll<HTMLButtonElement>('.s4-inspect-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.teamId;
        if (id) openS4InspectModal(id);
      });
    });
  }

  function renderS4Cf4List() {
    const container = document.getElementById('s4-cf4-list');
    if (!container) return;
    let teams = (s4Data?.teams || []).filter((t) => {
      const hasContent = Boolean(
        t.step2_final_title ||
        t.step2_title ||
        t.step5_abstract?.c ||
        t.step5_improved_abstract?.c ||
        t.cf4_status !== 'draft'
      );
      return hasContent;
    });

    if (s4Cf4Filter === 'pending') teams = teams.filter((t) => t.cf4_status === 'pending');
    if (s4Cf4Filter === 'approved') teams = teams.filter((t) => t.cf4_status === 'approved');

    if (!teams.length) {
      container.innerHTML = `<p class="text-center py-12 text-muted">No Case File #4 submissions matching filter "${escapeHtml(s4Cf4Filter)}".</p>`;
      return;
    }

    container.innerHTML = teams
      .map((t) => {
        const finalTitle = t.step2_final_title || t.step2_title || 'Untitled Mini Paper';
        const abs = (t.step5_improved_abstract || t.step5_abstract || {}) as any;
        const abstractFull = [
          abs.a1 || abs.c,
          abs.a2 || abs.g,
          abs.a3 || abs.m,
          abs.a4 || abs.r,
          abs.a5 || abs.meaning,
        ].filter((s) => s && s.trim()).join(' ');
        const m = (t.step3_moves || {}) as any;
        const m1 = m.move1 || m.m1;
        const m2 = m.move2 || m.m2;
        const m3 = m.move3 || m.m3;
        const m4 = m.move4 || m.m4;
        const introMoves = [
          m1 ? `<strong>Move 1 (Context):</strong> ${escapeHtml(m1)}` : '',
          m2 ? `<strong>Move 2 (Gap):</strong> ${escapeHtml(m2)}` : '',
          m3 ? `<strong>Move 3 (Question):</strong> ${escapeHtml(m3)}` : '',
          m4 ? `<strong>Move 4 (Roadmap):</strong> ${escapeHtml(m4)}` : '',
        ].filter(Boolean).join('<br/>');

        const isApproved = t.cf4_status === 'approved';
        const isPending = t.cf4_status === 'pending';

        return `
          <div class="bg-white border ${isApproved ? 'border-emerald-300 ring-1 ring-emerald-200' : isPending ? 'border-amber-300 ring-1 ring-amber-200' : 'border-navy/10'} rounded-xl p-6 shadow-sm space-y-4" data-team-id="${escapeHtml(t.id)}">
            <div class="flex flex-wrap items-center justify-between gap-3 border-b border-navy/10 pb-3">
              <div>
                <span class="font-bold text-ink font-mono text-base">${escapeHtml(t.name)} (${escapeHtml(t.code)})</span>
                <p class="text-[12px] text-muted">${escapeHtml((t.members || []).join(', ') || '—')}</p>
              </div>
              <div class="flex items-center gap-2">
                ${
                  isApproved
                    ? `<span class="bg-emerald-100 text-emerald-800 font-semibold px-2.5 py-1 rounded text-[12px] flex items-center gap-1">✓ Approved ${t.cf4_approved_by ? `by ${escapeHtml(t.cf4_approved_by)}` : ''}</span>`
                    : isPending
                    ? '<span class="bg-amber-100 text-amber-900 font-semibold px-2.5 py-1 rounded text-[12px] animate-pulse">● Pending Approval</span>'
                    : '<span class="bg-paper text-muted border border-navy/10 px-2.5 py-1 rounded text-[12px]">Draft</span>'
                }
                <button type="button" class="s4-inspect-btn text-[12px] text-blue hover:underline font-mono ml-2" data-team-id="${escapeHtml(t.id)}">Inspect full →</button>
              </div>
            </div>

            <div class="space-y-1">
              <span class="font-mono text-[11px] uppercase tracking-wider text-muted font-bold">Paper Title:</span>
              <p class="font-display font-bold text-base sm:text-lg text-ink">"${escapeHtml(finalTitle)}"</p>
            </div>

            <div class="bg-paper p-4 rounded-lg border border-navy/10 space-y-2">
              <span class="font-mono text-[11px] uppercase tracking-wider text-blue font-bold">Abstract (5 Sentences):</span>
              <p class="text-[13px] text-ink leading-relaxed font-serif">${abstractFull ? escapeHtml(abstractFull) : '<span class="text-muted italic">No abstract written yet</span>'}</p>
            </div>

            ${
              introMoves
                ? `
              <div class="text-[12px] text-body bg-paper/60 p-3 rounded border border-navy/10 space-y-1">
                <span class="font-mono text-[11px] uppercase tracking-wider text-muted font-bold block">Introduction (4 Moves):</span>
                ${introMoves}
              </div>
            `
                : ''
            }

            <div class="grid sm:grid-cols-2 gap-3 text-[12px] bg-paper/40 p-3 rounded border border-navy/10">
              <div>
                <strong class="text-ink block">Result (Facts Only):</strong>
                <p class="text-body mt-0.5">${t.step4_result ? escapeHtml(t.step4_result) : '<span class="text-muted">—</span>'}</p>
              </div>
              <div>
                <strong class="text-ink block">Discussion (Mechanism + Limit):</strong>
                <p class="text-body mt-0.5">${t.step4_discussion ? escapeHtml(t.step4_discussion) : '<span class="text-muted">—</span>'}</p>
              </div>
            </div>

            ${
              t.cf4_hardest
                ? `
              <div class="text-[12px] text-muted italic">
                <strong>What was hardest:</strong> "${escapeHtml(t.cf4_hardest)}"
              </div>
            `
                : ''
            }

            ${
              !isApproved
                ? `
              <div class="pt-2 border-t border-navy/10 flex flex-wrap items-center justify-between gap-3">
                <p class="text-xs text-muted">Approving records green ✓ and unlocks final preprint celebration on team screen.</p>
                <button type="button" class="btn btn-sm btn-primary bg-emerald-600 hover:bg-emerald-700 text-white font-semibold s4-approve-btn flex items-center gap-1.5" data-team-id="${escapeHtml(t.id)}">
                  <span>✓ Approve Case File #4</span>
                </button>
              </div>
            `
                : ''
            }
          </div>
        `;
      })
      .join('');

    container.querySelectorAll<HTMLButtonElement>('.s4-inspect-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const id = (e.currentTarget as HTMLElement).dataset.teamId;
        if (id) openS4InspectModal(id);
      });
    });

    container.querySelectorAll<HTMLButtonElement>('.s4-approve-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        if (!mentor) return;
        const target = e.currentTarget as HTMLButtonElement;
        const teamId = target.dataset.teamId!;
        target.disabled = true;
        target.textContent = 'Approving…';
        try {
          await mentorS4ApproveCaseFile(mentor.token, teamId, mentor.mentorName);
          await refreshAll();
        } catch (err: any) {
          alert(friendlyError(err));
          target.disabled = false;
          target.textContent = '✓ Approve Case File #4';
        }
      });
    });
  }

  function openS4InspectModal(teamId: string) {
    s4InspectTeamId = teamId;
    const team = (s4Data?.teams || []).find((t) => t.id === teamId);
    if (!team) return;
    document.getElementById('s4-inspect-modal')?.classList.remove('hidden');
    renderS4InspectModalBody(team);
  }

