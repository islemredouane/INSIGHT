          ${
            !isApproved
              ? `<button type="button" id="s4-modal-quick-approve" class="btn btn-sm btn-primary bg-emerald-600 hover:bg-emerald-700 text-white !py-1 !px-3 !text-[12px]">✓ Approve Case File #4</button>`
              : '<span class="text-emerald-700 font-semibold text-[12px]">✓ Approved</span>'
          }
        </div>
        ${
          t.cf4_hardest
            ? `<p class="text-xs text-muted"><strong>Reflection:</strong> "${escapeHtml(t.cf4_hardest)}"</p>`
            : ''
        }
      </div>
    `;

    body.scrollTop = prevScroll;

    body.querySelector<HTMLButtonElement>('#s4-modal-quick-approve')?.addEventListener('click', async (e) => {
      if (!mentor) return;
      const btn = e.currentTarget as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = 'Approving…';
      try {
        await mentorS4ApproveCaseFile(mentor.token, t.id, mentor.mentorName);
        await refreshAll();
      } catch (err: any) {
        alert(friendlyError(err));
        btn.disabled = false;
        btn.textContent = '✓ Approve Case File #4';
      }
    });
