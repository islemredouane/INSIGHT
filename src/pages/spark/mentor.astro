  s2TabOverview.addEventListener('click', () => switchS2Tab('overview'));
  s2TabCards.addEventListener('click', () => switchS2Tab('cards'));
  s2TabJar.addEventListener('click', () => switchS2Tab('jar'));

  // Session 1 Tabs
  const tabOverview = document.getElementById('tab-overview')!;
  const tabQuestions = document.getElementById('tab-questions')!;
