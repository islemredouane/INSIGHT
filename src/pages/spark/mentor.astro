    s3InspectLastHash = hash;

    document.getElementById('s3-inspect-title')!.textContent = `${t.name} (${t.code})`;
    document.getElementById('s3-inspect-subtitle')!.textContent = `Members: ${(t.members || []).join(', ') || '—'}`;

    const spotsHtml = Object.entries(t.step1_spots || {})
      .map(([k, v]) => `<span class="px-2 py-0.5 bg-white border border-navy/10 rounded font-mono text-[11px]">${escapeHtml(k)}: ${escapeHtml(v)}</span>`)
      .join(' ');

    const body = document.getElementById('s3-inspect-body')!;
    const prevScroll = body.scrollTop;
    body.innerHTML = `
      <div class="space-y-2 border-b border-navy/10 pb-4">
        <p class="font-mono text-[11px] uppercase font-bold text-blue">Step 1 · Detective Mistake Tags (${Object.keys(t.step1_spots || {}).length}/7)</p>
        <div class="flex flex-wrap gap-1.5">${spotsHtml || '<span class="text-muted">No mistakes tagged yet</span>'}</div>
      </div>

      <div class="space-y-2 border-b border-navy/10 pb-4">
        <p class="font-mono text-[11px] uppercase font-bold text-blue">Step 2 · Paraphrases (Peeks: P1=${t.step2_peek1 || 0}, P2=${t.step2_peek2 || 0})</p>
        <p><strong>Sentence 1:</strong> ${t.step2_p1?.trim() ? escapeHtml(t.step2_p1) : '<span class="text-muted">—</span>'}</p>
        <p><strong>Sentence 2:</strong> ${t.step2_p2?.trim() ? escapeHtml(t.step2_p2) : '<span class="text-muted">—</span>'}</p>
      </div>

      <div class="space-y-2 border-b border-navy/10 pb-4">
        <p class="font-mono text-[11px] uppercase font-bold text-blue">Step 3 · Initial PEEL Draft</p>
        <p><strong>Point:</strong> ${t.peel?.p ? escapeHtml(t.peel.p) : '—'}</p>
        <p><strong>Evidence:</strong> ${t.peel?.e ? escapeHtml(t.peel.e) : '—'}</p>
        <p><strong>Explain:</strong> ${t.peel?.explain ? escapeHtml(t.peel.explain) : '—'}</p>
        <p><strong>Link:</strong> ${t.peel?.l ? escapeHtml(t.peel.l) : '—'}</p>
        <p><strong>Reference:</strong> ${t.peel?.ref ? escapeHtml(t.peel.ref) : '—'}</p>
      </div>

      <div class="space-y-2 border-b border-navy/10 pb-4">
        <p class="font-mono text-[11px] uppercase font-bold text-blue">Step 4 · Peer Review Given</p>
        <p><strong>Star:</strong> ${t.peer_review?.star ? escapeHtml(t.peer_review.star) : '—'}</p>
        <p><strong>Wish:</strong> ${t.peer_review?.wish ? escapeHtml(t.peer_review.wish) : '—'}</p>
      </div>

      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <p class="font-mono text-[11px] uppercase font-bold text-blue">Step 5 · Final Case File #3 (${escapeHtml(t.cf3_status)})</p>
          ${
            t.cf3_status !== 'approved'
              ? `<button type="button" id="s3-modal-quick-approve" class="btn btn-sm btn-primary bg-emerald-600 hover:bg-emerald-700 text-white !py-1 !px-3 !text-[12px]">✓ Approve Case File #3</button>`
              : '<span class="text-emerald-700 font-semibold text-[12px]">✓ Approved</span>'
          }
        </div>
        <p><strong>Final Point:</strong> ${t.improved_peel?.p || t.peel?.p ? escapeHtml(t.improved_peel?.p || t.peel?.p) : '—'}</p>
        <p><strong>Final Evidence:</strong> ${t.improved_peel?.e || t.peel?.e ? escapeHtml(t.improved_peel?.e || t.peel?.e) : '—'}</p>
        <p><strong>Final Explain:</strong> ${t.improved_peel?.explain || t.peel?.explain ? escapeHtml(t.improved_peel?.explain || t.peel?.explain) : '—'}</p>
        <p><strong>Final Link:</strong> ${t.improved_peel?.l || t.peel?.l ? escapeHtml(t.improved_peel?.l || t.peel?.l) : '—'}</p>
        <p><strong>Final Ref:</strong> ${t.improved_peel?.ref || t.peel?.ref ? escapeHtml(t.improved_peel?.ref || t.peel?.ref) : '—'}</p>
