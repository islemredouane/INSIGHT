        <div class="flex flex-wrap gap-2">${k.step1.pageMap.map((p) => `<span class="px-2 py-0.5 bg-white rounded border border-navy/10"><strong>${escapeHtml(p.name)}:</strong> ${escapeHtml(p.expected)}</span>`).join('')}</div>
        <div class="grid sm:grid-cols-2 gap-2 pt-2">${k.step1.fourPartTrick.map((f) => `<div class="bg-white p-2 rounded border border-navy/10"><strong>${escapeHtml(f.label)}:</strong> ${escapeHtml(f.expected)} <span class="text-muted text-[11px]">(${escapeHtml(f.where)})</span></div>`).join('')}</div>
