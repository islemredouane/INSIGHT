              Draft
            </span>
          </div>
        </div>

        <!-- Final Dossier Document Card -->
        <div class="p-6 sm:p-8 bg-paper rounded-2xl border border-navy/10 space-y-6 relative overflow-hidden">
          <div class="flex items-center justify-between border-b border-navy/10 pb-3">
            <div>
              <p class="text-[11px] font-mono uppercase text-muted tracking-wider">Official Case Submission</p>
              <h3 class="font-display text-lg font-bold text-ink">To: Yacine · From: <span id="cf3-team-title">Our Research Team</span></h3>
            </div>
            <span class="font-mono text-xs text-blue font-semibold">Case File #3</span>
