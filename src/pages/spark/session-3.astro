    color: #059669;
  }
</style>

<script>
  import {
    getSession3State,
    saveSession3Progress,
    getPeerTargetSession3,
    submitPeerReviewSession3,
    submitCaseFile3,
    watchSession3State,
    getStoredTeamCode,
    storeTeamCode,
    clearTeamCode,
    getStoredMentor,
    storeMentor,
    clearMentor,
    mentorLogin,
    mentorS3SetStep,
    mentorS3SetReveal,
    escapeHtml,
    friendlyError,
    type Session3TeamAnswers,
    type Session3RoomState,
    type PeerTargetPayload,
  } from '../../lib/spark/api';
  import { sparkSession3 } from '../../data/spark';

  // State
  let teamCode = getStoredTeamCode();
  let roomState: Session3RoomState = { unlocked_step: 0, revealed_steps: {} };
  let revealedKeys: Record<string, any> = {};
  let activePanel = 0;
  let mentorSession = getStoredMentor();
  let peerTarget: PeerTargetPayload | null = null;

  const defaultAnswers: Session3TeamAnswers = {
    step1_spots: {},
    step2_p1: '',
    step2_p2: '',
    step2_peek1: 0,
    step2_peek2: 0,
    peel: { p: '', e: '', explain: '', l: '', ref: '' },
    peel_saved: false,
    peer_review: { checks: [], star: '', wish: '' },
    improved_peel: { p: '', e: '', explain: '', l: '', ref: '' },
    cf3_status: 'draft',
  };

  let answers: Session3TeamAnswers = structuredClone(defaultAnswers);
  let autosaveTimer: any = null;

  // Web Audio Synth for celebration / cues
  function playAudioChime(type: 'unlock' | 'success' | 'tag') {
    try {
      const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain);
      gain.connect(ctx.destination);
      const t = ctx.currentTime;
      if (type === 'unlock') {
        osc.frequency.setValueAtTime(330, t);
        osc.frequency.exponentialRampToValueAtTime(660, t + 0.15);
        gain.gain.setValueAtTime(0.15, t);
        gain.gain.exponentialRampToValueAtTime(0.01, t + 0.3);
        osc.start(t);
        osc.stop(t + 0.3);
      } else if (type === 'success') {
        osc.frequency.setValueAtTime(523.25, t);
        osc.frequency.setValueAtTime(659.25, t + 0.1);
        osc.frequency.setValueAtTime(783.99, t + 0.2);
        gain.gain.setValueAtTime(0.2, t);
        gain.gain.exponentialRampToValueAtTime(0.01, t + 0.4);
        osc.start(t);
        osc.stop(t + 0.4);
      } else {
        osc.frequency.setValueAtTime(440, t);
        gain.gain.setValueAtTime(0.08, t);
        gain.gain.exponentialRampToValueAtTime(0.01, t + 0.1);
        osc.start(t);
        osc.stop(t + 0.1);
      }
    } catch {
      // Audio not permitted or supported
    }
  }

  // UI DOM Elements
  const teamLabel = document.getElementById('team-label');
  const teamBadge = document.getElementById('team-badge');
  const teamBanner = document.getElementById('team-banner');
  const bannerIconBox = document.getElementById('banner-icon-box');
  const bannerName = document.getElementById('banner-team-name');
  const bannerMembers = document.getElementById('banner-team-members');
  const bannerBadge = document.getElementById('banner-status-badge');
  const switchTeamBtn = document.getElementById('btn-switch-team');
  const bannerFeedback = document.getElementById('banner-feedback');
  const inlineInput = document.getElementById('inline-team-code') as HTMLInputElement | null;
  const inlineBtn = document.getElementById('inline-connect-btn') as HTMLButtonElement | null;
  const unlockedStepIndicator = document.getElementById('unlocked-step-indicator');
  const liveSaveStatus = document.getElementById('live-save-status');

  function renderTeamBanner(team: { id?: string; code: string; name: string; members: string[] } | null) {
    if (team) {
      if (teamLabel) teamLabel.textContent = `Team ${team.name}`;
      if (teamBadge) teamBadge.textContent = `${team.code} · ${team.members.length} Members`;
      if (bannerName) bannerName.textContent = `Team ${team.name}`;
      if (bannerMembers) bannerMembers.textContent = `Members: ${team.members.join(', ')} · Live sync active`;
      if (bannerBadge) {
        bannerBadge.textContent = `✓ Code: ${team.code}`;
        bannerBadge.className = 'px-2.5 py-0.5 text-[11px] font-mono rounded bg-emerald-100 text-emerald-800 border border-emerald-300 font-semibold';
      }
      if (bannerIconBox) bannerIconBox.textContent = '✨';
      teamBanner?.classList.add('is-connected');
    } else {
      if (teamLabel) teamLabel.textContent = 'The Music Case · Session 3';
      if (teamBadge) teamBadge.textContent = 'Not Connected';
      if (bannerName) bannerName.textContent = 'Connect your team to save live!';
      if (bannerMembers) bannerMembers.textContent = 'Enter your 6-character team code from Session 1 or 2 below, or register a new team in 1 minute so your answers go live to your mentor.';
      if (bannerBadge) {
        bannerBadge.textContent = 'Connect Required';
        bannerBadge.className = 'px-2.5 py-0.5 text-[11px] font-mono rounded bg-amber-100 text-amber-900 border border-amber-300 font-semibold';
      }
      if (bannerIconBox) bannerIconBox.textContent = '👥';
      teamBanner?.classList.remove('is-connected');
    }
  }

  function showBannerFeedback(message: string, type: 'error' | 'success') {
    if (!bannerFeedback) return;
    bannerFeedback.textContent = message;
    if (type === 'error') {
      bannerFeedback.className = 'px-5 sm:px-6 py-2.5 text-[13px] border-t border-signal/20 bg-signal/5 text-signal font-medium block';
    } else {
      bannerFeedback.className = 'px-5 sm:px-6 py-2.5 text-[13px] border-t border-emerald-500/20 bg-emerald-50 text-emerald-800 font-medium block';
      setTimeout(() => {
        bannerFeedback.className = 'hidden';
      }, 5000);
    }
  }

  async function handleConnectCode() {
    if (!inlineInput) return;
    const raw = inlineInput.value.trim().toUpperCase();
    if (!raw || raw.length < 4) {
      showBannerFeedback('Please enter your 6-character team code.', 'error');
      return;
    }
    if (inlineBtn) inlineBtn.disabled = true;
    try {
      const payload = await getSession3State(raw);
      if (!payload || !payload.team) {
        throw new Error("That code wasn't found. Check the letters or register a new team.");
      }
      storeTeamCode(raw);
      teamCode = raw;
      showBannerFeedback(`✓ Connected as Team ${payload.team.name}! Loading live workspace…`, 'success');
      setTimeout(() => window.location.reload(), 400);
    } catch (err: any) {
      showBannerFeedback(friendlyError(err), 'error');
      if (inlineBtn) inlineBtn.disabled = false;
    }
  }

  inlineBtn?.addEventListener('click', handleConnectCode);
  inlineInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      handleConnectCode();
    }
  });

  switchTeamBtn?.addEventListener('click', () => {
    clearTeamCode();
    showBannerFeedback('Disconnected team. Reloading…', 'success');
    setTimeout(() => window.location.reload(), 300);
  });

  // Session 2 Participation & Catch-up Choices
  const s2Choices = document.querySelectorAll<HTMLButtonElement>('.s2-participation-choice');
  const s2YesInfo = document.getElementById('s2-choice-yes-info');
  const s2NoInfo = document.getElementById('s2-choice-no-info');
  const loadFallbackBtn = document.getElementById('btn-load-fallback-card');

  s2Choices.forEach((btn) => {
    btn.addEventListener('click', () => {
      s2Choices.forEach((b) => b.classList.remove('chosen'));
      btn.classList.add('chosen');
      const isYes = btn.dataset.choice === 'yes';
      s2YesInfo?.classList.toggle('hidden', !isYes);
      s2NoInfo?.classList.toggle('hidden', isYes);
    });
  });

  loadFallbackBtn?.addEventListener('click', () => {
    const who = document.getElementById('s2-drawer-who');
    const what = document.getElementById('s2-drawer-what');
    const finding = document.getElementById('s2-drawer-finding');
    const exp = document.getElementById('s2-drawer-explanation');
    if (who) who.textContent = '30 university undergraduates (mean age 21 years)';
    if (what) what.textContent = 'Reading comprehension under 4 conditions (quiet, instrumental, preferred music, disliked music)';
    if (finding) finding.textContent = 'Highest performance in quiet & instrumental; lowest in both lyric conditions (liked or disliked)';
    if (exp) exp.textContent = 'Lyrics compete for linguistic processing; suppressing lyrics leaves less working memory for comprehension';
    alert('✓ Session 2 Evidence Card successfully loaded into your Step 3 writing drawer!');
  });

  // Step Tabs
  const stepTabs = document.querySelectorAll('.step-tab');
  const gamePanels = document.querySelectorAll('.game-panel');

  function setActiveStep(stepIndex: number) {
    if (stepIndex < 0 || stepIndex > 5) return;
    activePanel = stepIndex;
    stepTabs.forEach((tab, idx) => {
      tab.classList.toggle('active', idx === stepIndex);
    });

    gamePanels.forEach((panel, idx) => {
      panel.classList.toggle('hidden', idx !== stepIndex);
    });

    window.scrollTo({ top: 0, behavior: 'smooth' });

    // When entering Step 4, automatically request peer target if not yet loaded
    if (stepIndex === 4 && teamCode && !peerTarget) {
      loadPeerTarget();
    }
  }

  stepTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const step = Number((tab as HTMLElement).dataset.step);
      if (step > roomState.unlocked_step && !mentorSession) {
        alert(`Step ${step} is currently locked by the mentor. Please wait for room unlock!`);
        return;
      }
      setActiveStep(step);
    });
  });

  document.querySelectorAll('.btn-next-step').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = Number((btn as HTMLElement).dataset.next);
      if (next > roomState.unlocked_step && !mentorSession) {
        alert(`Step ${next} is currently locked by the mentor.`);
        return;
      }
      setActiveStep(next);
    });
  });

  // Render Room State & Locks
  function renderLocks() {
    if (unlockedStepIndicator) unlockedStepIndicator.textContent = `Step ${roomState.unlocked_step}/5`;
    stepTabs.forEach((tab, idx) => {
      const lockIcon = tab.querySelector('.step-lock-icon');
      if (idx > roomState.unlocked_step) {
        lockIcon?.classList.remove('hidden');
        tab.classList.add('locked');
      } else {
        lockIcon?.classList.add('hidden');
        tab.classList.remove('locked');
      }
    });

    // Render answer key visibility (0..5)
    for (let i = 0; i <= 5; i++) {
      const keyBox = document.getElementById(`key-box-${i}`);
      const isRevealed = Boolean(roomState.revealed_steps && roomState.revealed_steps[i]);
      if (keyBox) {
        keyBox.classList.toggle('hidden', !isRevealed);
      }
    }
  }

  // Hydrate UI Inputs from `answers` object
  function hydrateUI() {
    // Step 1: Detective Spots
    let spotCount = 0;
    sparkSession3.badAnswerMistakes.forEach((m) => {
      const sel = document.querySelector(`.mistake-selector[data-mistake-id="${m.id}"]`) as HTMLSelectElement | null;
      const row = document.querySelector(`[data-row-id="${m.id}"]`);
      const badge = row?.querySelector('.mistake-badge') as HTMLElement | null;
      const targetSpan = document.querySelector(`.detective-target[data-id="${m.id}"]`) as HTMLElement | null;
      const assigned = answers.step1_spots?.[m.id] || '';
      if (sel) sel.value = assigned;
      if (assigned) {
        spotCount++;
        if (badge) {
          badge.textContent = assigned;
          badge.classList.remove('hidden');
          badge.classList.add('bg-blue/10', 'text-blue', 'border', 'border-blue/20');
        }
        if (targetSpan) {
          targetSpan.classList.add('bg-blue/15', 'text-blue', 'font-semibold', '!border-solid', '!border-blue');
        }
      } else {
        if (badge) badge.classList.add('hidden');
        if (targetSpan) {
          targetSpan.classList.remove('bg-blue/15', 'text-blue', 'font-semibold', '!border-solid', '!border-blue');
        }
      }
    });
    const counter = document.getElementById('mistakes-counter');
    if (counter) counter.textContent = `${spotCount} / 7 Tagged`;

    // Step 2: Paraphrases
    const p1 = document.getElementById('paraphrase-input-p1') as HTMLTextAreaElement | null;
    const p2 = document.getElementById('paraphrase-input-p2') as HTMLTextAreaElement | null;
    if (p1) p1.value = answers.step2_p1 || '';
    if (p2) p2.value = answers.step2_p2 || '';

    const b1 = document.getElementById('peek-badge-p1');
    const b2 = document.getElementById('peek-badge-p2');
    if (b1) b1.textContent = `Peeks: ${answers.step2_peek1 || 0}`;
    if (b2) b2.textContent = `Peeks: ${answers.step2_peek2 || 0}`;

    // Step 3: PEEL
    const inpP = document.getElementById('peel-input-p') as HTMLTextAreaElement | null;
    const inpE = document.getElementById('peel-input-e') as HTMLTextAreaElement | null;
    const inpExp = document.getElementById('peel-input-explain') as HTMLTextAreaElement | null;
    const inpL = document.getElementById('peel-input-l') as HTMLTextAreaElement | null;
    const inpRef = document.getElementById('peel-input-ref') as HTMLTextAreaElement | null;

    if (inpP) inpP.value = answers.peel?.p || '';
    if (inpE) inpE.value = answers.peel?.e || '';
    if (inpExp) inpExp.value = answers.peel?.explain || '';
    if (inpL) inpL.value = answers.peel?.l || '';
    if (inpRef) inpRef.value = answers.peel?.ref || '';

    updateCombinedPreview();

    // Step 4: Peer review & improved peel
    const impP = document.getElementById('improved-p') as HTMLTextAreaElement | null;
    const impE = document.getElementById('improved-e') as HTMLTextAreaElement | null;
    const impExp = document.getElementById('improved-explain') as HTMLTextAreaElement | null;
    const impL = document.getElementById('improved-l') as HTMLTextAreaElement | null;
    const impRef = document.getElementById('improved-ref') as HTMLTextAreaElement | null;

    if (impP) impP.value = answers.improved_peel?.p || answers.peel?.p || '';
    if (impE) impE.value = answers.improved_peel?.e || answers.peel?.e || '';
    if (impExp) impExp.value = answers.improved_peel?.explain || answers.peel?.explain || '';
    if (impL) impL.value = answers.improved_peel?.l || answers.peel?.l || '';
    if (impRef) impRef.value = answers.improved_peel?.ref || answers.peel?.ref || '';

    // Step 5: Final text render
    updateFinalDossier();
  }

  function updateCombinedPreview() {
    const p = (document.getElementById('peel-input-p') as HTMLTextAreaElement)?.value || '';
    const e = (document.getElementById('peel-input-e') as HTMLTextAreaElement)?.value || '';
    const exp = (document.getElementById('peel-input-explain') as HTMLTextAreaElement)?.value || '';
    const l = (document.getElementById('peel-input-l') as HTMLTextAreaElement)?.value || '';
    const ref = (document.getElementById('peel-input-ref') as HTMLTextAreaElement)?.value || '';

    const preview = document.getElementById('combined-preview-body');
    const previewRef = document.getElementById('combined-preview-ref');

    const parts = [p, e, exp, l].filter((s) => s.trim().length > 0);
    if (preview) {
      preview.textContent = parts.length > 0 ? parts.join(' ') : '(Type in the P, E, E, L boxes above to preview your complete paragraph here…)';
    }
    if (previewRef) {
      previewRef.textContent = ref.trim() ? `Reference: ${ref}` : '';
    }
  }

  function updateFinalDossier() {
    const p = answers.improved_peel?.p || answers.peel?.p || '';
    const e = answers.improved_peel?.e || answers.peel?.e || '';
    const exp = answers.improved_peel?.explain || answers.peel?.explain || '';
    const l = answers.improved_peel?.l || answers.peel?.l || '';
    const ref = answers.improved_peel?.ref || answers.peel?.ref || sparkSession3.apaReference;

    const parts = [p, e, exp, l].filter((s) => s.trim().length > 0);
    const textEl = document.getElementById('cf3-final-text');
    const refEl = document.getElementById('cf3-final-ref');
    const badge = document.getElementById('cf3-status-badge');
    const approvedBanner = document.getElementById('cf3-approved-banner');
    const commentEl = document.getElementById('cf3-mentor-comment');

    if (textEl && parts.length > 0) {
      textEl.textContent = parts.join(' ');
    }
    if (refEl) {
      refEl.textContent = ref;
    }

    if (badge) {
      if (answers.cf3_status === 'approved') {
        badge.textContent = '✓ Approved by Mentor Jury';
        badge.className = 'px-3 py-1 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300';
        approvedBanner?.classList.remove('hidden');
        if (commentEl && answers.cf3_mentor_comment) {
          commentEl.textContent = `"${answers.cf3_mentor_comment}"`;
        }
      } else if (answers.cf3_status === 'pending') {
        badge.textContent = '● Awaiting Mentor Jury ✓';
        badge.className = 'px-3 py-1 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-amber-100 text-amber-800 border border-amber-300 animate-pulse';
        approvedBanner?.classList.add('hidden');
      } else {
        badge.textContent = 'Draft';
        badge.className = 'px-3 py-1 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-paper text-muted border border-navy/15';
        approvedBanner?.classList.add('hidden');
      }
    }
  }

  // Step 1: Detective Mistake Selector change
  document.querySelectorAll('.mistake-selector').forEach((sel) => {
    sel.addEventListener('change', () => {
      const mId = (sel as HTMLElement).dataset.mistakeId;
      const val = (sel as HTMLSelectElement).value;
      if (!mId) return;
      if (!answers.step1_spots) answers.step1_spots = {};
      answers.step1_spots[mId] = val;
      playAudioChime('tag');
      hydrateUI();
      triggerAutosave({ step1_spots: answers.step1_spots });
    });
  });

  // Detective click on inline text triggers selection
  document.querySelectorAll('.detective-target').forEach((target) => {
    target.addEventListener('click', () => {
      const mId = (target as HTMLElement).dataset.id;
      const sel = document.querySelector(`.mistake-selector[data-mistake-id="${mId}"]`) as HTMLSelectElement | null;
      if (sel) {
        sel.focus();
        sel.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    });
  });

  // Step 2: Close the Paper (Hide / Peek)
  document.querySelectorAll('.btn-hide-original').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = (btn as HTMLElement).dataset.target;
      const card = document.querySelector(`[data-paraphrase-id="${targetId}"]`);
      const originalBox = card?.querySelector('.original-box');
      const peekBtn = card?.querySelector('.btn-peek-original');
      const statusLabel = card?.querySelector('.original-status-label');

      originalBox?.classList.add('hidden');
      btn.classList.add('hidden');
      peekBtn?.classList.remove('hidden');
      if (statusLabel) statusLabel.textContent = 'Hidden 🙈 (Writing from memory)';
      playAudioChime('tag');
    });
  });

  document.querySelectorAll('.btn-peek-original').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = (btn as HTMLElement).dataset.target;
      const card = document.querySelector(`[data-paraphrase-id="${targetId}"]`);
      const originalBox = card?.querySelector('.original-box');
      const hideBtn = card?.querySelector('.btn-hide-original');
      const statusLabel = card?.querySelector('.original-status-label');

      originalBox?.classList.remove('hidden');
      btn.classList.add('hidden');
      hideBtn?.classList.remove('hidden');
      if (statusLabel) statusLabel.textContent = 'Original visible';

      if (targetId === 'p1') {
        answers.step2_peek1 = (answers.step2_peek1 || 0) + 1;
        triggerAutosave({ step2_peek1: answers.step2_peek1 });
      } else {
        answers.step2_peek2 = (answers.step2_peek2 || 0) + 1;
        triggerAutosave({ step2_peek2: answers.step2_peek2 });
      }
      hydrateUI();
    });
  });

  document.getElementById('btn-save-paraphrases')?.addEventListener('click', () => {
    const p1 = (document.getElementById('paraphrase-input-p1') as HTMLTextAreaElement)?.value || '';
    const p2 = (document.getElementById('paraphrase-input-p2') as HTMLTextAreaElement)?.value || '';
    answers.step2_p1 = p1;
    answers.step2_p2 = p2;
    triggerAutosave({ step2_p1: p1, step2_p2: p2 }, true);
  });

  // Step 3: Insert Paraphrases & APA Reference shortcuts
  document.querySelectorAll('.btn-insert-paraphrase').forEach((btn) => {
    btn.addEventListener('click', () => {
      const src = (btn as HTMLElement).dataset.source;
      if (src === 'p1') {
        const val = answers.step2_p1 || (document.getElementById('paraphrase-input-p1') as HTMLTextAreaElement)?.value || '';
        if (!val.trim()) {
          alert("You haven't written Paraphrase 1 in Step 2 yet! Complete it in Step 2 first, or type directly into this Evidence box.");
          return;
        }
        const inp = document.getElementById('peel-input-e') as HTMLTextAreaElement | null;
        if (inp) {
          inp.value = val;
          answers.peel.e = val;
          updateCombinedPreview();
          triggerAutosave({ peel: answers.peel });
        }
      } else if (src === 'p2') {
        const val = answers.step2_p2 || (document.getElementById('paraphrase-input-p2') as HTMLTextAreaElement)?.value || '';
        if (!val.trim()) {
          alert("You haven't written Paraphrase 2 in Step 2 yet! Complete it in Step 2 first, or type directly into this Explain box.");
          return;
        }
        const inp = document.getElementById('peel-input-explain') as HTMLTextAreaElement | null;
        if (inp) {
          inp.value = val;
          answers.peel.explain = val;
          updateCombinedPreview();
          triggerAutosave({ peel: answers.peel });
        }
      }
    });
  });

  document.getElementById('btn-insert-apa-template')?.addEventListener('click', () => {
    const inp = document.getElementById('peel-input-ref') as HTMLTextAreaElement | null;
    if (inp) {
      inp.value = sparkSession3.apaReference;
      answers.peel.ref = sparkSession3.apaReference;
      updateCombinedPreview();
      triggerAutosave({ peel: answers.peel });
    }
  });

  ['p', 'e', 'explain', 'l', 'ref'].forEach((f) => {
    const inp = document.getElementById(`peel-input-${f}`) as HTMLTextAreaElement | null;
    inp?.addEventListener('input', () => {
      (answers.peel as any)[f] = inp.value;
      updateCombinedPreview();
      debouncedAutosave({ peel: answers.peel, peel_saved: true });
    });
  });

  document.getElementById('btn-save-peel')?.addEventListener('click', () => {
    triggerAutosave({ peel: answers.peel, peel_saved: true }, true);
  });

  // Step 4: Peer Target & Review
  async function loadPeerTarget() {
    if (!teamCode) return;
    try {
      const target = await getPeerTargetSession3(teamCode);
      peerTarget = target;
      const codeBadge = document.getElementById('peer-target-code-badge');
      const paragraphEl = document.getElementById('peer-target-paragraph');
      const refEl = document.getElementById('peer-target-reference');

      const code = target.target_team_code || target.peer_code || 'ANON';
      if (codeBadge) codeBadge.textContent = `Draft Team: ${code}`;
      const p = target.peel || target.paragraph || ({} as any);
      const fullText = [p.p, p.e, p.explain, p.l].filter((s) => s && s.trim()).join(' ');
      if (paragraphEl) {
        paragraphEl.textContent = fullText || '(This team has not yet written their PEEL draft.)';
      }
      if (refEl) {
        refEl.textContent = p.ref ? `Reference: ${p.ref}` : 'Reference: [Missing]';
      }
    } catch (err) {
      console.warn('Failed to load peer target:', err);
    }
  }

  document.getElementById('btn-refresh-peer')?.addEventListener('click', () => {
    peerTarget = null;
    loadPeerTarget();
  });

  document.getElementById('btn-submit-peer-review')?.addEventListener('click', async () => {
    if (!teamCode || !peerTarget) {
      alert('Please wait for an anonymous peer draft to load before submitting review.');
      return;
    }
    const checks: string[] = [];
    document.querySelectorAll('.peer-check-input:checked').forEach((chk) => {
      checks.push((chk as HTMLInputElement).value);
    });
    const star = (document.getElementById('peer-star-input') as HTMLTextAreaElement)?.value || '';
    const wish = (document.getElementById('peer-wish-input') as HTMLTextAreaElement)?.value || '';

    if (!star.trim() || !wish.trim()) {
      alert('Please provide at least 1 star (something done well) and 1 wish (improvement) for your peer team!');
      return;
    }

    try {
      const statusLabel = document.getElementById('peer-submit-status');
      if (statusLabel) statusLabel.textContent = 'Submitting…';
      await submitPeerReviewSession3(teamCode, {
        target_team_id: peerTarget.target_team_id,
        target_team_code: peerTarget.target_team_code,
        checks,
        star,
        wish,
      });
      if (statusLabel) statusLabel.textContent = '✓ Review delivered to peers!';
      playAudioChime('success');
      alert('Your peer review has been delivered anonymously to your peer team! Now inspect incoming feedback on your own paragraph on the right.');
    } catch (err: any) {
      alert(friendlyError(err));
    }
  });

  document.getElementById('btn-copy-peel-to-improved')?.addEventListener('click', () => {
    answers.improved_peel = structuredClone(answers.peel);
    hydrateUI();
    triggerAutosave({ improved_peel: answers.improved_peel }, true);
  });

  ['p', 'e', 'explain', 'l', 'ref'].forEach((f) => {
    const inp = document.getElementById(`improved-${f}`) as HTMLTextAreaElement | null;
    inp?.addEventListener('input', () => {
      (answers.improved_peel as any)[f] = inp.value;
      updateFinalDossier();
      debouncedAutosave({ improved_peel: answers.improved_peel });
    });
  });

  document.getElementById('btn-save-improved-peel')?.addEventListener('click', () => {
    triggerAutosave({ improved_peel: answers.improved_peel }, true);
  });

  // Step 5: Submit Case File #3
  document.getElementById('btn-submit-cf3')?.addEventListener('click', async () => {
    if (!teamCode) {
      alert('Please sign in with your team code to submit Case File #3.');
      return;
    }
    const finalP = answers.improved_peel?.p ? answers.improved_peel : answers.peel;
    if (!finalP.p.trim() || !finalP.e.trim()) {
      alert('Your PEEL paragraph is incomplete! Please write at least your Point and Evidence before submitting to Yacine.');
      return;
    }

    try {
      const res = await submitCaseFile3(teamCode, finalP);
      answers.cf3_status = res.cf3_status;
      hydrateUI();
      playAudioChime('success');
      alert('🚀 Case File #3 sent to the mentor jury! When the mentor gives the green ✓, your approval badge will celebrate here.');
    } catch (err: any) {
      alert(friendlyError(err));
    }
  });

  // Debounced Autosave
  function debouncedAutosave(patch: Record<string, unknown>) {
    clearTimeout(autosaveTimer);
    liveSaveStatus!.textContent = 'Editing…';
    autosaveTimer = setTimeout(() => {
      triggerAutosave(patch);
    }, 800);
  }

  async function triggerAutosave(patch: Record<string, unknown>, notify = false) {
    if (!teamCode) return;
    try {
      liveSaveStatus!.textContent = 'Saving…';
      await saveSession3Progress(teamCode, patch);
      liveSaveStatus!.textContent = 'Synced live';
      if (notify) alert('Changes saved successfully!');
    } catch (err) {
      console.warn('Autosave hiccup:', err);
      liveSaveStatus!.textContent = 'Sync issue (retrying)';
    }
  }

  // Mentor Inline Controls
  const mentorToggle = document.getElementById('mentor-controls-toggle');
  const mentorMenu = document.getElementById('mentor-controls-menu');
  const mentorInlineLogin = document.getElementById('mentor-inline-login');
  const mentorInlineAuthed = document.getElementById('mentor-controls-authed');

  mentorToggle?.addEventListener('click', () => {
    mentorMenu?.classList.toggle('hidden');
  });

  function updateMentorUI() {
    if (mentorSession) {
      mentorInlineLogin?.classList.add('hidden');
      mentorInlineAuthed?.classList.remove('hidden');
    } else {
      mentorInlineLogin?.classList.remove('hidden');
      mentorInlineAuthed?.classList.add('hidden');
    }
  }

  document.getElementById('mentor-inline-login')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const pw = (document.getElementById('mentor-inline-password') as HTMLInputElement)?.value;
    const errEl = document.getElementById('mentor-inline-error');
    try {
      const s = await mentorLogin(pw);
      storeMentor(s);
      mentorSession = s;
      updateMentorUI();
      renderLocks();
      playAudioChime('unlock');
    } catch (err: any) {
      if (errEl) {
        errEl.textContent = friendlyError(err);
        errEl.classList.remove('hidden');
      }
    }
  });

  document.getElementById('btn-mentor-logout')?.addEventListener('click', () => {
    clearMentor();
    mentorSession = null;
    updateMentorUI();
  });

  document.getElementById('btn-reveal-next')?.addEventListener('click', async () => {
    if (!mentorSession) return;
    const next = Math.min(5, roomState.unlocked_step + 1);
    await mentorS3SetStep(mentorSession.token, next);
    roomState.unlocked_step = next;
    renderLocks();
    playAudioChime('unlock');
  });

  document.getElementById('btn-reveal-all')?.addEventListener('click', async () => {
    if (!mentorSession) return;
    await mentorS3SetStep(mentorSession.token, 5);
    roomState.unlocked_step = 5;
    renderLocks();
  });

  document.getElementById('btn-lock-all')?.addEventListener('click', async () => {
    if (!mentorSession) return;
    await mentorS3SetStep(mentorSession.token, 0);
    roomState.unlocked_step = 0;
    renderLocks();
  });

  document.querySelectorAll('.s3-reveal-step-toggle').forEach((chk) => {
    chk.addEventListener('change', async () => {
      if (!mentorSession) return;
      const step = Number((chk as HTMLElement).dataset.step);
      const rev = (chk as HTMLInputElement).checked;
      const res = await mentorS3SetReveal(mentorSession.token, step, rev);
      roomState.revealed_steps = res;
      renderLocks();
    });
  });

  document.getElementById('btn-reveal-keys-all')?.addEventListener('click', async () => {
    if (!mentorSession) return;
    const res = await mentorS3SetReveal(mentorSession.token, -1, true);
    roomState.revealed_steps = res;
    renderLocks();
  });

  document.getElementById('btn-hide-keys-all')?.addEventListener('click', async () => {
    if (!mentorSession) return;
    const res = await mentorS3SetReveal(mentorSession.token, -1, false);
    roomState.revealed_steps = res;
    renderLocks();
  });

  // Boot & Watcher
  async function boot() {
    updateMentorUI();
    try {
      const payload = await getSession3State(teamCode);
      if (payload) {
        roomState = payload.state;
        revealedKeys = payload.revealed_keys || {};

        renderTeamBanner(payload.team);
        if (payload.team) {
          const cf3Title = document.getElementById('cf3-team-title');
          if (cf3Title) cf3Title.textContent = `${payload.team.name} (${payload.team.code})`;
        }

        if (payload.answers) {
          answers = {
            ...structuredClone(defaultAnswers),
            ...payload.answers,
            step1_spots: { ...(payload.answers.step1_spots || {}) },
            peel: { ...defaultAnswers.peel, ...(payload.answers.peel || {}) },
            improved_peel: { ...defaultAnswers.improved_peel, ...(payload.answers.improved_peel || {}) },
          };
        }

        // Render S2 Reading card in drawer
        const who = document.getElementById('s2-drawer-who');
        const what = document.getElementById('s2-drawer-what');
        const finding = document.getElementById('s2-drawer-finding');
        const exp = document.getElementById('s2-drawer-explanation');

        if (payload.s2_reading_card && (payload.s2_reading_card.who || payload.s2_reading_card.main_finding)) {
          const c = payload.s2_reading_card;
          if (who) who.textContent = c.who || '30 university students (Perham & Currie, 2014)';
          if (what) what.textContent = c.what_tested || 'Reading in 4 conditions (quiet, instrumental, liked songs, disliked songs)';
          if (finding) finding.textContent = c.main_finding || 'Quiet & instrumental = best; songs with lyrics = worst';
          if (exp) exp.textContent = c.explanation || 'Brain suppresses song lyrics, stealing working memory from text';
        } else {
          if (who) who.textContent = '30 university students (Perham & Currie, 2014)';
          if (what) what.textContent = 'Reading in 4 conditions (quiet, instrumental, liked songs, disliked songs)';
          if (finding) finding.textContent = 'Quiet & instrumental = best; songs with lyrics = worst';
          if (exp) exp.textContent = 'Brain suppresses song lyrics, stealing working memory from text';
        }

        // Render peer feedback if already received
        if (payload.peer_feedback_received) {
          const f = payload.peer_feedback_received;
          const starEl = document.getElementById('received-star');
          const wishEl = document.getElementById('received-wish');
          const pill = document.getElementById('feedback-live-pill');
          if (starEl) starEl.textContent = f.star;
          if (wishEl) wishEl.textContent = f.wish;
          if (pill) {
            pill.textContent = `Feedback from Team ${f.reviewer_code}`;
            pill.className = 'px-2 py-0.5 text-[10px] font-mono rounded bg-emerald-50 text-emerald-800 border border-emerald-200';
          }
        }

        hydrateUI();
        renderLocks();
      }
    } catch (err) {
      console.warn('Boot fetch issue:', err);
    }

    watchSession3State((freshState) => {
      roomState = freshState;
      renderLocks();
    });

    // Check periodically for Case File #3 approval or peer review arrival
    setInterval(async () => {
      if (!teamCode) return;
      try {
        const fresh = await getSession3State(teamCode);
        if (fresh?.answers) {
          if (answers.cf3_status !== fresh.answers.cf3_status) {
            answers.cf3_status = fresh.answers.cf3_status;
            answers.cf3_mentor_comment = fresh.answers.cf3_mentor_comment;
            if (answers.cf3_status === 'approved') playAudioChime('success');
            updateFinalDossier();
          }
        }
        if (fresh?.peer_feedback_received) {
          const f = fresh.peer_feedback_received;
          const starEl = document.getElementById('received-star');
          const wishEl = document.getElementById('received-wish');
          const pill = document.getElementById('feedback-live-pill');
          if (starEl) starEl.textContent = f.star;
          if (wishEl) wishEl.textContent = f.wish;
          if (pill) {
            pill.textContent = `Feedback from Team ${f.reviewer_code}`;
            pill.className = 'px-2 py-0.5 text-[10px] font-mono rounded bg-emerald-50 text-emerald-800 border border-emerald-200';
          }
        }
      } catch {
        /* transient hiccup */
      }
    }, 5000);
  }

  boot();
</script>
