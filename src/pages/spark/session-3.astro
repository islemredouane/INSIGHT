---
// SPARK · The Music Case (Part 3) — Session 3 Game (Steps 0-5).
// "Write for Yacine" · From reading to writing · 60 minutes · PEEL Paragraph & Peer Review.
// No red ✗, no blocking states, 100% responsive and aligned to the INSIGHT design system.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sparkSession3 } from '../../data/spark';

const steps = [
  '00 · Yacine’s Message',
  '01 · Spot the Problems',
  '02 · Paraphrase Key Result',
  '03 · Build PEEL Paragraph',
  '04 · Swap & Review',
  '05 · Case File #3',
];
---
<BaseLayout
  title="The Music Case · Session 3 · SPARK"
  description="SPARK 2026 Session 3: Write for Yacine. Detective mistake hunt, close-the-paper paraphrasing, PEEL paragraph builder, and anonymous peer review."
  noindex
>
  <!-- Top Bar -->
  <section class="bg-ink text-white pt-24 xl:pt-32 pb-8 border-b border-white/10">
    <div class="max-w-[1100px] mx-auto px-5 flex flex-wrap items-center justify-between gap-4">
      <div>
        <p class="eyebrow text-peri">SPARK 2026 · Session 3</p>
        <div class="flex items-center gap-3 mt-1">
          <h1 id="team-label" class="font-display text-xl sm:text-2xl font-bold">The Music Case · Part 3</h1>
          <span id="team-badge" class="px-2.5 py-0.5 text-[11px] font-mono font-semibold uppercase tracking-wider rounded bg-blue/20 text-peri border border-blue/40">
            Team Loading…
          </span>
        </div>
      </div>
      <div class="flex items-center gap-3 text-[13px]">
        <!-- Mentor Reveal Controls (Password-Protected) -->
        <div class="relative">
          <button
            type="button"
            id="mentor-controls-toggle"
            aria-expanded="false"
            aria-controls="mentor-controls-menu"
            class="px-2.5 py-1 text-[11px] font-mono font-semibold rounded bg-white/10 hover:bg-white/20 text-silver transition flex items-center gap-1.5 border border-white/15"
          >
            <span>👑 Mentor Reveal:</span>
            <span id="unlocked-step-indicator" class="text-peri">Step 0/5</span>
          </button>
          <div
            id="mentor-controls-menu"
            class="hidden absolute right-0 mt-2 w-72 max-w-[calc(100vw-2rem)] bg-white text-ink border border-navy/10 rounded-xl shadow-2xl p-4 z-30 space-y-3 text-left"
          >
            <!-- Mentor Auth Gate (visible when not logged in as mentor) -->
            <form id="mentor-inline-login" class="space-y-2.5">
              <div class="flex items-center justify-between">
                <p class="font-mono text-[10px] uppercase text-blue font-bold tracking-wider">👑 Mentor Only</p>
                <span class="text-[10px] font-mono text-muted">Password required</span>
              </div>
              <p class="text-[12px] text-body leading-snug">
                Sign in with the SPARK mentor password to unlock steps and reveal answer keys after teams finish.
              </p>
              <input
                id="mentor-inline-password"
                type="password"
                class="field !mt-0 !h-9 !py-1 !text-[13px]"
                placeholder="Mentor password…"
                autocomplete="current-password"
                required
              />
              <p id="mentor-inline-error" class="hidden text-[12px] text-signal font-medium"></p>
              <button type="submit" id="mentor-inline-submit" class="btn btn-sm btn-primary w-full justify-center">
                Unlock Mentor Controls
              </button>
            </form>

            <!-- Mentor Controls (visible ONLY once authenticated as mentor) -->
            <div id="mentor-controls-authed" class="hidden space-y-3">
              <div class="flex items-center justify-between pb-2 border-b border-navy/10">
                <span id="mentor-authed-badge" class="font-mono text-[10px] uppercase text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded font-semibold">
                  ✓ Mentor Active
                </span>
                <button type="button" id="btn-mentor-logout" class="text-[11px] text-muted hover:text-ink underline">
                  Lock controls
                </button>
              </div>

              <!-- Step Locks -->
              <div class="space-y-1.5">
                <p class="font-mono text-[10px] uppercase text-muted tracking-wider">1. Room Step Access</p>
                <button type="button" id="btn-reveal-next" class="btn btn-sm btn-primary w-full text-left justify-start">
                  🔓 Unlock Next Step
                </button>
                <div class="grid grid-cols-2 gap-1.5">
                  <button type="button" id="btn-reveal-all" class="btn btn-sm btn-secondary w-full justify-center btn-on-light !px-2 !text-[11px]">
                    ⚡ Unlock All
                  </button>
                  <button type="button" id="btn-lock-all" class="btn btn-sm btn-secondary w-full justify-center text-signal border-signal/20 hover:bg-signal/5 !px-2 !text-[11px]">
                    🔒 Reset (0)
                  </button>
                </div>
              </div>

              <!-- Answer Key Reveals -->
              <div class="pt-2 border-t border-navy/10 space-y-2">
                <div class="flex items-center justify-between">
                  <p class="font-mono text-[10px] uppercase text-muted tracking-wider">2. Answer Key Reveals</p>
                  <button type="button" id="btn-reveal-current-answers" class="text-[11px] font-semibold text-blue hover:underline">
                    Reveal current
                  </button>
                </div>
                <div class="space-y-1 text-[12px]">
                  {[
                    { step: 0, label: 'Step 0 · Message & 4 Pillars' },
                    { step: 1, label: 'Step 1 · 7 Mistake Explanations' },
                    { step: 2, label: 'Step 2 · Model Paraphrases' },
                    { step: 3, label: 'Step 3 · Model PEEL Paragraph' },
                    { step: 4, label: 'Step 4 · Peer Advice & Checks' },
                    { step: 5, label: 'Step 5 · Approval Criteria' },
                  ].map((item) => (
                    <label class="flex items-center justify-between gap-2 px-2 py-1.5 rounded hover:bg-paper cursor-pointer">
                      <span class="text-ink font-medium">{item.label}</span>
                      <input
                        type="checkbox"
                        class="s3-reveal-step-toggle accent-blue"
                        data-step={item.step}
                      />
                    </label>
                  ))}
                </div>
                <div class="grid grid-cols-2 gap-1.5 pt-1">
                  <button type="button" id="btn-reveal-keys-all" class="btn btn-sm btn-secondary w-full justify-center btn-on-light !px-2 !text-[10px]">
                    Reveal All Keys
                  </button>
                  <button type="button" id="btn-hide-keys-all" class="btn btn-sm btn-secondary w-full justify-center btn-on-light !px-2 !text-[10px]">
                    Hide All Keys
                  </button>
                </div>
              </div>

              <div class="pt-2 border-t border-navy/10 text-center">
                <a href="/spark/mentor" target="_blank" class="text-[11px] text-blue hover:underline font-mono">
                  Open Full Mentor Dashboard ↗
                </a>
              </div>
            </div>
          </div>
        </div>

        <span class="text-white/20">|</span>
        <a href="/spark/session-2" class="text-silver/70 hover:text-white transition-colors flex items-center gap-1.5">
          <span>← Session 2</span>
        </a>
        <span class="text-white/20">|</span>
        <a href="/spark/join?next=/spark/session-3" id="switch-link" class="text-silver/70 hover:text-white transition-colors">
          Switch team
        </a>
      </div>
    </div>
  </section>

  <!-- Sticky Progress Bar with Lock indicators (matching Session 2) -->
  <nav id="progress" class="sticky top-[72px] xl:top-[116px] z-20 bg-white border-b border-navy/10 overflow-x-auto shadow-sm" aria-label="Session 3 progress">
    <div class="max-w-[1100px] mx-auto px-5 flex gap-1 py-3 min-w-max">
      {steps.map((label, i) => (
        <button type="button" class="step-tab" data-step={i}>
          <span class="step-num">{i}</span>
          <span class="step-label">{label}</span>
          <span class="step-lock-icon text-[11px] ml-1 hidden">🔒</span>
        </button>
      ))}
    </div>
  </nav>

  <!-- Main Game Panels Container (Paper Background, not Dark Blue) -->
  <main id="game" class="bg-paper text-ink py-10 sm:py-14 min-h-[75vh]">
    <div class="max-w-[1040px] mx-auto px-4 sm:px-6">

      <!-- Team Check-In & Identity Banner (matching Session 2 UI) -->
      <div id="team-banner" class="mb-8 bg-white border border-navy/10 rounded-xl shadow-sm overflow-hidden transition-all">
        <!-- Top Bar: Identity & Status -->
        <div class="p-5 sm:p-6 flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-3.5 min-w-0">
            <div id="banner-icon-box" class="w-10 h-10 rounded-lg bg-blue/10 text-blue flex items-center justify-center shrink-0 text-lg transition-colors">
              👥
            </div>
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <h3 id="banner-team-name" class="font-display font-bold text-ink text-base sm:text-lg">
                  Working with a team?
                </h3>
                <span id="banner-status-badge" class="px-2.5 py-0.5 text-[11px] font-mono rounded bg-paper text-muted border border-navy/10 font-medium">
                  Explorer Mode
                </span>
              </div>
              <p id="banner-team-members" class="text-[13px] text-body mt-0.5">
                Have a team code from Session 1 or 2? Enter it below. New to SPARK? Register a team in 1 minute!
              </p>
            </div>
          </div>

          <!-- Switch team button (Visible ONLY when connected) -->
          <button
            type="button"
            id="btn-switch-team"
            class="text-[12px] font-mono font-medium px-3 py-1.5 rounded-lg border border-navy/15 text-muted hover:text-ink hover:border-navy/30 bg-paper/50 hover:bg-paper transition-all shrink-0 items-center gap-1.5"
          >
            <span class="text-sm">⇄</span> Switch Team
          </button>
        </div>

        <!-- Bottom Bar: Connection Controls (Visible ONLY in guest mode) -->
        <div id="banner-connect-panel" class="p-4 sm:px-6 bg-paper/50 border-t border-navy/5 flex flex-wrap items-center justify-between gap-4">
          <div class="flex flex-wrap items-center gap-2.5 w-full sm:w-auto">
            <label for="inline-team-code" class="text-[12px] font-mono text-muted uppercase tracking-wider shrink-0 font-medium">
              Team Code:
            </label>
            <div class="flex items-center gap-2 w-full sm:w-auto">
              <input
                id="inline-team-code"
                type="text"
                class="field !mt-0 !h-9 !w-32 uppercase text-center font-mono tracking-widest text-[14px] !py-0"
                maxlength="6"
                placeholder="K7P2QX"
              />
              <button type="button" id="inline-connect-btn" class="btn btn-sm btn-primary !h-9 !px-4 shrink-0">
                Connect
              </button>
            </div>
          </div>

          <div class="flex items-center gap-2.5 w-full sm:w-auto justify-between sm:justify-end pt-2 sm:pt-0 border-t sm:border-t-0 border-navy/10">
            <span class="text-[13px] text-muted">New to SPARK?</span>
            <a
              href="/spark/join?next=/spark/session-3"
              id="inline-register-btn"
              class="btn btn-sm btn-secondary btn-on-light !h-9 !px-3.5 !text-[13px] inline-flex items-center gap-1.5 shrink-0 bg-white hover:bg-blue hover:!text-white transition shadow-2xs font-semibold"
            >
              <span>Register Team</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <!-- Feedback / Errors -->
        <div id="banner-feedback" class="hidden px-5 sm:px-6 py-2.5 text-[13px] border-t border-navy/5"></div>
      </div>

      <!-- =========================================================================
           STEP 0: YACINE'S MESSAGE (3 MIN · WARM-UP & CATCH-UP)
           ========================================================================= -->
      <section id="panel-0" class="game-panel space-y-6">
        <div class="flex items-center justify-between gap-3">
          <div>
            <span class="font-mono text-[12px] uppercase text-blue font-bold tracking-wider">Step 0 · 3 Minutes</span>
            <h2 class="font-display text-3xl font-bold tracking-tight mt-1 text-ink">Yacine’s Urgent Message</h2>
          </div>
          <span class="px-3 py-1 bg-blue/10 text-blue font-mono text-[12px] font-semibold rounded">Skill: Research Synthesis</span>
        </div>

        <!-- Mentor Cue Banner (matching Session 2) -->
        <div class="p-4 sm:p-5 bg-ink text-white rounded-lg flex items-start gap-3.5 border border-white/10">
          <span class="text-2xl leading-none">🗣️</span>
          <div>
            <p class="font-mono text-[11px] uppercase tracking-wider text-peri">Mentor briefing</p>
            <p class="mt-1 text-[15px] text-white/95 leading-relaxed font-serif italic">
              “{sparkSession3.mentorCue}”
            </p>
          </div>
        </div>

        <!-- Phone Message Frame -->
        <div class="bg-white border border-navy/10 rounded-2xl p-6 sm:p-8 shadow-sm">
          <div class="flex items-center justify-between border-b border-navy/10 pb-4 mb-6">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-blue/10 text-blue font-bold flex items-center justify-center font-display text-lg">
                Y
              </div>
              <div>
                <p class="font-bold text-ink text-sm sm:text-base">Yacine</p>
                <p class="text-[11px] font-mono text-muted">Incoming SMS · Just now</p>
              </div>
            </div>
            <span class="px-2.5 py-1 text-[11px] font-mono bg-emerald-50 text-emerald-800 border border-emerald-200 rounded-full font-semibold">
              ● Urgent Request
            </span>
          </div>

          <div class="max-w-xl mx-auto bg-paper/60 p-5 rounded-2xl border border-navy/5 relative">
            <p class="text-body text-base sm:text-lg italic leading-relaxed font-serif">
              "{sparkSession3.yacineMessage}"
            </p>
          </div>
        </div>

        <!-- The Story So Far (Recap for all participants) -->
        <div class="bg-white border border-navy/10 p-6 sm:p-8 rounded-2xl shadow-sm">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <div>
              <span class="font-mono text-xs uppercase tracking-wider text-blue font-semibold">Background Recap</span>
              <h3 class="font-display text-lg font-bold text-ink mt-0.5">The Case So Far</h3>
            </div>
            <span class="text-[12px] text-blue font-mono font-medium">From Sessions 1 &amp; 2</span>
          </div>
          <div class="mt-3 text-[14px] sm:text-[15px] leading-relaxed text-body space-y-3">
            <p>
              <strong>Yacine</strong> is a first-year university student who always listens to his favourite music with headphones while studying. He claims it helps him focus, but his sister noticed his grades dropped and told him music is distracting him.
            </p>
            <p>
              In <strong>Session 1</strong>, teams followed the research trail to find the landmark empirical paper: <em>Perham &amp; Currie (2014)</em>.
              In <strong>Session 2</strong>, teams analyzed the experiment: 30 students reading in 4 conditions. The scientific finding was clear: silence and music without lyrics performed best; songs with lyrics (whether liked or disliked) impaired reading comprehension.
            </p>
          </div>
        </div>

        <!-- Session 2 Participation & Catch-Up Card (with choices!) -->
        <div class="bg-white border border-navy/10 p-6 sm:p-8 rounded-2xl shadow-sm space-y-4">
          <div class="flex items-center justify-between flex-wrap gap-2">
            <div>
              <span class="font-mono text-xs uppercase tracking-wider text-blue font-semibold">Team Readiness</span>
              <h3 class="font-display text-lg font-bold text-ink mt-0.5">Did your team participate in Session 2?</h3>
              <p class="text-[13px] text-muted">Choose your team status so we set up your evidence card for Step 3.</p>
            </div>
            <span class="text-[12px] text-blue font-mono font-medium">Session 2 Check</span>
          </div>

          <!-- Choices buttons -->
          <div class="flex flex-col sm:flex-row gap-3 pt-1">
            <button type="button" class="s2-participation-choice choice-btn chosen" data-choice="yes">
              Yes, we completed Session 2
            </button>
            <button type="button" class="s2-participation-choice choice-btn" data-choice="no">
              No, we're new / missed Session 2
            </button>
          </div>

          <!-- Yes info -->
          <div id="s2-choice-yes-info" class="p-4 bg-emerald-50 border border-emerald-200 text-emerald-900 rounded-xl text-[13px] flex items-start gap-2.5">
            <span class="text-emerald-600 text-lg leading-none mt-0.5">✓</span>
            <div>
              <strong>Great!</strong> Your Reading Card from Session 2 (who, what was tested, main finding, and explanation) is linked to your team code and will be ready in the drawer beside your writing boxes in Step 3.
            </div>
          </div>

          <!-- No / Catch-up info -->
          <div id="s2-choice-no-info" class="hidden p-5 bg-blue/5 border border-blue/20 rounded-xl space-y-3">
            <div class="flex items-center gap-2 text-blue font-bold text-sm">
              <span>📖</span>
              <span>No problem at all! Here is the Session 2 Evidence Card ready for you:</span>
            </div>
            <p class="text-body text-[13px] leading-relaxed">
              Here is the exact scientific evidence from <em>Perham &amp; Currie (2014)</em> that your team will need today to write Yacine’s trusted paragraph:
            </p>
            <div class="grid sm:grid-cols-2 gap-3 text-[12px]">
              <div class="p-3 bg-white rounded-lg border border-navy/10">
                <strong class="text-ink">1. Who was tested:</strong>
                <p class="text-muted mt-0.5">30 university undergraduates (mean age 21 years) completed reading comprehension tests.</p>
              </div>
              <div class="p-3 bg-white rounded-lg border border-navy/10">
                <strong class="text-ink">2. What was tested (4 conditions):</strong>
                <p class="text-muted mt-0.5">Quiet environment, music without lyrics (instrumental), preferred songs with lyrics, and disliked songs with lyrics.</p>
              </div>
              <div class="p-3 bg-white rounded-lg border border-navy/10">
                <strong class="text-ink">3. Empirical Result:</strong>
                <p class="text-muted mt-0.5">Understanding was highest in quiet and instrumental music; lowest in both lyric conditions (whether liked or disliked).</p>
              </div>
              <div class="p-3 bg-white rounded-lg border border-navy/10">
                <strong class="text-ink">4. Explanation (Mechanism):</strong>
                <p class="text-muted mt-0.5">Lyrics contain words. The brain must spend mental effort to process and suppress those words, leaving less capacity for the reading text.</p>
              </div>
            </div>
            <div class="pt-2 text-right">
              <button type="button" id="btn-load-fallback-card" class="btn btn-sm btn-primary">
                ✓ Use this Evidence in Step 3 Drawer
              </button>
            </div>
          </div>
        </div>

        <!-- 4 Pillars of a Trusted Paragraph -->
        <div class="bg-white border border-navy/10 rounded-2xl p-6 sm:p-8 shadow-sm space-y-6">
          <div>
            <span class="font-mono text-xs uppercase tracking-wider text-blue font-semibold">The Research Standard</span>
            <h2 class="font-display text-xl sm:text-2xl font-bold text-ink mt-1">What makes a paragraph something he can trust?</h2>
            <p class="text-body text-[14px] mt-1">
              Yacine needs an honest, evidence-based answer — not a blog post, personal feeling, or distorted overclaim.
            </p>
          </div>

          <div class="grid sm:grid-cols-2 gap-4">
            {sparkSession3.fourPillars.map((p) => (
              <div class="p-4 bg-paper rounded-xl border border-navy/10 flex flex-col justify-between">
                <div>
                  <p class="font-bold text-ink text-[14px]">{p.title}</p>
                  <p class="text-body text-[13px] mt-1.5 leading-relaxed">{p.desc}</p>
                </div>
              </div>
            ))}
          </div>

          <div class="pt-4 border-t border-navy/10 flex flex-wrap items-center justify-between gap-4">
            <p class="text-[13px] text-muted font-mono">Ready to write for Yacine? Let's inspect a bad answer first.</p>
            <button type="button" class="btn btn-primary btn-next-step" data-next="1">
              Step 1 · Spot the Problems →
            </button>
          </div>
        </div>

        <!-- Answer Key Box (Key 0) -->
        <div id="key-box-0" class="hidden bg-emerald-50 border border-emerald-200 rounded-2xl p-6 space-y-3">
          <div class="flex items-center gap-2 text-emerald-900 font-bold text-sm">
            <span>👑 Mentor Key Revealed · Step 0</span>
          </div>
          <p class="text-emerald-950 text-[13px] leading-relaxed">
            The goal of Session 3 is to bridge reading and writing: using <strong>Perham &amp; Currie (2014)</strong> to craft a rigorous, 1-paragraph synthesis that answers Yacine honestly. Remind students that research writing is not about winning an argument — it's about accuracy.
          </p>
        </div>
      </section>

    <!-- =========================================================================
         STEP 1: SPOT THE PROBLEMS (10 MIN · DETECTIVE STEP)
         ========================================================================= -->
    <section id="panel-1" class="game-panel hidden space-y-8">
      <div class="bg-white border border-navy/10 rounded-2xl p-6 sm:p-8 shadow-sm space-y-6">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-navy/10 pb-4">
          <div>
            <span class="font-mono text-xs uppercase tracking-wider text-blue font-semibold">The Detective Step · 10 min</span>
            <h2 class="font-display text-xl sm:text-2xl font-bold text-ink mt-1">Spot the 7 Mistakes in the Bad Answer</h2>
            <p class="text-body text-[14px] mt-1">
              Yacine’s friend sent him this hasty summary. Click on each problematic segment below and tag it with the correct diagnosis.
            </p>
          </div>
          <div class="text-right">
            <span class="text-xs font-mono text-muted uppercase">Detective Score:</span>
            <p id="mistakes-counter" class="font-mono font-bold text-xl text-blue">0 / 7 Tagged</p>
          </div>
        </div>

        <!-- Bad Answer Interactive Card -->
        <div class="p-6 bg-paper rounded-2xl border border-navy/10 space-y-4">
          <p class="text-[11px] font-mono uppercase text-muted tracking-wider">Tap a phrase to diagnose its problem:</p>
          
          <div class="text-[17px] sm:text-[18px] leading-relaxed font-serif text-ink select-none">
            <span class="detective-target cursor-pointer px-1 py-0.5 rounded transition border-b-2 border-dashed border-signal/60 hover:bg-signal/10" data-id="m1">
              "Music is really bad for studying!!"
            </span>{" "}
            <span class="detective-target cursor-pointer px-1 py-0.5 rounded transition border-b-2 border-dashed border-signal/60 hover:bg-signal/10" data-id="m2">
              Perham and Currie
            </span>{" "}
            <span class="detective-target cursor-pointer px-1 py-0.5 rounded transition border-b-2 border-dashed border-signal/60 hover:bg-signal/10" data-id="m3">
              proved
            </span>{" "}
            that{" "}
            <span class="detective-target cursor-pointer px-1 py-0.5 rounded transition border-b-2 border-dashed border-signal/60 hover:bg-signal/10" data-id="m4">
              listening to music is always distracting.
            </span>{" "}
            In their study,{" "}
            <span class="detective-target cursor-pointer px-1 py-0.5 rounded transition border-b-2 border-dashed border-signal/60 hover:bg-signal/10" data-id="m5">
              songs with lyrics made reading worse, and the songs students liked were just as bad as the songs they disliked.
            </span>{" "}
            <span class="detective-target cursor-pointer px-1 py-0.5 rounded transition border-b-2 border-dashed border-signal/60 hover:bg-signal/10" data-id="m6">
              So Yacine should never listen to any music.
            </span>{" "}
            <span class="detective-target cursor-pointer px-1 py-0.5 rounded transition border-b-2 border-dashed border-signal/60 hover:bg-signal/10" data-id="m7">
              Lots of students
            </span>{" "}
            did the test.
          </div>
        </div>

        <!-- Tagging Interface & Status Table -->
        <div class="space-y-3">
          <p class="font-mono text-[11px] uppercase text-muted tracking-wider">Detected Issues List:</p>
          <div class="grid gap-2.5" id="mistakes-list">
            {sparkSession3.badAnswerMistakes.map((m) => (
