---
// 404 — "This island isn't on the map."
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found" noindex>
  <script is:inline>
    // Handle dynamic client-side routes in static mode
    if (typeof window !== 'undefined' && window.location.pathname.startsWith('/spark/mentor/team/')) {
      const id = window.location.pathname.replace('/spark/mentor/team/', '').replace(/\/$/, '');
      if (id) {
        window.location.replace('/spark/mentor/team?id=' + encodeURIComponent(id));
      }
    }
  </script>
  <section class="relative min-h-[80vh] overflow-hidden bg-ink flex items-center">
    <div class="absolute inset-0 dots opacity-25 pointer-events-none"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[640px] h-[460px] rounded-full bg-blue/15 blur-[140px] pointer-events-none"></div>
    <div class="relative max-w-[1240px] mx-auto px-6 md:px-12 pt-32 xl:pt-40 pb-20 text-center">
      <p class="hero-in eyebrow text-peri" style="--hd:.05s">Error 404</p>
      <h1 data-split="hero" class="mt-6 font-display font-bold text-white text-5xl sm:text-6xl tracking-tight leading-[1.05]">This island isn't on the map.</h1>
      <p style="--hd:.6s" class="hero-in mt-6 font-serif italic text-xl sm:text-2xl text-peri">“Even the best navigators get lost sometimes.”</p>
      <div style="--hd:.8s" class="hero-in mt-10 flex flex-col sm:flex-row justify-center gap-4">
        <a href="/" class="btn btn-primary">Back to home</a>
        <a href="/events" class="btn btn-secondary">See events →</a>
      </div>
    </div>
  </section>
</BaseLayout>
