---
// Research — Research Programs department (Welcome Day deck, slides 15–17).
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import SectionHeader from '../../components/ui/SectionHeader.astro';
import Icon from '../../components/ui/Icon.astro';
import EmptyState from '../../components/ui/EmptyState.astro';
import VoyageRoute from '../../components/sections/VoyageRoute.astro';
import CollaborateStrip from '../../components/sections/CollaborateStrip.astro';
import FinalCTA from '../../components/sections/FinalCTA.astro';
import { getPoles, getPoleLeads, getDepartmentHeads } from '../../lib/content';
import { voyage } from '../../data/club';

const dept = (await getEntry('departments', 'research'))!;
const [head] = await getDepartmentHeads('research');
const poles = await getPoles();
const leads = await getPoleLeads();
---
<BaseLayout title="Research" description="INSIGHT's research programs: four research poles, project teams, and the voyage from a first question to a first paper.">
  <PageHeader
    eyebrow="Research programs"
    title="Where questions become discoveries."
    lead="Research Programs is the heart of INSIGHT. It develops projects in our four poles, forms and guides the teams, and takes each project from a first question to a paper."
    chip={head && { label: 'Head of Research', value: head.data.name }}
  />

  <!-- LOG 01 · The mission -->
  <section class="bg-paper text-ink py-24 sm:py-28">
    <div class="max-w-[1240px] mx-auto px-6 md:px-12">
      <SectionHeader eyebrow="Log 01 · The mission" title="What Research Programs does." />
      <div class="mt-14 rounded-2xl overflow-hidden border border-navy/10 grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-navy/10 rv-cells">
        {dept.data.handles.map((h, i) => (
          <article class="p-8 bg-white">
            <span class="font-mono text-[12px] text-muted">{String(i + 1).padStart(2, '0')}</span>
            <p class="mt-6 font-display text-xl font-bold leading-snug text-ink">{h}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- LOG 02 · The four poles -->
  <section class="relative bg-ink py-24 sm:py-28 overflow-hidden">
    <div class="absolute inset-0 dots opacity-20 pointer-events-none"></div>
    <div class="absolute top-1/3 right-[10%] w-[500px] h-[500px] rounded-full bg-blue/12 blur-[120px] pointer-events-none"></div>
    <div class="relative max-w-[1240px] mx-auto px-6 md:px-12">
      <SectionHeader eyebrow="Log 02 · Research poles" title="Four poles. One fleet." subtitle="Pick the ship that excites you." tone="dark" />
      <ul class="mt-14 rounded-2xl overflow-hidden border border-silver/10 grid md:grid-cols-2 gap-px bg-silver/10 rv-cells" role="list">
        {poles.map((p) => {
          const poleLeads = leads.filter((l) => l.data.pole === p.id);
          return (
            <li class="group relative bg-ink-2 hover:bg-[#162038] transition-colors">
              <a href={`/research/${p.id}`} class="flex h-full flex-col p-8 lg:p-10">
                <span class="eyebrow text-peri">Pole {String(p.data.number).padStart(2, '0')}</span>
                <h3 class="mt-3 font-display text-3xl font-bold text-white tracking-tight">{p.data.name}</h3>
                <p class="mt-3 text-[16px] text-silver/75 leading-relaxed">{p.data.description}</p>
                <div class="mt-6 flex flex-wrap gap-2">
                  {p.data.topics.map((t) => <span class="px-3 py-1 font-mono text-[12px] text-silver border border-peri/30">{t.title}</span>)}
                </div>
                <div class="mt-8 pt-6 border-t border-silver/10">
                  <p class="eyebrow text-muted">Pole leads</p>
                  <p class="mt-3 text-[15px] text-white leading-relaxed">{poleLeads.map((l) => l.data.name).join(' · ')}</p>
                </div>
                <span class="mt-8 inline-flex items-center gap-2 text-[15px] font-medium text-peri-light group-hover:text-white transition-colors">
                  Explore the pole <Icon name="arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <VoyageRoute eyebrow="Log 03 · How research works" cta={null} />

  <!-- LOG 04 · How you take part -->
  <section class="bg-white text-ink py-24 sm:py-28 border-t border-navy/10">
    <div class="max-w-[1240px] mx-auto px-6 md:px-12">
      <SectionHeader eyebrow="Log 04 · Take part" title="How you take part." />
      <div class="mt-14 rounded-2xl overflow-hidden border border-navy/10 grid md:grid-cols-3 gap-px bg-navy/10 rv-cells">
        {voyage.takePart.map((s, i) => (
          <article class="p-8 bg-white">
            <span class="flex w-11 h-11 rounded-full border-2 border-navy items-center justify-center font-mono text-[13px] font-semibold text-navy">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-6 font-display text-xl font-bold text-ink">{s.title}</h3>
            <p class="mt-2 text-[15px] text-body leading-relaxed">{s.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- LOG 05 · Current projects (none yet: honest state) -->
  <section class="bg-paper text-ink py-24 sm:py-28">
    <div class="max-w-[1240px] mx-auto px-6 md:px-12">
      <SectionHeader eyebrow="Log 05 · Projects" title="Current projects." class="mb-12" />
      <EmptyState
        label="In progress"
        title="Our first projects are being formed."
        text="Project teams are taking shape in the four poles. Explore our research directions or get in touch with our pole leads."
        action={{ href: '/contact', label: 'Contact pole leads →' }}
      />
    </div>
  </section>

  <CollaborateStrip title="Researchers from around the world work with our crew." href="/network" label="Meet the network →" />

  <FinalCTA secondary={{ href: '/training', label: 'See the training path →' }} />
</BaseLayout>
