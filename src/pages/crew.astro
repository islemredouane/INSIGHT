---
// Crew — the Helm, the 7 departments and the pole leads (Welcome Day deck, slides 7–13 and 17).
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Masthead from '../components/sections/Masthead.astro';
import MemberCard from '../components/cards/MemberCard.astro';
import Icon from '../components/ui/Icon.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import { getPoles, getPoleLeads, byOrder } from '../lib/content';
import { site } from '../data/site';

const departments = (await getCollection('departments')).sort((a, b) => a.data.number - b.data.number);
const heads = (await getCollection('crew', (m) => m.data.group === 'department')).sort(byOrder);
const poles = await getPoles();
const leads = await getPoleLeads();
---
<BaseLayout title="Crew" description={`The INSIGHT crew ${site.season}: the Helm, seven departments and four research poles.`}>
  <PageHeader
    eyebrow={`The crew · ${site.season}`}
    title="Every great voyage needs more than a captain."
    lead="The Helm sets the course. Seven departments sail the ship, and four research poles carry the heart of INSIGHT."
  >
    <nav class="hero-in mt-8 flex flex-wrap gap-2" style="--hd:.75s" aria-label="On this page">
      <a href="#helm" class="btn btn-sm btn-secondary">The Helm</a>
      <a href="#departments" class="btn btn-sm btn-secondary">Departments</a>
      <a href="#poles" class="btn btn-sm btn-secondary">Research poles</a>
    </nav>
  </PageHeader>

  <div id="helm" class="scroll-mt-20">
    <Masthead eyebrow="Log 01 · The helm" title="The Helm." subtitle="The helm sets the course." showLink={false} />
  </div>

  <!-- LOG 02 · Departments -->
  <section id="departments" class="bg-white text-ink py-24 sm:py-28 border-t border-navy/10 scroll-mt-20">
    <div class="max-w-[1240px] mx-auto px-6 md:px-12">
      <SectionHeader eyebrow="Log 02 · Departments" title="Seven departments sail the ship." subtitle="Five keep the ship running. Two are its heart." />
      <div class="mt-16 divide-y divide-navy/10 border-y border-navy/10">
        {departments.map((d) => {
          const team = heads.filter((h) => h.data.department === d.id);
          return (
            <article id={d.id} class="rv py-12 grid lg:grid-cols-12 gap-10 scroll-mt-24">
              <div class="lg:col-span-5">
                <p class="eyebrow text-blue flex items-center gap-3">
                  Department {String(d.data.number).padStart(2, '0')}
                  {d.data.heart && <span class="px-2 py-0.5 bg-blue text-white tracking-[.1em]">The heart</span>}
                </p>
                <h3 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink">{d.data.name}</h3>
                <p class="mt-3 font-serif italic text-xl text-blue leading-snug">{d.data.onBoardAs}</p>
                <ul class="mt-6 space-y-2">
                  {d.data.handles.map((h, i) => (
                    <li class="flex gap-4 text-[15px] text-body"><span class="font-mono text-[12px] text-muted pt-0.5">{String(i + 1).padStart(2, '0')}</span>{h}</li>
                  ))}
                </ul>
                <p class="mt-6 text-[15px] font-medium text-navy">{d.data.closing}</p>
              </div>
              <ul class:list={['lg:col-span-7 self-start rounded-2xl overflow-hidden border border-navy/10 grid gap-px bg-navy/10', team.length > 1 && 'sm:grid-cols-2 sm:[&>li:last-child:nth-child(odd)]:col-span-2']} role="list">
                {team.map((m) => <MemberCard member={m} roleLabel={m.data.role === 'Head' ? `Head · ${d.data.name.split(' & ')[0]}` : m.data.role} />)}
              </ul>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- LOG 03 · Research pole leads -->
  <section id="poles" class="relative bg-ink py-24 sm:py-28 overflow-hidden scroll-mt-20">
    <div class="absolute inset-0 dots opacity-20 pointer-events-none"></div>
    <div class="relative max-w-[1240px] mx-auto px-6 md:px-12">
      <SectionHeader eyebrow="Log 03 · Research poles" title="Four ships, one fleet." subtitle="The pole leads guide the project teams." tone="dark" />
      <ul class="mt-14 rounded-2xl overflow-hidden border border-silver/10 grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-silver/10 rv-cells" role="list">
        {poles.map((p) => (
          <li class="group bg-ink-2 hover:bg-[#162038] transition-colors">
            <a href={`/research/${p.id}`} class="flex h-full flex-col p-7">
              <span class="font-mono text-[12px] text-peri">Pole {String(p.data.number).padStart(2, '0')}</span>
              <span class="mt-2 font-display text-xl font-bold text-white">{p.data.name}</span>
              <ul class="mt-5 space-y-3 flex-1">
                {leads.filter((l) => l.data.pole === p.id).map((l) => (
                  <li><p class="text-[15px] font-semibold text-white">{l.data.name}</p><p class="font-mono text-[12px] text-peri-light">Pole lead</p></li>
                ))}
              </ul>
              <span class="mt-6 inline-flex items-center gap-2 text-[14px] font-medium text-peri-light group-hover:text-white">Explore the pole <Icon name="arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-1" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <FinalCTA
    eyebrow="Your name here next year?"
    title="Every great voyage needs more than a captain."
    line="No crew member left behind."
    secondary={{ href: '/about', label: 'How the club works →' }}
  />
</BaseLayout>
