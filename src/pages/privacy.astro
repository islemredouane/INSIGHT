---
// Privacy — short and honest. Update if analytics or a contact form are added.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { site, mailto } from '../data/site';
const updated = '9 November 2026';
---
<BaseLayout title="Privacy" description="How the INSIGHT website handles your data.">
  <PageHeader eyebrow="Privacy" title="Your data, simply." lead={`Last updated: ${updated}.`} />
  <section class="bg-paper text-ink py-20 sm:py-24">
    <div class="max-w-3xl mx-auto px-6 md:px-12 prose-insight">
      <h2>What this website collects</h2>
      <p>Nothing about you. The website does not use cookies, trackers or analytics, and it does not ask you to create an account.</p>
      <h2>When you contact us</h2>
      <p>If you use the <a href="/contact">contact form</a> or write to <a href={mailto()}>{site.email}</a>, we receive your name, your email and your message. We use them only to answer you, and we don't share them with anyone outside the club.</p>
      <p>The contact form is delivered by Web3Forms, a service that forwards each message to our email. Web3Forms' own privacy policy applies to that delivery.</p>
      <h2>Joining the club</h2>
      <p>Registrations use a form hosted by Google Forms. What you write there is used only by the club's Human Resources department to process your registration. Google's own privacy policy applies to that form.</p>
      <h2>Links to other websites</h2>
      <p>Some links lead to other websites (ESTIN, Instagram, researchers' pages). Their own privacy policies apply there.</p>
      <h2>Questions</h2>
      <p>Write to <a href={mailto('Privacy question')}>{site.email}</a> and we'll answer.</p>
    </div>
  </section>
</BaseLayout>
