---
// About — content from the Welcome Day 2026 deck (slides 2, 3 and 8).
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Directions from '../components/sections/Directions.astro';
import OrgChart from '../components/sections/OrgChart.astro';
import StatBand from '../components/sections/StatBand.astro';
import FinalCTA from '../components/sections/FinalCTA.astro';
import { site } from '../data/site';
import { longDate } from '../lib/format';

const defining = [
  { n: 'I', title: 'Student-led', text: 'Run by students, free and open to everyone.' },
  { n: 'II', title: 'Why we set sail', text: 'To give students a place to discover research together.' },
  { n: 'III', title: 'Our spirit', text: 'We gather, protect and question knowledge. No special talent required, only curiosity.' },
];
---
<BaseLayout title="About" description="INSIGHT is the student-led research club of ESTIN, Béjaïa: a crew of students who read, question and contribute to science.">
  <PageHeader
    eyebrow="About INSIGHT"
    title="We read, question and contribute to science."
    lead={`A student-led research community at ${site.school.name}, Béjaïa. Founded on ${longDate(new Date(site.founded))}, free and open to every student.`}
  />

  <!-- LOG 01 · What is INSIGHT (deck slide 2) -->
  <section class="bg-paper text-ink py-24 sm:py-28">
    <div class="max-w-[1240px] mx-auto px-6 md:px-12">
      <div class="grid lg:grid-cols-12 gap-10 items-end">
        <SectionHeader eyebrow="Log 01 · What is INSIGHT" title="A place to discover research together." class="lg:col-span-7" />
        <p style="--d:180ms" class="rv lg:col-span-5 text-[17px] text-body leading-relaxed">
          INSIGHT officially set sail at our Welcome Day on {longDate(new Date(site.founded))}, with a live talk by
          Dr. Pin-Yu Chen from IBM Research. Since then, the crew has one goal: help every member go from a first
          question to a first research paper.
        </p>
      </div>
      <div class="mt-14 rounded-2xl overflow-hidden border border-navy/10 grid md:grid-cols-3 gap-px bg-navy/10 rv-cells">
        {defining.map((d) => (
          <article class="p-8 bg-white">
            <span class="font-mono text-xl font-semibold text-blue">{d.n}</span>
            <h3 class="mt-6 font-display text-xl font-bold text-ink">{d.title}</h3>
            <p class="mt-2 text-[15px] text-body leading-relaxed">{d.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- LOG 02 · Vision (deck slide 3) -->
  <section class="bg-white text-ink py-24 sm:py-28 border-y border-navy/10">
    <div class="max-w-[1240px] mx-auto px-6 md:px-12">
      <SectionHeader eyebrow="Log 02 · Our vision" title="Our compass." subtitle="It always points to the next question." />
      <Directions class="mt-16" />
    </div>
  </section>

  <!-- LOG 03 · How the ship is organised (deck slide 8) -->
  <section class="bg-paper text-ink py-24 sm:py-28">
    <div class="max-w-[1240px] mx-auto px-6 md:px-12">
      <SectionHeader eyebrow="Log 03 · The crew" title="How our ship is organised." subtitle="The helm sets the course. The departments sail the ship." />
      <OrgChart />
    </div>
  </section>

  <StatBand />

  <FinalCTA
    eyebrow="Log 04 · Come aboard"
    title="Every great journey needs more than a captain."
    line="Set sail. Explore the unknown."
    secondary={{ href: '/crew', label: 'Meet the crew →' }}
  />
</BaseLayout>
