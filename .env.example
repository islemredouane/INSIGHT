# Copy to .env.local (local development) or add in Vercel → Project Settings → Environment Variables.

# Review mode: set to true to preview unpublished drafts & placeholders locally. Defaults to false.
PUBLIC_REVIEW_MODE=false

# Cloudflare R2 Storage & CDN Configuration
PUBLIC_CDN_URL=https://pub-554f8a45acb54090af55ec98805e7e60.r2.dev
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=insight-images
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
